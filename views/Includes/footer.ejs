<script>
  // ====== Config ======
  const waNumber = "<%= typeof whatsappNumber !== 'undefined' ? whatsappNumber : '918319339945' %>"; // e.g., 919876543210
  const grad = "<%= graduation_type_send || '' %>"; // empty string if null

  function waLink(extra) {
    extra = extra || '';
    var base = 'https://wa.me/' + waNumber;
    var text = 'Hi FileMakr,%0AI\'m looking for ' + grad + ' final-year project report and source code.';
    if (extra) {
      text += '%0AQuery: ' + encodeURIComponent(extra);
    }
    text += '%0APlease share details.';
    return base + '?text=' + text;
  }
  function setAllWaLinks(query=''){
    ['WhatsAppFloat','WhatsAppTop','WhatsAppEmpty','WhatsAppSide','WhatsAppHero','WhatsAppSticky'].forEach(id=>{
      const a=document.getElementById(id);
      if(a){a.setAttribute('href',waLink(query));a.setAttribute('target','_blank');a.setAttribute('rel','noopener');}
    });
  }

  // Homepage / pages without listing grid: skip heavy filter/sort JS
  if (!document.getElementById('Grid') && !document.getElementById('Search')) {
    setAllWaLinks();
  } else if (document.getElementById('Grid') && document.getElementById('Grid').getAttribute('data-pr-catalog') === '1') {
    // project-report progressive catalog owns search/filter — don't bind DOM listing filter
    setAllWaLinks();
  } else {
  // ====== Search + Sort ======
  const input=document.getElementById('Search');
  const exploreSearch=document.getElementById('ExploreSearch');
  const techFilter=document.getElementById('TechFilter');
  const nodes=Array.from(document.getElementsByClassName('target'));
  const countEl=document.getElementById('ResultCount') || document.getElementById('ExploreCount');
  const emptyEl=document.getElementById('EmptyState');
  const grid=document.getElementById('Grid');
  const sortSel=document.getElementById('Sort');
  const demoFilterBtn=document.getElementById('FilterDemoOnly');
  const demoFilterMobile=document.getElementById('FilterDemoOnlyMobile');
  const mdBtnLabel = <%- JSON.stringify(typeof listCtaLabel !== 'undefined' ? listCtaLabel : 'View') %>;

  let q='';
  let activeStack='';
  let activeTech='';
  const normalize=s=> (s||'').toLowerCase();
  // Match categories regardless of -, _, ., spaces (e.g. machine-learning === Machine Learning)
  const normalizeCat=s=> String(s||'')
    .toLowerCase()
    .replace(/[,|/]+/g, ' ')
    .replace(/[-_.]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  const compactCat=s=> normalizeCat(s).replace(/\s+/g, '');

  function categoryMatches(cardCat, selectedTech){
    if (!selectedTech) return true;
    const nc = normalizeCat(cardCat);
    const nt = normalizeCat(selectedTech);
    if (!nt) return true;
    if (nc === nt) return true;
    if (nc.includes(nt)) return true;
    // token / compact match: "nodejs" <-> "node js", "data-analytics" <-> "Data Analytics"
    if (compactCat(cardCat).includes(compactCat(selectedTech))) return true;
    const cardTokens = nc.split(' ').filter(Boolean);
    const techTokens = nt.split(' ').filter(Boolean);
    if (techTokens.length && techTokens.every(function (t) { return cardTokens.indexOf(t) !== -1; })) return true;
    return false;
  }

  function isDemoFilterActive(){
    return (demoFilterBtn && demoFilterBtn.classList.contains('active'))
      || (demoFilterMobile && demoFilterMobile.classList.contains('active'));
  }

  function setDemoFilterActive(on){
    [demoFilterBtn, demoFilterMobile].forEach(function(btn){
      if (!btn) return;
      btn.classList.toggle('active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

 function apply(){
  const nq = normalize(q);
  const demoOnlyActive = isDemoFilterActive();
  let visible = [];
  let hiddenPool = document.getElementById('GridHiddenPool');
  if (!hiddenPool && grid) {
    hiddenPool = document.createElement('div');
    hiddenPool.id = 'GridHiddenPool';
    hiddenPool.hidden = true;
    hiddenPool.setAttribute('aria-hidden', 'true');
    grid.parentNode.insertBefore(hiddenPool, grid.nextSibling);
  }

  nodes.forEach(n=>{
    const name = normalize(n.getAttribute('data-name'));
    const desc = normalize(n.getAttribute('data-desc'));
    const cat = normalize(n.getAttribute('data-category'));
    const hasDemo = n.getAttribute('data-demo') === '1';
    const stackSlug = (n.getAttribute('data-stack-slug') || '').toLowerCase();
    const matchText = !nq || name.includes(nq) || desc.includes(nq) || normalizeCat(cat).includes(nq) || compactCat(cat).includes(nq.replace(/\s+/g, ''));
    const matchDemo = !demoOnlyActive || hasDemo;
    const matchStack = !activeStack || stackSlug === activeStack;
    const matchTech = categoryMatches(cat, activeTech);
    const matches = matchText && matchDemo && matchStack && matchTech;
    n.classList.toggle('is-filter-hidden', !matches);
    if (matches) {
      if (grid) grid.appendChild(n);
      n.hidden = false;
      n.style.display = '';
      visible.push(n);
    } else {
      if (hiddenPool) hiddenPool.appendChild(n);
      n.hidden = true;
      n.style.display = 'none';
    }
  });

  // Sort visible in DOM
  const mode = sortSel ? sortSel.value : 'relevance';
  visible.sort((a,b)=>{
    const an = a.getAttribute('data-name').toLowerCase();
    const bn = b.getAttribute('data-name').toLowerCase();
    if(mode==='alpha') return an.localeCompare(bn);
    if(mode==='alphaDesc') return bn.localeCompare(an);
    return 0;
  });
  visible.forEach(n=>grid.appendChild(n));

  // ✅ Null-safe UI updates
  if (typeof countEl !== 'undefined' && countEl) {
    countEl.textContent = String(visible.length);
  }
  if (typeof emptyEl !== 'undefined' && emptyEl) {
    const showEmpty = visible.length === 0;
    emptyEl.style.display = showEmpty ? 'block' : 'none';

    if (showEmpty) {
      // Pre-fill WhatsApp topic with the current query
      const topicInput = document.getElementById('EmptyTopicInput');
      if (topicInput && q && !topicInput.value) topicInput.value = q;

      // Ensure WA links carry the query
      setAllWaLinks(q);

      // Smooth scroll into view on mobile
      emptyEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  } else {
    // Fallback: still keep WA links updated
    setAllWaLinks(q);
  }

  if (window.AOS && typeof window.AOS.refreshHard === 'function') {
    window.AOS.refreshHard();
  } else if (window.AOS && typeof window.AOS.refresh === 'function') {
    window.AOS.refresh();
  }
}

  // ====== Most Demanding (random from current results) ======
  function shuffle(arr){for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];} return arr;}
  function mdStripText(s){
    const t = String(s == null ? '' : s).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
    return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function populateMostDemanding(){
  const container = document.getElementById('MostDemanding');
  if(!container) return;
  container.innerHTML = '';

  const items = shuffle(nodes.slice()).slice(0, Math.min(8, nodes.length));
  items.forEach(n=>{
    const rawName = n.getAttribute('data-name') || '';
    const rawDesc = n.getAttribute('data-desc') || '';
    const name = mdStripText(rawName);
    const desc = mdStripText(rawDesc);
    const url  = n.getAttribute('data-url')  || '#';
    const stack = mdStripText(n.getAttribute('data-stack') || '');
    const hasDemo = n.getAttribute('data-demo') === '1';
    const wa   = waLink(`Need details for "${rawName}"`);

    const card = document.createElement('div');
    card.className = 'md-item';
    card.innerHTML = `
      <div class="md-badges">
        <span class="md-chip"><i class="feather-trending-up"></i> Popular</span>
        ${stack ? `<span class="md-chip md-chip--stack">${stack}</span>` : ''}
        ${hasDemo ? `<span class="md-chip md-chip--demo"><i class="feather-play-circle"></i> Live demo</span>` : ''}
        <span class="md-chip md-chip--price">₹99</span>
      </div>
      <h4 class="md-title">${name}</h4>
      <div class="md-desc">${desc}</div>
      <div class="md-actions">
        <a class="md-btn md-btn-light" href="${url}" aria-label="${mdBtnLabel}: ${name}">${mdBtnLabel} →</a>
      </div>
    `;
    container.appendChild(card);
  });
}


  // Debounced search
  let t;
  function setSearchQuery(val){
    q = val || '';
    if (input && input.value !== q) input.value = q;
    if (exploreSearch && exploreSearch.value !== q) exploreSearch.value = q;
    clearTimeout(t);
    t = setTimeout(apply, 150);
  }
  input && input.addEventListener('input',(e)=>{ setSearchQuery(e.target.value || ''); });
  exploreSearch && exploreSearch.addEventListener('input',(e)=>{ setSearchQuery(e.target.value || ''); });
  sortSel && sortSel.addEventListener('change',apply);
  techFilter && techFilter.addEventListener('change', function(){
    activeTech = techFilter.value || '';
    apply();
  });
  demoFilterBtn && demoFilterBtn.addEventListener('click', function(){
    setDemoFilterActive(!isDemoFilterActive());
    apply();
  });
  demoFilterMobile && demoFilterMobile.addEventListener('click', function(){
    setDemoFilterActive(!isDemoFilterActive());
    apply();
  });
  document.querySelectorAll('[data-stack-filter]').forEach(function(btn){
    btn.addEventListener('click', function(){
      activeStack = btn.getAttribute('data-stack-filter') || '';
      document.querySelectorAll('[data-stack-filter]').forEach(function(b){
        const slug = b.getAttribute('data-stack-filter') || '';
        const on = slug === activeStack;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      apply();
    });
  });

  // Init
  setAllWaLinks('');
  populateMostDemanding();
  apply();
  } // end listing-page branch
</script>

<script>
  // Enhance WhatsApp click: prefer typed topic, else fallback to search query
(function(){
  const waBtn = document.getElementById('WhatsAppEmpty');
  const topicInput = document.getElementById('EmptyTopicInput');
  const emptyWrap = document.getElementById('EmptyState');

  if (waBtn) {
    waBtn.addEventListener('click', function(e){
      e.preventDefault();
      const searchQ = (typeof q !== 'undefined' ? q : '')
        || document.getElementById('Search')?.value
        || document.getElementById('ExploreSearch')?.value
        || window.__PR_SEARCH_QUERY
        || '';
      const topic = (topicInput?.value || searchQ || 'custom project topic').trim();
      const kind = emptyWrap?.getAttribute('data-empty-kind') || 'source-code';
      const isIdeas = kind === 'ideas';
      const msg = topic
        ? (isIdeas
          ? `Hi FileMakr, I searched for "${topic}" but couldn't find a matching project idea. Can your team create a custom final-year project idea and report outline for me?`
          : `Hi FileMakr, I searched for "${topic}" but couldn't find matching source code. Can your team build this project for me with complete source code, database, documentation and setup support?`)
        : '';
      window.open(waLink(msg), '_blank', 'noopener');
    });
  }

  // Optional: submit on Enter
  topicInput && topicInput.addEventListener('keydown', function(e){
    if (e.key === 'Enter') {
      e.preventDefault();
      document.getElementById('WhatsAppEmpty').click();
    }
  });
})();

</script>


