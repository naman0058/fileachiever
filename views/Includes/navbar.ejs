<div class="main-wrapper">
  <style>
   /* ---- Offer Bar — sticky only (header scrolls away) ---- */
.offer-bar{
  --offer-orange: #F17F23;
  --offer-ink: #2F3542;
  position: sticky;
  top: 0;
  z-index: 1040;
  width: 100%;
  color: var(--offer-ink);
  box-shadow: none;
  border-bottom: 1px solid #F3E0D2;
  background: #FFF3EA;
}

/* Theme `.header-fixed` is fixed/top:0 — keep header in document flow so it never covers offer */
header.fm-header.header-fixed,
.fm-header.header-fixed{
  position: relative !important;
  top: auto !important;
  left: auto !important;
  right: auto !important;
  z-index: 1025 !important;
}

html.menu-opened .fm-header.header-fixed,
html.menu-opened header.fm-header.header-fixed{
  z-index: 20000 !important;
}

.wa-fab{
  z-index: 1016;
}

.has-fixed-navbar .offer-bar { z-index: 1040; }

.offer-inner{
  padding: 8px 0;
}

.offer-content{
  display: flex;
  align-items: center;
  gap: 10px 18px;
  justify-content: space-between;
  flex-wrap: nowrap;
  position: relative;
}

.offer-main{
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.offer-gift{
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  color: var(--offer-orange);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.offer-gift svg{
  width: 18px;
  height: 18px;
  display: block;
}

.offer-headline{
  margin: 0;
  font-size: 13.5px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.35;
  color: var(--offer-ink);
}

.offer-headline .offer-em{
  color: var(--offer-orange);
  font-weight: 800;
}

.offer-valid{
  flex-shrink: 0;
  margin: 0;
  font-size: 12.5px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--offer-orange);
  letter-spacing: 0.01em;
  white-space: nowrap;
  text-decoration: none;
}

.offer-valid strong{
  font-weight: 800;
  color: var(--offer-orange);
}

.offer-valid .offer-chevron{
  margin-left: 2px;
  font-weight: 700;
}

/* Desktop: main offer text centered in the bar */
@media (min-width: 768px){
  .offer-content{
    justify-content: flex-end;
    min-height: 22px;
  }

  .offer-main{
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    flex: 0 1 auto;
    max-width: calc(100% - 280px);
    justify-content: center;
    text-align: center;
  }

  .offer-valid{
    margin-left: auto;
    position: relative;
    z-index: 1;
  }
}

/* unused legacy hooks kept harmless */
.offer-badge,
.offer-price-pill,
.offer-sub,
.offer-cta,
.offer-dismiss{ display: none !important; }

@media (max-width: 767.98px){
  .offer-inner{ padding: 8px 0; }
  .offer-content{
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .offer-headline{ font-size: 12.5px; }
  .offer-valid{
    width: 100%;
    padding-left: 26px;
    font-size: 12px;
  }
}

