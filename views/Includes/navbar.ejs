<script>
(function () {
  var el = document.getElementById('offerValidTill');
  if (!el) return;
  var now = new Date();
  var last = new Date(now.getFullYear(), now.getMonth() + 1, 0);
  var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  el.textContent = last.getDate() + ' ' + months[last.getMonth()] + ' ' + last.getFullYear();
})();
