<meta name="abstract" content="<%=Metatags.abstract%>"/>
<meta name="keywords" content="<%=Metatags.keywords%>"/>
<%
  var fmOgUrl = (typeof fullUrl !== 'undefined' && fullUrl) ? fullUrl : (CommonMetaTags.URL || 'https://www.filemakr.com/');
  var fmOgTitle = Metatags.title || 'FileMakr';
  var fmOgDesc = Metatags.description || '';
  var fmIsHomeOg = (typeof active !== 'undefined' && active === 'home');
  var fmOgImageRaw = '';
  if (Metatags && Metatags.ogImage) fmOgImageRaw = Metatags.ogImage;
  else if (!fmIsHomeOg && typeof ogImage !== 'undefined' && ogImage) fmOgImageRaw = ogImage;
  else if (!fmIsHomeOg && typeof product !== 'undefined' && product && product.image) fmOgImageRaw = product.image;
  else if (!fmIsHomeOg && typeof demo !== 'undefined' && demo) {
    fmOgImageRaw = demo.og_image || demo.thumbnail_url || demo.image || demo.cover_image || '';
  } else if (!fmIsHomeOg && typeof result !== 'undefined' && result) {
    var fmOgProduct = null;
    if (Array.isArray(result) && result.length) {
      if (Array.isArray(result[0]) && result[0].length) fmOgProduct = result[0][0];
      else if (result[0] && typeof result[0] === 'object') fmOgProduct = result[0];
    }
    if (fmOgProduct && fmOgProduct.image) fmOgImageRaw = fmOgProduct.image;
  }
  var fmOgImage = (typeof ogImageUrl === 'function')
    ? ogImageUrl(fmOgImageRaw)
    : ((typeof defaultOgImageUrl === 'function') ? defaultOgImageUrl() : (CommonMetaTags.ogImage || ''));
  var fmOgImageAlt = (Metatags && Metatags.ogImageAlt)
    || (Metatags && Metatags.title)
    || 'FileMakr — final year project reports and source code';
%>
