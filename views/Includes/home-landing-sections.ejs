<%
  var srcAll = (typeof sourceCode !== 'undefined' && sourceCode && sourceCode.length) ? sourceCode : [];
  var reports = srcAll;
  var demos = (typeof liveproject !== 'undefined' && liveproject && liveproject.length) ? liveproject : [];
  var cats = (typeof category !== 'undefined' && category && category.length) ? category : [];

  function fmText(v, d) { return (v == null || v === '') ? (d || '') : String(v); }
  function fmAttrEsc(v) {
    return fmText(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').trim();
  }
  function fmAltLabel(v, suffix) {
    var base = fmText(v).trim() || 'Project';
    return fmAttrEsc(suffix ? (base + ' ' + suffix) : base);
  }
  function fmShort(v, n) {
    var t = fmText(v).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
    if (t.length <= n) return t;
    return t.slice(0, n - 1).trim() + '…';
  }
  function fmMatchCat(item, re) {
    var hay = [item.category, item.name, item.description, item.language, item.lang, item.stack].map(function (x) { return fmText(x).toLowerCase(); }).join(' ');
    return re.test(hay);
  }
  function fmCatField(item) {
    return fmText(item && item.category).toLowerCase().replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
  }
  function fmSeoField(item) {
    return fmText(item && item.seo_name).toLowerCase();
  }
  function fmInTech(item, opts) {
    var cat = fmCatField(item);
    var seo = fmSeoField(item);
    var lang = fmText(item && (item.language || item.lang || item.stack)).toLowerCase();
    var name = fmText(item && item.name).toLowerCase();
    var keys = opts.keys || [];
    var i;
    for (i = 0; i < keys.length; i++) {
      var k = keys[i].toLowerCase();
      if (cat === k || cat.indexOf(k) !== -1) return true;
      if (seo === k.replace(/\s+/g, '-') || seo.indexOf(k.replace(/\s+/g, '-')) !== -1) return true;
      if (lang === k || lang.indexOf(k) !== -1) return true;
    }
    if (opts.nameRe && opts.nameRe.test(name)) return true;
    if (opts.strictRe && opts.strictRe.test(cat + ' ' + seo + ' ' + lang)) return true;
    return false;
  }
  var pythonProjects = srcAll.filter(function (s) {
    return fmInTech(s, {
      keys: ['python', 'django', 'flask', 'streamlit'],
      strictRe: /python|django|flask|streamlit/
    });
  });
  var nodeProjects = srcAll.filter(function (s) {
    return fmInTech(s, {
      keys: ['nodejs', 'node.js', 'node js', 'express', 'mern'],
      strictRe: /node\.?js|\bnodejs\b|express|mern/
    });
  });
  var mlProjects = srcAll.filter(function (s) {
    return fmInTech(s, {
      keys: ['machine learning', 'machinelearning', 'deep learning', 'artificial intelligence', 'ai ml', 'ai & ml'],
      nameRe: /machine\s*learning|deep\s*learning|neural\s*network/,
      strictRe: /machine\s*learning|deep\s*learning|neural\s*network|tensorflow|scikit|sklearn|\bml\b/
    });
  });
  var phpProjects = srcAll.filter(function (s) {
    return fmInTech(s, {
      keys: ['php', 'laravel', 'codeigniter'],
      strictRe: /\bphp\b|laravel|codeigniter/
    });
  });
  var liveDemoProjects = srcAll.filter(function (s) { return !!(s.demo_url); });
  if (!liveDemoProjects.length && demos.length) liveDemoProjects = demos;

  function fmLatestScore(item) {
    var id = Number(item && item.id);
    if (!isNaN(id) && id > 0) return id;
    var ts = Date.parse(fmText(item && (item.created_at || item.updated_at || item.created || item.date)));
    return isNaN(ts) ? 0 : ts;
  }
  function fmByLatest(list) {
    return list.slice().sort(function (a, b) { return fmLatestScore(b) - fmLatestScore(a); });
  }
  function fmShuffle(list) {
    var arr = list.slice();
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i];
      arr[i] = arr[j];
      arr[j] = tmp;
    }
    return arr;
  }
  function fmPickMix(aList, bList, total) {
    var aPool = fmShuffle(fmByLatest(aList).slice(0, Math.max(8, total * 2)));
    var bPool = fmShuffle(fmByLatest(bList).slice(0, Math.max(8, total * 2)));
    var half = Math.ceil(total / 2);
    var picked = [];
    var seen = {};
    function take(pool, n) {
      for (var i = 0; i < pool.length && picked.length < total && n > 0; i++) {
        var key = fmText(pool[i].id || pool[i].seo_name || pool[i].name);
        if (!key || seen[key]) continue;
        seen[key] = 1;
        picked.push(pool[i]);
        n--;
      }
    }
    take(aPool, half);
    take(bPool, total - picked.length);
    take(aPool, total - picked.length);
    take(bPool, total - picked.length);
    return fmShuffle(picked).slice(0, total);
  }
  function fmStripPick(serverList, fallbackPool, total) {
    if (serverList && serverList.length) return serverList.slice(0, total);
    return fmShuffle(fmByLatest(fallbackPool).slice(0, 16)).slice(0, total);
  }
  var stripData = (typeof homeStrips !== 'undefined' && homeStrips) ? homeStrips : {};
  var directoryItems = fmPickMix(pythonProjects, nodeProjects, 6);
  var popularWeek = fmShuffle(fmByLatest(srcAll).slice(0, 24)).slice(0, 5);
  var latestProjects = fmByLatest(srcAll).slice(0, 5);
  var mlStrip = fmStripPick(stripData.ml, mlProjects, 5);
  var pyStrip = fmStripPick(stripData.python, pythonProjects, 5);
  var phpStrip = fmStripPick(stripData.php, phpProjects, 5);
  var demoStrip = fmShuffle(fmByLatest(liveDemoProjects).slice(0, 16)).slice(0, 5);
  function fmImg(item) {
    var img = fmText(item && item.image);
    if (!img) return '';
    if (/^https?:\/\//i.test(img) || img.charAt(0) === '/') return img;
    return '/' + img.replace(/^\.?\/+/, '');
  }
  function fmLabel(v) {
    var t = fmText(v).replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
    if (!t) return '';
    return t.replace(/\b[a-z]/g, function (ch) { return ch.toUpperCase(); });
  }
  function fmTechTags(item) {
    var raw = [item.category, item.language, item.lang, item.stack]
      .map(function (x) { return fmText(x); })
      .filter(Boolean)
      .join(',');
    var parts = raw.split(/[,|/]+/).map(function (t) { return fmLabel(t); }).filter(Boolean);
    var seen = {};
    var out = [];
    parts.forEach(function (t) {
      var key = t.toLowerCase();
      if (seen[key]) return;
      seen[key] = 1;
      out.push(t);
    });
    return out.slice(0, 3);
  }
  var waSetup = 'https://wa.me/918319339945?text=' + encodeURIComponent('Hi FileMakr, I need setup support for my project.');
  var waHelp = 'https://wa.me/918319339945?text=' + encodeURIComponent('Hi FileMakr, I need help finding a final year project.');
  var faqs = [
    ['What is included in a FileMakr project report?', 'FileMakr project reports typically include structured academic documentation such as synopsis-oriented content, chapters, diagrams and formatting suitable for faculty review and viva preparation.'],
    ['Are FileMakr project reports plagiarism-free?', 'Reports are prepared as plagiarism-free, humanized documentation designed for originality checks. Always follow your college’s citation and submission guidelines.'],
    ['What does AI-detection reviewed mean?', 'It means documentation is written and reviewed with academic originality and AI-detection review workflows in mind—not a fake score or guaranteed detector result.'],
    ['Can I purchase only the source code?', 'Yes. You can browse the source code library and purchase only the code package you need.'],
    ['Can I preview a live demo before buying?', 'Selected projects include live demos so you can evaluate the application in your browser first.'],
    ['Is source code runnable?', 'Source packages are designed as runnable stacks with README guidance, dependencies and setup instructions.'],
    ['Does source code include a README?', 'Yes. Projects are structured with setup guidance so you can understand and run the stack.'],
    ['Do you provide project setup support?', 'Yes. Setup support is available over WhatsApp when you need help running frontend, backend or database.'],
    ['Which technologies are available?', 'Popular stacks include Python, Java, PHP, Node.js, MERN, React and machine learning categories—browse the technology hub above.'],
    ['Can I find projects for B.Tech, BCA or MCA?', 'Yes. Use degree pages for B.Tech, BCA, MCA, M.Tech, B.Sc and M.Sc project reports and ideas.'],
    ['How quickly are project resources delivered?', 'Digital resources are typically available immediately after successful checkout.']
  ];
%>

<div class="fm-directory">

  <div class="fm-dir-band">
    <section class="fm-dir-usp" aria-labelledby="fm-dir-usp-title">
      <aside class="fm-dir-usp__panel">
        <div class="fm-dir-usp__visual" aria-hidden="true">
          <span class="fm-dir-usp__burst"></span>
          <div class="fm-dir-usp__doc">
            <span></span><span></span><span></span><span></span>
          </div>
          <img
            class="fm-dir-usp__badge"
            src="https://res.cloudinary.com/dvkuan8my/image/upload/v1785666146/Untitled_design_20_gygo4x.svg"
            alt="Plagiarism-free and AI-detection reviewed documentation badge"
            width="52"
            height="56"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="fm-dir-usp__mid">
          <h2 class="fm-dir-usp__title" id="fm-dir-usp-title">
            <span class="fm-dir-usp__title-accent">AI-Detection Reviewed</span>
            <span class="fm-dir-usp__title-amp">&amp;</span>
            Plagiarism-Free Documentation
          </h2>
          <p class="fm-dir-usp__desc">
            Humanized, faculty-aligned project reports structured for originality checks, plagiarism review, AI-detection review, academic evaluation and viva preparation.
          </p>
        </div>

        <ul class="fm-dir-usp__list">
          <li>Plagiarism-Free Reports</li>
          <li>AI-Detection Reviewed</li>
          <li>Faculty-Aligned Documentation</li>
          <li>Viva-Friendly Structure</li>
        </ul>
      </aside>
    </section>

    <!-- Project directory -->
    <section class="fm-dir-marketplace" id="project-directory" aria-labelledby="fm-dir-market-title">
      <div class="fm-dir-market">
        <aside class="fm-dir-filters" aria-label="Filter projects" id="fmDirFiltersPanel">
          <h3 class="fm-dir-filters__title">Filter Projects</h3>

          <details class="fm-dir-filters__group" open>
            <summary>Resource Type</summary>
            <ul class="fm-dir-filters__checks">
              <li><label><input type="checkbox" name="fmRes" value="/final-year-project-ideas"> Project Report</label></li>
              <li><label><input type="checkbox" name="fmRes" value="/source-code"> Source Code</label></li>
              <li><label><input type="checkbox" name="fmRes" value="/demo"> Live Demo</label></li>
              <li><label><input type="checkbox" name="fmRes" value="<%= waSetup %>" data-external="1"> Setup Support</label></li>
            </ul>
          </details>

          <details class="fm-dir-filters__group" open>
            <summary>Degree</summary>
            <ul class="fm-dir-filters__checks">
              <li><label><input type="checkbox" name="fmDeg" value="/btech-final-year-project-report"> B.Tech</label></li>
              <li><label><input type="checkbox" name="fmDeg" value="/bca-final-year-project-report"> BCA</label></li>
              <li><label><input type="checkbox" name="fmDeg" value="/mca-final-year-project-report"> MCA</label></li>
              <li><label><input type="checkbox" name="fmDeg" value="/mtech-final-year-project-report"> M.Tech</label></li>
              <li><label><input type="checkbox" name="fmDeg" value="/bsc-final-year-project-report"> B.Sc</label></li>
              <li><label><input type="checkbox" name="fmDeg" value="/msc-final-year-project-report"> M.Sc</label></li>
            </ul>
          </details>

          <details class="fm-dir-filters__group" open>
            <summary>Technology</summary>
            <ul class="fm-dir-filters__checks">
              <% if (cats.length) { cats.slice(0, 9).forEach(function (c) { %>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/<%= c.seo_name %>"> <%= c.name %></label></li>
              <% }); } else { %>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/python"> Python</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/java"> Java</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/php"> PHP</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/machine-learning"> AI / ML</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/mern"> MERN</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/react"> React</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/python"> Flask</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/python"> Django</label></li>
                <li><label><input type="checkbox" name="fmTech" value="/source-code/java"> Spring Boot</label></li>
              <% } %>
            </ul>
          </details>

          <div class="fm-dir-filters__actions">
            <button type="button" class="fm-dir-filters__apply" id="fmDirApplyFilters">Apply Filters</button>
            <button type="button" class="fm-dir-filters__reset" id="fmDirResetFilters">Reset</button>
          </div>
        </aside>

        <div class="fm-dir-market__main">
          <header class="fm-dir-sec__head fm-dir-sec__head--market">
            <div>
              <h2 id="fm-dir-market-title">Popular Final-Year Projects</h2>
              <p>Explore project topics students are currently browsing across software development, AI and academic programs.</p>
            </div>
            <button type="button" class="fm-dir-filter-toggle" id="fmDirFilterToggle" aria-expanded="false" aria-controls="fmDirFiltersDrawer">
              Filter projects
            </button>
          </header>

          <div class="fm-dir-grid fm-dir-grid--3" id="fmDirGrid">
            <% if (directoryItems.length) { directoryItems.forEach(function (s) {
              var codeUrl = s.seo_name ? '/' + s.seo_name + '/source-code' : '/source-code';
              var hasDemo = !!(s.demo_url);
              var cover = fmImg(s);
              var isPython = fmMatchCat(s, /python|django|flask|streamlit/);
              var isNode = fmMatchCat(s, /node\.?js|nodejs|\bnode\b|express|mern|nest\.?js/);
              var tags = fmTechTags(s);
              if (!tags.length) {
                if (isPython) tags = ['Python'];
                else if (isNode) tags = ['Node Js'];
                else tags = [fmLabel(s.category) || 'Project'];
              }
              var badge = tags[0] || (isPython ? 'Python' : (isNode ? 'Node Js' : 'Project'));
              var cardCat = isPython ? 'python' : (isNode ? 'nodejs' : 'project');
            %>
              <article class="fm-dir-card fm-dir-card--media" data-category="<%= cardCat %>">
                <a class="fm-dir-card__media" href="<%= codeUrl %>" tabindex="-1" aria-hidden="true">
                  <% if (cover) { %>
                    <img
                      src="<%= cloudinaryUrl(cover, { width: 480 }) %>"
                      srcset="<%= cloudinarySrcSet(cover, [640, 960, 1280]) %>"
                      sizes="(max-width: 640px) 90vw, 480px"
                      alt="<%= fmAltLabel(s.name, 'final year project preview') %>"
                      width="480"
                      height="270"
                      loading="lazy"
                      decoding="async"
                    />
                  <% } else { %>
                    <span class="fm-dir-card__media-fallback" data-letter="<%= (s.name || 'P').charAt(0).toUpperCase() %>"></span>
                  <% } %>
                  <span class="fm-dir-card__badge"><%= badge %></span>
                </a>
                <div class="fm-dir-card__body">
                  <h3 class="fm-dir-card__title"><a href="<%= codeUrl %>"><%= s.name %></a></h3>
                  <p class="fm-dir-card__desc"><%= fmShort(s.description, 100) || 'Final-year project with structured documentation and runnable source code.' %></p>
                  <ul class="fm-dir-card__features">
                    <li>Report</li>
                    <li>Code</li>
                    <li<% if (!hasDemo) { %> class="is-muted"<% } %>>Demo</li>
                  </ul>
                  <div class="fm-dir-card__foot fm-dir-card__foot--media">
                    <p class="fm-dir-card__price">Starting from <strong>₹99</strong></p>
                    <a class="fm-dir-card__cta fm-dir-card__cta--orange" href="<%= codeUrl %>">View Project</a>
                  </div>
                </div>
              </article>
            <% }); } else { %>
              <p class="fm-dir-empty">Projects are loading from the library. <a href="/source-code/python">Browse Python</a> or <a href="/source-code/nodejs">Node.js projects</a>.</p>
            <% } %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Mobile filters drawer -->
  <div class="fm-dir-drawer" id="fmDirFiltersDrawer" hidden>
    <div class="fm-dir-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="fmDirDrawerTitle">
      <div class="fm-dir-drawer__head">
        <h2 id="fmDirDrawerTitle">Filter projects</h2>
        <button type="button" class="fm-dir-drawer__close" id="fmDirFilterClose" aria-label="Close filters">&times;</button>
      </div>
      <div class="fm-dir-drawer__body">
        <a href="/source-code">All source code</a>
        <a href="/final-year-project-ideas">Project reports</a>
        <a href="/demo">Live demos</a>
        <a href="/btech-final-year-project-report">B.Tech</a>
        <a href="/bca-final-year-project-report">BCA</a>
        <a href="/mca-final-year-project-report">MCA</a>
        <a href="/source-code/python">Python</a>
        <a href="/source-code/java">Java</a>
        <a href="/source-code/php">PHP</a>
        <a href="/source-code/machine-learning">AI &amp; ML</a>
      </div>
    </div>
  </div>

  <!-- Technology hub -->
  <section class="fm-dir-tech fm-dir-tech--hub" aria-labelledby="fm-dir-tech-title">
    <div class="fm-dir-tech__inner">
      <header class="fm-dir-tech__head">
        <h2 id="fm-dir-tech-title">Browse Final-Year Projects by Technology</h2>
      </header>
      <div class="fm-dir-tech__row">
        <%
          function fmCatCount(cat) {
            // Avoid full-catalog scans on homepage; CTA label is enough.
            return 'Browse projects';
          }
          function fmTechIconUrl(seo, name) {
            var key = (fmText(seo) + ' ' + fmText(name)).toLowerCase();
            var base = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/';
            if (/python|django|flask|streamlit/.test(key)) return base + 'python/python-original.svg';
            if (/php|laravel|codeigniter/.test(key)) return base + 'php/php-original.svg';
            if (/node/.test(key)) return base + 'nodejs/nodejs-original.svg';
            if (/java(?!script)|spring/.test(key)) return base + 'java/java-original.svg';
            if (/react/.test(key)) return base + 'react/react-original.svg';
            if (/angular/.test(key)) return base + 'angularjs/angularjs-original.svg';
            if (/vue/.test(key)) return base + 'vuejs/vuejs-original.svg';
            if (/mern|mongo/.test(key)) return base + 'mongodb/mongodb-original.svg';
            if (/express/.test(key)) return base + 'express/express-original.svg';
            if (/android|kotlin/.test(key)) return base + 'android/android-original.svg';
            if (/ios|swift/.test(key)) return base + 'swift/swift-original.svg';
            if (/dotnet|c#|csharp/.test(key)) return base + 'csharp/csharp-original.svg';
            if (/c\+\+|cpp/.test(key)) return base + 'cplusplus/cplusplus-original.svg';
            if (/\bc\b(?!ode|ss)/.test(key)) return base + 'c/c-original.svg';
            if (/html|css|web/.test(key)) return base + 'html5/html5-original.svg';
            if (/javascript|js\b/.test(key)) return base + 'javascript/javascript-original.svg';
            if (/typescript/.test(key)) return base + 'typescript/typescript-original.svg';
            if (/mysql|sql|database|data.?analytics|data.?science/.test(key)) return base + 'mysql/mysql-original.svg';
            if (/machine|ml|ai|deep|neural|tensorflow/.test(key)) return base + 'tensorflow/tensorflow-original.svg';
            if (/flutter/.test(key)) return base + 'flutter/flutter-original.svg';
            if (/wordpress/.test(key)) return base + 'wordpress/wordpress-original.svg';
            return '';
          }
          var techHub = (cats.length ? cats : [
            { name: 'PHP', seo_name: 'php' },
            { name: 'Node.js', seo_name: 'nodejs' },
            { name: 'Python', seo_name: 'python' },
            { name: 'CodeIgniter', seo_name: 'codeigniter' },
            { name: 'Machine Learning', seo_name: 'machine-learning' },
            { name: 'Data Analytics', seo_name: 'data-analytics' }
          ]).slice(0, 6).map(function (c) {
            var seo = fmText(c.seo_name);
            var name = fmText(c.name) || seo;
            return {
              name: /projects?/i.test(name) ? name : (name + ' Projects'),
              count: fmCatCount(c),
              href: '/source-code/' + seo,
              iconUrl: fmTechIconUrl(seo, name),
              letter: (name.charAt(0) || 'P').toUpperCase()
            };
          });
          techHub.forEach(function (t) {
        %>
          <a class="fm-dir-tech__tile" href="<%= t.href %>">
            <span class="fm-dir-tech__icon" aria-hidden="true">
              <% if (t.iconUrl) { %>
                <img src="<%= t.iconUrl %>" alt="<%= fmAltLabel(t.name, 'technology icon') %>" width="24" height="24" loading="lazy" decoding="async" />
              <% } else { %>
                <span class="fm-dir-tech__icon-fallback"><%= t.letter %></span>
              <% } %>
            </span>
            <span class="fm-dir-tech__copy">
              <strong><%= t.name %></strong>
              <span><%= t.count %></span>
            </span>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <%
    var fmStrips = [
      { id: 'fm-strip-popular', title: 'Popular this week', href: '/source-code', items: popularWeek, cols: 5, showBtn: true },
      { id: 'fm-strip-ml', title: 'Machine Learning Projects', href: '/source-code/machine-learning', items: mlStrip, cols: 5, showBtn: false },
      { id: 'fm-strip-py', title: 'Python Final-Year Projects', href: '/source-code/python', items: pyStrip, cols: 5, showBtn: false },
      { id: 'fm-strip-php', title: 'PHP Final-Year Projects', href: '/source-code/php', items: phpStrip, cols: 5, showBtn: false }
    ];
    fmStrips.forEach(function (strip) {
      if (!strip.items || !strip.items.length) return;
  %>
  <section class="fm-dir-strip" aria-labelledby="<%= strip.id %>">
    <div class="fm-dir-strip__inner">
      <header class="fm-dir-strip__head">
        <h2 id="<%= strip.id %>"><%= strip.title %></h2>
        <a class="fm-dir-strip__all" href="<%= strip.href %>">View all <span aria-hidden="true">→</span></a>
      </header>
      <div class="fm-dir-popgrid fm-dir-popgrid--<%= strip.cols %>">
        <% strip.items.forEach(function (s) {
          var codeUrl = s.seo_name ? '/' + s.seo_name + '/source-code' : '/source-code';
          var hasDemo = !!(s.demo_url);
          var cover = fmImg(s);
        %>
          <article class="fm-dir-pop fm-dir-pop--compact">
            <a class="fm-dir-pop__media" href="<%= codeUrl %>" tabindex="-1" aria-hidden="true">
              <% if (cover) { %>
                <img
                  src="<%= cloudinaryUrl(cover, { width: 640 }) %>"
                  srcset="<%= cloudinarySrcSet(cover, [640, 960, 1280]) %>"
                  sizes="(max-width: 640px) 45vw, (max-width: 1100px) 33vw, 280px"
                  alt="<%= fmAltLabel(s.name, 'project thumbnail') %>"
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
              <% } else { %>
