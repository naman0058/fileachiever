<script>
(function () {
  var toggle = document.getElementById('fmDirFilterToggle');
  var drawer = document.getElementById('fmDirFiltersDrawer');
  var closeBtn = document.getElementById('fmDirFilterClose');
  function openDrawer() {
    if (!drawer) return;
    drawer.hidden = false;
    if (toggle) toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.hidden = true;
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  if (toggle) toggle.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (drawer) {
    drawer.addEventListener('click', function (e) {
      if (e.target === drawer) closeDrawer();
    });
  }

  var filterPanel = document.getElementById('fmDirFiltersPanel');
  var applyBtn = document.getElementById('fmDirApplyFilters');
  var resetBtn = document.getElementById('fmDirResetFilters');
  if (applyBtn && filterPanel) {
    applyBtn.addEventListener('click', function () {
      var checked = filterPanel.querySelector('input[type="checkbox"]:checked');
      if (checked && checked.value) {
        if (checked.getAttribute('data-external') === '1') {
          window.open(checked.value, '_blank', 'noopener,noreferrer');
        } else {
          window.location.href = checked.value;
        }
        return;
      }
      window.location.href = '/source-code';
    });
  }
  if (resetBtn && filterPanel) {
    resetBtn.addEventListener('click', function () {
      filterPanel.querySelectorAll('input[type="checkbox"]').forEach(function (box) {
        box.checked = false;
      });
    });
  }

  document.querySelectorAll('#fmDirFaq .fm-dir-acc__q button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (expanded) {
        btn.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
        return;
      }
      document.querySelectorAll('#fmDirFaq .fm-dir-acc__q button').forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
        var p = document.getElementById(b.getAttribute('aria-controls'));
        if (p) p.hidden = true;
      });
      btn.setAttribute('aria-expanded', 'true');
      if (panel) panel.hidden = false;
    });
  });
})();
</script>
