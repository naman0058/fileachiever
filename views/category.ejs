<% include Includes/navbar2.ejs %>
<% include Includes/projectReport.ejs %>

<% const projectCount = result.length; %>
<% function scStackLabel(cat) {
  if (!cat) return 'Source Code';
  return String(cat).split('-').map(function(w){ return w.charAt(0).toUpperCase() + w.slice(1); }).join(' ');
} %>
<% function scStripDesc(html) {
  return String(html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
} %>

<style>
  /* ===== Source code listing — conversion-first, text-only ===== */
  :root {
    --scStickyDockH: 88px;
    --scListEndPad: calc(var(--scStickyDockH) + 24px + env(safe-area-inset-bottom, 0px));
    --scMobileBottomPad: calc(var(--navH, 64px) + var(--scStickyDockH) + 20px + env(safe-area-inset-bottom, 0px));
    --scToolbarH: 120px;
  }
  .sc-code-page { padding-bottom: 0; }
  .sc-code-list .target.is-filter-hidden { display: none !important; }
  @media (min-width: 992px) {
    body:has(.sc-code-page) footer.footer {
      display: block !important;
      margin-top: 28px;
    }
    body:has(.sc-code-page) footer.footer .footer-top,
    body:has(.sc-code-page) footer.footer .footer-top.aos {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
    body:has(.sc-code-page) .sc-list-scroll-pad {
      display: none !important;
      height: 0 !important;
      min-height: 0 !important;
    }
  }
  @media (max-width: 991.98px) {
    html { scroll-padding-bottom: var(--scMobileBottomPad); }
    body.sc-code-sticky-active {
      padding-bottom: calc(var(--navH, 64px) + env(safe-area-inset-bottom, 0px)) !important;
    }
    /* Full site footer adds dead scroll on mobile — hide on this conversion page */
    footer.footer { display: none !important; }
    .sc-browse { margin-top: 14px; }
    .sc-browse .row.mt-3 { margin-top: 0 !important; }
    .sc-results-bar { margin: 12px 0 8px; }
    .sc-code-list { margin-bottom: 0; }
    /* Guaranteed scroll room so last card CTA clears fixed bottom UI */
    .sc-list-scroll-pad {
      height: var(--scListEndPad);
      min-height: 142px;
      flex-shrink: 0;
      pointer-events: none;
    }
  }

  .sc-code-page .page-breadcrumb { margin-bottom: 10px; }
  .sc-code-page .page-breadcrumb .breadcrumb-item { font-size: 13px; font-weight: 600; color: #64748b; }
  .sc-code-page .page-breadcrumb .breadcrumb-item.active { color: #0f172a; }

  /* Hero */
  .sc-hero {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: 22px 18px 20px;
    background:
      radial-gradient(900px 280px at 100% -20%, rgba(241,127,35,.14), transparent 55%),
      radial-gradient(700px 240px at -10% 0%, rgba(42,71,255,.12), transparent 50%),
      linear-gradient(135deg, #fff 0%, #f8faff 100%);
    border: 1px solid rgba(14,18,32,.07);
    box-shadow: 0 8px 32px rgba(14,18,32,.06);
  }
  @media (min-width: 768px) {
    .sc-hero {
      padding: 28px 28px 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
      gap: 22px;
      align-items: stretch;
    }
  }
  .sc-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 8px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(42,71,255,.08);
    color: var(--brandBlue);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .sc-hero h1 {
    margin: 0 0 8px;
    font-size: clamp(22px, 5vw, 32px);
    line-height: 1.2;
    color: var(--ink);
  }
  .sc-hero__lead {
    margin: 0 0 14px;
    color: #475569;
    font-size: 15px;
    line-height: 1.55;
    max-width: 640px;
  }
  .sc-hero__trust {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .sc-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
  }
  .sc-hero__trust li i { color: #16a34a; font-size: 13px; }
  .sc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .sc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none !important;
    border: none;
    cursor: pointer;
    transition: filter .2s, transform .2s, box-shadow .2s;
  }
  .sc-btn:hover { filter: brightness(.98); transform: translateY(-1px); }
  .sc-btn--primary {
    background: var(--brandBlue);
    color: #fff;
    box-shadow: 0 10px 28px rgba(42,71,255,.25);
  }
  .sc-btn--ghost {
    background: #fff;
    color: var(--brandBlue);
    border: 2px solid var(--brandBlue);
  }
  .sc-btn--wa {
    background: #25D366;
    color: #fff;
    box-shadow: 0 8px 22px rgba(37,211,102,.25);
  }
  .sc-hero__aside { min-width: 0; }
  .sc-wa-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    border-radius: 16px;
    border: 1px solid rgba(37,211,102,.28);
    box-shadow: 0 10px 32px rgba(37,211,102,.1);
    background: linear-gradient(160deg, rgba(37,211,102,.06) 0%, #fff 45%);
  }
  .sc-wa-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(37,211,102,.12);
    color: #15803d;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .03em;
  }
  .sc-wa-card__title {
    margin: 0;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.25;
    color: #0f172a;
  }
  .sc-wa-card__text {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #475569;
    font-weight: 600;
  }
  .sc-wa-card__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .sc-wa-card__points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #334155;
    line-height: 1.35;
  }
  .sc-wa-card__points li i {
    color: #16a34a;
    font-size: 13px;
    margin-top: 1px;
    flex-shrink: 0;
  }
  .sc-wa-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: auto;
    min-height: 46px;
    padding: 0 16px;
    border-radius: 12px;
    background: #25D366;
    color: #fff !important;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none !important;
    box-shadow: 0 8px 22px rgba(37,211,102,.28);
    transition: filter .2s;
  }
  .sc-wa-card__btn:hover { filter: brightness(.98); color: #fff; }
  @media (max-width: 991.98px) {
    .sc-code-page .sc-hero__aside { display: none !important; }
    .sc-code-page .sc-hero {
      display: block;
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767.98px) {
    .sc-wa-card { padding: 16px; }
    .sc-wa-card__title { font-size: 17px; }
  }

  /* Popular section */
  .sc-popular {
    margin-top: 18px;
    background: #fff;
    border: 1px solid rgba(14,18,32,.07);
    border-radius: 18px;
    padding: 16px;
    box-shadow: 0 4px 20px rgba(14,18,32,.04);
  }
  .sc-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .sc-section-head h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 900;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sc-section-head p {
    margin: 4px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
  }
  .sc-popular .md-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 2px;
  }
  .sc-popular .md-chip--stack {
    background: rgba(42,71,255,.08);
    color: var(--brandBlue);
  }
  .sc-popular .md-chip--demo {
    background: rgba(22,163,74,.1);
    color: #15803d;
  }
  .sc-popular .md-chip--price {
    background: rgba(241,127,35,.1);
    color: var(--brandOrange);
  }
  .sc-popular .md-btn-light {
    background: var(--brandBlue);
    color: #fff;
    border: none;
    box-shadow: 0 6px 18px rgba(42,71,255,.22);
  }

  /* Browse toolbar */
  .sc-browse { margin-top: 20px; }

  /* Offer bar — sticky at top until search toolbar takes over (no layout padding toggle) */
  body:has(.sc-code-page) #OfferBar {
    position: sticky;
    top: 0;
    z-index: 1020;
    width: 100%;
  }

  .sc-toolbar-sticky-wrap {
    position: sticky;
    top: 0;
    z-index: 900;
    padding-bottom: 12px;
    margin-bottom: 4px;
    background: var(--bg);
  }
  body:has(.sc-code-page):not(.sc-toolbar-stuck) .sc-toolbar-sticky-wrap {
    top: var(--offerBarH, 52px);
  }
  body:has(.sc-code-page).sc-toolbar-stuck .sc-toolbar-sticky-wrap {
    top: 0;
  }
  .sc-toolbar-sticky-wrap.is-stuck {
    z-index: 1025;
    box-shadow: 0 10px 28px rgba(14,18,32,.06);
  }
  /* Hide promo when search is pinned — one sticky row at top (mobile + laptop) */
  body.sc-toolbar-stuck #OfferBar {
    display: none !important;
  }
  .sc-toolbar-sticky-wrap.is-stuck .sc-toolbar {
    box-shadow: 0 8px 28px rgba(14,18,32,.1);
  }
  .sc-toolbar {
    background: #fff;
    border: 1px solid rgba(14,18,32,.07);
    border-radius: 16px;
    padding: 14px;
    box-shadow: 0 2px 12px rgba(14,18,32,.04);
    transition: box-shadow .2s ease;
  }
  @media (max-width: 991.98px) {
    .sc-toolbar-sticky-wrap {
      top: var(--offerBarH, 52px);
      z-index: 9980;
      /* Full-bleed: break out of .container horizontal padding */
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding: 0 0 10px;
      background: #fff;
    }
    .sc-toolbar-sticky-wrap.is-stuck {
      box-shadow: 0 6px 20px rgba(14,18,32,.08);
    }
    .sc-toolbar {
      border-radius: 0;
      padding: 12px 14px 10px;
      border: none;
      border-bottom: 1px solid rgba(14,18,32,.07);
      box-shadow: none;
    }
    .sc-toolbar-sticky-wrap.is-stuck .sc-toolbar {
      border-radius: 0;
    }
    .sc-chip-scroll {
      padding-left: 2px;
      padding-right: 2px;
    }
    .sc-toolbar__row .sort-select,
    .sc-toolbar__row .sc-toolbar__demo-btn { display: none !important; }
  }
  @media (min-width: 992px) {
    .sc-toolbar-sticky-wrap {
      padding-bottom: 14px;
      background: linear-gradient(to bottom, var(--bg) 92%, rgba(247,248,252,0));
    }
    .sc-toolbar-sticky-wrap.is-stuck {
      padding-top: 8px;
    }
    .sc-code-page .sticky-side {
      top: calc(var(--scToolbarH, 130px) + 16px);
      z-index: 2;
      max-height: calc(100vh - var(--scToolbarH, 130px) - 32px);
      overflow-y: auto;
    }
    body.sc-toolbar-stuck .sc-code-page .sticky-side {
      top: calc(var(--scToolbarH, 130px) + 12px);
    }
    .sc-chip-scroll #FilterDemoOnlyMobile {
      display: none;
    }
    .sc-browse__body {
      align-items: flex-start;
      min-height: 0;
    }
    .target,
    .sc-code-card {
      scroll-margin-top: calc(var(--scToolbarH, 130px) + 16px);
    }
  }
  .sc-toolbar__row {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 992px) {
    .sc-toolbar__row {
      grid-template-columns: 1fr auto auto;
      align-items: center;
    }
  }
  .sc-toolbar .search-group { margin: 0; }
  .sc-toolbar .search-input { height: 46px; font-weight: 600; }
  .sc-toolbar .search-input::placeholder { color: #94a3b8; font-weight: 500; }
  .sc-toolbar .sort-select { height: 46px; font-weight: 600; min-width: 160px; }

  /* Scrollable stack chips — all viewports */
  .sc-chip-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding: 10px 0 2px;
    margin: 0 -2px;
    scrollbar-width: none;
  }
  .sc-chip-scroll::-webkit-scrollbar { display: none; }
  .sc-filter-row--desktop { display: none !important; }
  .sc-chip-scroll .sc-filter-chip {
    flex-shrink: 0;
    scroll-snap-align: start;
    white-space: nowrap;
    padding: 8px 13px;
    font-size: 12px;
  }
  .sc-chip-scroll .sc-filter-chip--demo {
    background: rgba(22,163,74,.08);
    border-color: rgba(22,163,74,.25);
    color: #15803d;
  }
  .sc-chip-scroll .sc-filter-chip--demo.active {
    background: #15803d;
    border-color: #15803d;
    color: #fff;
  }

  .sc-browse__main {
    position: relative;
    z-index: 1;
  }

  .sc-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    align-items: center;
  }
  .sc-filter-label {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-right: 4px;
  }
  .sc-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(14,18,32,.1);
    background: #f8fafc;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
  }
  .sc-filter-chip:hover { border-color: rgba(42,71,255,.35); color: var(--brandBlue); }
  .sc-filter-chip.active {
    background: rgba(42,71,255,.08);
    border-color: var(--brandBlue);
    color: var(--brandBlue);
  }
  .sc-filter-chip i { font-size: 14px; }
  a.sc-filter-chip {
    text-decoration: none !important;
    color: #334155;
  }
  a.sc-filter-chip:hover { color: var(--brandBlue); }

  /* Degree pills — tighter */
  .sc-code-page .degree-pills-wrap { margin-top: 14px; }
  .sc-code-page .degree-scroller {
    border-radius: 14px;
    box-shadow: none;
    border: 1px solid rgba(14,18,32,.08);
    background: #fff;
  }
  .sc-code-page .degree-pill {
    font-size: 13px;
    padding: 8px 14px;
    background: #f1f5f9;
  }

  /* Results bar */
  .sc-results-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 16px 0 12px;
  }
  .sc-results-bar h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 900;
    color: #0f172a;
  }
  .sc-results-count {
    font-size: 13px;
    font-weight: 700;
    color: #64748b;
  }
  .sc-results-count strong { color: var(--brandBlue); }

  /* Project list — text cards, no thumbnails */
  .sc-code-list { display: grid; gap: 10px; }
  .sc-code-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background: #fff;
    border: 1px solid rgba(14,18,32,.07);
    border-radius: 16px;
    box-shadow: 0 1px 3px rgba(14,18,32,.04);
    transition: border-color .2s, box-shadow .2s, transform .15s;
    height: 100%;
  }
  .sc-code-card:hover {
    border-color: rgba(42,71,255,.28);
    box-shadow: 0 10px 28px rgba(14,18,32,.08);
    transform: translateY(-1px);
  }
  @media (min-width: 768px) {
    .sc-code-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 18px 20px;
    }
  }
  .sc-code-card__main { min-width: 0; flex: 1 1 auto; }
  .sc-code-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .sc-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .03em;
  }
  .sc-badge--stack { background: rgba(42,71,255,.08); color: var(--brandBlue); }
  .sc-badge--demo { background: rgba(22,163,74,.1); color: #15803d; }
  .sc-badge--price { background: rgba(241,127,35,.1); color: var(--brandOrange); }
  .sc-badge--pick { background: rgba(241,127,35,.12); color: #c2410c; }
  .sc-code-card h2 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
  }
  @media (min-width: 768px) { .sc-code-card h2 { font-size: 17px; } }
  .sc-code-card h2 a {
    color: #0f172a;
    text-decoration: none;
  }
  .sc-code-card h2 a:hover { color: var(--brandBlue); }
  .sc-code-card p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sc-code-card__actions {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  @media (min-width: 768px) {
    .sc-code-card__actions { width: auto; min-width: 168px; align-items: stretch; }
  }
  .sc-code-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 12px;
    background: var(--brandBlue);
    color: #fff !important;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none !important;
    box-shadow: 0 6px 18px rgba(42,71,255,.22);
    white-space: nowrap;
    transition: filter .2s;
  }
  .sc-code-card__cta:hover { filter: brightness(.97); color: #fff; }
  .sc-code-card__demo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 10px;
    background: #fff;
    color: var(--brandBlue) !important;
    border: 1px solid rgba(42,71,255,.25);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none !important;
  }
  .sc-code-card__demo:hover { background: rgba(42,71,255,.05); }

  /* Sidebar — desktop conversion */
  .sc-side-promo {
    background: linear-gradient(160deg, #2A47FF 0%, #1e3a8a 100%);
    color: #fff;
    border-radius: 18px;
    padding: 18px;
    margin-bottom: 12px;
    box-shadow: 0 12px 32px rgba(42,71,255,.25);
  }
  .sc-side-promo h4 { margin: 0 0 6px; font-size: 18px; font-weight: 900; }
  .sc-side-promo p { margin: 0 0 14px; font-size: 13px; opacity: .92; line-height: 1.45; }
  .sc-side-promo ul {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .sc-side-promo li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
  }
  .sc-side-promo li i { opacity: .9; }
  .sc-side-promo .sc-btn {
    width: 100%;
    background: #fff;
    color: var(--brandBlue);
    box-shadow: none;
  }
  .sc-code-page .side-card { border-radius: 16px; }
  .sc-code-page .qa-item { border-radius: 12px; }

  /* Mobile sticky CTA — shows after scroll, stays visible while browsing list */
  .sc-list-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: var(--navH, 64px);
    z-index: 9997;
    padding: 8px 12px;
    background: rgba(255,255,255,.96);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-top: 1px solid rgba(14,18,32,.08);
    box-shadow: 0 -4px 16px rgba(14,18,32,.08);
    pointer-events: none;
    opacity: 0;
    transform: translateY(110%);
    transition: opacity .25s ease, transform .25s ease;
  }
  .sc-list-sticky.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }
  .sc-list-sticky__wa {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    min-height: 52px;
    padding: 8px 12px;
    border-radius: 14px;
    background: #25D366;
    color: #fff !important;
    text-decoration: none !important;
    box-shadow: 0 8px 24px rgba(37,211,102,.32);
    transition: filter .2s;
  }
  .sc-list-sticky__wa:hover { filter: brightness(.98); color: #fff; }
  .sc-list-sticky__wa-icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .sc-list-sticky__wa-text {
