<script>
(function(){
  const sticky = document.getElementById('ScListSticky');
  const sentinel = document.getElementById('ScStickySentinel');
  const waSticky = document.getElementById('WhatsAppSticky');
  if (!sticky || !sentinel) return;

  if (window.matchMedia('(min-width: 992px)').matches) return;

  function syncWaSticky() {
    if (!waSticky || typeof waLink !== 'function') return;
    waSticky.setAttribute('href', waLink('Need custom source code'));
  }

  function setStickyVisible(show) {
    sticky.classList.toggle('is-visible', show);
    sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
    document.body.classList.toggle('sc-code-sticky-active', show);
  }

  /* Sentinel sits after hero/popular — once it scrolls up past viewport, show bar and keep it visible */
  const io = new IntersectionObserver(function(entries){
    setStickyVisible(!entries[0].isIntersecting);
  }, { threshold: 0, rootMargin: '0px 0px 0px 0px' });
  io.observe(sentinel);

  waSticky && waSticky.addEventListener('click', function(){
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'custom_code_sticky_click', page: 'source_code_list' });
  });

  syncWaSticky();
})();

(function initOfferSticky(){
  if (!document.querySelector('.sc-code-page')) return;
  const offer = document.getElementById('OfferBar');
  if (!offer) return;

  let cachedOfferH = offer.offsetHeight || 52;

  function syncOfferH(){
    if (offer.offsetHeight > 0) cachedOfferH = offer.offsetHeight;
    document.documentElement.style.setProperty('--offerBarH', cachedOfferH + 'px');
  }

  syncOfferH();
  window.addEventListener('resize', syncOfferH);
  window.addEventListener('load', syncOfferH);
})();

(function initStickyToolbar(){
  const wrap = document.getElementById('ScToolbarWrap');
  const toolbar = document.getElementById('ScToolbar');
  const sentinel = document.getElementById('ScToolbarSentinel');
  if (!wrap || !toolbar || !sentinel) return;

  let stuck = false;
  const UNSTICK_BUFFER = 12;

  function syncStickyMetrics(){
    document.documentElement.style.setProperty('--scToolbarH', toolbar.offsetHeight + 'px');
  }

  function setToolbarStuck(next) {
    if (next === stuck) return;
    stuck = next;
    wrap.classList.toggle('is-stuck', stuck);
    document.body.classList.toggle('sc-toolbar-stuck', stuck);
    syncStickyMetrics();
  }

  function updateStuckState(){
    const top = sentinel.getBoundingClientRect().top;
    if (!stuck && top <= 0) setToolbarStuck(true);
    else if (stuck && top > UNSTICK_BUFFER) setToolbarStuck(false);
  }

  syncStickyMetrics();
  window.addEventListener('resize', function(){
    syncStickyMetrics();
    updateStuckState();
  });
  window.addEventListener('load', function(){
    syncStickyMetrics();
    updateStuckState();
  });
  window.addEventListener('scroll', updateStuckState, { passive: true });

  if (typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(syncStickyMetrics).observe(toolbar);
  }

  updateStuckState();
})();

(function ensureDesktopFooter(){
  if (!window.matchMedia('(min-width: 992px)').matches) return;
  function revealFooterTop(){
    const footerTop = document.querySelector('footer.footer .footer-top');
    if (footerTop) footerTop.classList.add('aos-animate');
    if (window.AOS && typeof window.AOS.refreshHard === 'function') {
      window.AOS.refreshHard();
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', revealFooterTop);
  } else {
    revealFooterTop();
  }
  window.addEventListener('load', revealFooterTop);
})();
</script>
