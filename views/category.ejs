  }
  .sc-list-sticky__wa-text span {
    font-size: 11px;
    font-weight: 700;
    opacity: .92;
    line-height: 1.3;
  }
  .sc-sticky-sentinel {
    height: 1px;
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }
  @media (min-width: 992px) {
    .sc-list-sticky { display: none !important; }
  }
</style>

