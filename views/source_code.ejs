  <%
    const allReports = (typeof result !== 'undefined' && result && result.length) ? result : [];
    // Most Demanding: 5 random source codes each load
    const demandingReports = (function (list) {
      var copy = list.slice();
      for (var i = copy.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = copy[i];
        copy[i] = copy[j];
        copy[j] = tmp;
      }
      return copy.slice(0, 5);
    })(allReports);

    function prItemUrl(seo) {
      return seo ? ('/' + seo + '/source-code') : '/source-code';
    }
    function prItemImg(item) {
      var img = String((item && item.image) || '').trim();
      if (!img) return '';
      if (/^https?:\/\//i.test(img) || img.charAt(0) === '/') return img;
      return '/' + img.replace(/^\.?\/+/, '');
    }
    function prItemCats(item) {
      var raw = String((item && item.category) || '').trim();
      if (!raw) return [];
      var seen = {};
      var out = [];
      raw.split(/[,|/]+/).forEach(function (part) {
        var t = String(part || '').replace(/[-_.]+/g, ' ').replace(/\s+/g, ' ').trim();
        if (!t) return;
        t = t.replace(/\b[a-z]/g, function (ch) { return ch.toUpperCase(); });
        // Keep common product casing
        t = t.replace(/\bJs\b/g, 'JS').replace(/\bPhp\b/g, 'PHP').replace(/\bAi\b/g, 'AI').replace(/\bMl\b/g, 'ML');
        var key = t.toLowerCase();
        if (seen[key]) return;
        seen[key] = 1;
        out.push(t);
      });
      return out.slice(0, 3);
    }
    function prItemDesc(item) {
      return String((item && (item.description || item.short_description)) || '').trim();
    }
  %>

  <% if (!isSearchPage) { %>
  <section class="fm-dir-strip" aria-labelledby="pr-demanding-title">
    <div class="fm-dir-strip__inner">
      <header class="fm-dir-strip__head">
        <div class="fm-dir-strip__titles">
          <h2 id="pr-demanding-title">Most Demanding Source Code</h2>
          <p class="fm-dir-strip__sub">Popular projects students download first.</p>
        </div>
      </header>
      <div class="fm-dir-popgrid fm-dir-popgrid--5">
        <% demandingReports.forEach(function (item) {
          var href = prItemUrl(item.seo_name);
          var cover = prItemImg(item);
          var cats = prItemCats(item);
          var letter = String(item.name || 'P').charAt(0).toUpperCase();
        %>
          <article class="fm-dir-pop fm-dir-pop--compact">
            <div class="fm-dir-pop__media-wrap">
              <a class="fm-dir-pop__media" href="<%= href %>" tabindex="-1" aria-hidden="true">
                <% if (cover) { %>
                  <img
                    src="<%= cloudinaryUrl(cover, { width: 640 }) %>"
                    srcset="<%= cloudinarySrcSet(cover, [640, 960, 1280]) %>"
                    sizes="(max-width: 640px) 45vw, (max-width: 1100px) 33vw, 280px"
                    alt="<%= imageAltLabel(item.name, 'source code preview') %>"
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                <% } else { %>
                  <span class="fm-dir-pop__fallback" data-letter="<%= letter %>"></span>
                <% } %>
              </a>
              <% if (cats.length) { %>
                <span class="fm-dir-pop__pill"><%= cats[0] %></span>
              <% } %>
            </div>
            <div class="fm-dir-pop__body">
              <h3 class="fm-dir-pop__title"><a href="<%= href %>"><%= item.name %></a></h3>
              <ul class="fm-dir-pop__feats" aria-label="Included resources">
                <li class="is-report">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 7l-4 5 4 5M16 7l4 5-4 5M13 5l-2 14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Source Code
                </li>
                <li class="is-diagram">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="6" rx="6" ry="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M6 6v5c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V6" stroke="currentColor" stroke-width="1.7"/></svg>
                  Database
                </li>
                <li class="is-plagiarism">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3.5h7.5L19 8v12.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.7"/><path d="M14.5 3.5V8H19M9 12h6M9 15.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                  Setup Guide
                </li>
              </ul>
              <a class="fm-dir-pop__btn" href="<%= href %>">Get Source Code</a>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <section class="fm-dir-strip pr-explore"<% if (isSearchPage) { %> aria-label="Search results"<% } else { %> aria-labelledby="pr-explore-title"<% } %>>
    <div class="fm-dir-strip__inner">
      <header class="fm-dir-strip__head">
        <% if (!isSearchPage) { %>
        <div class="fm-dir-strip__titles">
          <h2 id="pr-explore-title">Explore <%= original ? graduation_type_send + ' ' : '' %>Source Code</h2>
          <p class="fm-dir-strip__sub">Browse working projects by technology, domain and demo availability.</p>
        </div>
        <% } %>
      </header>

      <%
        var techOptions = [];
        var techSeen = {};
        allReports.forEach(function (item) {
          prItemCats(item).forEach(function (c) {
            var key = String(c).toLowerCase();
            if (techSeen[key]) return;
            techSeen[key] = 1;
            techOptions.push(c);
          });
        });
        techOptions.sort(function (a, b) { return a.localeCompare(b); });
      %>

      <% if (isSearchPage) { %>
      <% include partials/pr-search-meta-bar.ejs %>
      <% } else { %>
      <div id="PrToolbarSentinel" class="pr-sticky-sentinel pr-sticky-sentinel--toolbar" aria-hidden="true"></div>
      <div class="pr-toolbar-sticky-wrap" id="PrToolbarWrap">
      <div class="pr-explore__bar" id="PrToolbar">
        <p class="pr-explore__count">
          <strong id="ExploreCount"><%= allReports.length %></strong> Source Code Projects
        </p>
        <div class="pr-explore__tools">
          <div class="pr-explore__search">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <label class="visually-hidden" for="ExploreSearch">Search source code</label>
            <input id="ExploreSearch" type="search" placeholder="Search source code..." autocomplete="off" />
          </div>
          <label class="visually-hidden" for="TechFilter">Technology</label>
          <select id="TechFilter" class="pr-explore__tech" aria-label="Filter by technology">
            <option value="">Technology</option>
            <% techOptions.forEach(function (opt) { %>
              <option value="<%= opt %>"><%= opt %></option>
            <% }) %>
          </select>
        </div>
      </div>
      </div>
      <% } %>

      <%
        var prCatalog = allReports.map(function (item) {
          return {
            n: String(item.name || ''),
            s: String(item.seo_name || ''),
            c: String(item.category || ''),
            i: prItemImg(item),
            d: prItemDesc(item)
          };
        });
        var prCatalogJson = JSON.stringify(prCatalog).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
      %>

      <div class="fm-dir-popgrid fm-dir-popgrid--5" id="Grid" role="list" data-pr-catalog="1" data-pr-original="<%= original %>" aria-busy="true"></div>
      <div id="ExploreMore" class="pr-explore__more" hidden aria-hidden="true">
        <span class="pr-explore__more-dot" aria-hidden="true"></span>
        <span class="pr-explore__more-dot" aria-hidden="true"></span>
        <span class="pr-explore__more-dot" aria-hidden="true"></span>
        <span>Loading more projects…</span>
      </div>

      <% var emptyKind = 'source-code'; %>
      <% include partials/pr-search-empty-state.ejs %>
    </div>
  </section>
  </div>
</div>

<script>
window.__PR_CATALOG = <%- prCatalogJson %>;
window.__PR_ORIGINAL = <%- JSON.stringify(original) %>;
window.__PR_SEARCH_PAGE = <%= isSearchPage ? 'true' : 'false' %>;
window.__PR_SEARCH_QUERY = <%- JSON.stringify(searchQ) %>;
window.__PR_SEARCH_TYPE = <%- JSON.stringify(searchTypeVal) %>;
window.__PR_CATEGORIES = <%- JSON.stringify((Array.isArray(category) ? category : []).map(function (c) {
  return { n: String(c.name || ''), s: String(c.seo_name || '') };
})).replace(/</g, '\\u003c') %>;
</script>
<script>
(function () {
  var BATCH = 24;
  var items = Array.isArray(window.__PR_CATALOG) ? window.__PR_CATALOG : [];
  var original = String(window.__PR_ORIGINAL || '');
  var categories = Array.isArray(window.__PR_CATEGORIES) ? window.__PR_CATEGORIES : [];
  var isSearchPage = !!window.__PR_SEARCH_PAGE;
  var searchType = String(window.__PR_SEARCH_TYPE || 'Source Code');
  var isCategoryPage = !!original && !isSearchPage;
  var grid = document.getElementById('Grid');
  var moreEl = document.getElementById('ExploreMore');
  var countEl = document.getElementById('ExploreCount');
  var emptyEl = document.getElementById('EmptyState');
  var heroSearch = document.getElementById('Search');
  var exploreSearch = document.getElementById('ExploreSearch');
  var techFilter = document.getElementById('TechFilter');
  var btn = document.getElementById('prHeroSearchBtn');

  if (!grid || !grid.getAttribute('data-pr-catalog')) return;

  var q = '';
  var activeTech = '';
  var filtered = items.slice();
  var cursor = 0;
  var timer = null;
  var observer = null;

  function slugifyTech(s) {
    return String(s || '')
      .toLowerCase()
      .replace(/\.js\b/g, '-js')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function normalizeKey(s) {
    return String(s || '')
      .toLowerCase()
      .replace(/\.js\b/g, ' js')
      .replace(/[^a-z0-9]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function compactKey(s) {
    return normalizeKey(s).replace(/\s+/g, '');
  }

  function resolveCategorySlug(query) {
    var raw = String(query || '').trim();
    if (!raw) return '';
    var qKey = normalizeKey(raw);
    var qCompact = compactKey(raw);
    var qSlug = slugifyTech(raw);
    var i;
    var cat;
    var nameKey;
    var seoKey;
    var seoSlug;

    for (i = 0; i < categories.length; i++) {
      cat = categories[i];
      seoSlug = String(cat.s || '').toLowerCase();
      nameKey = normalizeKey(cat.n);
      seoKey = normalizeKey(String(cat.s || '').replace(/-/g, ' '));
      if (!seoSlug) continue;
      if (qSlug === seoSlug || qKey === nameKey || qKey === seoKey || qCompact === compactKey(cat.n)) {
        return seoSlug;
      }
    }

    for (i = 0; i < categories.length; i++) {
      cat = categories[i];
      seoSlug = String(cat.s || '').toLowerCase();
      nameKey = normalizeKey(cat.n);
      if (!seoSlug || qKey.length < 3 || nameKey.length < 3) continue;
      if (nameKey.indexOf(qKey) === 0 || qKey.indexOf(nameKey) === 0) return seoSlug;
    }

    var chipEls = document.querySelectorAll('[data-pr-chip]');
    for (i = 0; i < chipEls.length; i++) {
      var chipVal = chipEls[i].getAttribute('data-pr-chip') || chipEls[i].textContent || '';
      if (normalizeKey(chipVal) === qKey || compactKey(chipVal) === qCompact || slugifyTech(chipVal) === qSlug) {
        var fromDb = '';
        for (var j = 0; j < categories.length; j++) {
          if (slugifyTech(categories[j].n) === slugifyTech(chipVal) || String(categories[j].s || '').toLowerCase() === slugifyTech(chipVal)) {
            fromDb = String(categories[j].s || '').toLowerCase();
            break;
          }
        }
        return fromDb || slugifyTech(chipVal);
      }
    }

    return qSlug && categories.some(function (c) { return String(c.s || '').toLowerCase() === qSlug; })
      ? qSlug
      : '';
  }

  function goCategoryPage(slug) {
    if (!slug) return false;
    if (slug === original) return true;
    window.location.href = '/source-code/' + encodeURIComponent(slug);
    return true;
  }

  function goSearchPage(query) {
    var term = String(query || '').trim();
    if (!term) return false;
    window.location.href = '/search?q=' + encodeURIComponent(term) + '&type=' + encodeURIComponent(searchType);
    return true;
  }

  /** Category pages only: tech → /source-code/:seo, project name → /search */
  function navigateCategoryGlobalSearch(query) {
    var term = String(query || '').trim();
    if (!term) return false;
    var slug = resolveCategorySlug(term);
    if (slug) return goCategoryPage(slug);
    return goSearchPage(term);
  }

  function syncActiveChips(activeSlugOrLabel) {
    var targetSlug = resolveCategorySlug(activeSlugOrLabel) || slugifyTech(activeSlugOrLabel) || String(activeSlugOrLabel || '').toLowerCase();
    document.querySelectorAll('[data-pr-chip]').forEach(function (c) {
      var chipVal = c.getAttribute('data-pr-chip') || c.textContent || '';
      var chipSlug = resolveCategorySlug(chipVal) || slugifyTech(chipVal);
      c.classList.toggle('is-active', !!(targetSlug && chipSlug && chipSlug === targetSlug));
    });
  }

  function altLabel(name, suffix) {
    var base = String(name || '').trim() || 'Project';
    return esc(base + ' ' + suffix);
  }

  function esc(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function normalize(s) {
    return String(s || '').toLowerCase();
  }

  function normalizeCat(s) {
    return String(s || '')
      .toLowerCase()
      .replace(/[,|/]+/g, ' ')
      .replace(/[-_.]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function compactCat(s) {
    return normalizeCat(s).replace(/\s+/g, '');
  }

  function categoryMatches(cardCat, selectedTech) {
    if (!selectedTech) return true;
    var nc = normalizeCat(cardCat);
    var nt = normalizeCat(selectedTech);
    if (!nt) return true;
    if (nc === nt || nc.indexOf(nt) !== -1) return true;
    if (compactCat(cardCat).indexOf(compactCat(selectedTech)) !== -1) return true;
    var cardTokens = nc.split(' ').filter(Boolean);
    var techTokens = nt.split(' ').filter(Boolean);
    if (techTokens.length && techTokens.every(function (t) { return cardTokens.indexOf(t) !== -1; })) return true;
    return false;
  }

  function firstCat(raw) {
    var parts = String(raw || '').split(/[,|/]+/);
    for (var i = 0; i < parts.length; i++) {
      var t = String(parts[i] || '').replace(/[-_.]+/g, ' ').replace(/\s+/g, ' ').trim();
      if (!t) continue;
      t = t.replace(/\b[a-z]/g, function (ch) { return ch.toUpperCase(); });
      t = t.replace(/\bJs\b/g, 'JS').replace(/\bPhp\b/g, 'PHP').replace(/\bAi\b/g, 'AI').replace(/\bMl\b/g, 'ML');
      return t;
    }
    return '';
  }

  function itemHref(seo) {
    return seo
      ? ('/' + seo + '/source-code')
      : '/source-code';
  }

  function cardHtml(item) {
    var name = String(item.n || '');
    var seo = String(item.s || '');
    var href = itemHref(seo);
    var cover = String(item.i || '');
    var cat = firstCat(item.c);
    var letter = (name.charAt(0) || 'P').toUpperCase();
    var media;
    if (cover) {
      var cl = window.fmCloudinary;
      var src = cl ? cl.url(cover, { width: 640 }) : cover;
      var srcset = cl ? cl.srcSet(cover, [640, 960, 1280]) : '';
      media =
        '<img src="' + esc(src) + '"' +
        (srcset ? ' srcset="' + esc(srcset) + '" sizes="(max-width: 640px) 45vw, (max-width: 1100px) 33vw, 280px"' : '') +
        ' alt="' + altLabel(name, 'source code preview') + '" width="640" height="360" loading="lazy" decoding="async" />';
    } else {
      media = '<span class="fm-dir-pop__fallback" data-letter="' + esc(letter) + '"></span>';
    }
    var pill = cat ? '<span class="fm-dir-pop__pill">' + esc(cat) + '</span>' : '';

    return (
      '<article class="fm-dir-pop fm-dir-pop--compact target" role="listitem"' +
        ' data-name="' + esc(name) + '"' +
        ' data-desc="' + esc(item.d || '') + '"' +
        ' data-category="' + esc(item.c || '') + '"' +
        ' data-url="' + esc(seo + '/source-code') + '">' +
        '<div class="fm-dir-pop__media-wrap">' +
          '<a class="fm-dir-pop__media" href="' + esc(href) + '" tabindex="-1" aria-hidden="true">' + media + '</a>' +
          pill +
        '</div>' +
        '<div class="fm-dir-pop__body">' +
          '<h3 class="fm-dir-pop__title"><a href="' + esc(href) + '">' + esc(name) + '</a></h3>' +
          '<ul class="fm-dir-pop__feats" aria-label="Included resources">' +
            '<li class="is-report"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 7l-4 5 4 5M16 7l4 5-4 5M13 5l-2 14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Source Code</li>' +
            '<li class="is-diagram"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><ellipse cx="12" cy="6" rx="6" ry="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M6 6v5c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V6" stroke="currentColor" stroke-width="1.7"/></svg>Database</li>' +
            '<li class="is-plagiarism"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3.5h7.5L19 8v12.5a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.7"/><path d="M14.5 3.5V8H19M9 12h6M9 15.5h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>Setup Guide</li>' +
          '</ul>' +
          '<a class="fm-dir-pop__btn" href="' + esc(href) + '">Get Source Code</a>' +
        '</div>' +
      '</article>'
    );
  }

  function setMoreVisible(on) {
    if (!moreEl) return;
    moreEl.hidden = !on;
    moreEl.setAttribute('aria-hidden', on ? 'false' : 'true');
  }

  function updateCount() {
    if (countEl) countEl.textContent = String(filtered.length);
    var empty = filtered.length === 0;
    if (emptyEl) {
      emptyEl.hidden = !empty;
      if (empty && q) {
        var topicInput = document.getElementById('EmptyTopicInput');
        if (topicInput) topicInput.value = q;
        var queryEl = document.getElementById('PrSearchEmptyQuery');
        if (queryEl) queryEl.textContent = '\u201c' + q + '\u201d';
      }
    }
    var zeroSub = document.getElementById('PrSearchZeroSub');
    if (zeroSub) zeroSub.hidden = !empty;
    grid.setAttribute('aria-busy', cursor < filtered.length ? 'true' : 'false');
  }

  function renderMore() {
    if (cursor >= filtered.length) {
      setMoreVisible(false);
      updateCount();
      return;
    }
    var end = Math.min(cursor + BATCH, filtered.length);
    var html = '';
    for (var i = cursor; i < end; i++) html += cardHtml(filtered[i]);
    grid.insertAdjacentHTML('beforeend', html);
    cursor = end;
    setMoreVisible(cursor < filtered.length);
    updateCount();
  }

  function resetAndRender() {
    cursor = 0;
    grid.innerHTML = '';
    renderMore();
    // If viewport is tall, keep filling until scrollable or done
    var guard = 0;
    while (cursor < filtered.length && guard < 8) {
      var docH = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
      if (docH > window.innerHeight + 240) break;
      renderMore();
      guard++;
    }
  }

  function applyFilter() {
    var nq = normalize(q);
    var nqCompact = nq.replace(/\s+/g, '');
    filtered = items.filter(function (item) {
      var name = normalize(item.n);
      var desc = normalize(item.d);
      var cat = normalizeCat(item.c);
      var matchText = !nq || name.indexOf(nq) !== -1 || desc.indexOf(nq) !== -1 || cat.indexOf(nq) !== -1 || compactCat(item.c).indexOf(nqCompact) !== -1;
      var matchTech = categoryMatches(item.c, activeTech);
      return matchText && matchTech;
    });
    resetAndRender();
  }

  function setQuery(val, opts) {
    q = String(val || '');
    if (heroSearch && heroSearch.value !== q) heroSearch.value = q;
    if (exploreSearch && exploreSearch.value !== q) exploreSearch.value = q;
    clearTimeout(timer);
    var delay = (opts && opts.immediate) ? 0 : 140;
    timer = setTimeout(applyFilter, delay);
  }

  function focusGrid() {
    if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  if (heroSearch) {
    heroSearch.addEventListener('input', function (e) { setQuery(e.target.value || ''); });
    heroSearch.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      if (!isCategoryPage) return;
      e.preventDefault();
      navigateCategoryGlobalSearch(heroSearch.value || '');
    });
  }
  if (exploreSearch) {
    exploreSearch.addEventListener('input', function (e) { setQuery(e.target.value || ''); });
    exploreSearch.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      if (isSearchPage) {
        e.preventDefault();
        goSearchPage(exploreSearch.value || '');
        return;
      }
      if (!isCategoryPage) return;
      e.preventDefault();
      navigateCategoryGlobalSearch(exploreSearch.value || '');
    });
  }
  if (techFilter) {
    techFilter.addEventListener('change', function () {
      if (isCategoryPage) {
        var techVal = techFilter.value || '';
        if (!techVal) return;
        if (navigateCategoryGlobalSearch(techVal)) return;
      }
      activeTech = techFilter.value || '';
      applyFilter();
    });
  }
  if (btn && heroSearch) {
    btn.addEventListener('click', function () {
      if (isCategoryPage) {
        navigateCategoryGlobalSearch(heroSearch.value || '');
        return;
      }
      setQuery(heroSearch.value || '', { immediate: true });
      focusGrid();
    });
  }
  document.querySelectorAll('[data-pr-chip]').forEach(function (chip) {
    chip.addEventListener('click', function () {
      var v = chip.getAttribute('data-pr-chip') || chip.textContent || '';
      if (isCategoryPage) {
        var slug = resolveCategorySlug(v) || slugifyTech(v);
        syncActiveChips(slug || v);
        if (slug === original) {
          focusGrid();
          return;
        }
        if (slug) {
          goCategoryPage(slug);
          return;
        }
        navigateCategoryGlobalSearch(v);
        return;
      }
      if (!heroSearch) return;
      syncActiveChips(v);
      setQuery(v, { immediate: true });
      focusGrid();
    });
  });

  if ('IntersectionObserver' in window && moreEl) {
    observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) renderMore();
      });
    }, { rootMargin: '480px 0px' });
    observer.observe(moreEl);
  } else {
    window.addEventListener('scroll', function () {
      if (cursor >= filtered.length) return;
      var rect = moreEl ? moreEl.getBoundingClientRect() : null;
      if (rect && rect.top < window.innerHeight + 400) renderMore();
    }, { passive: true });
  }

  if (isCategoryPage) syncActiveChips(original);
  if (isSearchPage) {
    q = String(window.__PR_SEARCH_QUERY || '');
    if (exploreSearch) exploreSearch.value = q;
  }
  applyFilter();
})();
</script>

