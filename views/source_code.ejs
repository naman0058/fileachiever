<script>
(function () {
  var sticky = document.getElementById('PrListSticky');
  var sentinel = document.getElementById('PrStickySentinel');
  var waSticky = document.getElementById('WhatsAppSticky');
  if (!sticky || !sentinel) return;
  if (window.matchMedia('(min-width: 992px)').matches) return;

  if (waSticky && typeof waLink === 'function') {
    waSticky.setAttribute('href', waLink('Need custom source code'));
  }

  function setStickyVisible(show) {
    sticky.classList.toggle('is-visible', show);
    sticky.setAttribute('aria-hidden', show ? 'false' : 'true');
    document.body.classList.toggle('pr-report-sticky-active', show);
  }

  var io = new IntersectionObserver(function (entries) {
    setStickyVisible(!entries[0].isIntersecting);
  }, { threshold: 0 });
  io.observe(sentinel);
})();
</script>

<script>
(function initOfferSticky() {
  if (!document.querySelector('.pr-page')) return;
  var offer = document.getElementById('OfferBar');
  if (!offer) return;
  var cachedOfferH = offer.offsetHeight || 52;
  function syncOfferH() {
    if (offer.offsetHeight > 0) cachedOfferH = offer.offsetHeight;
    document.documentElement.style.setProperty('--offerBarH', cachedOfferH + 'px');
  }
  syncOfferH();
  window.addEventListener('resize', syncOfferH);
  window.addEventListener('load', syncOfferH);
})();

(function initStickyToolbar() {
  var wrap = document.getElementById('PrToolbarWrap');
  var toolbar = document.getElementById('PrToolbar');
  var sentinel = document.getElementById('PrToolbarSentinel');
  if (!wrap || !toolbar || !sentinel) return;

  var stuck = false;
  var UNSTICK_BUFFER = 12;

  function setToolbarStuck(next) {
    if (next === stuck) return;
    stuck = next;
    wrap.classList.toggle('is-stuck', stuck);
    document.body.classList.toggle('pr-toolbar-stuck', stuck);
  }

  function updateStuckState() {
    var top = sentinel.getBoundingClientRect().top;
    if (!stuck && top <= 0) setToolbarStuck(true);
    else if (stuck && top > UNSTICK_BUFFER) setToolbarStuck(false);
  }

  window.addEventListener('resize', updateStuckState);
  window.addEventListener('load', updateStuckState);
  window.addEventListener('scroll', updateStuckState, { passive: true });
  updateStuckState();
})();
</script>
