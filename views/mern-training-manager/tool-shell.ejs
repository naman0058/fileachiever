<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= pageTitle %> • MERN Training Manager</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; margin: 0; background: #0f172a; min-height: 100vh; display: flex; flex-direction: column; }
    .portal-bar { background: linear-gradient(135deg, #0f172a 0%, #14532d 100%); color: #e2e8f0; flex-shrink: 0; border-bottom: 1px solid rgba(148,163,184,.2); }
    .nav-pill { border-radius: 999px; padding: .35rem .85rem; font-size: .8rem; font-weight: 600; color: #cbd5e1; text-decoration: none; border: 1px solid transparent; white-space: nowrap; }
    .nav-pill:hover { color: #fff; background: rgba(255,255,255,.08); }
    .nav-pill.active { background: rgba(34,197,94,.25); color: #86efac; border-color: rgba(34,197,94,.35); }
    .tool-frame-wrap { flex: 1; min-height: 0; background: #f8fafc; }
    .tool-frame { width: 100%; height: 100%; min-height: calc(100vh - 120px); border: 0; display: block; background: #fff; }
  </style>
</head>
<body>
  <header class="portal-bar py-3 px-3 px-md-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
      <div class="d-flex align-items-center gap-3">
        <a href="/mern-training-manager" class="text-white text-decoration-none fw-bold d-flex align-items-center gap-2">
          <i class="bi bi-grid-1x2-fill text-success"></i>
          <span>Program manager</span>
        </a>
        <span class="text-white-50 d-none d-sm-inline">|</span>
        <span class="small text-white-50 d-none d-sm-inline"><%= pageTitle %></span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="small text-white-50 d-none d-md-inline">Signed in as <strong class="text-white"><%= user.name %></strong></span>
        <a href="/mern-training-manager/logout" class="btn btn-outline-light btn-sm rounded-pill">Sign out</a>
      </div>
    </div>
    <nav class="d-flex flex-wrap gap-2 pb-1" aria-label="Program tools">
      <a class="nav-pill <%= activeTool === 'add-student' ? 'active' : '' %>" href="/mern-training-manager/workspace/add-student"><i class="bi bi-person-plus me-1"></i>Add student</a>
      <a class="nav-pill <%= activeTool === 'create-task' ? 'active' : '' %>" href="/mern-training-manager/workspace/create-task"><i class="bi bi-list-task me-1"></i>Create task</a>
      <a class="nav-pill <%= activeTool === 'review-tasks' ? 'active' : '' %>" href="/mern-training-manager/workspace/review-tasks"><i class="bi bi-check2-square me-1"></i>Review tasks</a>
      <a class="nav-pill <%= activeTool === 'internship' ? 'active' : '' %>" href="/mern-training-manager/workspace/internship"><i class="bi bi-graph-up-arrow me-1"></i>Internship</a>
    </nav>
  </header>
  <div class="tool-frame-wrap">
    <iframe class="tool-frame" title="<%= pageTitle %>" src="<%= iframeSrc %>"></iframe>
  </div>
</body>
</html>
