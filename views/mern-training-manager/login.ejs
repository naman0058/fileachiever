<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>MERN Training Program Manager • FileMakr</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/setup-support/support.css">
  <style>
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    .login-page { min-height: 100vh; background: linear-gradient(165deg, #0f172a 0%, #1e293b 45%, #334155 100%); display: flex; align-items: center; justify-content: center; padding: 24px; }
    .login-card { border-radius: 20px; box-shadow: 0 4px 6px rgba(0,0,0,.15), 0 28px 60px rgba(0,0,0,.35); border: 1px solid rgba(148,163,184,.2); max-width: 440px; overflow: hidden; background: #fff; }
    .login-card::before { content: ''; display: block; height: 4px; background: linear-gradient(90deg, #22c55e 0%, #2E48FB 50%, #F17F23 100%); }
    .login-brand .logo { font-size: 1.35rem; font-weight: 700; color: #0f172a; letter-spacing: -0.02em; }
    .login-brand .tagline { font-size: 0.875rem; color: #64748b; margin-top: 4px; }
    .btn-signin { background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); border: none; color: #fff; font-weight: 600; padding: 0.75rem 1.5rem; border-radius: 12px; }
    .btn-signin:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 10px 28px rgba(22,163,74,.35); }
    .form-control:focus { border-color: #16a34a; box-shadow: 0 0 0 0.2rem rgba(22,163,74,.2); }
    .badge-stack { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em; }
  </style>
</head>
<body class="login-page">
  <div class="w-100">
    <div class="login-card mx-auto">
      <div class="p-4 p-md-5">
        <div class="login-brand text-center mb-4">
          <div class="d-flex justify-content-center gap-2 mb-2">
            <span class="badge bg-dark badge-stack">MERN</span>
            <span class="badge bg-primary badge-stack">TRAINING</span>
          </div>
          <div class="logo d-block">Program Manager</div>
          <div class="tagline">Onboard students, tasks, reviews &amp; internship metrics</div>
        </div>
        <% if (error) { %>
        <div class="alert alert-danger py-3 mb-0"><%= error %></div>
        <% } %>
        <form method="POST" action="/mern-training-manager/login" class="mt-4">
          <input type="hidden" name="next" value="<%= typeof nextPath !== 'undefined' ? nextPath : '' %>"/>
          <div class="mb-3">
            <label class="form-label fw-semibold">Work email</label>
            <input type="email" name="email" class="form-control form-control-lg" placeholder="you@company.com" required autocomplete="email">
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Password</label>
            <input type="password" name="password" class="form-control form-control-lg" placeholder="••••••••" required autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn-signin w-100 btn-lg">Sign in</button>
        </form>
        <p class="text-center text-muted small mt-4 mb-0">Accounts are issued by an administrator (<code>crm_users</code> · role <code>mern_training_manager</code>).</p>
      </div>
    </div>
  </div>
</body>
</html>
