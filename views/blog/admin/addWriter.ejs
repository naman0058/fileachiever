<%- include('./layout/header', { pageTitle: 'Add Writer' }) %>
<div class="mb-4">
  <nav aria-label="breadcrumb" class="blog-breadcrumb">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/backoffice">Backoffice</a></li>
      <li class="breadcrumb-item"><a href="/blog-admin">Blog Writers</a></li>
      <li class="breadcrumb-item active">Add Writer</li>
    </ol>
  </nav>
</div>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card blog-card">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-person-plus-fill text-primary"></i>
        Add Content Writer
      </div>
      <div class="card-body p-4">
        <% if (msg) { %>
        <div class="alert alert-danger blog-alert d-flex align-items-center gap-2" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <%= msg %>
        </div>
        <% } %>
        <form method="post" action="/blog-admin/add-writer" class="blog-form">
          <div class="mb-4">
            <label class="form-label">Full Name</label>
            <input type="text" name="name" class="form-control form-control-lg" required placeholder="Enter writer's full name" autocomplete="name">
          </div>
          <div class="mb-4">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control form-control-lg" required placeholder="writer@example.com" autocomplete="email">
          </div>
          <div class="mb-4">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control form-control-lg" required minlength="6" placeholder="Minimum 6 characters" autocomplete="new-password">
            <div class="form-text">Writer will use this to log in at /blog-writer</div>
          </div>
          <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary btn-blog-primary d-inline-flex align-items-center gap-2">
              <i class="bi bi-person-plus"></i>
              Add Writer
            </button>
            <a href="/blog-admin" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('./layout/footer') %>
