<%- include('./layout/header', { pageTitle: 'Content Writers' }) %>
<div class="mb-4">
  <nav aria-label="breadcrumb" class="blog-breadcrumb">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
      <li class="breadcrumb-item active">Blog Writers</li>
    </ol>
  </nav>
</div>

<% if (typeof added !== 'undefined' && added) { %>
<div class="alert alert-success blog-alert d-flex align-items-center gap-2" role="alert">
  <i class="bi bi-check-circle-fill"></i>
  Writer added successfully.
</div>
<% } %>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
  <div>
    <h4 class="mb-1 fw-bold" style="color: var(--blog-text);">Content Writers</h4>
    <p class="text-muted mb-0 small">Manage your blog content writers and their access</p>
  </div>
  <a href="/blog-admin/add-writer" class="btn btn-primary btn-blog-primary d-inline-flex align-items-center gap-2">
    <i class="bi bi-person-plus"></i>
    Add Writer
  </a>
</div>

<div class="card blog-card overflow-hidden">
  <div class="table-responsive">
    <table class="table blog-table mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Email</th>
          <th>Status</th>
          <th>Joined</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!writers || writers.length === 0) { %>
        <tr>
          <td colspan="6" class="blog-empty">
            <i class="bi bi-people display-4 text-muted d-block mb-2"></i>
            <p class="mb-0">No writers yet. Add your first content writer to get started.</p>
            <a href="/blog-admin/add-writer" class="btn btn-primary btn-blog-primary mt-3">Add Writer</a>
          </td>
        </tr>
        <% } else { %>
        <% (writers || []).forEach(function(w){ %>
        <tr>
          <td class="fw-medium text-muted">#<%= w.id %></td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 36px; height: 36px;">
                <i class="bi bi-person"></i>
              </div>
              <span class="fw-medium"><%= w.name %></span>
            </div>
          </td>
          <td><%= w.email %></td>
          <td>
            <span class="badge badge-status bg-<%= w.status === 'active' ? 'success' : 'secondary' %>">
              <%= w.status %>
            </span>
          </td>
          <td class="text-muted"><%= new Date(w.created_at).toLocaleDateString() %></td>
          <td class="text-end">
            <form action="/blog-admin/writer/<%= w.id %>/toggle" method="post" class="d-inline">
              <button type="submit" class="btn btn-sm btn-outline-primary me-1">
                <%= w.status === 'active' ? 'Deactivate' : 'Activate' %>
              </button>
            </form>
            <a href="/blog-admin/writer/<%= w.id %>/delete" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this writer? This action cannot be undone.');">
              <i class="bi bi-trash"></i>
            </a>
          </td>
        </tr>
        <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('./layout/footer') %>
