<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>My Blogs | FileMakr Writer</title>
  <link rel="shortcut icon" type="image/png" href="https://res.cloudinary.com/dggf8vl9p/image/upload/v1718627756/filemakr-project-file-creator-favicon_1_dqogst.avif">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body{font-family:'Inter',system-ui,sans-serif;background:#f8fafc;color:#1e293b;min-height:100vh}
    .blog-navbar{background:linear-gradient(135deg,#1e293b 0%,#334155 100%)!important;box-shadow:0 4px 20px rgba(0,0,0,.15);padding:.75rem 1.5rem}
    .blog-navbar .btn-outline-light:hover{background:rgba(255,255,255,.2);border-color:transparent}
    .blog-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .blog-card .card-header{background:#fff;border-bottom:1px solid #e2e8f0;padding:1rem 1.25rem;font-weight:600}
    .writer-stat-card{background:#fff;border-radius:12px;padding:1.25rem 1.5rem;border:1px solid #e2e8f0;box-shadow:0 1px 3px rgba(0,0,0,.08)}
    .writer-stat-card:hover{box-shadow:0 10px 40px rgba(0,0,0,.1);transform:translateY(-2px)}
    .writer-stat-card.primary{background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);border:none;color:#fff}
    .writer-stat-card .stat-value{font-size:1.75rem;font-weight:700}
    .writer-stat-card .stat-label{font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;opacity:.9}
    .blog-table thead th{font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:#64748b;padding:.875rem 1.25rem;border-bottom:2px solid #e2e8f0}
    .blog-table tbody td{padding:1rem 1.25rem;border-bottom:1px solid #e2e8f0}
    .blog-table tbody tr:hover{background:#f8fafc}
    .badge-status{font-weight:500;padding:.35rem .65rem;border-radius:6px;font-size:.75rem}
    .btn-blog-primary{background:#4f46e5;border-color:#4f46e5;font-weight:600;border-radius:8px}
    .btn-blog-primary:hover{background:#4338ca;border-color:#4338ca}
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark blog-navbar">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/blog-writer/dashboard">
        <i class="bi bi-journal-richtext fs-5"></i>
        FileMakr Blog Writer
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#writerNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="writerNav">
        <ul class="navbar-nav ms-auto align-items-center gap-3">
          <li class="nav-item">
            <span class="nav-link text-white-50 d-flex align-items-center gap-2">
              <span class="rounded-circle bg-white bg-opacity-25 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-person-fill text-white small"></i>
              </span>
              <span><%= typeof user !== 'undefined' && user ? user.name : 'Writer' %></span>
            </span>
          </li>
          <li class="nav-item">
            <a href="/blog-writer/logout" class="btn btn-outline-light btn-sm px-3">Logout</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid py-4 px-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
      <div>
        <h4 class="mb-1 fw-bold" style="color:#1e293b">My Blogs</h4>
        <p class="text-muted mb-0 small">Manage and edit your published posts</p>
      </div>
      <a href="/blog-writer/write" class="btn btn-primary btn-blog-primary d-inline-flex align-items-center gap-2 px-4">
        <i class="bi bi-pencil-square"></i>
        Write New Blog
      </a>
    </div>

    <% 
      var blogsArr = blogs || [];
      var publishedCount = blogsArr.filter(function(b){ return b.status === 'published'; }).length;
      var draftCount = blogsArr.filter(function(b){ return b.status === 'draft'; }).length;
      var pendingCount = blogsArr.filter(function(b){ return b.status === 'pending_review'; }).length;
    %>
    <!-- Stats -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="writer-stat-card primary h-100">
          <div class="stat-value"><%= total || 0 %></div>
          <div class="stat-label">Total Posts</div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="writer-stat-card h-100">
          <div class="stat-value text-primary"><%= publishedCount %></div>
          <div class="stat-label text-muted">Published</div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="writer-stat-card h-100">
          <div class="stat-value text-secondary"><%= draftCount %></div>
          <div class="stat-label text-muted">Drafts</div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="writer-stat-card h-100">
          <div class="stat-value text-warning"><%= pendingCount %></div>
          <div class="stat-label text-muted">Pending</div>
        </div>
      </div>
    </div>

    <div class="card blog-card overflow-hidden">
      <div class="card-header d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3">
        <span><i class="bi bi-list-ul me-2 text-primary"></i>All Posts</span>
        <div class="input-group input-group-sm" style="max-width: 280px;">
          <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="blogSearch" class="form-control" placeholder="Search by title, slug, or ID...">
        </div>
      </div>
      <div class="table-responsive">
        <table class="table blog-table mb-0">
          <thead>
            <tr>
              <th>Post</th>
              <th>Slug</th>
              <th>Status</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!blogs || blogs.length === 0) { %>
            <tr>
              <td colspan="5" class="blog-empty py-5">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                  <i class="bi bi-file-earmark-plus display-4"></i>
                </div>
                <h5 class="fw-bold mb-2">No blogs yet</h5>
                <p class="text-muted mb-3">Start writing your first post and share your ideas with the world.</p>
                <a href="/blog-writer/write" class="btn btn-primary btn-blog-primary">
                  <i class="bi bi-pencil-square me-2"></i>Write Your First Blog
                </a>
              </td>
            </tr>
            <% } else { %>
            <% (blogs || []).forEach(function(b){ %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <div class="rounded d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 40px; height: 40px; min-width: 40px;">
                    <i class="bi bi-file-text"></i>
                  </div>
                  <div>
                    <div class="fw-semibold"><%= b.title %></div>
                    <small class="text-muted">#<%= b.id %></small>
                  </div>
                </div>
              </td>
              <td><code class="small bg-light px-2 py-1 rounded"><%= b.slug %></code></td>
              <td>
                <span class="badge badge-status bg-<%= b.status === 'published' ? 'success' : (b.status === 'draft' ? 'secondary' : 'warning') %>">
                  <%= b.status || 'draft' %>
                </span>
              </td>
              <td class="text-muted"><%= new Date(b.created_at).toLocaleDateString() %></td>
              <td class="text-end">
                <a href="/blog/<%= b.slug %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1" title="Live preview">
                  <i class="bi bi-eye me-1"></i>View
                </a>
                <a href="/blog-writer/edit/<%= b.id %>" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
              </td>
            </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function(){
      const searchInput = document.getElementById('blogSearch');
      const table = document.querySelector('.blog-table tbody');
      if (!searchInput || !table) return;
      const rows = table.querySelectorAll('tr');
      searchInput.addEventListener('input', function(){
        const q = (this.value || '').toLowerCase().trim();
        rows.forEach(function(tr){
          if (tr.cells.length < 2) return;
          const text = (tr.cells[0]?.textContent || '') + ' ' + (tr.cells[1]?.textContent || '');
          const match = !q || text.toLowerCase().includes(q);
          tr.style.display = match ? '' : 'none';
        });
      });
    })();
  </script>
</body>
</html>
