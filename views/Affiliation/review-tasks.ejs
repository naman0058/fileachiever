<% include ./header.ejs %>

<div class="content-body">
  <div class="page-titles">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="#">CMS</a></li>
      <li class="breadcrumb-item active"><a href="#">Today’s daily attendance (pending)</a></li>
    </ol>
  </div>

  <div class="container-fluid">
    <% if (tasks.length === 0) { %>
      <div class="alert alert-info">No pending daily attendance for today. Submissions appear after students tap <strong>Verify my attendance</strong> and their Instagram comment is found.</div>
    <% } else { %>
      <!-- Bulk action form wraps the whole table -->
<form method="POST" action="/affiliate/update-task-status" id="bulkActionForm">
  <input type="hidden" name="status" id="bulkStatus" />
  <input type="hidden" name="reason" id="bulkReason" />

  <div class="d-flex gap-2 mb-3">
    <button type="button" id="verifySelected" class="btn btn-success btn-sm">Verify Selected</button>
    <button type="button" id="rejectSelected" class="btn btn-danger btn-sm">Reject Selected</button>
  </div>

  <table class="table table-striped table-bordered align-middle text-center">
    <thead class="table-dark">
      <tr>
        <th><input type="checkbox" id="selectAll" /></th>
        <th>#</th><th>Title</th><th>Type</th><th>Student</th><th>Email</th><th>Instagram</th><th>Description</th><th>Proof</th>
        <th>Quick Action</th>
      </tr>
    </thead>
    <tbody>
      <% tasks.forEach((task, index) => { %>
        <tr>
          <td><input type="checkbox" class="rowCheckbox" name="taskIds[]" value="<%= task.internshipTaskId %>"></td>
          <td><%= index + 1 %></td>
          <td><%= task.title %></td>
          <td><%= task.task_type.charAt(0).toUpperCase() + task.task_type.slice(1) %></td>
          <td><strong><%= task.ambassador_name %></strong></td>
          <td><small><%= task.ambassador_email || '—' %></small></td>
          <td><small><%= task.ambassador_instagram || '—' %></small></td>
          <td style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
              title="<%= task.description.replace(/(<([^>]+)>)/gi, '') %>">
            <%= task.description.replace(/(<([^>]+)>)/gi, '') %>
          </td>
          <td>
            <% if (task.proofLink && String(task.proofLink).indexOf('instagram:') === 0) { %>
              <span class="text-muted small">Instagram · comment OK</span>
            <% } else if (task.proofLink) { %>
              <a href="<%= task.proofLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-link text-primary">View</a>
            <% } else { %>—<% } %>
          </td>
          <td class="text-center">
            <!-- No nested form here -->
            <button type="button" class="btn btn-success btn-sm quick-verify" data-id="<%= task.internshipTaskId %>">Verified</button>
            <button type="button" class="btn btn-danger btn-sm quick-reject"  data-id="<%= task.internshipTaskId %>">Reject</button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</form>

    <% } %>
  </div>
</div>

<% include ./footer.ejs %>

<script>
  const selectAll = document.getElementById('selectAll');
  const rowCheckboxes = Array.from(document.querySelectorAll('.rowCheckbox'));
  const bulkForm   = document.getElementById('bulkActionForm');
  const bulkStatus = document.getElementById('bulkStatus');
  const bulkReason = document.getElementById('bulkReason');

  function getSelected() { return rowCheckboxes.filter(cb => cb.checked); }
  function ensureAtLeastOne() {
    if (getSelected().length === 0) { alert('Please select at least one task.'); return false; }
    return true;
  }

  // Select-all behavior
  if (selectAll) {
    selectAll.addEventListener('change', () => rowCheckboxes.forEach(cb => cb.checked = selectAll.checked));
    rowCheckboxes.forEach(cb => cb.addEventListener('change', () => {
      if (!cb.checked) selectAll.checked = false;
      else if (rowCheckboxes.every(c => c.checked)) selectAll.checked = true;
    }));
  }

  // Bulk verify
  document.getElementById('verifySelected')?.addEventListener('click', () => {
    if (!ensureAtLeastOne()) return;
    bulkStatus.value = 'verified';
    bulkReason.value = '';
    bulkForm.submit();
  });

  // Bulk reject
  document.getElementById('rejectSelected')?.addEventListener('click', () => {
    if (!ensureAtLeastOne()) return;
    const reason = prompt('Please enter the reason for rejection (applied to all selected):');
    if (!reason || !reason.trim()) return alert('Rejection reason is required.');
    bulkStatus.value = 'rejected';
    bulkReason.value = reason.trim();
    bulkForm.submit();
  });

  // Quick per-row actions (no nested forms!)
  document.querySelectorAll('.quick-verify').forEach(btn => {
    btn.addEventListener('click', () => {
      rowCheckboxes.forEach(cb => cb.checked = (cb.value === btn.dataset.id));
      bulkStatus.value = 'verified';
      bulkReason.value = '';
      bulkForm.submit();
    });
  });

  document.querySelectorAll('.quick-reject').forEach(btn => {
    btn.addEventListener('click', () => {
      const reason = prompt('Please enter the reason for rejection:');
      if (!reason || !reason.trim()) return alert('Rejection reason is required.');
      rowCheckboxes.forEach(cb => cb.checked = (cb.value === btn.dataset.id));
      bulkStatus.value = 'rejected';
      bulkReason.value = reason.trim();
      bulkForm.submit();
    });
  });
</script>

