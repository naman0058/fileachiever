<% include ./header.ejs %>

<div class="content-body">
  <div class="container-fluid">
    <div class="row page-titles mx-0 mb-3">
      <div class="col-sm-12 p-md-0">
        <div class="welcome-text">
          <h4 class="mb-1">Attendance review</h4>
          <p class="mb-0 text-muted">Today’s MERN daily submissions — approve or reject. Approving sends each student an email with today’s <strong>Google Meet</strong> link and adds them to the calendar event when OAuth is configured.</p>
        </div>
      </div>
    </div>

    <% if (tasks.length === 0) { %>
      <div class="card border-0 shadow-sm">
        <div class="card-body py-5 text-center text-muted">
          <p class="mb-1 fw-semibold text-dark">No pending submissions</p>
          <p class="mb-0 small">Rows appear here after students comment on today’s Instagram task and use <strong>Verify my attendance</strong> on their dashboard.</p>
        </div>
      </div>
    <% } else { %>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body py-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <span class="badge badge-rounded badge-primary light fs-14"><%= tasks.length %> pending</span>
          <span class="text-muted small ms-2">Select rows, then approve or reject.</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <button type="button" id="verifySelected" class="btn btn-success btn-sm px-3">
            Approve selected
          </button>
          <button type="button" id="openBulkReject" class="btn btn-outline-danger btn-sm px-3">
            Reject selected
          </button>
        </div>
      </div>
    </div>

    <form method="POST" action="/affiliate/update-task-status" id="bulkActionForm">
      <% if (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) { %>
      <input type="hidden" name="embed" value="1">
      <% } %>
      <input type="hidden" name="status" id="bulkStatus" />
      <input type="hidden" name="reason" id="bulkReason" />

      <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th class="border-0 ps-4" style="width:44px;">
                    <input type="checkbox" class="form-check-input" id="selectAll" title="Select all" />
                  </th>
                  <th class="border-0">Student</th>
                  <th class="border-0">Email</th>
                  <th class="border-0">Instagram</th>
                  <th class="border-0">Submitted</th>
                  <th class="border-0">Verification</th>
                  <th class="border-0 pe-4 text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% tasks.forEach((task) => { %>
                  <tr>
                    <td class="ps-4">
                      <input type="checkbox" class="form-check-input rowCheckbox" name="taskIds[]" value="<%= task.internshipTaskId %>" />
                    </td>
                    <td>
                      <div class="fw-semibold text-dark"><%= task.ambassador_name %></div>
                      <div class="small text-muted text-truncate" style="max-width:14rem" title="<%= String(task.title || '').replace(/\"/g, '&quot;') %>"><%= task.title %></div>
                    </td>
                    <td>
                      <% if (task.ambassador_email) { %>
                        <a href="mailto:<%= task.ambassador_email %>" class="text-primary small text-break"><%= task.ambassador_email %></a>
                      <% } else { %>
                        <span class="text-muted small">—</span>
                      <% } %>
                    </td>
                    <td><span class="small text-muted"><%= task.ambassador_instagram || '—' %></span></td>
                    <td><span class="small text-muted"><%= task.submittedAtLabel %></span></td>
                    <td>
                      <% if (task.proofLink && String(task.proofLink).indexOf('instagram:') === 0) { %>
                        <span class="badge badge-rounded badge-success light">Instagram · comment OK</span>
                      <% } else if (task.proofLink) { %>
                        <a href="<%= task.proofLink %>" target="_blank" rel="noopener noreferrer" class="badge badge-rounded badge-secondary light text-decoration-none">View proof</a>
                      <% } else { %>
                        <span class="text-muted small">—</span>
                      <% } %>
                    </td>
                    <td class="pe-4 text-end text-nowrap">
                      <button type="button" class="btn btn-success btn-sm shadow-sm quick-verify px-2 py-1" data-id="<%= task.internshipTaskId %>">Approve</button>
                      <button type="button" class="btn btn-outline-danger btn-sm shadow-sm quick-reject px-2 py-1 ms-1" data-id="<%= task.internshipTaskId %>">Reject</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </form>

    <% } %>
  </div>
</div>

<!-- Reject reason modal -->
<div class="modal fade" id="rejectReasonModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title">Reject submission</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2">
        <p class="small text-muted mb-2" id="rejectModalHint">Students receive this reason by email.</p>
        <textarea class="form-control" id="rejectReasonText" rows="4" placeholder="Explain what they should fix (required)"></textarea>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm" id="confirmRejectBtn">Send rejection</button>
      </div>
    </div>
  </div>
</div>

<% include ./footer.ejs %>

<script>
(function () {
  const selectAll = document.getElementById('selectAll');
  const rowCheckboxes = Array.from(document.querySelectorAll('.rowCheckbox'));
  const bulkForm = document.getElementById('bulkActionForm');
  const bulkStatus = document.getElementById('bulkStatus');
  const bulkReason = document.getElementById('bulkReason');
  const rejectModalEl = document.getElementById('rejectReasonModal');
  const rejectReasonText = document.getElementById('rejectReasonText');
  const rejectModalHint = document.getElementById('rejectModalHint');
  const confirmRejectBtn = document.getElementById('confirmRejectBtn');

  let rejectMode = 'bulk';
  let singleRejectId = null;
  var rejectModalInstance = null;

  function showRejectModalUi() {
    if (window.bootstrap && bootstrap.Modal && rejectModalEl) {
      if (!rejectModalInstance) rejectModalInstance = new bootstrap.Modal(rejectModalEl);
      rejectModalInstance.show();
    } else if (window.jQuery && typeof jQuery(rejectModalEl).modal === 'function') {
      jQuery(rejectModalEl).modal('show');
    }
  }

  function hideRejectModalUi() {
    if (rejectModalInstance) rejectModalInstance.hide();
    else if (window.jQuery) jQuery(rejectModalEl).modal('hide');
  }

  function getSelected() {
    return rowCheckboxes.filter(function (cb) { return cb.checked; });
  }

  function ensureAtLeastOne() {
    if (getSelected().length === 0) {
      alert('Select at least one submission.');
      return false;
    }
    return true;
  }

  if (selectAll) {
    selectAll.addEventListener('change', function () {
      rowCheckboxes.forEach(function (cb) { cb.checked = selectAll.checked; });
    });
    rowCheckboxes.forEach(function (cb) {
      cb.addEventListener('change', function () {
        if (!cb.checked) selectAll.checked = false;
        else if (rowCheckboxes.every(function (c) { return c.checked; })) selectAll.checked = true;
      });
    });
  }

  document.getElementById('verifySelected')?.addEventListener('click', function () {
    if (!ensureAtLeastOne()) return;
    var n = getSelected().length;
    if (!confirm('Approve ' + n + ' submission(s)?\n\nEach student will receive an email with today’s Google Meet link (and a calendar invite when OAuth is configured).')) return;
    bulkStatus.value = 'verified';
    bulkReason.value = '';
    bulkForm.submit();
  });

  function openRejectModal(mode, id) {
    rejectMode = mode;
    singleRejectId = id || null;
    rejectReasonText.value = '';
    if (rejectModalHint) {
      rejectModalHint.textContent = mode === 'bulk'
        ? 'This reason will be emailed to all selected students.'
        : 'This reason will be emailed to this student.';
    }
    showRejectModalUi();
    if (!window.bootstrap && !(window.jQuery && typeof jQuery(rejectModalEl).modal === 'function')) {
      var r = prompt('Rejection reason (required):');
      if (!r || !r.trim()) return;
      bulkReason.value = r.trim();
      bulkStatus.value = 'rejected';
      if (mode === 'single' && id) {
        rowCheckboxes.forEach(function (cb) { cb.checked = (cb.value === String(id)); });
      } else if (!ensureAtLeastOne()) return;
      bulkForm.submit();
    }
  }

  document.getElementById('openBulkReject')?.addEventListener('click', function () {
    if (!ensureAtLeastOne()) return;
    openRejectModal('bulk', null);
  });

  confirmRejectBtn?.addEventListener('click', function () {
    var reason = (rejectReasonText.value || '').trim();
    if (!reason) {
      alert('Please enter a rejection reason.');
      return;
    }
    bulkReason.value = reason;
    bulkStatus.value = 'rejected';
    if (rejectMode === 'single' && singleRejectId) {
      rowCheckboxes.forEach(function (cb) { cb.checked = (cb.value === String(singleRejectId)); });
    } else if (!ensureAtLeastOne()) return;
    hideRejectModalUi();
    bulkForm.submit();
  });

  document.querySelectorAll('.quick-verify').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!confirm('Approve this submission?\n\nThe student will receive an email with today’s Google Meet link.')) return;
      rowCheckboxes.forEach(function (cb) { cb.checked = (cb.value === btn.dataset.id); });
      bulkStatus.value = 'verified';
      bulkReason.value = '';
      bulkForm.submit();
    });
  });

  document.querySelectorAll('.quick-reject').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openRejectModal('single', btn.dataset.id);
    });
  });
})();
</script>
