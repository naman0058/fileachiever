<% include ./header.ejs %>

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: { brandOrange: '#F17F23', brandBlue: '#2A47FF' },
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
      }
    }
  }
</script>
<% var mernEmbAmp = (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) ? '&embed=1' : ''; var mernEmbQ = (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) ? '?embed=1' : ''; %>

<div class="content-body bg-slate-50 min-h-screen font-sans text-gray-900">
  <div class="container mx-auto px-4 py-8 space-y-8 max-w-7xl">

    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200/80 overflow-hidden">
      <div class="flex flex-col xl:flex-row items-start xl:items-start justify-between gap-6 px-6 py-6 border-b border-slate-100">
        <div class="space-y-2">
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Affiliate · Internship</p>
          <h2 class="text-2xl font-semibold text-slate-900 tracking-tight">Program performance</h2>
          <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
            Dashboard includes ambassadors whose account was created in the <strong>last <%= typeof internshipRecentDays !== 'undefined' ? internshipRecentDays : 60 %> days</strong>.
            Task counts (verified, pending, rejected) and performance use attendance from the same rolling window.
            The daily trend uses your selected dates, scoped to this cohort and window.
          </p>
        </div>

        <!-- Filters -->
        <form id="filters" class="flex flex-wrap items-end gap-3 xl:max-w-xl" method="GET" action="">
          <% if (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) { %>
          <input type="hidden" name="embed" value="1">
          <% } %>
          <div class="flex flex-col gap-1">
            <label for="startDate" class="text-xs font-medium text-slate-600">Start</label>
            <input id="startDate" type="date" name="start" value="<%= start %>"
                   class="px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white relative z-10"
                   onchange="handleDateChange()">
          </div>
          <div class="flex flex-col gap-1">
            <label for="endDate" class="text-xs font-medium text-slate-600">End</label>
            <input id="endDate" type="date" name="end" value="<%= end %>"
                   class="px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white relative z-10"
                   onchange="handleDateChange()">
          </div>
          <div class="flex flex-col gap-1">
            <label for="qSearch" class="text-xs font-medium text-slate-600">Search</label>
            <input id="qSearch" type="text" name="q" value="<%= qSearch %>" placeholder="Name or number"
                   class="px-3 py-2 border border-slate-200 rounded-lg w-44 text-sm"
                   onkeydown="if(event.key==='Enter'){this.form.submit()}">
          </div>
          <div class="flex flex-col gap-1">
            <label for="statusFilter" class="text-xs font-medium text-slate-600">Status</label>
            <select id="statusFilter" name="status" class="px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white" onchange="this.form.submit()">
              <option value="all"      <%= statusFilter==='all'?'selected':'' %>>All</option>
              <option value="verified" <%= statusFilter==='verified'?'selected':'' %>>Has verified</option>
              <option value="pending"  <%= statusFilter==='pending'?'selected':'' %>>Has pending</option>
              <option value="rejected" <%= statusFilter==='rejected'?'selected':'' %>>Has rejected</option>
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label for="minPerf" class="text-xs font-medium text-slate-600">Min %</label>
            <input id="minPerf" type="number" step="1" min="0" max="100" name="minPerf" value="<%= minPerf %>"
                   placeholder="0"
                   class="px-3 py-2 border border-slate-200 rounded-lg w-20 text-sm"
                   onchange="this.form.submit()">
          </div>
          <button type="submit" class="bg-brandBlue text-white px-4 py-2 rounded-lg text-sm font-medium hover:opacity-95">Apply</button>
          <a href="/affiliate/internship/export/main.csv?<%= `start=${start}&end=${end}&q=${encodeURIComponent(qSearch||'')}&status=${statusFilter}&minPerf=${minPerf}` %><%= mernEmbAmp %>"
             class="px-4 py-2 rounded-lg border border-slate-200 text-sm font-medium text-brandBlue hover:bg-slate-50">Export CSV</a>
          <a href="/affiliate/internship<%= mernEmbQ %>"
             class="px-4 py-2 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50">Reset</a>
        </form>
      </div>
      <p class="px-6 py-3 text-xs text-slate-500 bg-slate-50/80 border-t border-slate-100">Filters apply to exports and to the top / bottom performer charts below.</p>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">In cohort</p>
        <p class="text-3xl font-semibold text-brandBlue mt-1 tabular-nums"><%= totalAmbassadors %></p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Eligible today</p>
        <p class="text-3xl font-semibold text-slate-900 mt-1 tabular-nums"><%= eligibleToday %></p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Verified today</p>
        <p class="text-3xl font-semibold text-emerald-600 mt-1 tabular-nums"><%= todayVerifiedCount %></p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Missed today</p>
        <p class="text-3xl font-semibold text-red-600 mt-1 tabular-nums"><%= todayMissedCount %></p>
      </div>
      <div class="bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm col-span-2 md:col-span-1">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Today completion</p>
        <p class="text-3xl font-semibold mt-1 tabular-nums <%= todayCompletionRate>=70?'text-emerald-600':(todayCompletionRate<30?'text-red-600':'text-amber-600') %>">
          <%= todayCompletionRate %>%</p>
      </div>
    </div>

    <!-- Last 7 days: per-ambassador status (directly under overview) -->
    <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div>
          <h3 class="text-lg font-semibold text-slate-900">Last 7 days · daily verification</h3>
          <p class="text-sm text-slate-500 mt-0.5">One row per ambassador; green = verified that calendar day.</p>
        </div>
        <a href="/affiliate/internship/export/weekly-matrix.csv<%= mernEmbQ %>" class="shrink-0 px-4 py-2 rounded-lg border border-slate-200 text-sm font-medium text-brandBlue hover:bg-slate-50">Export matrix</a>
      </div>

      <div class="overflow-x-auto rounded-lg border border-slate-100">
        <table class="min-w-full text-sm text-left">
          <thead>
            <tr class="bg-slate-800 text-white">
              <th class="px-4 py-3 font-medium">#</th>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Number</th>
              <% for (let i=6; i>=0; i--) {
                   const d = new Date(); d.setDate(d.getDate()-i);
                   const label = d.toISOString().slice(0,10);
              %>
                <th class="px-2 py-3 text-center font-medium text-xs"><%= label %></th>
              <% } %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <% if (weekly.length === 0) { %>
              <tr><td colspan="11" class="px-4 py-8 text-center text-slate-500">No ambassadors in the current cohort.</td></tr>
            <% } else { %>
              <% weekly.forEach((w, idx) => { %>
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3 text-slate-600 tabular-nums"><%= idx+1 %></td>
                  <td class="px-4 py-3 font-medium text-slate-900"><%= w.name %></td>
                  <td class="px-4 py-3 text-slate-600"><%= w.number %></td>
                  <% for (let k=6; k>=0; k--) {
                       const key = 'd'+k; const yes = (w[key]||0) > 0;
                  %>
                    <td class="px-2 py-2 text-center">
                      <span class="inline-block w-5 h-5 rounded-full <%= yes?'bg-emerald-500':'bg-slate-200' %>" title="<%= yes ? 'Verified' : 'Not verified' %>"></span>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Top vs bottom performers -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900 mb-1">Top 10 · performance</h3>
        <p class="text-sm text-slate-500 mb-4">Highest completion in the rolling <%= typeof internshipRecentDays !== 'undefined' ? internshipRecentDays : 60 %>-day window (after filters).</p>
        <canvas id="top10Chart" height="280"></canvas>
      </div>
      <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-sm ring-1 ring-amber-100/80">
        <h3 class="text-lg font-semibold text-slate-900 mb-1">Lowest 10 · needs attention</h3>
        <p class="text-sm text-slate-500 mb-4">Lowest completion among the same filtered cohort.</p>
        <canvas id="bottom10Chart" height="280"></canvas>
      </div>
    </div>

    <!-- Trend -->
    <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-sm">
      <h3 class="text-lg font-semibold text-slate-900 mb-1">Daily trend</h3>
      <p class="text-sm text-slate-500 mb-4"><%= start %> → <%= end %> · cohort and <%= typeof internshipRecentDays !== 'undefined' ? internshipRecentDays : 60 %>-day attendance window</p>
      <canvas id="trendChart" height="120"></canvas>
    </div>

    <!-- Today: verified -->
    <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
          <h3 class="text-lg font-semibold text-slate-900">Today · verified submissions</h3>
          <p class="text-sm text-slate-500">Cohort only; one row per verified task today.</p>
        </div>
        <a href="/affiliate/internship/export/today-verified.csv<%= mernEmbQ %>" class="shrink-0 px-4 py-2 rounded-lg border border-slate-200 text-sm font-medium text-brandBlue hover:bg-slate-50">Export CSV</a>
      </div>
      <div class="overflow-x-auto rounded-lg border border-slate-100">
        <table class="min-w-full text-sm text-left">
          <thead class="bg-slate-800 text-white">
            <tr>
              <th class="px-4 py-3 font-medium">#</th>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Number</th>
              <th class="px-4 py-3 font-medium">Email</th>
              <th class="px-4 py-3 font-medium">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (todayVerified.length === 0) { %>
              <tr><td colspan="5" class="px-4 py-8 text-center text-slate-500">No verified submissions today.</td></tr>
            <% } else { %>
              <% todayVerified.forEach((r, idx) => { %>
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3 tabular-nums text-slate-600"><%= idx+1 %></td>
                  <td class="px-4 py-3 font-medium text-slate-900"><%= r.name %></td>
                  <td class="px-4 py-3 text-slate-600"><%= r.number %></td>
                  <td class="px-4 py-3 text-slate-600"><%= r.email %></td>
                  <td class="px-4 py-3 text-slate-600"><%= r.on_date %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Today: missed -->
    <div class="bg-white p-6 rounded-xl border border-slate-200/80 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div>
          <h3 class="text-lg font-semibold text-slate-900">Today · no verified submission</h3>
          <p class="text-sm text-slate-500">Eligible cohort members who have not verified a task today.</p>
        </div>
        <a href="/affiliate/internship/export/today-missed.csv<%= mernEmbQ %>" class="shrink-0 px-4 py-2 rounded-lg border border-slate-200 text-sm font-medium text-brandBlue hover:bg-slate-50">Export CSV</a>
      </div>
      <div class="overflow-x-auto rounded-lg border border-slate-100">
        <table class="min-w-full text-sm text-left">
          <thead class="bg-red-700 text-white">
            <tr>
              <th class="px-4 py-3 font-medium">#</th>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Number</th>
              <th class="px-4 py-3 font-medium">Joined</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (todayMissed.length === 0) { %>
              <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">Everyone in cohort submitted or none are due—no missed rows.</td></tr>
            <% } else { %>
              <% todayMissed.forEach((r, idx) => { %>
                <tr class="hover:bg-slate-50/80">
                  <td class="px-4 py-3 tabular-nums text-slate-600"><%= idx+1 %></td>
                  <td class="px-4 py-3 font-medium text-slate-900"><%= r.name %></td>
                  <td class="px-4 py-3 text-slate-600"><%= r.number %></td>
                  <td class="px-4 py-3 text-slate-600"><%= (new Date(r.created_at)).toISOString().slice(0,10) %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<% include ./footer.ejs %>

<script>
  const top10Series = <%- JSON.stringify(top10.map(t => ({
    name: t.name,
    perf: t.performance_range
  }))) %>;
  const bottom10Series = <%- JSON.stringify(bottom10.map(t => ({
    name: t.name,
    perf: t.performance_range
  }))) %>;
  const trend = <%- JSON.stringify(timeseries) %>;

  const barChartOpts = {
    responsive: true,
    maintainAspectRatio: true,
    plugins: {
      legend: { display: false },
      tooltip: { callbacks: { label: c => (c.parsed.y != null ? c.parsed.y : c.parsed.x) + '%' } }
    },
    scales: {
      y: { beginAtZero: true, max: 100, title: { display: true, text: 'Performance %' } }
    }
  };

  (function () {
    const raw = top10Series.length ? top10Series : [{ name: 'No data', perf: 0 }];
    const ctx = document.getElementById('top10Chart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: raw.map(x => x.name),
        datasets: [{
          label: 'Performance %',
          data: raw.map(x => x.perf),
          backgroundColor: '#2A47FF',
          borderRadius: 4
        }]
      },
      options: barChartOpts
    });
  })();

  (function () {
    const raw = bottom10Series.length ? bottom10Series : [{ name: 'No data', perf: 0 }];
    const ctx = document.getElementById('bottom10Chart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: raw.map(x => x.name),
        datasets: [{
          label: 'Performance %',
          data: raw.map(x => x.perf),
          backgroundColor: '#C2410C',
          borderRadius: 4
        }]
      },
      options: barChartOpts
    });
  })();

  (function () {
    const ctx = document.getElementById('trendChart').getContext('2d');
    const labels = trend.map(t => t.d);
    const verified = trend.map(t => Number(t.verified || 0));
    const pending = trend.map(t => Number(t.pending || 0));
    const rejected = trend.map(t => Number(t.rejected || 0));

    new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [
          { label: 'Verified', data: verified, tension: 0.2, borderWidth: 2, borderColor: '#059669' },
          { label: 'Pending', data: pending, tension: 0.2, borderWidth: 2, borderColor: '#CA8A04' },
          { label: 'Rejected', data: rejected, tension: 0.2, borderWidth: 2, borderColor: '#DC2626' },
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'top' } },
        scales: { y: { beginAtZero: true, title: { display: true, text: 'Tasks' } } }
      }
    });
  })();
</script>

<script>
  function handleDateChange() {
    const form = document.getElementById('filters');
    const s = document.getElementById('startDate');
    const e = document.getElementById('endDate');

    // keep logical range and set min/max to avoid picking wrong side
    if (s.value && e.value && s.value > e.value) {
      // if user changed start beyond end, set end = start
      e.value = s.value;
    }
    e.min = s.value || '';
    s.max = e.value || '';

    form.submit();
  }

  // Ensure inputs are always clickable even if some parent has an overlay
  // (helps when unknown styles in header.ejs create a covering element)
  ['startDate','endDate','qSearch','statusFilter','minPerf'].forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.style.position = 'relative';
      el.style.zIndex = 10;
      el.style.pointerEvents = 'auto';
    }
  });




  
</script>
