<% include ./saved-views-toolbar.ejs %>
<form class="fa-filter" method="get" action="" role="search">
  <div class="fa-field fa-field--search fa-field--collapse-sm">
    <label class="fa-field__label" for="fa-filter-q">Search</label>
    <input class="fa-input" id="fa-filter-q" type="search" name="q" placeholder="Enquiry, client, phone, agent…" value="<%= filters.q || '' %>" autocomplete="off" />
  </div>
  <div class="fa-field fa-field--collapse-sm">
    <label class="fa-field__label" for="fa-filter-agent">Agent</label>
    <select class="fa-select" id="fa-filter-agent" name="agent">
      <option value="">All agents</option>
      <% (agentsList || []).forEach(function (a) { %>
        <option value="<%= a %>" <%= filters.agent === a ? 'selected' : '' %>><%= a %></option>
      <% }); %>
    </select>
  </div>
  <% if (typeof tab !== 'undefined' && tab && tab !== 'all') { %>
    <input type="hidden" name="view" value="<%= tab %>" />
  <% } %>
  <% if (typeof hasOps !== 'undefined' && hasOps) { %>
    <div class="fa-field fa-field--collapse-sm">
      <label class="fa-field__label" for="fa-filter-priority">Priority</label>
      <select class="fa-select" id="fa-filter-priority" name="priority">
        <option value="">Any priority</option>
        <% ['critical','high','medium','low'].forEach(function (p) { %>
          <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= p %></option>
        <% }); %>
      </select>
    </div>
  <% } %>
  <div class="fa-field fa-field--collapse-sm">
    <label class="fa-field__label" for="fa-filter-sort">Sort</label>
    <select class="fa-select fa-select--sm" id="fa-filter-sort" name="sort">
      <% 
        var sortOpts = [
          ['deadline', 'Deadline (soonest)'],
          ['deadline_desc', 'Deadline (latest)'],
          ['priority', 'Priority'],
          ['stage', 'Stage'],
          ['project', 'Project'],
          ['client', 'Client'],
          ['assign', 'Assignee'],
          ['updated', 'Last updated'],
        ];
        sortOpts.forEach(function (pair) {
      %>
        <option value="<%= pair[0] %>" <%= (typeof filters !== 'undefined' && filters.sort === pair[0]) || (!filters.sort && pair[0] === 'deadline') ? 'selected' : '' %>><%= pair[1] %></option>
      <% }); %>
    </select>
  </div>
  <% if (typeof filters !== 'undefined' && filters.quick) { %>
    <input type="hidden" name="quick" value="<%= filters.quick %>" />
  <% } %>
  <div class="fa-field fa-field--collapse-sm">
    <label class="fa-field__label" for="fa-filter-limit">Page size</label>
    <select class="fa-select fa-select--sm" id="fa-filter-limit" name="limit">
      <% [25, 50, 100].forEach(function (n) { %>
        <option value="<%= n %>" <%= (typeof filters !== 'undefined' && filters.limit === n) || (list && list.limit === n) ? 'selected' : (!list && !(typeof filters !== 'undefined' && filters.limit) && n === 50 ? 'selected' : '') %>><%= n %></option>
      <% }); %>
    </select>
  </div>
  <div class="fa-field fa-field--collapse-sm">
    <label class="fa-field__label" for="fa-filter-density">Density</label>
    <select class="fa-select fa-select--sm" name="density" id="fa-filter-density">
      <option value="comfortable">Comfortable</option>
      <option value="compact">Compact</option>
    </select>
  </div>
  <button type="submit" class="fa-btn fa-btn--primary">Apply</button>
  <% if (filters.q || filters.agent) { %>
    <a href="<%= typeof filterClearPath !== 'undefined' ? filterClearPath : '?' %>" class="fa-btn fa-btn--ghost">Clear</a>
  <% } %>
</form>
