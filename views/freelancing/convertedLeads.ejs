<% include ./header.ejs %>

<style>
  :root {
    --bg: #0b1220;
    --panel: #0f1a2f;
    --card: #111f3a;
    --card2: #0f1a2f;
    --border: rgba(255,255,255,0.08);
    --muted: rgba(255,255,255,0.68);
    --text: rgba(255,255,255,0.92);
    --accent: #4f8cff;
    --accent2: #7c5cff;
    --success: #28c76f;
    --warning: #ff9f43;
    --danger: #ea5455;
    --info: #00cfe8;
    --shadow: 0 10px 30px rgba(0,0,0,0.35);
    --radius: 14px;
  }

  /* Page background (fits most admin templates) */
  body {
    background: radial-gradient(1100px 500px at 20% -10%, rgba(79,140,255,0.22), transparent 60%),
                radial-gradient(900px 450px at 90% 0%, rgba(124,92,255,0.18), transparent 55%),
                var(--bg);
  }

  /* Sticky top bar */
  .sticky-topbar {
    position: sticky;
    top: 0;
    z-index: 999;
    backdrop-filter: blur(10px);
    background: rgba(11, 18, 32, 0.72);
    border-bottom: 1px solid var(--border);
  }

  .topbar-inner {
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .page-title {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 260px;
  }

  .page-title .badge-month {
    background: linear-gradient(135deg, rgba(79,140,255,0.22), rgba(124,92,255,0.18));
    border: 1px solid var(--border);
    color: var(--text);
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .page-title h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: 0.2px;
  }

  .page-subtitle {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .btn-pro {
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.04);
    color: var(--text);
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    transition: 0.2s;
  }

  .btn-pro:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,0.08);
  }

  .btn-primary-pro {
    border: 1px solid rgba(79,140,255,0.35);
    background: linear-gradient(135deg, rgba(79,140,255,0.95), rgba(124,92,255,0.95));
    color: #fff;
  }

  .btn-primary-pro:hover {
    filter: brightness(1.06);
  }

  .control {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px 12px;
    min-width: 260px;
  }

  .control input {
    width: 100%;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font-size: 13px;
  }

  .control select {
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font-size: 13px;
  }

  .control option {
    color: #000;
  }

  /* KPI grid */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 12px;
    margin-top: 14px;
  }

  .kpi-card {
    grid-column: span 3;
    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    box-shadow: var(--shadow);
    min-height: 92px;
    position: relative;
    overflow: hidden;
  }

  .kpi-card::after {
    content: "";
    position: absolute;
    inset: -60px -60px auto auto;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(79,140,255,0.18), transparent 60%);
    transform: rotate(20deg);
  }

  .kpi-title {
    margin: 0 0 6px 0;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.2px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .kpi-value {
    margin: 0;
    color: var(--text);
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 0.3px;
  }

  .kpi-hint {
    margin: 6px 0 0 0;
    color: var(--muted);
    font-size: 12px;
  }

  .pill {
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 11px;
    font-weight: 800;
    color: var(--text);
    background: rgba(255,255,255,0.04);
    white-space: nowrap;
  }

  .pill.success { border-color: rgba(40,199,111,0.35); background: rgba(40,199,111,0.08); }
  .pill.warning { border-color: rgba(255,159,67,0.35); background: rgba(255,159,67,0.08); }
  .pill.danger { border-color: rgba(234,84,85,0.35); background: rgba(234,84,85,0.08); }
  .pill.info { border-color: rgba(0,207,232,0.35); background: rgba(0,207,232,0.08); }
  .pill.primary { border-color: rgba(79,140,255,0.35); background: rgba(79,140,255,0.08); }

  /* Responsive KPIs */
  @media (max-width: 1200px) { .kpi-card { grid-column: span 4; } }
  @media (max-width: 768px)  { .kpi-card { grid-column: span 6; } }
  @media (max-width: 520px)  { .kpi-card { grid-column: span 12; } }

  /* Table container */
  .table-shell {
    margin-top: 14px;
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .table-head {
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.02);
  }

  .table-head h4 {
    margin: 0;
    color: var(--text);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.2px;
  }

  .table-wrap {
    max-height: 68vh;
    overflow: auto;
  }

  table.pro-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    min-width: 1200px;
  }

  table.pro-table thead th {
    position: sticky;
    top: 0; /* sticky inside .table-wrap */
    z-index: 5;
    background: rgba(11, 18, 32, 0.92);
    color: rgba(255,255,255,0.86);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    font-weight: 900;
    border-bottom: 1px solid var(--border);
    padding: 12px 10px;
    white-space: nowrap;
  }

  table.pro-table tbody td {
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 10px;
    color: rgba(255,255,255,0.90);
    font-size: 13px;
    vertical-align: middle;
  }

  table.pro-table tbody tr:hover td {
    background: rgba(255,255,255,0.03);
  }

  /* Editable cell */
  .editable {
    outline: none;
    border-radius: 8px;
  }
  .editable:focus {
    background: rgba(79,140,255,0.10);
    box-shadow: inset 0 0 0 1px rgba(79,140,255,0.35);
  }

  /* Status badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.15px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.04);
    white-space: nowrap;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255,255,255,0.5);
  }
  .st-in_progress .dot { background: var(--info); }
  .st-assign .dot { background: var(--primary); }
  .st-completed .dot { background: var(--success); }
  .st-hold .dot { background: var(--danger); }
  .st-pending .dot { background: var(--warning); }
  .st-client_review .dot { background: #ffd166; }
  .st-in_changes .dot { background: #a78bfa; }

  /* Toggle switch */
  .switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 22px;
  }
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255,255,255,0.18);
    transition: 0.25s;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.10);
  }
  .slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 2px;
    background-color: rgba(255,255,255,0.92);
    transition: 0.25s;
    border-radius: 50%;
  }
  input:checked + .slider {
    background: rgba(40,199,111,0.28);
    border-color: rgba(40,199,111,0.35);
  }
  input:checked + .slider:before {
    transform: translateX(21px);
  }

  /* Status select */
  .status-select {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 8px 10px;
    color: var(--text);
    font-weight: 800;
    font-size: 12px;
    outline: none;
  }
  .status-select option { color: #000; }

  /* Loader overlay */
  #loader-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 99999;
  }
  #loader {
    border: 8px solid rgba(255,255,255,0.20);
    border-top: 8px solid rgba(79,140,255,1);
    border-radius: 50%;
    width: 54px;
    height: 54px;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Small helper */
  .muted { color: var(--muted); }
</style>

<div class="content-body">
  <div class="container-fluid">

    <!-- Sticky header -->
    <div class="sticky-topbar">
      <div class="topbar-inner">
        <div class="page-title">
          <span class="badge-month"><%= (month || '').toUpperCase() %></span>
          <div>
            <h3>Freelancing Leads Dashboard</h3>
            <p class="page-subtitle">Operational overview, performance metrics, and lead management</p>
          </div>
        </div>

        <div class="topbar-actions">
          <div class="control" title="Search by name, number, enquiry, assign, status">
            <span class="muted" style="font-weight:900;">Search</span>
            <input id="searchInput" type="text" placeholder="Type to filter..." oninput="applyFilters()" />
          </div>

		  <div class="control" style="min-width: 220px;" title="Filter by year">
			  <span class="muted" style="font-weight:900;">Year</span>
		  <select onchange="location.href='?year=' + this.value">
  <% for(let y = new Date().getFullYear(); y >= 2020; y--){ %>
    <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
  <% } %>
</select>
</div>

          <div class="control" style="min-width: 220px;" title="Filter by status">
            <span class="muted" style="font-weight:900;">Status</span>
            <select id="statusFilter" onchange="applyFilters()">
              <option value="">All</option>
              <option value="in_progress">In Progress</option>
              <option value="assign">Assign</option>
              <option value="completed">Completed</option>
              <option value="hold">Hold</option>
              <option value="pending">Pending</option>
              <option value="client_review">Client Review</option>
              <option value="in_changes">In Changes</option>
            </select>
          </div>

          <button type="button" onclick="mergeData('btech_project')" class="btn-pro btn-primary-pro">Merge Duplicate Data</button>
          <button type="button" onclick="exportConvertedLeadsCSV('converted-leads.csv')" class="btn-pro">Download CSV</button>
        </div>
      </div>
    </div>

    <div id="loader-overlay"><div id="loader"></div></div>

    <!-- KPI Cards -->
    <div class="kpi-grid" id="kpiGrid">
      <!-- Filled by JS -->
    </div>

    <!-- Table -->
    <div class="table-shell">
      <div class="table-head">
        <h4><%= (month || '').toUpperCase() %> Leads</h4>
        <div class="muted" id="tableMeta" style="font-weight:800;">Showing 0 of 0</div>
      </div>

      <div class="table-wrap">
        <table id="leadsTable" class="pro-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Lead Status</th>
              <th>Name</th>
              <th>Number</th>
              <th>Enquiry</th>
              <th>Deadline</th>
              <th>Assign</th>
              <th>Agent Price</th>
              <th>Lead Price</th>
              <th>PKR Price</th>
              <th>Advance</th>
              <th>Project Done</th>
              <th>Payment Received</th>
              <th>Agent Payment</th>
              <th>Remarks</th>
              <th>Update Status</th>
            </tr>
          </thead>

          <tbody id="tableBody">
            <% for(let i = 0; i < result.length; i++){ %>
              <tr
                data-status="<%= result[i].status %>"
                data-name="<%= (result[i].name || '').toLowerCase() %>"
                data-number="<%= (result[i].number || '').toLowerCase() %>"
                data-enquiry="<%= (result[i].enquiry || '').toLowerCase() %>"
                data-assign="<%= (result[i].assign || '').toLowerCase() %>"
                data-created-at="<%= result[i].created_at ? (function(d){ try { return new Date(d).toISOString().slice(0,19).replace('T',' '); } catch(e){ return String(d).slice(0,19); } })(result[i].created_at) : '' %>"
              >
                <td><span class="pill primary"><%= i+1 %></span></td>

                <td>
                  <span class="status-badge st-<%= result[i].status %>">
                    <span class="dot"></span>
                    <span><%= result[i].status_label?.text || result[i].status || '-' %></span>
                  </span>
                </td>

                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'name', this.innerText)"><%= result[i].name %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'number', this.innerText)"><%= result[i].number %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'enquiry', this.innerText)"><%= result[i].enquiry %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'deadline', this.innerText)"><%= result[i].deadline %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'assign', this.innerText)"><%= result[i].assign %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'agent_price', this.innerText)"><%= result[i].agent_price %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'lead_price', this.innerText)"><%= result[i].lead_price %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'pakistani_price', this.innerText)"><%= result[i].pakistani_price %></td>
                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'advance_amount', this.innerText)"><%= result[i].advance_amount %></td>

                <td>
                  <label class="switch">
                    <input type="checkbox" onclick="toggleProjectStatus('<%= result[i].id %>', this.checked)" <%= result[i].is_project_done == 1 ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </td>

                <td>
                  <label class="switch">
                    <input type="checkbox" onclick="togglePaymentStatus('<%= result[i].id %>', this.checked)" <%= result[i].is_payment_received == 1 ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </td>

                <td>
                  <label class="switch">
                    <input type="checkbox" onclick="toggleAgentPaymentStatus('<%= result[i].id %>', this.checked)" <%= result[i].is_agent_payment_done == 1 ? 'checked' : '' %>>
                    <span class="slider"></span>
                  </label>
                </td>

                <td class="editable" contenteditable="true" onblur="updateField('<%= result[i].id %>', 'remarks', this.innerText)"><%= result[i].remarks %></td>

                <td>
                  <select class="status-select" onchange="updateStatus('<%=result[i].id%>', this.value)">
                    <option value="in_progress" <%= result[i].status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="assign" <%= result[i].status === 'assign' ? 'selected' : '' %>>Assign</option>
                    <option value="completed" <%= result[i].status === 'completed' ? 'selected' : '' %>>Completed</option>
                    <option value="hold" <%= result[i].status === 'hold' ? 'selected' : '' %>>Hold</option>
                    <option value="pending" <%= result[i].status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="client_review" <%= result[i].status === 'client_review' ? 'selected' : '' %>>Client Review</option>
                    <option value="in_changes" <%= result[i].status === 'in_changes' ? 'selected' : '' %>>In Changes</option>
                  </select>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<% include ./footer.ejs %>

<script>
  /** CSV export: only leads table, five columns; Excel-friendly (UTF-8 BOM, quoted fields). */
  function csvEscapeCell(val) {
    const s = (val == null ? '' : String(val)).replace(/\r\n/g, ' ').replace(/\n/g, ' ').replace(/\r/g, ' ').trim();
    if (/[",]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
    return s;
  }

  function exportConvertedLeadsCSV(filename) {
    const body = document.getElementById('tableBody');
    if (!body) {
      alert('Table not found.');
      return;
    }
    const headers = ['name', 'enquiry', 'created_at', 'assign', 'agent_price'];
    const lines = [headers.join(',')];
    const rows = Array.from(body.querySelectorAll('tr'));

    rows.forEach((tr) => {
      if (tr.style.display === 'none') return;
      const tds = tr.querySelectorAll('td');
      if (tds.length < 8) return;
      const name = (tds[2] && tds[2].innerText) ? tds[2].innerText.trim() : '';
      const enquiry = (tds[4] && tds[4].innerText) ? tds[4].innerText.trim() : '';
      const createdAt = (tr.getAttribute('data-created-at') || '').trim();
      const assign = (tds[6] && tds[6].innerText) ? tds[6].innerText.trim() : '';
      const agentPrice = (tds[7] && tds[7].innerText) ? tds[7].innerText.trim() : '';
      lines.push([
        csvEscapeCell(name),
        csvEscapeCell(enquiry),
        csvEscapeCell(createdAt),
        csvEscapeCell(assign),
        csvEscapeCell(agentPrice)
      ].join(','));
    });

    const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename || 'converted-leads.csv';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(link.href);
  }

  // Loader helpers
  function showLoader() {
    const el = document.getElementById("loader-overlay");
    if (el) el.style.display = "flex";
  }
  function hideLoader() {
    const el = document.getElementById("loader-overlay");
    if (el) el.style.display = "none";
  }

  // --- Update functions (your existing API) ---
  function toggleProjectStatus(id, isChecked) {
    updateToggleStatus(id, "is_project_done", isChecked);
  }
  function togglePaymentStatus(id, isChecked) {
    updateToggleStatus(id, "is_payment_received", isChecked);
  }
  function toggleAgentPaymentStatus(id, isChecked) {
    updateToggleStatus(id, "is_agent_payment_done", isChecked);
  }

  function updateToggleStatus(id, field, isChecked) {
    const newValue = isChecked ? 1 : 0;
    showLoader();

    fetch("/freelancing/update-field", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, field, value: newValue })
    })
    .then(r => r.json())
    .then(data => {
      if (!data.success) alert("Failed to update status!");
    })
    .catch(err => console.error(err))
    .finally(() => hideLoader());
  }

  function updateStatus(id, newValue) {
    updateField(id, "status", newValue);
  }

  function updateField(id, field, value) {
    // prevent accidental huge text or line breaks
    const safeValue = (value || "").toString().replace(/\n/g, " ").trim();

    showLoader();
    fetch("/freelancing/update-field", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, field, value: safeValue })
    })
    .then(r => r.json())
    .then(data => {
      if (!data.success) alert("Failed to update field!");
    })
    .catch(err => console.error(err))
    .finally(() => hideLoader());
  }

  // --- Dashboard KPIs (computed client-side) ---
  function parseMoney(v) {
    if (v === null || v === undefined) return 0;
    const s = String(v).replace(/,/g, "").trim();
    const n = Number(s);
    return Number.isFinite(n) ? n : 0;
  }

  function formatMoney(n) {
    try {
      return n.toLocaleString("en-IN", { maximumFractionDigits: 2 });
    } catch {
      return String(n);
    }
  }

  function computeStatsFromRows(rows) {
    const stats = {
      total: 0,
      status: {
        pending: 0,
        client_review: 0,
        in_changes: 0,
        completed: 0,
        hold: 0,
        in_progress: 0,
        assign: 0
      },
      payment_received: 0,
      project_done: 0,
      agent_paid: 0,
      sums: {
        lead_price: 0,
        agent_price: 0,
        advance: 0,
        pkr: 0
      }
    };

    rows.forEach(tr => {
      stats.total++;

      const st = (tr.getAttribute("data-status") || "").trim();
      if (stats.status[st] !== undefined) stats.status[st]++;

      // columns by index in table:
      // lead_price: 8, agent_price: 7, pkr: 9, advance: 10
      const tds = tr.querySelectorAll("td");
      const agentPrice = parseMoney(tds[7]?.innerText);
      const leadPrice  = parseMoney(tds[8]?.innerText);
      const pkrPrice   = parseMoney(tds[9]?.innerText);
      const advance    = parseMoney(tds[10]?.innerText);

      stats.sums.agent_price += agentPrice;
      stats.sums.lead_price += leadPrice;
      stats.sums.pkr += pkrPrice;
      stats.sums.advance += advance;

      // toggles: project done (11), payment received (12), agent paid (13)
      const pd = tds[11]?.querySelector("input[type=checkbox]")?.checked ? 1 : 0;
      const pr = tds[12]?.querySelector("input[type=checkbox]")?.checked ? 1 : 0;
      const ap = tds[13]?.querySelector("input[type=checkbox]")?.checked ? 1 : 0;

      stats.project_done += pd;
      stats.payment_received += pr;
      stats.agent_paid += ap;
    });

    return stats;
  }

  function renderKpis(stats) {
    const profit = stats.sums.lead_price - stats.sums.agent_price;
    const wrap = document.getElementById("kpiGrid");
    if (!wrap) return;

    const items = [
      { title: "Total Leads", value: stats.total, pill: { text: "This Month", cls: "primary" }, hint: "All imported leads in this view" },
      { title: "Pending", value: stats.status.pending, pill: { text: "Action Needed", cls: "warning" }, hint: "Leads waiting to start / confirm" },
      { title: "Client Review", value: stats.status.client_review, pill: { text: "In Review", cls: "info" }, hint: "Waiting for client feedback" },
      { title: "In Changes", value: stats.status.in_changes, pill: { text: "Revision", cls: "primary" }, hint: "Work in change requests" },

      { title: "Completed", value: stats.status.completed, pill: { text: "Delivered", cls: "success" }, hint: "Completed and delivered projects" },
      { title: "Hold", value: stats.status.hold, pill: { text: "Blocked", cls: "danger" }, hint: "On hold due to pending inputs" },
      { title: "In Progress", value: stats.status.in_progress, pill: { text: "Active", cls: "info" }, hint: "Work currently active" },
      { title: "Assigned", value: stats.status.assign, pill: { text: "Allocated", cls: "primary" }, hint: "Assigned to agent / team" },

      { title: "Total Earnings", value: "₹ " + formatMoney(stats.sums.lead_price), pill: { text: "Lead Price", cls: "success" }, hint: "Sum of lead_price across visible rows" },
      { title: "Total Agent Cost", value: "₹ " + formatMoney(stats.sums.agent_price), pill: { text: "Agent Price", cls: "danger" }, hint: "Sum of agent_price across visible rows" },
      { title: "Estimated Profit", value: "₹ " + formatMoney(profit), pill: { text: "Lead - Agent", cls: profit >= 0 ? "success" : "danger" }, hint: "Calculated from visible data" },
      { title: "Advance Collected", value: "₹ " + formatMoney(stats.sums.advance), pill: { text: "Advance", cls: "info" }, hint: "Sum of advance_amount across visible rows" },

      { title: "PKR Total", value: "PKR " + formatMoney(stats.sums.pkr), pill: { text: "Pakistan", cls: "primary" }, hint: "Sum of pakistani_price across visible rows" },
      { title: "Project Done", value: stats.project_done, pill: { text: "Done", cls: "success" }, hint: "Toggle-based count" },
      { title: "Payment Received", value: stats.payment_received, pill: { text: "Received", cls: "success" }, hint: "Toggle-based count" },
      { title: "Agent Payment Done", value: stats.agent_paid, pill: { text: "Paid", cls: "info" }, hint: "Toggle-based count" },
    ];

    wrap.innerHTML = items.map(x => `
      <div class="kpi-card">
        <div class="kpi-title">
          <span>${x.title}</span>
          <span class="pill ${x.pill.cls}">${x.pill.text}</span>
        </div>
        <p class="kpi-value">${x.value}</p>
        <p class="kpi-hint">${x.hint}</p>
      </div>
    `).join("");
  }

  // --- Filters ---
  function applyFilters() {
    const search = (document.getElementById("searchInput")?.value || "").trim().toLowerCase();
    const status = (document.getElementById("statusFilter")?.value || "").trim().toLowerCase();

    const body = document.getElementById("tableBody");
    const rows = Array.from(body.querySelectorAll("tr"));

    let shown = 0;

    rows.forEach(tr => {
      const st = (tr.getAttribute("data-status") || "").toLowerCase();
      const searchable = [
        tr.getAttribute("data-name"),
        tr.getAttribute("data-number"),
        tr.getAttribute("data-enquiry"),
        tr.getAttribute("data-assign"),
        st
      ].join(" ");

      const matchesSearch = !search || searchable.includes(search);
      const matchesStatus = !status || st === status;

      const visible = matchesSearch && matchesStatus;
      tr.style.display = visible ? "" : "none";
      if (visible) shown++;
    });

    // Update meta
    const meta = document.getElementById("tableMeta");
    if (meta) meta.innerText = `Showing ${shown} of ${rows.length}`;

    // Recompute KPIs based on visible rows only
    const visibleRows = rows.filter(r => r.style.display !== "none");
    const stats = computeStatsFromRows(visibleRows);
    renderKpis(stats);
  }

  // Initial render
  document.addEventListener("DOMContentLoaded", () => {
    const body = document.getElementById("tableBody");
    const rows = Array.from(body.querySelectorAll("tr"));
    const stats = computeStatsFromRows(rows);
    renderKpis(stats);

    const meta = document.getElementById("tableMeta");
    if (meta) meta.innerText = `Showing ${rows.length} of ${rows.length}`;
  });
</script>
