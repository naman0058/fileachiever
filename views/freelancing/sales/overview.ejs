<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %> · Sales CRM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/sales/sales.css?v=5">
</head>
<body>

<%
  const rejectedTotal =
    (stageCounts['new:rejected'] || 0) +
    (stageCounts['followup:rejected'] || 0) +
    (stageCounts['interested:rejected'] || 0);

  const closedTotal =
    (stageCounts['new:closed'] || 0) +
    (stageCounts['followup:closed'] || 0) +
    (stageCounts['interested:closed'] || 0);

  const basePath = (mode === 'admin') ? '/sales/admin/overview' : '/sales/my/overview';
  const assignmentsPath = (mode === 'admin') ? '/sales/admin' : '/sales/my';
  const month = filters.selectedMonth;
%>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="crm-topbar d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
      <div>
        <div class="crm-title d-flex align-items-center gap-2">
          <i class="bi bi-speedometer2"></i>
          <span><%= pageTitle %></span>
        </div>
        <div class="crm-subtitle">
          <% if (mode === 'agent') { %>
            Welcome back, <strong><%= user.name %></strong>. Pipeline snapshot for <strong><%= month %></strong>.
          <% } else { %>
            Month-wise overview, pipeline snapshot, and follow-ups due.
          <% } %>
        </div>
      </div>

      <div class="d-flex align-items-end gap-2 flex-wrap">
        <form method="GET" action="<%= basePath %>" class="crm-field" style="min-width:180px;margin:0;">
          <label>Month</label>
          <select name="month" class="form-select" onchange="this.form.submit()">
            <% filters.monthOptions.forEach(function(m){ %>
              <option value="<%= m %>" <%= m===month ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
        </form>
        <a class="btn btn-primary btn-soft" href="<%= assignmentsPath %>?month=<%= month %>">
          <i class="bi bi-kanban"></i> Open Leads
        </a>
        <% if (mode === 'agent') { %>
          <a class="btn btn-light btn-soft-outline" href="/sales/my/report?month=<%= month %>">
            <i class="bi bi-graph-up-arrow"></i> Report
          </a>
        <% } %>
      </div>
    </div>

    <% if (mode === 'agent') { %>
    <div class="agent-quick-actions mb-3">
      <a href="/sales/my?month=<%= month %>&stage=new&status=open" class="agent-quick-card">
        <span class="agent-quick-card__ico"><i class="bi bi-star"></i></span>
        <span class="agent-quick-card__label">New Leads</span>
        <span class="agent-quick-card__val"><%= stageCounts['new:open'] || 0 %></span>
      </a>
      <a href="/sales/my?month=<%= month %>&stage=followup&status=open" class="agent-quick-card">
        <span class="agent-quick-card__ico"><i class="bi bi-telephone"></i></span>
        <span class="agent-quick-card__label">Follow-up</span>
        <span class="agent-quick-card__val"><%= stageCounts['followup:open'] || 0 %></span>
      </a>
      <a href="/sales/my?month=<%= month %>&stage=interested&status=open" class="agent-quick-card">
        <span class="agent-quick-card__ico"><i class="bi bi-fire"></i></span>
        <span class="agent-quick-card__label">Interested</span>
        <span class="agent-quick-card__val"><%= stageCounts['interested:open'] || 0 %></span>
      </a>
      <a href="/sales/my/rejected-leads?month=<%= month %>" class="agent-quick-card agent-quick-card--danger">
        <span class="agent-quick-card__ico"><i class="bi bi-x-circle"></i></span>
        <span class="agent-quick-card__label">Rejected</span>
        <span class="agent-quick-card__val"><%= kpis.rejectedTotal || rejectedTotal %></span>
      </a>
      <a href="/sales/my/sales?month=<%= month %>" class="agent-quick-card agent-quick-card--success">
        <span class="agent-quick-card__ico"><i class="bi bi-check-circle"></i></span>
        <span class="agent-quick-card__label">Converted</span>
        <span class="agent-quick-card__val"><%= kpis.totalSales || 0 %></span>
      </a>
    </div>
    <% } %>

    <div class="crm-kpis mb-3">
      <div class="crm-kpi">
        <div class="crm-kpi-label">Open Pipeline</div>
        <div class="crm-kpi-val"><%= kpis.openAssignments %></div>
      </div>
      <div class="crm-kpi">
        <div class="crm-kpi-label">Sales This Month</div>
        <div class="crm-kpi-val"><%= kpis.totalSales %></div>
      </div>
      <div class="crm-kpi">
        <div class="crm-kpi-label">Revenue</div>
        <div class="crm-kpi-val">₹<%= Number(kpis.totalRevenue || 0).toLocaleString('en-IN') %></div>
      </div>
      <div class="crm-kpi">
        <div class="crm-kpi-label"><%= mode === 'agent' ? 'Conversion Rate' : 'Closed Assignments' %></div>
        <div class="crm-kpi-val"><%= mode === 'agent' ? (kpis.conversionRate || 0) + '%' : closedTotal %></div>
      </div>
    </div>

    <div class="crm-card mb-3">
      <div class="p-3 border-bottom" style="border-color:var(--line)!important;">
        <div class="fw-bold">Pipeline Snapshot</div>
        <div class="crm-small">Counts by stage and status for <%= month %>.</div>
      </div>
      <div class="p-3">
        <div class="d-flex flex-wrap gap-2">
          <span class="agent-stat-chip">New (Open): <strong><%= stageCounts['new:open'] || 0 %></strong></span>
          <span class="agent-stat-chip">Follow-up (Open): <strong><%= stageCounts['followup:open'] || 0 %></strong></span>
          <span class="agent-stat-chip">Interested (Open): <strong><%= stageCounts['interested:open'] || 0 %></strong></span>
          <span class="agent-stat-chip agent-stat-chip--danger">Rejected: <strong><%= rejectedTotal %></strong></span>
          <span class="agent-stat-chip agent-stat-chip--success">Closed: <strong><%= closedTotal %></strong></span>
        </div>
      </div>
    </div>

    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color:var(--line)!important;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <div class="fw-bold">Follow-ups Due Today</div>
            <div class="crm-small">Leads needing action based on your last call log.</div>
          </div>
          <% if (due.length) { %>
            <span class="agent-badge agent-badge--warn"><%= due.length %> due</span>
          <% } %>
        </div>
      </div>

      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <% if (mode==='admin') { %><th>Agent</th><% } %>
              <th>Lead</th>
              <th>Phone</th>
              <th>Enquiry</th>
              <th>Due Date</th>
              <th>Last Note</th>
              <% if (mode==='agent') { %><th></th><% } %>
            </tr>
          </thead>
          <tbody>
            <% if (!due.length) { %>
              <tr><td colspan="<%= mode==='admin' ? 6 : 7 %>" class="crm-small p-4 text-center">No follow-ups due for this month. Great job!</td></tr>
            <% } %>
            <% due.forEach(function(r){ %>
              <tr>
                <% if (mode==='admin') { %>
                  <td class="fw-semibold"><%= r.user_name %></td>
                <% } %>
                <td>
                  <div class="crm-lead-name"><%= r.name || 'Unnamed' %></div>
                  <div class="crm-small">#<%= r.lead_id %></div>
                </td>
                <td>
                  <% if (r.phone) { %>
                    <span class="crm-linktext" onclick="copyText('<%= r.phone %>')"><%= r.phone %></span>
                  <% } else { %>—<% } %>
                </td>
                <td><div class="crm-clamp2" style="max-width:280px;"><%= r.enquiry_title || '-' %></div></td>
                <td class="fw-bold text-danger"><%= r.next_followup_date %></td>
                <td><div class="crm-clamp2" style="max-width:240px;"><%= r.note || '-' %></div></td>
                <% if (mode==='agent' && r.assignment_id) { %>
                  <td class="text-end">
                    <a class="btn btn-sm btn-primary btn-soft" href="/sales/my?month=<%= month %>">View</a>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>
  window.copyText = async function(text){
    try { await navigator.clipboard.writeText(text || ''); }
    catch(e) {
      const ta = document.createElement('textarea');
      ta.value = text || '';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
  };
</script>
</body>
</html>
