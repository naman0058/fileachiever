<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle }) %></head>
<body class="agent-crm admin-crm">
<%
  function buildUrl(params){
    const url = new URL('http://x/sales/logs');
    Object.entries(params).forEach(([k,v]) => {
      if (v === undefined || v === null || v === '') url.searchParams.delete(k);
      else url.searchParams.set(k, String(v));
    });
    return url.pathname + url.search;
  }
  const stageLabel = { new:'New Inquiry', followup:'In Follow-up', interested:'High Intent' };
%>
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Team Activity Logs</h1>
        <p>Every follow-up note and callback across the team — filter by agent, month, or search leads for <strong><%= filters.selectedMonth %></strong>.</p>
      </div>
      <form method="GET" action="/sales/logs" class="agent-page-header__actions flex-wrap">
        <select name="month" class="agent-month-select">
          <% filters.monthOptions.forEach(function(mm){ %>
            <option value="<%= mm %>" <%= mm===filters.selectedMonth?'selected':'' %>><%= mm %></option>
          <% }) %>
        </select>
        <select name="agent" class="agent-month-select" style="min-width:150px;">
          <option value="">All Agents</option>
          <% (agents||[]).forEach(function(a){ %>
            <option value="<%= a.id %>" <%= Number(filters.agent)===Number(a.id)?'selected':'' %>><%= a.name %></option>
          <% }) %>
        </select>
        <input class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Name / phone / note…" style="max-width:220px;border-radius:12px;"/>
        <button class="agent-btn agent-btn--primary" type="submit"><i class="bi bi-search"></i></button>
      </form>
    </header>

    <div class="agent-metric mb-3" style="--metric-accent:#6366f1;--metric-bg:#eef2ff;max-width:260px;padding:16px 20px;">
      <div class="agent-metric__label">Log Entries</div>
      <div class="agent-metric__value"><%= (rows||[]).length %></div>
    </div>

    <div class="agent-table-card">
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Agent</th>
              <th>Lead</th>
              <th>Stage</th>
              <th>Next Follow-up</th>
              <th>Note</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows || !rows.length) { %>
              <tr><td colspan="7" class="agent-empty"><i class="bi bi-chat-square-text"></i>No activity logs for this filter.</td></tr>
            <% } %>
            <% (rows||[]).forEach(function(r){ %>
              <tr>
                <td class="crm-small"><%= r.log_created_at ? new Date(r.log_created_at).toLocaleString() : '—' %></td>
                <td><strong><%= r.user_name %></strong></td>
                <td>
                  <div class="crm-lead-name"><%= r.lead_name || 'Unnamed' %> <span class="crm-chip">#<%= r.tempid %></span></div>
                  <div class="crm-small"><%= r.phone || '—' %> · <%= (r.enquiry_title || '—').slice(0,50) %></div>
                </td>
                <td>
                  <span class="agent-badge agent-badge--muted"><%= stageLabel[r.assignment_stage] || r.assignment_stage || '—' %></span>
                  <% if (r.assignment_status && r.assignment_status !== 'open') { %>
                    <div class="crm-small text-danger"><%= r.assignment_status %></div>
                  <% } %>
                </td>
                <td><% if (r.next_followup_date) { %><span class="agent-tag agent-tag--due"><%= r.next_followup_date %></span><% } else { %>—<% } %></td>
                <td>
                  <div class="crm-clamp2"><%= r.note || '—' %></div>
                  <% if (r.day_label) { %><div class="crm-small"><%= r.day_label %></div><% } %>
                </td>
                <td class="text-end">
                  <a class="agent-btn agent-btn--ghost agent-btn--sm" href="/sales/admin?month=<%= encodeURIComponent(filters.selectedMonth) %>&q=<%= encodeURIComponent(r.tempid || '') %>">Open Lead</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
