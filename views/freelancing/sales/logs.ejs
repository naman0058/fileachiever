<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Your CRM theme -->
  <link rel="stylesheet" href="/sales/sales.css?v=4">
</head>

<body>
<%
  function buildUrl(params){
    const url = new URL('http://x/sales/logs');
    Object.entries(params).forEach(([k,v]) => {
      if (v === undefined || v === null || v === '') url.searchParams.delete(k);
      else url.searchParams.set(k, String(v));
    });
    return url.pathname + url.search;
  }
%>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="topbar">
      <div>
        <div class="topTitle"><%= pageTitle %></div>
        <div class="topSub">All call logs across team (month-wise). Filter by agent and search by lead/notes.</div>
      </div>

      <div class="d-flex gap-2 flex-wrap align-items-center">
        <!-- Month -->
        <div class="field">
          <label>Month</label>
          <select onchange="location.href=this.value">
            <% filters.monthOptions.forEach(function(mm){ %>
              <option value="<%= buildUrl({ month:mm, agent:filters.agent, q:filters.q }) %>" <%= mm===filters.selectedMonth?'selected':'' %>><%= mm %></option>
            <% }) %>
          </select>
        </div>

        <!-- Agent -->
        <div class="field">
          <label>Agent</label>
          <select onchange="location.href=this.value">
            <option value="<%= buildUrl({ agent:'', month:filters.selectedMonth, q:filters.q }) %>" <%= !filters.agent?'selected':'' %>>All</option>
            <% (agents||[]).forEach(function(a){ %>
              <option value="<%= buildUrl({ agent:a.id, month:filters.selectedMonth, q:filters.q }) %>" <%= Number(filters.agent)===Number(a.id)?'selected':'' %>><%= a.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Search -->
        <div class="field grow">
          <label>Search</label>
          <form method="GET" action="/sales/logs" class="searchRow">
            <input type="hidden" name="month" value="<%= filters.selectedMonth %>"/>
            <input type="hidden" name="agent" value="<%= filters.agent || '' %>"/>
            <input name="q" value="<%= filters.q || '' %>" placeholder="Name / phone / enquiry / tempid / note"/>
            <button class="btn">Go</button>
          </form>
        </div>
      </div>
    </div>

    <section class="crm-card">
      <div class="tableWrap">
        <table class="table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Agent</th>
              <th>Lead</th>
              <th>Stage</th>
              <th>Next Follow-up</th>
              <th>Note</th>
              <th class="right">Quick Jump</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows || !rows.length) { %>
              <tr><td colspan="7" class="muted" style="padding:18px;">No logs found for this filter.</td></tr>
            <% } %>

            <% (rows||[]).forEach(function(r){ %>
              <tr>
                <td class="mutedSmall"><%= r.log_created_at ? new Date(r.log_created_at).toLocaleString() : '' %></td>
                <td><%= r.user_name %></td>

                <td>
                  <div class="leadCell">
                    <div class="leadName">
                      <%= r.lead_name || 'Unnamed' %>
                      <span class="chip">#<%= r.tempid %></span>
                    </div>
                    <div class="leadMeta">
                      <span class="mutedSmall"><%= r.phone || '-' %></span>
                      <span class="dotSep">•</span>
                      <span class="mutedSmall"><%= (r.enquiry_title || '-').slice(0,60) %></span>
                    </div>
                  </div>
                </td>

                <td>
                  <span class="chip"><%= r.assignment_stage || '-' %></span>
                  <% if (r.assignment_status && r.assignment_status !== 'open') { %>
                    <div class="mutedSmall">Status: <%= r.assignment_status %></div>
                  <% } %>
                </td>

                <td>
                  <% if (r.next_followup_date) { %>
                    <div class="fw"><%= r.next_followup_date %></div>
                  <% } else { %>
                    <div class="mutedSmall">—</div>
                  <% } %>
                </td>

                <td>
                  <div class="clamp2"><%= r.note || '-' %></div>
                  <div class="mutedSmall"><%= r.day_label || '' %></div>
                </td>

                <td class="right">
                  <!-- Jump to assignments page with search tempid -->
                  <a class="btn ghost" href="/sales/admin?month=<%= encodeURIComponent(filters.selectedMonth) %>&q=<%= encodeURIComponent(r.tempid || '') %>">Open</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

  </main>
</div>
</body>
</html>
