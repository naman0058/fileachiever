<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/sales/sales.css?v=4">
</head>
<body>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="topbar">
      <div>
        <div class="topTitle"><%= pageTitle %></div>
        <div class="topSub">Your assigned setup support requests. Contact customers and update status when done.</div>
      </div>
    </div>

    <div class="crm-card mb-3">
      <div class="p-3 d-flex flex-wrap gap-3 align-items-center">
        <a class="btn btn-sm <%= filters.tab === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>" href="/sales/setup-support">All</a>
        <a class="btn btn-sm <%= filters.tab === 'pending' ? 'btn-warning' : 'btn-outline-secondary' %>" href="/sales/setup-support?tab=pending">
          Pending (<%= pendingCount %>)
        </a>
        <a class="btn btn-sm <%= filters.tab === 'done' ? 'btn-success' : 'btn-outline-secondary' %>" href="/sales/setup-support?tab=done">
          Completed (<%= doneCount %>)
        </a>
      </div>
    </div>

    <% if (unassigned && unassigned.length) { %>
    <div class="crm-card mb-3">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="fw-bold">Available to Claim (unassigned)</div>
        <div class="mutedSmall">Click "Claim" to assign yourself and work on these requests.</div>
      </div>
      <div class="p-3">
        <div class="table-responsive">
          <table class="table align-middle mb-0 table-sm">
            <thead>
              <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Number</th>
                <th>Enquiry</th>
                <th>Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% unassigned.forEach(function(r){ %>
                <tr>
                  <td>#<%= r.id %></td>
                  <td><%= r.customer_name %></td>
                  <td><a href="tel:<%= r.customer_number %>"><%= r.customer_number %></a></td>
                  <td class="clamp2" style="max-width:200px;"><%= (r.enquiry || '').slice(0, 80) %></td>
                  <td class="mutedSmall"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %></td>
                  <td><button type="button" class="btn btn-sm btn-primary claim-btn" data-id="<%= r.id %>">Claim</button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% } %>

    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="fw-bold">My Setup Support Requests</div>
        <div class="mutedSmall">Total: <%= rows.length %></div>
      </div>

      <div class="p-3">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width:60px;">ID</th>
                <th>Customer</th>
                <th>Number</th>
                <th style="min-width:200px;">Enquiry</th>
                <th>Status</th>
                <th style="min-width:180px;">Notes</th>
                <th>Created</th>
                <th style="width:220px;">Actions</th>
              </tr>
            </thead>
            <tbody>
                <% if (!rows.length) { %>
                <tr><td colspan="8" class="py-4 mutedSmall">No setup support requests assigned to you.</td></tr>
                <% } %>
              <% rows.forEach(function(r){ %>
                <tr>
                  <td class="fw-semibold">#<%= r.id %></td>
                  <td><%= r.customer_name || '-' %></td>
                  <td>
                    <% if (r.customer_number) { %>
                      <a href="tel:<%= r.customer_number %>"><%= r.customer_number %></a>
                      <a href="https://wa.me/<%= r.customer_number.replace(/\D/g,'') %>" target="_blank" class="ms-1" title="WhatsApp">📱</a>
                    <% } else { %>-<% } %>
                  </td>
                  <td class="clamp2" style="max-width:280px;"><%= (r.enquiry || '-').slice(0, 120) %></td>
                  <td>
                    <span class="badge rounded-pill px-2 py-1
                      <%= r.status === 'done' ? 'bg-success' : r.status === 'in_progress' ? 'bg-warning text-dark' : r.status === 'cancelled' ? 'bg-secondary' : 'bg-primary' %>">
                      <%= r.status || 'pending' %>
                    </span>
                  </td>
                  <td class="mutedSmall" style="max-width:200px;" title="<%= (r.notes || '').replace(/"/g,'&quot;') %>"><%= (r.notes || '-').slice(0, 80) %><%= (r.notes && r.notes.length > 80) ? '…' : '' %></td>
                  <td class="mutedSmall"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %></td>
                  <td>
                    <% if (r.status !== 'done' && r.status !== 'cancelled') { %>
                      <div class="d-flex gap-1 flex-wrap">
                        <select class="form-select form-select-sm status-select" style="width:120px;" data-id="<%= r.id %>">
                          <option value="pending" <%= r.status === 'pending' ? 'selected' : '' %>>Pending</option>
                          <option value="in_progress" <%= r.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                          <option value="done" <%= r.status === 'done' ? 'selected' : '' %>>Done</option>
                          <option value="cancelled">Cancelled</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-secondary notes-btn" data-id="<%= r.id %>" data-notes="<%= (r.notes || '').replace(/"/g,'&quot;') %>">Notes</button>
                      </div>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
document.querySelectorAll('.status-select').forEach(function(sel){
  sel.addEventListener('change', async function(){
    const id = this.dataset.id;
    const status = this.value;
    const res = await fetch('/sales/api/setup-support/' + id + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'status=' + encodeURIComponent(status)
    });
    const j = await res.json();
    if (j.ok) { window.location.reload(); } else { alert(j.message || 'Failed'); }
  });
});

document.querySelectorAll('.claim-btn').forEach(function(btn){
  btn.addEventListener('click', async function(){
    const id = this.dataset.id;
    const res = await fetch('/sales/api/setup-support/' + id + '/claim', { method: 'POST' });
    const j = await res.json();
    if (j.ok) { window.location.reload(); } else { alert(j.message || 'Failed'); }
  });
});

document.querySelectorAll('.notes-btn').forEach(function(btn){
  btn.addEventListener('click', async function(){
    const id = this.dataset.id;
    const current = this.dataset.notes || '';
    const notes = prompt('Notes (support details, contact summary, etc.):', current);
    if (notes === null) return;
    const res = await fetch('/sales/api/setup-support/' + id + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'status=' + encodeURIComponent(document.querySelector('.status-select[data-id="'+id+'"]')?.value || 'in_progress') + '&notes=' + encodeURIComponent(notes)
    });
    const j = await res.json();
    if (j.ok) { window.location.reload(); } else { alert(j.message || 'Failed'); }
  });
});
</script>

</body>
</html>
