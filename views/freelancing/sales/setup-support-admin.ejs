<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'Setup Support' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Setup Support</h1>
        <p>Checkout + manual sales — assign team members, track status, and clear aging tickets at scale.</p>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a class="agent-btn agent-btn--ghost agent-btn--sm" href="/sales/admin/setup-support/performance">
          <i class="bi bi-graph-up"></i> Performance
        </a>
        <form method="POST" action="/sales/admin/setup-support/backfill" onsubmit="return confirm('Create missing tickets from paid support orders?');">
          <button type="submit" class="agent-btn agent-btn--ghost agent-btn--sm">
            <i class="bi bi-arrow-repeat"></i> Backfill paid orders
          </button>
        </form>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'setupSupport', activeTab: 'overview' }) %>

    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="alert alert-success py-2"><%= msg %></div>
    <% } %>
    <% if (typeof err !== 'undefined' && err) { %>
      <div class="alert alert-danger py-2"><%= err %></div>
    <% } %>

    <div class="agent-metrics mb-3" style="grid-template-columns:repeat(5,1fr);max-width:1100px;">
      <div class="agent-metric" style="--metric-accent:#6366f1;--metric-bg:#eef2ff;">
        <div class="agent-metric__label">Total</div>
        <div class="agent-metric__value"><%= totalCount %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#f59e0b;--metric-bg:#fffbeb;">
        <div class="agent-metric__label">Pending / In Progress</div>
        <div class="agent-metric__value"><%= pendingCount %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#ef4444;--metric-bg:#fef2f2;">
        <div class="agent-metric__label">Unassigned</div>
        <div class="agent-metric__value"><%= unassignedCount %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#2A47FF;--metric-bg:#eef2ff;">
        <div class="agent-metric__label">Checkout open</div>
        <div class="agent-metric__value"><%= checkoutOpen %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#16a34a;--metric-bg:#f0fdf4;">
        <div class="agent-metric__label">Completed</div>
        <div class="agent-metric__value"><%= doneCount %></div>
      </div>
    </div>

    <div class="admin-filter-bar">
      <a class="admin-filter-pill <%= filters.tab === 'all' ? 'is-active' : '' %>" href="/sales/admin/setup-support?origin=<%= filters.origin || '' %>&q=<%= encodeURIComponent(filters.q || '') %>">All</a>
      <a class="admin-filter-pill <%= filters.tab === 'pending' ? 'is-active is-active--warn' : '' %>" href="/sales/admin/setup-support?tab=pending&origin=<%= filters.origin || '' %>&employee=<%= filters.employee || '' %>&q=<%= encodeURIComponent(filters.q || '') %>">
        Pending <span class="admin-filter-pill__count">(<%= pendingCount %>)</span>
      </a>
      <a class="admin-filter-pill <%= filters.tab === 'done' ? 'is-active is-active--ok' : '' %>" href="/sales/admin/setup-support?tab=done&origin=<%= filters.origin || '' %>&employee=<%= filters.employee || '' %>&q=<%= encodeURIComponent(filters.q || '') %>">
        Done <span class="admin-filter-pill__count">(<%= doneCount %>)</span>
      </a>
      <form method="GET" action="/sales/admin/setup-support" class="ms-auto d-flex gap-2 align-items-center flex-wrap">
        <input type="hidden" name="tab" value="<%= filters.tab %>">
        <input type="search" name="q" value="<%= filters.q || '' %>" class="form-control form-control-sm" placeholder="Search name, phone, order…" style="min-width:180px;">
        <select name="origin" class="agent-month-select" style="min-width:140px;" onchange="this.form.submit()">
          <option value="">All origins</option>
          <option value="checkout" <%= filters.origin === 'checkout' ? 'selected' : '' %>>Checkout</option>
          <option value="manual_lead" <%= filters.origin === 'manual_lead' ? 'selected' : '' %>>Manual sale</option>
        </select>
        <select name="employee" class="agent-month-select" style="min-width:160px;" onchange="this.form.submit()">
          <option value="">All team members</option>
          <% (employees || []).forEach(function(e){ %>
            <option value="<%= e.id %>" <%= filters.employee === e.id ? 'selected' : '' %>><%= e.name %></option>
          <% }) %>
        </select>
        <button type="submit" class="agent-btn agent-btn--ghost agent-btn--sm">Filter</button>
      </form>
    </div>

    <div class="agent-table-card">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <div><div class="fw-bold">Support Requests</div><div class="crm-small"><%= rows.length %> shown (max 500)</div></div>
      </div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Origin</th>
              <th>Order</th>
              <th>Customer</th>
              <th>Contact</th>
              <th>Product</th>
              <th>Assigned To</th>
              <th>Status</th>
              <th>Notes</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="10" class="agent-empty"><i class="bi bi-inbox"></i>No setup support requests found.</td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td><span class="crm-chip">#<%= r.id %></span></td>
                <td>
                  <% if (r.origin === 'checkout') { %>
                    <span class="crm-chip" style="background:#eef2ff;color:#3730a3;">Checkout</span>
                  <% } else { %>
                    <span class="crm-chip">Manual</span>
                  <% } %>
                </td>
                <td class="crm-small">
                  <% if (r.fm_order_id) { %>
                    <strong><%= r.fm_order_id %></strong>
                    <% if (r.order_amount != null) { %><div>₹<%= r.order_amount %></div><% } %>
                  <% } else { %>—<% } %>
                </td>
                <td>
                  <strong><%= r.customer_name || '—' %></strong>
                  <% if (r.customer_email) { %><div class="crm-small"><%= r.customer_email %></div><% } %>
                </td>
                <td>
                  <% if (r.customer_number) { %>
                    <a href="tel:<%= r.customer_number %>" class="crm-linktext"><%= r.customer_number %></a>
                    <div><a class="crm-linktext" target="_blank" rel="noopener" href="https://wa.me/91<%= String(r.customer_number).replace(/\D/g,'').slice(-10) %>">WhatsApp</a></div>
                  <% } else { %>—<% } %>
                </td>
                <td>
                  <div class="crm-clamp2" style="max-width:200px;"><%= r.product_name || r.plan_label || '—' %></div>
                  <% if (r.seo_name) { %><div class="crm-small"><%= r.seo_name %></div><% } %>
                </td>
                <td>
                  <select class="form-select admin-inline-select assign-select" data-id="<%= r.id %>">
                    <option value="">— None —</option>
                    <% (employees || []).forEach(function(e){ %>
                      <option value="<%= e.id %>" <%= r.assigned_to == e.id ? 'selected' : '' %>><%= e.name %></option>
                    <% }) %>
                  </select>
                </td>
                <td>
                  <select class="form-select admin-inline-select admin-status-select" data-id="<%= r.id %>">
                    <option value="pending" <%= (r.status || 'pending') === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="in_progress" <%= r.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="done" <%= r.status === 'done' ? 'selected' : '' %>>Done</option>
                    <option value="cancelled" <%= r.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                </td>
                <td>
                  <% if (r.notes && r.notes.trim()) { %>
                    <button type="button" class="agent-btn agent-btn--ghost agent-btn--sm view-notes-btn"
                      data-notes="<%= (r.notes || '').replace(/"/g,'&quot;').replace(/\n/g,'&#10;') %>"
                      data-customer="<%= (r.customer_name || '').replace(/"/g,'&quot;') %>">
                      <i class="bi bi-chat-left-text"></i> View
                    </button>
                  <% } else { %><span class="crm-small">—</span><% } %>
                </td>
                <td class="crm-small"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<div class="modal fade" id="notesModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:16px;border:none;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="notesModalTitle">Notes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body pt-2">
        <pre id="notesModalBody" class="mb-0 p-3 rounded" style="white-space:pre-wrap;background:#f8fafc;border:1px solid #e2e8f0;max-height:400px;overflow-y:auto;font-size:13px;"></pre>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('.assign-select').forEach(function(sel){
  sel.addEventListener('change', async function(){
    const res = await fetch('/sales/api/admin/setup-support/' + this.dataset.id + '/assign', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'assigned_to=' + encodeURIComponent(this.value || '')
    });
    const j = await res.json();
    if (j.ok) { this.classList.add('is-saved'); setTimeout(() => this.classList.remove('is-saved'), 1500); }
    else alert(j.message || 'Failed');
  });
});
document.querySelectorAll('.admin-status-select').forEach(function(sel){
  sel.addEventListener('change', async function(){
    const res = await fetch('/sales/api/admin/setup-support/' + this.dataset.id + '/status', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'status=' + encodeURIComponent(this.value)
    });
    const j = await res.json();
    if (j.ok) window.location.reload(); else alert(j.message || 'Failed');
  });
});
document.querySelectorAll('.view-notes-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.getElementById('notesModalTitle').textContent = 'Notes — ' + (this.dataset.customer || 'Request');
    document.getElementById('notesModalBody').textContent = this.dataset.notes || '(No notes)';
    new bootstrap.Modal(document.getElementById('notesModal')).show();
  });
});
</script>
</body>
</html>
