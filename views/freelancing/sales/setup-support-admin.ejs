<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'Setup Support' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Setup Support</h1>
        <p>Manage customer setup requests — assign to team members, track status, and review completion notes.</p>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'setupSupport', activeTab: 'overview' }) %>

    <div class="agent-metrics mb-3" style="grid-template-columns:repeat(3,1fr);max-width:720px;">
      <div class="agent-metric" style="--metric-accent:#6366f1;--metric-bg:#eef2ff;">
        <div class="agent-metric__label">Total Requests</div>
        <div class="agent-metric__value"><%= rows.length %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#f59e0b;--metric-bg:#fffbeb;">
        <div class="agent-metric__label">Pending / In Progress</div>
        <div class="agent-metric__value"><%= pendingCount %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#16a34a;--metric-bg:#f0fdf4;">
        <div class="agent-metric__label">Completed</div>
        <div class="agent-metric__value"><%= doneCount %></div>
      </div>
    </div>

    <div class="admin-filter-bar">
      <a class="admin-filter-pill <%= filters.tab === 'all' ? 'is-active' : '' %>" href="/sales/admin/setup-support">All</a>
      <a class="admin-filter-pill <%= filters.tab === 'pending' ? 'is-active is-active--warn' : '' %>" href="/sales/admin/setup-support?tab=pending">
        Pending <span class="admin-filter-pill__count">(<%= pendingCount %>)</span>
      </a>
      <a class="admin-filter-pill <%= filters.tab === 'done' ? 'is-active is-active--ok' : '' %>" href="/sales/admin/setup-support?tab=done">
        Done <span class="admin-filter-pill__count">(<%= doneCount %>)</span>
      </a>
      <form method="GET" action="/sales/admin/setup-support" class="ms-auto d-flex gap-2 align-items-center">
        <input type="hidden" name="tab" value="<%= filters.tab %>">
        <select name="employee" class="agent-month-select" style="min-width:160px;" onchange="this.form.submit()">
          <option value="">All team members</option>
          <% (employees || []).forEach(function(e){ %>
            <option value="<%= e.id %>" <%= filters.employee === e.id ? 'selected' : '' %>><%= e.name %></option>
          <% }) %>
        </select>
      </form>
    </div>

    <div class="agent-table-card">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <div><div class="fw-bold">Support Requests</div><div class="crm-small"><%= rows.length %> records</div></div>
      </div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>ID</th><th>Customer</th><th>Contact</th><th>Enquiry</th>
              <th>Assigned To</th><th>Status</th><th>Notes</th><th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="8" class="agent-empty"><i class="bi bi-inbox"></i>No setup support requests found.</td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td><span class="crm-chip">#<%= r.id %></span></td>
                <td><strong><%= r.customer_name || '—' %></strong></td>
                <td><% if (r.customer_number) { %><a href="tel:<%= r.customer_number %>" class="crm-linktext"><%= r.customer_number %></a><% } else { %>—<% } %></td>
                <td><div class="crm-clamp2" style="max-width:240px;"><%= r.enquiry || '—' %></div></td>
                <td>
                  <select class="form-select admin-inline-select assign-select" data-id="<%= r.id %>">
                    <option value="">— None —</option>
                    <% (employees || []).forEach(function(e){ %>
                      <option value="<%= e.id %>" <%= r.assigned_to == e.id ? 'selected' : '' %>><%= e.name %></option>
                    <% }) %>
                  </select>
                </td>
                <td>
                  <select class="form-select admin-inline-select admin-status-select" data-id="<%= r.id %>">
                    <option value="pending" <%= (r.status || 'pending') === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="in_progress" <%= r.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                    <option value="done" <%= r.status === 'done' ? 'selected' : '' %>>Done</option>
                    <option value="cancelled" <%= r.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                </td>
                <td>
                  <% if (r.notes && r.notes.trim()) { %>
                    <button type="button" class="agent-btn agent-btn--ghost agent-btn--sm view-notes-btn"
                      data-notes="<%= (r.notes || '').replace(/"/g,'&quot;').replace(/\n/g,'&#10;') %>"
                      data-customer="<%= (r.customer_name || '').replace(/"/g,'&quot;') %>">
                      <i class="bi bi-chat-left-text"></i> View
                    </button>
                  <% } else { %><span class="crm-small">—</span><% } %>
                </td>
                <td class="crm-small"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<div class="modal fade" id="notesModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:16px;border:none;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="notesModalTitle">Notes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body pt-2">
        <pre id="notesModalBody" class="mb-0 p-3 rounded" style="white-space:pre-wrap;background:#f8fafc;border:1px solid #e2e8f0;max-height:400px;overflow-y:auto;font-size:13px;"></pre>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('.assign-select').forEach(function(sel){
  sel.addEventListener('change', async function(){
    const res = await fetch('/sales/api/admin/setup-support/' + this.dataset.id + '/assign', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'assigned_to=' + encodeURIComponent(this.value || '')
    });
    const j = await res.json();
    if (j.ok) { this.classList.add('is-saved'); setTimeout(() => this.classList.remove('is-saved'), 1500); }
    else alert(j.message || 'Failed');
  });
});
document.querySelectorAll('.admin-status-select').forEach(function(sel){
  sel.addEventListener('change', async function(){
    const res = await fetch('/sales/api/admin/setup-support/' + this.dataset.id + '/status', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'status=' + encodeURIComponent(this.value)
    });
    const j = await res.json();
    if (j.ok) window.location.reload(); else alert(j.message || 'Failed');
  });
});
document.querySelectorAll('.view-notes-btn').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.getElementById('notesModalTitle').textContent = 'Notes — ' + (this.dataset.customer || 'Request');
    document.getElementById('notesModalBody').textContent = this.dataset.notes || '(No notes)';
    new bootstrap.Modal(document.getElementById('notesModal')).show();
  });
});
</script>
</body>
</html>
