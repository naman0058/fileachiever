<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %> · Sales CRM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/sales/sales.css?v=5">
</head>
<body>

<%
  const basePath = (mode === 'admin') ? '/sales/admin/sales' : '/sales/my/sales';
  const month = filters.selectedMonth;
  const t = totals || {};
%>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="crm-topbar d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
      <div>
        <div class="crm-title d-flex align-items-center gap-2">
          <i class="bi bi-receipt"></i>
          <span><%= pageTitle %></span>
        </div>
        <div class="crm-subtitle">
          <% if (mode === 'agent') { %>
            Your converted sales for <strong><%= month %></strong> — track revenue and delivery status.
          <% } else { %>
            Month filter and search across all sales records.
          <% } %>
        </div>
      </div>

      <form method="GET" action="<%= basePath %>" class="d-flex align-items-end gap-2 flex-wrap">
        <div class="crm-field" style="min-width:160px;margin:0;">
          <label>Month</label>
          <select name="month" class="form-select" onchange="this.form.submit()">
            <% filters.monthOptions.forEach(function(m){ %>
              <option value="<%= m %>" <%= m===month ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
        </div>
        <div class="crm-field" style="min-width:220px;margin:0;">
          <label>Search</label>
          <input class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Name / phone / enquiry"/>
        </div>
        <button class="btn btn-primary btn-soft" type="submit"><i class="bi bi-search"></i> Search</button>
        <% if (mode === 'admin') { %>
          <a class="btn btn-outline-primary btn-soft" href="/sales/admin/new-sale">Direct Sale Entry</a>
        <% } else { %>
          <a class="btn btn-light btn-soft-outline" href="/sales/my/report?month=<%= month %>">
            <i class="bi bi-graph-up-arrow"></i> Full Report
          </a>
        <% } %>
      </form>
    </div>

    <% if (mode === 'agent' && t.total_sales != null) { %>
    <div class="crm-kpis mb-3">
      <div class="crm-kpi">
        <div class="crm-kpi-label">Total Sales</div>
        <div class="crm-kpi-val"><%= t.total_sales || 0 %></div>
      </div>
      <div class="crm-kpi">
        <div class="crm-kpi-label">Revenue</div>
        <div class="crm-kpi-val">₹<%= Number(t.total_revenue || 0).toLocaleString('en-IN') %></div>
      </div>
      <div class="crm-kpi">
        <div class="crm-kpi-label">Advance</div>
        <div class="crm-kpi-val">₹<%= Number(t.total_advance || 0).toLocaleString('en-IN') %></div>
      </div>
      <div class="crm-kpi">
        <div class="crm-kpi-label">Agent Price</div>
        <div class="crm-kpi-val">₹<%= Number(t.total_agent_price || 0).toLocaleString('en-IN') %></div>
      </div>
    </div>
    <% } %>

    <div class="crm-card">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color:var(--line)!important;">
        <div>
          <div class="fw-bold">Sales Records</div>
          <div class="crm-small"><%= rows.length %> record(s) · <%= month %></div>
        </div>
        <% if (mode === 'agent') { %>
          <a href="/sales/my" class="btn btn-sm btn-light btn-soft-outline"><i class="bi bi-kanban"></i> Work on Leads</a>
        <% } %>
      </div>

      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Client</th>
              <th>Enquiry</th>
              <th class="text-end">Lead Price</th>
              <% if (mode === 'agent') { %><th class="text-end">Advance</th><% } %>
              <th>Status</th>
              <% if (mode === 'admin') { %><th>Sales Person</th><% } %>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="<%= mode==='admin' ? 7 : 7 %>" class="crm-small p-4 text-center">
                No sales found. Convert leads from <a href="/sales/my">My Leads</a> to see them here.
              </td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td><span class="crm-chip">#<%= r.id %></span></td>
                <td>
                  <div class="crm-lead-name"><%= r.name || '-' %></div>
                  <% if (r.number) { %>
                    <span class="crm-linktext crm-small" onclick="copyText('<%= r.number %>')"><%= r.number %></span>
                  <% } %>
                </td>
                <td><div class="crm-clamp2" style="max-width:320px;"><%= r.enquiry || '-' %></div></td>
                <td class="text-end fw-bold">₹<%= Number(r.lead_price || 0).toLocaleString('en-IN') %></td>
                <% if (mode === 'agent') { %>
                  <td class="text-end">₹<%= Number(r.advance_amount || 0).toLocaleString('en-IN') %></td>
                <% } %>
                <td>
                  <span class="agent-badge <%= (r.status||'').toLowerCase()==='closed' ? 'agent-badge--success' : 'agent-badge--muted' %>">
                    <%= r.status || '-' %>
                  </span>
                </td>
                <% if (mode === 'admin') { %>
                  <td><%= r.sales_person_assign || '-' %></td>
                <% } %>
                <td class="crm-small"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<script>
  window.copyText = async function(text){
    try { await navigator.clipboard.writeText(text || ''); }
    catch(e) {
      const ta = document.createElement('textarea');
      ta.value = text || '';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
  };
</script>
</body>
</html>
