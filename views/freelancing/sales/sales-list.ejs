<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>

  <!-- Bootstrap first -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Your CRM UI last -->
  <link rel="stylesheet" href="/sales/sales.css?v=4">
</head>
<body>

<%
  const basePath = (mode === 'admin') ? '/sales/admin/sales' : '/sales/my/sales';
%>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <!-- Topbar -->
    <div class="topbar d-flex align-items-start justify-content-between gap-3 flex-wrap">
      <div>
        <div class="h1 mb-1"><%= pageTitle %></div>
        <div class="mutedSmall">Month filter and search across sales records.</div>
      </div>

      <form method="GET" action="<%= basePath %>" class="d-flex align-items-end gap-2 flex-wrap">
        <div class="field" style="min-width:180px;">
          <label>Month</label>
          <select name="month" onchange="this.form.submit()">
            <% filters.monthOptions.forEach(function(m){ %>
              <option value="<%= m %>" <%= m===filters.selectedMonth ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
        </div>

        <div class="field" style="min-width:260px;">
          <label>Search</label>
          <input name="q" value="<%= filters.q || '' %>" placeholder="name / phone / enquiry / assign"/>
        </div>

        <button class="btn btn-primary" type="submit">Search</button>

        <% if (mode === 'admin') { %>
          <a class="btn btn-outline-primary" href="/sales/admin/new-sale">Direct Sale Entry</a>
        <% } %>
      </form>
    </div>

    <!-- Sales Table Card -->
    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
          <div>
            <div class="fw-bold">Sales Records</div>
            <div class="mutedSmall">Total: <%= rows.length %></div>
          </div>
        </div>
      </div>

      <div class="p-3">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width:90px;">ID</th>
                <th>Name</th>
                <th>Number</th>
                <th style="min-width:260px;">Enquiry</th>
                <th class="text-end" style="width:140px;">Lead Price</th>
                <th style="width:140px;">Status</th>
                <th style="width:160px;">Sales Person</th>
                <th style="width:200px;">Created</th>
              </tr>
            </thead>

            <tbody>
              <% if (!rows.length) { %>
                <tr>
                  <td colspan="8" class="mutedSmall py-4">
                    No sales found for this month.
                  </td>
                </tr>
              <% } %>

              <% rows.forEach(function(r){ %>
                <tr>
                  <td class="fw-semibold">#<%= r.id %></td>

                  <td>
                    <div class="fw-semibold"><%= r.name || '-' %></div>
                  </td>

                  <td>
                    <% if (r.number) { %>
                      <span class="link" onclick="copyText('<%= r.number %>')"><%= r.number %></span>
                      <div class="mutedSmall">Click to copy</div>
                    <% } else { %>
                      <span class="mutedSmall">-</span>
                    <% } %>
                  </td>

                  <td class="clamp2" style="max-width:520px;">
                    <%= (r.enquiry || '-').slice(0, 220) %>
                  </td>

                  <td class="text-end fw-bold">
                    ₹<%= Number(r.lead_price || 0).toFixed(0) %>
                  </td>

                  <td>
                    <span class="badge rounded-pill
                      <%= (r.status || '').toLowerCase() === 'open' ? 'text-primary border border-primary-subtle bg-primary-subtle' :
                          (r.status || '').toLowerCase() === 'closed' ? 'text-success border border-success-subtle bg-success-subtle' :
                          'text-secondary border border-secondary-subtle bg-secondary-subtle' %>
                      px-3 py-2">
                      <%= r.status || '-' %>
                    </span>
                  </td>

                  <td>
                    <%= r.sales_person_assign || '-' %>
                  </td>

                  <td class="mutedSmall">
                    <%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>

<!-- helper -->
<script>
  window.copyText = async function(text){
    try{
      await navigator.clipboard.writeText(text || '');
    }catch(e){
      const ta = document.createElement('textarea');
      ta.value = text || '';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
  };
</script>

</body>
</html>
