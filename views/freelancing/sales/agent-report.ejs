<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/sales/sales.css?v=5">

<div class="crm-layout">
  <div class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </div>

  <div class="crm-main">
    <div class="crm-topbar d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
      <div>
        <div class="crm-title d-flex align-items-center gap-2">
          <i class="bi bi-graph-up-arrow"></i>
          <span><%= pageTitle %></span>
        </div>
        <div class="crm-subtitle">
          Your monthly performance for <strong><%= filters.selectedMonth %></strong> — sales, revenue, and incentives.
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-light btn-soft-outline" href="/sales/my/sales?month=<%= filters.selectedMonth %>">
          <i class="bi bi-receipt"></i> My Sales
        </a>
        <a class="btn btn-primary btn-soft" href="/sales/my?month=<%= filters.selectedMonth %>">
          <i class="bi bi-kanban"></i> My Leads
        </a>
      </div>
    </div>

    <form method="GET" action="/sales/my/report" class="crm-card mb-3">
      <div class="crm-filters" style="grid-template-columns: repeat(3, minmax(160px, 1fr));">
        <div class="crm-field">
          <label>Month</label>
          <select class="form-select" name="month">
            <% filters.monthOptions.forEach(function(m){ %>
              <option value="<%= m %>" <%= m===filters.selectedMonth ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
        </div>
        <div class="crm-field grow">
          <label>Search</label>
          <input class="form-control" name="q" value="<%= filters.q || '' %>" placeholder="Name / phone / enquiry / assign"/>
        </div>
        <div class="crm-field">
          <label class="d-none d-md-block">&nbsp;</label>
          <button class="btn btn-primary btn-soft w-100" type="submit"><i class="bi bi-funnel"></i> Apply</button>
        </div>
      </div>
    </form>

    <div class="crm-kpis mb-3">
      <div class="crm-kpi">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="crm-kpi-label">Total Sales</div>
            <div class="crm-kpi-val"><%= totals.total_sales || 0 %></div>
          </div>
          <div class="crm-kpi-ico"><i class="bi bi-bag-check-fill"></i></div>
        </div>
      </div>
      <div class="crm-kpi">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="crm-kpi-label">Revenue (Lead Price)</div>
            <div class="crm-kpi-val">₹<%= Number(totals.total_revenue || 0).toLocaleString('en-IN') %></div>
          </div>
          <div class="crm-kpi-ico" style="background:rgba(22,163,74,.12);"><i class="bi bi-currency-rupee"></i></div>
        </div>
      </div>
      <div class="crm-kpi">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="crm-kpi-label">Advance Collected</div>
            <div class="crm-kpi-val">₹<%= Number(totals.total_advance || 0).toLocaleString('en-IN') %></div>
          </div>
          <div class="crm-kpi-ico" style="background:rgba(245,158,11,.12);"><i class="bi bi-wallet2"></i></div>
        </div>
      </div>
      <div class="crm-kpi">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="crm-kpi-label">Agent Price Total</div>
            <div class="crm-kpi-val">₹<%= Number(totals.total_agent_price || 0).toLocaleString('en-IN') %></div>
          </div>
          <div class="crm-kpi-ico" style="background:rgba(139,92,246,.12);"><i class="bi bi-award"></i></div>
        </div>
      </div>
    </div>

    <% if (byStatus.length) { %>
    <div class="crm-card mb-3 p-3">
      <div class="fw-bold mb-2">Breakdown by Status</div>
      <div class="d-flex flex-wrap gap-2">
        <% byStatus.forEach(function(s){ %>
          <span class="agent-stat-chip">
            <%= s.status_label %>: <strong><%= s.total_sales %></strong> sales · ₹<%= Number(s.total_revenue || 0).toLocaleString('en-IN') %>
          </span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color:var(--line)!important;">
        <div class="fw-bold">Sales Detail</div>
        <div class="crm-small"><%= rows.length %> record(s)</div>
      </div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Client</th>
              <th>Enquiry</th>
              <th>Lead Price</th>
              <th>Advance</th>
              <th>Agent Price</th>
              <th>Status</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="8" class="crm-small p-4 text-center">No sales for this period.</td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td><span class="crm-chip">#<%= r.id %></span></td>
                <td>
                  <div class="crm-lead-name"><%= r.name || '-' %></div>
                  <div class="crm-small"><%= r.number || '-' %></div>
                </td>
                <td><div class="crm-clamp2"><%= r.enquiry || '-' %></div></td>
                <td class="fw-bold">₹<%= Number(r.lead_price || 0).toLocaleString('en-IN') %></td>
                <td>₹<%= Number(r.advance_amount || 0).toLocaleString('en-IN') %></td>
                <td>₹<%= Number(r.agent_price || 0).toLocaleString('en-IN') %></td>
                <td><span class="agent-badge agent-badge--muted"><%= r.status || '-' %></span></td>
                <td class="crm-small"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
