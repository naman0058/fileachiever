<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'Record Direct Sale' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Record Direct Sale</h1>
        <p>Log walk-in, WhatsApp, or referral sales directly — no lead conversion required. Only name, phone, enquiry, and deal value are mandatory.</p>
      </div>
      <div class="agent-page-header__actions">
        <a href="/sales/admin/sales" class="agent-btn agent-btn--ghost"><i class="bi bi-trophy"></i> Closed Won Deals</a>
        <a href="/sales/admin/sales-report" class="agent-btn agent-btn--ghost"><i class="bi bi-bar-chart-line"></i> Agent Performance</a>
      </div>
    </header>

    <% if (error) { %>
      <div class="admin-alert admin-alert--danger"><i class="bi bi-exclamation-circle"></i><strong>Could not save:</strong> <%= error %></div>
    <% } %>

    <form method="POST" action="/sales/admin/new-sale">
      <div class="agent-grid-2" style="align-items:start;">
        <div class="admin-form-card">
          <div class="admin-form-card__head">
            <div class="admin-form-card__title">Customer & Deal</div>
            <div class="admin-form-card__sub">Core fields required to create the sale record</div>
          </div>
          <div class="admin-form-card__body">
            <div class="admin-form-section">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Customer Name <span class="text-danger">*</span></label>
                  <input class="form-control" name="name" value="<%= form?.name || '' %>" placeholder="Full name" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                  <input class="form-control" name="number" value="<%= form?.number || '' %>" placeholder="10–15 digits" required>
                  <div class="crm-small mt-1">Digits only — e.g. 9998877123</div>
                </div>
                <div class="col-12">
                  <label class="form-label">Project Enquiry <span class="text-danger">*</span></label>
                  <input class="form-control" name="enquiry" value="<%= form?.enquiry || '' %>" placeholder="e.g. Final year project + report + setup" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Deal Value (₹) <span class="text-danger">*</span></label>
                  <input class="form-control" name="lead_price" value="<%= form?.lead_price || '' %>" type="number" min="0" step="0.01" placeholder="12000" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Advance Collected (₹)</label>
                  <input class="form-control" name="advance_amount" value="<%= form?.advance_amount || '' %>" type="number" min="0" step="0.01" placeholder="Optional">
                </div>
                <div class="col-12">
                  <label class="form-label">Remarks</label>
                  <textarea class="form-control" name="remarks" rows="3" placeholder="Scope, payment terms, delivery promise…"><%= form?.remarks || '' %></textarea>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="admin-form-card mb-3">
            <div class="admin-form-card__head">
              <div class="admin-form-card__title">Assignment & Commission</div>
              <div class="admin-form-card__sub">Link sale to a sales executive and track incentives</div>
            </div>
            <div class="admin-form-card__body">
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label">Sales Agent</label>
                  <select class="form-select" name="assign">
                    <option value="">— Unassigned —</option>
                    <% (agents || []).forEach(function(a){ %>
                      <option value="<%= a.name %>" <%= form?.assign === a.name ? 'selected' : '' %>><%= a.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Agent Commission (₹)</label>
                  <input class="form-control" name="agent_price" value="<%= form?.agent_price || '' %>" type="number" min="0" step="0.01">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Delivery Deadline</label>
                  <input class="form-control" name="deadline" value="<%= form?.deadline || '' %>" type="date">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Pakistani Price</label>
                  <input class="form-control" name="pakistani_price" value="<%= form?.pakistani_price || '' %>" type="number" min="0" step="0.01">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Sheet UID</label>
                  <input class="form-control" name="sheet_uid" value="<%= form?.sheet_uid || '' %>" placeholder="Optional tracker ID">
                </div>
              </div>
            </div>
          </div>

          <div class="admin-form-card mb-3">
            <div class="admin-form-card__head">
              <div class="admin-form-card__title">Add-on Services</div>
              <div class="admin-form-card__sub">Flags for downstream teams</div>
            </div>
            <div class="admin-form-card__body">
              <div class="admin-check-grid mb-3">
                <label class="admin-check-item">
                  <input type="checkbox" name="setup_support" value="1" <%= form?.setup_support ? 'checked' : '' %>>
                  <span>Setup Support</span>
                </label>
                <label class="admin-check-item">
                  <input type="checkbox" name="project_report" value="1" <%= form?.project_report ? 'checked' : '' %>>
                  <span>Project Report</span>
                </label>
                <label class="admin-check-item">
                  <input type="checkbox" name="ppt" value="1" <%= form?.ppt ? 'checked' : '' %>>
                  <span>PPT</span>
                </label>
              </div>
              <% if (setupSupportEmployees && setupSupportEmployees.length) { %>
              <div>
                <label class="form-label">Assign Setup Support To</label>
                <select class="form-select" name="assign_setup_support">
                  <option value="">— Auto-assign later —</option>
                  <% setupSupportEmployees.forEach(function(emp){ %>
                    <option value="<%= emp.id %>" <%= form?.assign_setup_support == emp.id ? 'selected' : '' %>><%= emp.name %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a class="agent-btn agent-btn--ghost" href="/sales/admin/sales">Cancel</a>
            <button class="agent-btn agent-btn--primary" type="submit"><i class="bi bi-check2-circle"></i> Create Sale</button>
          </div>
        </div>
      </div>
    </form>
  </main>
</div>
</body>
</html>
