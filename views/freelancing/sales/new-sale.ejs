<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Your CRM theme -->
  <link rel="stylesheet" href="/sales/sales.css?v=4">
</head>

<body>
<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <!-- TOPBAR -->
    <div class="topbar">
      <div>
        <div class="topTitle"><%= pageTitle %></div>
        <div class="topSub">Direct entry for walk-in / WhatsApp / referral sales. Only Name, Number, Enquiry, Lead Price are required.</div>
      </div>
    </div>

    <!-- CARD -->
    <section class="crm-card">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
          <div>
            <div class="fw-bold" style="font-size:18px;">Create Sale</div>
            <div class="mutedSmall">Save a sale directly without converting a Rockerstop lead.</div>
          </div>

          <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/sales/admin/sales">Back to Sales</a>
          </div>
        </div>
      </div>

      <div class="p-3">
        <% if (error) { %>
          <div class="alert alert-danger py-2 mb-3" role="alert" style="border-radius:12px;">
            <strong>Failed:</strong> <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/sales/admin/new-sale" class="row g-3">

          <!-- REQUIRED -->
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
            <input class="form-control" name="name" value="<%= form?.name || '' %>" placeholder="Customer name" required>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Number <span class="text-danger">*</span></label>
            <input class="form-control" name="number" value="<%= form?.number || '' %>" placeholder="10–15 digits" required>
            <div class="form-text">Digits only. Example: 9998877123</div>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Enquiry <span class="text-danger">*</span></label>
            <input class="form-control" name="enquiry" value="<%= form?.enquiry || '' %>" placeholder="e.g. Final year project + report" required>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Lead Price <span class="text-danger">*</span></label>
            <input class="form-control" name="lead_price" value="<%= form?.lead_price || '' %>"
                   type="number" min="0" step="0.01" placeholder="e.g. 12000" required>
          </div>

          <!-- OPTIONAL -->
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Assign (optional)</label>
            <select class="form-select" name="assign">
              <option value="">-- None --</option>
              <% (agents || []).forEach(function(a){ %>
                <option value="<%= a.name %>" <%= (form?.assign === a.name ? 'selected' : '') %>><%= a.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Deadline (optional)</label>
            <input class="form-control" name="deadline" value="<%= form?.deadline || '' %>" type="date">
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Agent Price (optional)</label>
            <input class="form-control" name="agent_price" value="<%= form?.agent_price || '' %>"
                   type="number" min="0" step="0.01" placeholder="optional">
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Advance Amount (optional)</label>
            <input class="form-control" name="advance_amount" value="<%= form?.advance_amount || '' %>"
                   type="number" min="0" step="0.01" placeholder="optional">
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Pakistani Price (optional)</label>
            <input class="form-control" name="pakistani_price" value="<%= form?.pakistani_price || '' %>"
                   type="number" min="0" step="0.01" placeholder="optional">
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Sheet UID (optional)</label>
            <input class="form-control" name="sheet_uid" value="<%= form?.sheet_uid || '' %>" placeholder="optional identifier">
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">Remarks (optional)</label>
            <textarea class="form-control" name="remarks" rows="4" placeholder="Scope summary, payment details, delivery promise, etc."><%= form?.remarks || '' %></textarea>
          </div>

          <!-- ACTIONS -->
          <div class="col-12 d-flex justify-content-end gap-2 pt-2">
            <a class="btn btn-outline-secondary" href="/sales/admin/sales">Cancel</a>
            <button class="btn btn-primary" type="submit">Create Sale</button>
          </div>

        </form>
      </div>
    </section>

  </main>
</div>
</body>
</html>
