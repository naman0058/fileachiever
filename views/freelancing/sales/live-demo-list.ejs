<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'Live Demo Manager' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Live Demo Manager</h1>
        <p>Manage SEO-friendly live demo pages — add, edit, activate, or remove demo entries for the public site.</p>
      </div>
      <div class="agent-page-header__actions">
        <a href="/sales/admin/live-demo/add" class="agent-btn agent-btn--primary"><i class="bi bi-plus-lg"></i> Add Live Demo</a>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'liveDemo', activeTab: 'list' }) %>

    <% if (error) { %><div class="admin-alert admin-alert--danger"><%= error %></div><% } %>
    <% if (success) { %><div class="admin-alert admin-alert--success"><%= success %></div><% } %>

    <div class="agent-metric mb-3" style="--metric-accent:#6366f1;--metric-bg:#eef2ff;max-width:240px;padding:16px 20px;">
      <div class="agent-metric__label">Total Demos</div>
      <div class="agent-metric__value"><%= rows.length %></div>
    </div>

    <div class="agent-table-card">
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr><th>ID</th><th>Title</th><th>SEO Slug</th><th>Demo Link</th><th>Status</th><th>Updated</th><th class="text-end">Actions</th></tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="7" class="agent-empty"><i class="bi bi-play-circle"></i>No live demos yet. <a href="/sales/admin/live-demo/add">Add your first demo</a></td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td><span class="crm-chip">#<%= r.id %></span></td>
                <td><strong><%= (r.title || '—').slice(0, 60) %></strong></td>
                <td><code class="crm-small"><%= r.seo_slug || '—' %></code></td>
                <td>
                  <% if (r.demo_link) { %><a href="<%= r.demo_link %>" target="_blank" rel="noopener" class="crm-linktext"><i class="bi bi-box-arrow-up-right"></i> Open</a>
                  <% } else { %>—<% } %>
                </td>
                <td>
                  <span class="admin-status <%= r.is_active ? 'admin-status--active' : 'admin-status--inactive' %>">
                    <%= r.is_active ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="crm-small"><%= r.updated_at ? new Date(r.updated_at).toLocaleDateString() : '—' %></td>
                <td class="text-end">
                  <a class="agent-btn agent-btn--ghost agent-btn--sm" href="/demo/<%= r.seo_slug %>" target="_blank">View</a>
                  <a class="agent-btn agent-btn--ghost agent-btn--sm" href="/sales/admin/live-demo/edit/<%= r.id %>"><i class="bi bi-pencil"></i> Edit</a>
                  <form method="POST" action="/sales/admin/live-demo/delete/<%= r.id %>" class="d-inline" onsubmit="return confirm('Delete this live demo permanently?');">
                    <button type="submit" class="agent-btn agent-btn--danger agent-btn--sm"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
