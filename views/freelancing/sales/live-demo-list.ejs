<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/sales/sales.css?v=4">
</head>
<body>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="topbar">
      <div>
        <div class="topTitle"><%= pageTitle %></div>
        <div class="topSub">Manage live demo entries with SEO-friendly URLs. Add, edit, or remove demos.</div>
      </div>
      <a class="btn btn-primary" href="/sales/admin/live-demo/add">+ Add Live Demo</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="fw-bold">Live Demos</div>
        <div class="mutedSmall">Total: <%= rows.length %></div>
      </div>

      <div class="p-3">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width:50px;">ID</th>
                <th>Title</th>
                <th>Slug</th>
                <th>Demo Link</th>
                <th>Status</th>
                <th>Updated</th>
                <th style="width:160px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!rows.length) { %>
                <tr><td colspan="7" class="py-4 mutedSmall">No live demos yet. <a href="/sales/admin/live-demo/add">Add one</a></td></tr>
              <% } %>
              <% rows.forEach(function(r){ %>
                <tr>
                  <td class="fw-semibold">#<%= r.id %></td>
                  <td><%= (r.title || '-').slice(0, 50) %><% if ((r.title||'').length > 50) { %>...<% } %></td>
                  <td><code class="small"><%= r.seo_slug || '-' %></code></td>
                  <td>
                    <% if (r.demo_link) { %>
                      <a href="<%= r.demo_link %>" target="_blank" rel="noopener" class="small">Open ↗</a>
                    <% } else { %>-<% } %>
                  </td>
                  <td>
                    <% if (r.is_active) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td class="mutedSmall"><%= r.updated_at ? new Date(r.updated_at).toLocaleDateString() : '-' %></td>
                  <td>
                    <a class="btn btn-sm btn-outline-primary" href="/demo/<%= r.seo_slug %>" target="_blank">View</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/sales/admin/live-demo/edit/<%= r.id %>">Edit</a>
                    <form method="POST" action="/sales/admin/live-demo/delete/<%= r.id %>" class="d-inline" onsubmit="return confirm('Delete this live demo?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

</body>
</html>
