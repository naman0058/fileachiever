<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'PRM Team' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Project Report Manager Team</h1>
        <p>Staff who write report headings and body content at <code>/project-report-manager</code>.</p>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'prm', activeTab: 'employees' }) %>

    <% if (error) { %><div class="admin-alert admin-alert--danger"><%= error %></div><% } %>
    <% if (success) { %><div class="admin-alert admin-alert--success"><%= success %></div><% } %>

    <div class="admin-form-card mb-3">
      <div class="admin-form-card__head">
        <div class="admin-form-card__title">Add Team Member</div>
      </div>
      <div class="admin-form-card__body">
        <form method="POST" action="/sales/admin/project-report-manager/employees" class="row g-3 align-items-end">
          <div class="col-md-4"><label class="form-label">Full Name</label><input class="form-control" name="name" required></div>
          <div class="col-md-4"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required></div>
          <div class="col-md-4"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required></div>
          <div class="col-12"><button type="submit" class="agent-btn agent-btn--primary"><i class="bi bi-person-plus"></i> Add Employee</button></div>
        </form>
      </div>
    </div>

    <div class="agent-table-card">
      <div class="p-3 border-bottom"><div class="fw-bold">Team Directory</div><div class="crm-small"><%= employees.length %> members</div></div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Status</th><th>Joined</th></tr></thead>
          <tbody>
            <% if (!employees.length) { %><tr><td colspan="5" class="agent-empty"><i class="bi bi-people"></i>No team members yet.</td></tr><% } %>
            <% (employees || []).forEach(function(e){ %>
              <tr>
                <td><span class="crm-chip">#<%= e.id %></span></td>
                <td><strong><%= e.name %></strong></td>
                <td><%= e.email %></td>
                <td><span class="admin-status <%= e.is_active ? 'admin-status--active' : 'admin-status--inactive' %>"><%= e.is_active ? 'Active' : 'Inactive' %></span></td>
                <td class="crm-small"><%= e.created_at ? new Date(e.created_at).toLocaleDateString() : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
