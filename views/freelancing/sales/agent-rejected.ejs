<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/sales/sales.css?v=5">

<div class="crm-layout">
  <div class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </div>

  <div class="crm-main">
    <div class="crm-topbar d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
      <div>
        <div class="crm-title d-flex align-items-center gap-2">
          <i class="bi bi-x-circle"></i>
          <span><%= pageTitle %></span>
        </div>
        <div class="crm-subtitle">
          Leads you rejected this month. Review reasons and learn from lost opportunities.
        </div>
      </div>
      <a class="btn btn-primary btn-soft" href="/sales/my?month=<%= filters.selectedMonth %>&status=open">
        <i class="bi bi-kanban"></i> Back to My Leads
      </a>
    </div>

    <div class="crm-card">
      <div class="crm-filters" style="grid-template-columns: 220px 1fr;">
        <div class="crm-field">
          <label>Month</label>
          <select class="form-select" onchange="location.href='/sales/my/rejected-leads?month='+encodeURIComponent(this.value)">
            <% filters.monthOptions.forEach(function(mm){ %>
              <option value="<%= mm %>" <%= mm === filters.selectedMonth ? 'selected' : '' %>><%= mm %></option>
            <% }) %>
          </select>
        </div>
        <div class="crm-field d-flex align-items-end">
          <div class="agent-stat-chip">
            <i class="bi bi-info-circle"></i>
            Total rejected: <strong><%= rows.length %></strong>
          </div>
        </div>
      </div>

      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead>
            <tr>
              <th>Lead</th>
              <th>Enquiry</th>
              <th>Stage at Reject</th>
              <th>Reason</th>
              <th>Rejected At</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="5" class="crm-small p-4 text-center">No rejected leads for this month.</td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td>
                  <div class="crm-lead-name">
                    <%= r.name || 'Unnamed' %>
                    <span class="crm-chip">#<%= r.tempid %></span>
                  </div>
                  <div class="crm-small mt-1"><%= r.phone || '-' %></div>
                </td>
                <td>
                  <div style="font-weight:800;"><%= r.enquiry_title || '-' %></div>
                  <div class="crm-small crm-clamp2"><%= r.enquiry_description || '' %></div>
                </td>
                <td><span class="agent-badge agent-badge--warn"><%= r.assignment_stage || '-' %></span></td>
                <td><div class="crm-clamp2"><%= r.reject_reason || '—' %></div></td>
                <td class="crm-small"><%= r.rejected_at ? new Date(r.rejected_at).toLocaleString() : '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
