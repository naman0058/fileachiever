<% var base = typeof basePath !== 'undefined' ? basePath : '/sales/admin/source-code-manager'; %>
<% var showOverview = typeof showOverview === 'undefined' ? true : showOverview; %>
<% function scmHref(overrides) {
  var qs = buildQuery(overrides || {});
  return base + (qs ? '?' + qs : '');
} %>

<% if (showOverview) { %>
<div class="scm-metrics">
  <div class="scm-metric" style="--scm-accent:#6366f1;--scm-bg:#eef2ff;">
    <div class="scm-metric__icon"><i class="bi bi-collection"></i></div>
    <div class="scm-metric__label">Total Products</div>
    <div class="scm-metric__value"><%= stats.total %></div>
  </div>
  <div class="scm-metric" style="--scm-accent:#16a34a;--scm-bg:#f0fdf4;">
    <div class="scm-metric__icon"><i class="bi bi-check2-circle"></i></div>
    <div class="scm-metric__label">Fully Complete</div>
    <div class="scm-metric__value"><%= stats.complete %></div>
    <div class="scm-metric__hint"><%= stats.completionRate %>% catalog ready</div>
  </div>
  <div class="scm-metric" style="--scm-accent:#f59e0b;--scm-bg:#fffbeb;">
    <div class="scm-metric__icon"><i class="bi bi-exclamation-triangle"></i></div>
    <div class="scm-metric__label">Has Gaps</div>
    <div class="scm-metric__value"><%= stats.pending %></div>
    <div class="scm-metric__hint">Missing one or more assets</div>
  </div>
  <div class="scm-metric" style="--scm-accent:#2563eb;--scm-bg:#eff6ff;">
    <div class="scm-metric__icon"><i class="bi bi-patch-check"></i></div>
    <div class="scm-metric__label">Admin Verified</div>
    <div class="scm-metric__value"><%= stats.verified %></div>
    <div class="scm-metric__hint"><%= stats.unverified %> awaiting review</div>
  </div>
  <div class="scm-metric" style="--scm-accent:#ef4444;--scm-bg:#fef2f2;">
    <div class="scm-metric__icon"><i class="bi bi-image"></i></div>
    <div class="scm-metric__label">Missing Screenshots</div>
    <div class="scm-metric__value"><%= stats.gaps.screenshot %></div>
  </div>
  <div class="scm-metric" style="--scm-accent:#a855f7;--scm-bg:#f5f3ff;">
    <div class="scm-metric__icon"><i class="bi bi-diagram-3"></i></div>
    <div class="scm-metric__label">Incomplete Diagrams</div>
    <div class="scm-metric__value"><%= stats.gaps.diagrams %></div>
    <div class="scm-metric__hint">Need all 10 types</div>
  </div>
</div>

<div class="scm-charts" id="scm-analytics">
  <div class="scm-chart-card">
    <div class="scm-chart-card__head">
      <h3 class="scm-chart-card__title">Catalog Completion</h3>
      <p class="scm-chart-card__sub">Products with all 4 asset types vs gaps</p>
    </div>
    <div class="scm-chart-card__body scm-chart-card__body--sm"><canvas id="scmCompletionChart"></canvas></div>
  </div>
  <div class="scm-chart-card scm-chart-card--wide">
    <div class="scm-chart-card__head">
      <h3 class="scm-chart-card__title">Asset Gap Analysis</h3>
      <p class="scm-chart-card__sub">Count of products missing each deliverable</p>
    </div>
    <div class="scm-gap-bars">
      <% var maxGap = Math.max(stats.gaps.screenshot, stats.gaps.demo, stats.gaps.diagrams, stats.gaps.db, 1); %>
      <div class="scm-gap-bar">
        <div class="scm-gap-bar__label"><i class="bi bi-image me-1"></i>Screenshots</div>
        <div class="scm-gap-bar__track"><div class="scm-gap-bar__fill scm-gap-bar__fill--screenshot" style="width:<%= Math.round((stats.gaps.screenshot/maxGap)*100) %>%"></div></div>
        <div class="scm-gap-bar__value"><%= stats.gaps.screenshot %></div>
      </div>
      <div class="scm-gap-bar">
        <div class="scm-gap-bar__label"><i class="bi bi-link-45deg me-1"></i>Demo Link</div>
        <div class="scm-gap-bar__track"><div class="scm-gap-bar__fill scm-gap-bar__fill--demo" style="width:<%= Math.round((stats.gaps.demo/maxGap)*100) %>%"></div></div>
        <div class="scm-gap-bar__value"><%= stats.gaps.demo %></div>
      </div>
      <div class="scm-gap-bar">
        <div class="scm-gap-bar__label"><i class="bi bi-diagram-3 me-1"></i>Diagrams</div>
        <div class="scm-gap-bar__track"><div class="scm-gap-bar__fill scm-gap-bar__fill--diagrams" style="width:<%= Math.round((stats.gaps.diagrams/maxGap)*100) %>%"></div></div>
        <div class="scm-gap-bar__value"><%= stats.gaps.diagrams %></div>
      </div>
      <div class="scm-gap-bar">
        <div class="scm-gap-bar__label"><i class="bi bi-database me-1"></i>DB Screenshots</div>
        <div class="scm-gap-bar__track"><div class="scm-gap-bar__fill scm-gap-bar__fill--db" style="width:<%= Math.round((stats.gaps.db/maxGap)*100) %>%"></div></div>
        <div class="scm-gap-bar__value"><%= stats.gaps.db %></div>
      </div>
    </div>
  </div>
  <div class="scm-chart-card">
    <div class="scm-chart-card__head">
      <h3 class="scm-chart-card__title">By Category</h3>
      <p class="scm-chart-card__sub">Product distribution across tech stacks</p>
    </div>
    <div class="scm-chart-card__body scm-chart-card__body--sm"><canvas id="scmCategoryChart"></canvas></div>
  </div>
</div>
<% } else if (typeof filterLabel !== 'undefined' && filterLabel) { %>
<div class="scm-filter-context mb-3">
  <i class="bi bi-funnel"></i>
  <span>Filtered view: <strong><%= filterLabel %></strong></span>
  <a href="<%= base %>" class="scm-filter-context__link">Back to Catalog Dashboard</a>
</div>
<% } %>

<div class="scm-filter-panel">
  <div class="scm-filter-panel__head">
    <h3 class="scm-filter-panel__title"><i class="bi bi-funnel me-2"></i>Filters & Search</h3>
    <div class="scm-legend">
      <span><span class="dot" style="background:#16a34a"></span> Complete</span>
      <span><span class="dot" style="background:#f59e0b"></span> Partial</span>
      <span><span class="dot" style="background:#ef4444"></span> Missing</span>
    </div>
  </div>
  <div class="scm-filter-panel__body">
    <div class="scm-filter-row">
      <span class="scm-filter-label">Status</span>
      <a class="scm-filter-pill <%= filters.tab === 'all' ? 'is-active' : '' %>" href="<%= scmHref({ tab: 'all' }) %>">All <span class="scm-filter-pill__count"><%= stats.total %></span></a>
      <a class="scm-filter-pill <%= filters.tab === 'pending' ? 'is-active is-active--warn' : '' %>" href="<%= scmHref({ tab: 'pending' }) %>">Has Gaps <span class="scm-filter-pill__count"><%= stats.pending %></span></a>
      <a class="scm-filter-pill <%= filters.tab === 'complete' ? 'is-active is-active--ok' : '' %>" href="<%= scmHref({ tab: 'complete' }) %>">Complete <span class="scm-filter-pill__count"><%= stats.complete %></span></a>
      <a class="scm-filter-pill <%= filters.tab === 'verified' ? 'is-active is-active--info' : '' %>" href="<%= scmHref({ tab: 'verified' }) %>">Verified <span class="scm-filter-pill__count"><%= stats.verified %></span></a>
      <a class="scm-filter-pill <%= filters.tab === 'unverified' ? 'is-active is-active--muted' : '' %>" href="<%= scmHref({ tab: 'unverified' }) %>">Unverified <span class="scm-filter-pill__count"><%= stats.unverified %></span></a>
    </div>
    <div class="scm-filter-row">
      <span class="scm-filter-label">Missing</span>
      <a class="scm-filter-pill <%= filters.missing === 'all' ? 'is-active' : '' %>" href="<%= scmHref({ missing: 'all' }) %>">Any Asset</a>
      <a class="scm-filter-pill <%= filters.missing === 'screenshot' ? 'is-active' : '' %>" href="<%= scmHref({ missing: 'screenshot' }) %>">Screenshots <span class="scm-filter-pill__count"><%= stats.gaps.screenshot %></span></a>
      <a class="scm-filter-pill <%= filters.missing === 'demo' ? 'is-active' : '' %>" href="<%= scmHref({ missing: 'demo' }) %>">Demo <span class="scm-filter-pill__count"><%= stats.gaps.demo %></span></a>
      <a class="scm-filter-pill <%= filters.missing === 'only-demo' ? 'is-active' : '' %>" href="<%= scmHref({ missing: 'only-demo' }) %>">Demo only <span class="scm-filter-pill__count"><%= stats.gaps.onlyDemo || 0 %></span></a>
      <a class="scm-filter-pill <%= filters.missing === 'diagrams' ? 'is-active' : '' %>" href="<%= scmHref({ missing: 'diagrams' }) %>">Diagrams <span class="scm-filter-pill__count"><%= stats.gaps.diagrams %></span></a>
      <a class="scm-filter-pill <%= filters.missing === 'db' ? 'is-active' : '' %>" href="<%= scmHref({ missing: 'db' }) %>">DB SS <span class="scm-filter-pill__count"><%= stats.gaps.db %></span></a>
    </div>
    <form method="GET" action="<%= base %>" class="scm-filter-form">
      <input type="hidden" name="tab" value="<%= filters.tab %>">
      <input type="hidden" name="missing" value="<%= filters.missing %>">
      <div>
        <label>Search</label>
        <input type="search" name="q" class="form-control" value="<%= filters.q || '' %>" placeholder="Product name, SEO slug, description…">
      </div>
      <div>
        <label>Category</label>
        <select name="category" class="form-select">
          <option value="">All categories</option>
          <% (categoryList || []).forEach(function(cat){ %>
            <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Verification</label>
        <select name="verified" class="form-select">
          <option value="all" <%= filters.verified === 'all' ? 'selected' : '' %>>All</option>
          <option value="verified" <%= filters.verified === 'verified' ? 'selected' : '' %>>Verified only</option>
          <option value="unverified" <%= filters.verified === 'unverified' ? 'selected' : '' %>>Unverified only</option>
        </select>
      </div>
      <div>
        <label>Sort By</label>
        <select name="sort" class="form-select">
          <option value="id_desc" <%= filters.sort === 'id_desc' ? 'selected' : '' %>>Newest first</option>
          <option value="name_asc" <%= filters.sort === 'name_asc' ? 'selected' : '' %>>Name A–Z</option>
          <option value="gaps_desc" <%= filters.sort === 'gaps_desc' ? 'selected' : '' %>>Most gaps first</option>
          <option value="completion_asc" <%= filters.sort === 'completion_asc' ? 'selected' : '' %>>Lowest completion</option>
          <option value="completion_desc" <%= filters.sort === 'completion_desc' ? 'selected' : '' %>>Highest completion</option>
        </select>
      </div>
      <div>
        <label>&nbsp;</label>
        <button type="submit" class="agent-btn agent-btn--primary w-100"><i class="bi bi-search"></i> Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="scm-table-card scm-catalog">
  <div class="scm-table-card__head">
    <div>
      <h3 class="scm-table-card__title">Product Catalog</h3>
      <p class="scm-table-card__sub mb-0"><%= rows.length %> records · 4 deliverables per product (screenshots, demo, diagrams, DB)</p>
    </div>
    <div class="scm-table-toolbar">
      <div class="scm-table-legend">
        <span class="scm-table-legend__item scm-table-legend__item--ok"><i class="bi bi-circle-fill"></i> Complete</span>
        <span class="scm-table-legend__item scm-table-legend__item--partial"><i class="bi bi-circle-fill"></i> Partial</span>
        <span class="scm-table-legend__item scm-table-legend__item--miss"><i class="bi bi-circle-fill"></i> Missing</span>
      </div>
      <% if (filters.tab !== 'all' || filters.missing !== 'all' || filters.q || filters.category) { %>
        <a href="<%= base %>" class="scm-table-toolbar__btn"><i class="bi bi-x-lg"></i> Clear filters</a>
      <% } %>
    </div>
  </div>
  <div class="scm-catalog-table-wrap">
    <table class="scm-catalog-table">
      <thead>
        <tr>
          <th class="scm-catalog-table__th scm-catalog-table__th--id">ID</th>
          <th class="scm-catalog-table__th scm-catalog-table__th--product">Product</th>
          <th class="scm-catalog-table__th">Category</th>
          <th class="scm-catalog-table__th scm-catalog-table__th--progress">Completion</th>
          <th class="scm-catalog-table__th scm-catalog-table__th--assets">Deliverables</th>
          <th class="scm-catalog-table__th">Review</th>
          <th class="scm-catalog-table__th scm-catalog-table__th--actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="7" class="scm-catalog-empty"><i class="bi bi-inbox"></i><span>No products match your filters</span></td></tr>
        <% } %>
        <% (rows || []).forEach(function(r){
          var pctClass = r.completionPct >= 100 ? 'scm-ring--complete' : (r.completionPct >= 50 ? 'scm-ring--mid' : 'scm-ring--low');
          var rowState = r.isFullyComplete ? 'scm-catalog-row--complete' : (r.missingCount >= 3 ? 'scm-catalog-row--critical' : (r.missingCount ? 'scm-catalog-row--gap' : ''));
        %>
          <tr class="scm-catalog-row <%= rowState %>" data-completion="<%= r.completionPct %>">
            <td class="scm-catalog-table__id" data-label="ID">
              <span class="scm-id-badge">#<%= r.id %></span>
            </td>
            <td class="scm-catalog-table__product" data-label="Product">
              <div class="scm-product-cell">
                <div class="scm-product-cell__name" title="<%= (r.name || '').replace(/"/g, '&quot;') %>"><%= r.name || '—' %></div>
                <% if (r.missing && r.missing.length) { %>
                  <div class="scm-missing-chips">
                    <% r.missing.forEach(function(m){
                      var cls = m === 'demo' ? ' scm-missing-chip--demo' : (m === 'diagrams' ? ' scm-missing-chip--diagrams' : (m === 'db' ? ' scm-missing-chip--db' : ''));
                      var lbl = m === 'db' ? 'DB SS' : m;
                    %>
                      <span class="scm-missing-chip<%= cls %>"><%= lbl %></span>
                    <% }) %>
                  </div>
                <% } else if (r.isFullyComplete) { %>
                  <span class="scm-product-cell__ready"><i class="bi bi-shield-check"></i> Ready for review</span>
                <% } %>
              </div>
            </td>
            <td data-label="Category">
              <span class="scm-cat-pill"><i class="bi bi-tag"></i> <%= r.category || '—' %></span>
            </td>
            <td class="scm-catalog-table__progress" data-label="Completion">
              <div class="scm-completion-cell">
                <div class="scm-ring <%= pctClass %>" style="--pct:<%= r.completionPct %>">
                  <span><%= r.completionPct %>%</span>
                </div>
                <div class="scm-completion-cell__bar">
                  <div class="scm-progress__track"><div class="scm-progress__fill <%= r.completionPct >= 100 ? '' : (r.completionPct >= 50 ? 'scm-progress__fill--mid' : 'scm-progress__fill--low') %>" style="width:<%= r.completionPct %>%"></div></div>
                  <span class="scm-completion-cell__label"><%= (4 - (r.missingCount || 0)) %>/4 assets</span>
                </div>
              </div>
            </td>
            <td class="scm-catalog-table__assets" data-label="Deliverables">
              <div class="scm-deliverables">
                <div class="scm-deliverable <%= r.hasScreenshot ? 'scm-deliverable--ok' : 'scm-deliverable--miss' %>">
                  <div class="scm-deliverable__icon"><i class="bi bi-image"></i></div>
                  <div class="scm-deliverable__body">
                    <span class="scm-deliverable__label">Screenshots</span>
                    <% if (r.hasScreenshot && r.totalScreenshotCount > 0) { %>
                      <a href="#" class="scm-deliverable__value view-screenshots-btn"
                        data-id="<%= r.id %>"
                        data-name="<%= (r.name || '').replace(/"/g, '&quot;') %>"
                        data-count="<%= r.totalScreenshotCount %>"><%= r.totalScreenshotCount %> files</a>
                    <% } else { %>
                      <span class="scm-deliverable__value scm-deliverable__value--miss">Missing</span>
                    <% } %>
                  </div>
                </div>
                <div class="scm-deliverable <%= r.hasDemo ? 'scm-deliverable--ok' : 'scm-deliverable--miss' %>">
                  <div class="scm-deliverable__icon"><i class="bi bi-link-45deg"></i></div>
                  <div class="scm-deliverable__body">
                    <span class="scm-deliverable__label">Demo</span>
                    <% if (r.hasDemo) { %>
                      <a href="<%= r.demo_url %>" target="_blank" rel="noopener" class="scm-deliverable__value">Open link</a>
                    <% } else { %>
                      <span class="scm-deliverable__value scm-deliverable__value--miss">Missing</span>
                    <% } %>
                  </div>
                </div>
                <div class="scm-deliverable <%= r.hasAllDiagrams ? 'scm-deliverable--ok' : 'scm-deliverable--partial' %>">
                  <div class="scm-deliverable__icon"><i class="bi bi-diagram-3"></i></div>
                  <div class="scm-deliverable__body">
                    <span class="scm-deliverable__label">Diagrams</span>
                    <span class="scm-deliverable__value"><%= r.diagramCount || 0 %>/10</span>
                  </div>
                </div>
                <div class="scm-deliverable <%= r.hasDbScreenshots ? 'scm-deliverable--ok' : 'scm-deliverable--miss' %>">
                  <div class="scm-deliverable__icon"><i class="bi bi-database"></i></div>
                  <div class="scm-deliverable__body">
                    <span class="scm-deliverable__label">DB SS</span>
                    <% if (r.hasDbScreenshots) { %>
                      <span class="scm-deliverable__value"><%= r.dbScreenshotCount %><% if (!r.hasAllDatatables) { %> <span class="scm-deliverable__sub">(<%= r.dbWithDatatableCount %>/<%= r.dbScreenshotCount %> DT)</span><% } %></span>
                    <% } else { %>
                      <span class="scm-deliverable__value scm-deliverable__value--miss">Missing</span>
                    <% } %>
                  </div>
                </div>
              </div>
            </td>
            <td data-label="Review">
              <% if (r.isVerified) { %>
                <span class="scm-review-badge scm-review-badge--verified"><i class="bi bi-patch-check-fill"></i> Verified</span>
              <% } else if (r.isFullyComplete) { %>
                <span class="scm-review-badge scm-review-badge--ready"><i class="bi bi-hourglass-split"></i> Awaiting</span>
              <% } else { %>
                <span class="scm-review-badge scm-review-badge--pending"><i class="bi bi-dash-circle"></i> In progress</span>
              <% } %>
            </td>
            <td class="scm-catalog-table__actions" data-label="Actions">
              <div class="scm-action-group">
                <a class="scm-action-btn scm-action-btn--primary" href="/source-code-manager/edit/<%= r.id %>" title="Edit product">
                  <i class="bi bi-pencil-square"></i><span>Edit</span>
                </a>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) {
                  var canVerifyAll = r.hasScreenshot && r.hasDemo && !r.isVerified;
                  if (canVerifyAll) { %>
                    <button type="button" class="scm-action-btn scm-action-btn--verify verify-btn" data-id="<%= r.id %>" data-field="all" title="Verify">
                      <i class="bi bi-check2-circle"></i>
                    </button>
                <% } } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (rows.length) { %>
  <div class="scm-table-card__foot">
    <span><strong><%= rows.length %></strong> products displayed</span>
    <span class="scm-table-card__foot-hint">Scroll for more · Click Edit to upload assets</span>
  </div>
  <% } %>
</div>

<div class="modal fade" id="scmScreenshotsModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:16px;border:none;">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-bold" id="scmScreenshotsModalTitle">Screenshots</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body"><div class="d-flex flex-wrap gap-3" id="scmScreenshotsModalThumbs"></div></div>
    </div>
  </div>
</div>

<% if (showOverview) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function(){
  const cd = <%- JSON.stringify(chartData) %>;
  Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
  const doughnutOpts = {
    responsive: true, maintainAspectRatio: false, cutout: '62%',
    plugins: {
      legend: { position: 'bottom', labels: { boxWidth: 10, padding: 14, font: { size: 11, weight: '600' } } }
    }
  };
  const completionEl = document.getElementById('scmCompletionChart');
  if (completionEl && cd.completionValues) {
    new Chart(completionEl, {
      type: 'doughnut',
      data: {
        labels: cd.completionLabels,
        datasets: [{ data: cd.completionValues, backgroundColor: ['#16a34a', '#f59e0b'], borderWidth: 0, hoverOffset: 6 }]
      },
      options: doughnutOpts
    });
  }
  const catEl = document.getElementById('scmCategoryChart');
  if (catEl && cd.categoryLabels && cd.categoryLabels.length) {
    const colors = ['#6366f1','#a855f7','#2563eb','#0891b2','#16a34a','#f59e0b','#ef4444','#ec4899','#64748b','#84cc16','#14b8a6','#f97316'];
    new Chart(catEl, {
      type: 'bar',
      data: {
        labels: cd.categoryLabels,
        datasets: [{ data: cd.categoryTotals, backgroundColor: colors.slice(0, cd.categoryLabels.length), borderRadius: 6, maxBarThickness: 28 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0, font: { size: 10 } }, grid: { color: '#eef2f7' }, border: { display: false } },
          x: { ticks: { font: { size: 10 }, maxRotation: 45, minRotation: 0 }, grid: { display: false }, border: { display: false } }
        }
      }
    });
  } else if (catEl) {
    catEl.parentElement.innerHTML = '<div class="agent-empty" style="padding:40px 16px"><i class="bi bi-bar-chart"></i>No category data</div>';
  }
})();
</script>
<% } %>

<script>
(function(){
  const screenshotsApi = '<%= typeof screenshotsApiPrefix !== "undefined" ? screenshotsApiPrefix : "/sales/api/admin/source-code-manager" %>';
  document.querySelectorAll('.view-screenshots-btn').forEach(function(btn){
    btn.addEventListener('click', async function(e){
      e.preventDefault();
      const id = this.dataset.id;
      const name = this.dataset.name || 'Product';
      const modal = document.getElementById('scmScreenshotsModal');
      const container = document.getElementById('scmScreenshotsModalThumbs');
      const titleEl = document.getElementById('scmScreenshotsModalTitle');
      if (!modal || !container) return;
      titleEl.textContent = name + ' — loading…';
      container.innerHTML = '<div class="crm-small text-muted p-3">Loading screenshots…</div>';
      new bootstrap.Modal(modal).show();
      try {
        const res = await fetch(screenshotsApi + '/' + id + '/screenshots');
        const j = await res.json();
        if (!j.ok || !j.screenshots) throw new Error(j.message || 'Failed');
        titleEl.textContent = name + ' — ' + j.count + ' screenshot(s)';
        container.innerHTML = '';
        j.screenshots.forEach(function(ss){
          const url = typeof ss === 'string' ? ss : (ss.url || '');
          if (!url) return;
          const wrap = document.createElement('div');
          wrap.className = 'text-center';
          const a = document.createElement('a'); a.href = url; a.target = '_blank'; a.rel = 'noopener';
          const img = document.createElement('img'); img.src = url; img.className = 'admin-thumb'; img.alt = ss.name || 'Screenshot';
          img.onerror = function(){ this.replaceWith(document.createTextNode('Failed to load')); };
          a.appendChild(img); wrap.appendChild(a);
          if (ss.name) {
            const lbl = document.createElement('div');
            lbl.className = 'crm-small mt-1';
            lbl.textContent = ss.name;
            wrap.appendChild(lbl);
          }
          container.appendChild(wrap);
        });
        if (!j.screenshots.length) {
          container.innerHTML = '<div class="agent-empty"><i class="bi bi-image"></i>No screenshots found</div>';
        }
      } catch (err) {
        titleEl.textContent = name + ' — error';
        container.innerHTML = '<div class="admin-alert admin-alert--danger">' + (err.message || 'Could not load') + '</div>';
      }
    });
  });
})();
</script>
