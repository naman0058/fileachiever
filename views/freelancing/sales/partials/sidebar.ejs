<aside class="crm-sidebar">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <div class="crm-sidebar__brand">
    <div class="crm-brand">Sales CRM</div>
    <div class="crm-sub">Team pipeline management</div>
  </div>

  <nav class="crm-nav">
    <% if (user.role === 'admin') { %>
      <a class="crm-link <%= active === 'overview' ? 'active' : '' %>" href="/sales/admin/overview">
        Overview
      </a>
      <a class="crm-link <%= active === 'assignments' ? 'active' : '' %>" href="/sales/admin">
        Assignments
      </a>
      <a class="crm-link <%= active === 'sales' ? 'active' : '' %>" href="/sales/admin/sales">
        Sales
      </a>
      <a class="crm-link <%= active === 'logs' ? 'active' : '' %>" href="/sales/logs">
        Team Logs
      </a>
      <a class="crm-link <%= active === 'salesReport' ? 'active' : '' %>" href="/sales/admin/sales-report">Sales Report</a>

      <a class="crm-link <%= active === 'newSale' ? 'active' : '' %>" href="/sales/admin/new-sale">
        Direct Sale Entry
      </a>

      <div class="crm-nav__sep"></div>
      <span class="crm-nav__label">Setup Support</span>
      <a class="crm-link <%= active === 'setupSupportOverview' ? 'active' : '' %>" href="/sales/admin/setup-support">
        Setup Support Overview
      </a>
      <a class="crm-link <%= active === 'setupSupportEmployees' ? 'active' : '' %>" href="/sales/admin/setup-support/employees">
        Setup Support Employees
      </a>

      <div class="crm-nav__sep"></div>
      <span class="crm-nav__label">Source Code Manager</span>
      <a class="crm-link <%= active === 'sourceCodeManagerOverview' ? 'active' : '' %>" href="/sales/admin/source-code-manager">
        Source Code Manager Overview
      </a>
      <a class="crm-link <%= active === 'sourceCodeManagerEmployees' ? 'active' : '' %>" href="/sales/admin/source-code-manager/employees">
        Source Code Manager Employees
      </a>

      <div class="crm-nav__sep"></div>
      <span class="crm-nav__label">Project Report Manager</span>
      <a class="crm-link <%= active === 'projectReportManagerOverview' ? 'active' : '' %>" href="/sales/admin/project-report-manager">
        Project Report Manager Overview
      </a>
      <a class="crm-link <%= active === 'projectReportManagerEmployees' ? 'active' : '' %>" href="/sales/admin/project-report-manager/employees">
        Project Report Manager Employees
      </a>

      <div class="crm-nav__sep"></div>
      <span class="crm-nav__label">Project Report Creator</span>
      <a class="crm-link <%= active === 'projectReportCreatorOverview' ? 'active' : '' %>" href="/sales/admin/project-report-creator">
        Project Report Creator Overview
      </a>
      <a class="crm-link <%= active === 'projectReportCreatorEmployees' ? 'active' : '' %>" href="/sales/admin/project-report-creator/employees">
        Project Report Creator Employees
      </a>

      <div class="crm-nav__sep"></div>
      <span class="crm-nav__label">Live Demo</span>
      <a class="crm-link <%= active === 'liveDemo' ? 'active' : '' %>" href="/sales/admin/live-demo">
        Live Demo Manager
      </a>
    <% } %>
    <% if (user.role === 'agent') { %>
      <span class="crm-nav__label">My Workspace</span>
      <a class="crm-link <%= active === 'overview' ? 'active' : '' %>" href="/sales/my/overview">
        <i class="bi bi-speedometer2 crm-link-ico"></i> Overview
      </a>
      <a class="crm-link <%= active === 'assignments' ? 'active' : '' %>" href="/sales/my">
        <i class="bi bi-kanban crm-link-ico"></i> My Leads
      </a>
      <a class="crm-link <%= active === 'sales' ? 'active' : '' %>" href="/sales/my/sales">
        <i class="bi bi-receipt crm-link-ico"></i> My Sales
      </a>
      <a class="crm-link <%= active === 'agentReport' ? 'active' : '' %>" href="/sales/my/report">
        <i class="bi bi-graph-up-arrow crm-link-ico"></i> Performance Report
      </a>
      <a class="crm-link <%= active === 'rejectedLeads' ? 'active' : '' %>" href="/sales/my/rejected-leads">
        <i class="bi bi-x-circle crm-link-ico"></i> Rejected Leads
      </a>
    <% } %>

    <div class="crm-nav__sep"></div>

    <a class="crm-link danger" href="/auth/logout">Logout</a>
  </nav>

  <div class="crm-user">
    <div class="crm-user__name"><%= user.name %></div>
    <div class="crm-user__meta">Role: <%= user.role %></div>
  </div>
</aside>

<%- include('./lead-socket-alert') %>