<%#
  module: fmOnlineOrders | setupSupport | scm | prm | prc | liveDemo
  activeTab: overview | employees | list | add | orders | payments | exceptions | analytics | lookup
%>
<%
  const tabs = {
    fmOnlineOrders: {
      overview: { href: '/sales/admin/fm-online-orders', label: 'Overview', icon: 'bi-grid-1x2' },
      orders: { href: '/sales/admin/fm-online-orders/orders', label: 'Orders', icon: 'bi-receipt' },
      payments: { href: '/sales/admin/fm-online-orders/payments', label: 'Payments', icon: 'bi-credit-card' },
      exceptions: { href: '/sales/admin/fm-online-orders/exceptions', label: 'Exceptions', icon: 'bi-exclamation-triangle' },
      analytics: { href: '/sales/admin/fm-online-orders/analytics', label: 'Analytics', icon: 'bi-bar-chart-line' },
      lookup: { href: '/sales/admin/fm-online-orders/lookup', label: 'Lookup', icon: 'bi-search' }
    },
    setupSupport: {
      overview: { href: '/sales/admin/setup-support', label: 'Requests', icon: 'bi-inbox' },
      performance: { href: '/sales/admin/setup-support/performance', label: 'Performance', icon: 'bi-graph-up' },
      employees: { href: '/sales/admin/setup-support/employees', label: 'Team', icon: 'bi-people' }
    },
    scm: {
      overview: { href: '/sales/admin/source-code-manager', label: 'Catalog', icon: 'bi-code-square' },
      employees: { href: '/sales/admin/source-code-manager/employees', label: 'Team', icon: 'bi-people' }
    },
    prm: {
      overview: { href: '/sales/admin/project-report-manager', label: 'Reports', icon: 'bi-file-earmark-text' },
      employees: { href: '/sales/admin/project-report-manager/employees', label: 'Team', icon: 'bi-people' }
    },
    prc: {
      overview: { href: '/sales/admin/project-report-creator', label: 'Topics', icon: 'bi-journal-plus' },
      employees: { href: '/sales/admin/project-report-creator/employees', label: 'Team', icon: 'bi-people' }
    },
    liveDemo: {
      list: { href: '/sales/admin/live-demo', label: 'All Demos', icon: 'bi-play-circle' },
      add: { href: '/sales/admin/live-demo/add', label: 'Add New', icon: 'bi-plus-lg' }
    }
  };
  const mod = tabs[module] || {};
%>
<nav class="admin-module-tabs">
  <% Object.entries(mod).forEach(function([key, t]) { %>
    <a href="<%= t.href %>" class="admin-module-tabs__link <%= activeTab === key ? 'is-active' : '' %>">
      <i class="bi <%= t.icon %>"></i><%= t.label %>
    </a>
  <% }) %>
</nav>
