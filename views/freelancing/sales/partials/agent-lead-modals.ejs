<!-- Call History Modal -->
<div class="modal fade" id="logsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="logsTitle">Conversation History</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="logsAssignmentId" />
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Next Callback Date</label>
            <input id="logsNextDate" type="date" class="form-control"/>
          </div>
          <div class="col-md-8">
            <label class="form-label fw-bold">Conversation Notes</label>
            <textarea id="logsNote" class="form-control" rows="3" placeholder="What was discussed? Next steps?"></textarea>
          </div>
        </div>
        <div class="d-flex justify-content-end mt-3">
          <button class="agent-btn agent-btn--primary" type="button" onclick="addLog()">Save Note</button>
        </div>
        <div class="mt-3" id="logsTimeline"></div>
      </div>
    </div>
  </div>
</div>

<!-- Disqualify Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rejectTitle">Disqualify Lead</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="rejectAssignmentId"/>
        <p class="crm-small mb-3">This lead moves to <strong>Disqualified Leads</strong>. Use when the prospect is not a fit or unreachable.</p>
        <label class="form-label fw-bold">Reason for Disqualification</label>
        <textarea id="rejectReason" class="form-control" rows="3" placeholder="Budget mismatch, not interested, invalid contact…"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="agent-btn agent-btn--ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="agent-btn agent-btn--danger" onclick="doReject()">Confirm Disqualify</button>
      </div>
    </div>
  </div>
</div>

<!-- Close Won Modal -->
<div class="modal fade" id="convertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="convertTitle">Close as Won Deal</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="convertAssignmentId" />
        <p class="crm-small mb-3">Creates a confirmed sale record and marks this lead as converted.</p>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Client Name *</label>
            <input id="convertName" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Phone Number *</label>
            <input id="convertNumber" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Project / Enquiry *</label>
            <input id="convertEnquiry" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Deal Value (₹) *</label>
            <input id="convertLeadPrice" type="number" min="0" step="0.01" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Your Commission (5%)</label>
            <input id="convertAgentPrice" type="text" class="form-control agent-commission-readonly" readonly tabindex="-1" placeholder="Enter deal value" />
            <div class="crm-small mt-1">Fixed at 5% of deal value — not editable</div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Delivery Deadline</label>
            <input id="convertDeadline" type="date" class="form-control"/>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Advance Received (₹)</label>
            <input id="convertAdvance" type="number" min="0" step="0.01" class="form-control"/>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Assign To (Team Member)</label>
            <input id="convertAssign" class="form-control" />
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Pakistani Price (₹)</label>
            <input id="convertPakPrice" type="number" min="0" step="0.01" class="form-control"/>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Sheet Reference ID</label>
            <input id="convertSheetUid" class="form-control" />
          </div>
          <div class="col-12">
            <label class="form-label fw-bold">Internal Remarks</label>
            <textarea id="convertRemarks" class="form-control" rows="3"></textarea>
          </div>
        </div>
        <div class="d-flex justify-content-end mt-3 gap-2">
          <button class="agent-btn agent-btn--ghost" type="button" data-bs-dismiss="modal">Cancel</button>
          <button class="agent-btn agent-btn--success" type="button" onclick="doConvert()">
            <i class="bi bi-trophy"></i> Confirm Won Deal
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
  <div id="copyToast" class="toast align-items-center text-bg-dark border-0">
    <div class="d-flex">
      <div class="toast-body" id="copyToastBody">Copied</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  async function apiPost(url, payload){
    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type':'application/json' },
      body: JSON.stringify(payload || {})
    });
    const data = await resp.json().catch(() => ({}));
    if(!resp.ok || !data.ok) throw new Error(data.message || ('HTTP ' + resp.status));
    return data;
  }
  function showModal(id){ return bootstrap.Modal.getOrCreateInstance(document.getElementById(id)).show(); }
  function toast(msg){
    document.getElementById('copyToastBody').textContent = msg;
    bootstrap.Toast.getOrCreateInstance(document.getElementById('copyToast'), { delay: 1800 }).show();
  }
  window.copyText = async function(text){
    try { await navigator.clipboard.writeText(text||''); toast('Copied'); } catch(e){ toast('Copied'); }
  };
  const AGENT_COMMISSION_RATE = 0.05;
  function commissionFromDealValue(v) {
    const n = Number(v) || 0;
    return Math.round(n * AGENT_COMMISSION_RATE * 100) / 100;
  }
  function updateConvertCommission() {
    const lp = document.getElementById('convertLeadPrice')?.value;
    const ap = document.getElementById('convertAgentPrice');
    if (!ap) return;
    if (lp === '' || lp == null) {
      ap.value = '';
      ap.dataset.commission = '0';
      return;
    }
    const c = commissionFromDealValue(lp);
    ap.value = '₹' + c.toLocaleString('en-IN');
    ap.dataset.commission = String(c);
  }
  document.getElementById('convertLeadPrice')?.addEventListener('input', updateConvertCommission);
  window.setStage = async function(id, stage){
    try { await apiPost('/sales/api/assignment/stage', { assignment_id: Number(id), stage }); location.reload(); }
    catch(e){ alert('Stage update failed: ' + e.message); }
  };
  window.openReject = function(id, name){
    document.getElementById('rejectAssignmentId').value = Number(id);
    document.getElementById('rejectTitle').textContent = 'Disqualify • ' + (name||'Lead');
    document.getElementById('rejectReason').value = '';
    showModal('rejectModal');
  };
  window.doReject = async function(){
    const id = Number(document.getElementById('rejectAssignmentId').value);
    const reason = (document.getElementById('rejectReason').value||'').trim();
    try {
      await apiPost('/sales/api/assignment/status', { assignment_id: id, status: 'rejected', reason });
      location.reload();
    } catch(e){ alert('Failed: ' + e.message); }
  };
  window.openLogs = async function(id, name){
    document.getElementById('logsAssignmentId').value = Number(id);
    document.getElementById('logsTitle').textContent = 'Conversation History • ' + (name||'Lead');
    document.getElementById('logsNote').value = '';
    document.getElementById('logsNextDate').value = '';
    document.getElementById('logsTimeline').innerHTML = '';
    showModal('logsModal');
    await loadLogs(id);
  };
  async function loadLogs(id){
    const box = document.getElementById('logsTimeline');
    try {
      const resp = await fetch('/sales/api/assignment/logs/' + Number(id));
      const data = await resp.json();
      if(!data.ok) throw new Error(data.message);
      if(!data.rows?.length){ box.innerHTML = '<div class="crm-small">No conversation history yet.</div>'; return; }
      box.innerHTML = data.rows.map(r => `
        <div class="log-row">
          <div class="log-top"><div class="log-day">${r.day_label||''}</div>
          <div class="crm-small">${new Date(r.created_at).toLocaleString()}${r.next_followup_date?' • Callback: '+r.next_followup_date:''}</div></div>
          <div class="log-note">${r.note||''}</div>
        </div>`).join('');
    } catch(e){ box.innerHTML = '<div class="text-danger small">'+e.message+'</div>'; }
  }
  window.addLog = async function(){
    const id = Number(document.getElementById('logsAssignmentId').value);
    const note = (document.getElementById('logsNote').value||'').trim();
    if(!note) return alert('Please enter conversation notes');
    try {
      await apiPost('/sales/api/assignment/logs', { assignment_id: id, note, next_followup_date: document.getElementById('logsNextDate').value||null });
      await loadLogs(id);
      setTimeout(()=> location.reload(), 200);
    } catch(e){ alert('Failed: '+e.message); }
  };
  window.followUpNow = async function(id, name){
    try {
      await apiPost('/sales/api/assignment/stage', { assignment_id: Number(id), stage: 'followup' });
      await openLogs(Number(id), name);
    } catch(e){ alert('Failed: '+e.message); }
  };
  window.openConvert = function(id, name){
    document.getElementById('convertAssignmentId').value = Number(id);
    document.getElementById('convertTitle').textContent = 'Close as Won • ' + (name||'Lead');
    ['convertName','convertNumber','convertEnquiry','convertLeadPrice','convertDeadline','convertAdvance','convertAssign','convertPakPrice','convertSheetUid','convertRemarks'].forEach(i => {
      const el = document.getElementById(i); if(el) el.value = '';
    });
    const ap = document.getElementById('convertAgentPrice');
    if (ap) { ap.value = ''; ap.dataset.commission = '0'; }
    const card = document.querySelector('[data-assignment-id="'+id+'"]');
    if(card){
      document.getElementById('convertName').value = card.getAttribute('data-lead-name')||'';
      document.getElementById('convertNumber').value = (card.getAttribute('data-lead-phone')||'').replace(/\D/g,'');
      document.getElementById('convertEnquiry').value = card.getAttribute('data-lead-enquiry')||'';
    }
    showModal('convertModal');
    updateConvertCommission();
  };
  window.doConvert = async function(){
    const id = Number(document.getElementById('convertAssignmentId').value);
    const name = (document.getElementById('convertName').value||'').trim();
    const number = (document.getElementById('convertNumber').value||'').trim();
    const enquiry = (document.getElementById('convertEnquiry').value||'').trim();
    const lead_price = document.getElementById('convertLeadPrice').value;
    if(!name||!number||!enquiry||lead_price==='') return alert('Client name, phone, enquiry and deal value are required');
    try {
      await apiPost('/sales/api/assignment/convert', {
        assignment_id: id, name, number, enquiry, lead_price: Number(lead_price),
        agent_price: commissionFromDealValue(lead_price),
        deadline: document.getElementById('convertDeadline').value||null,
        assign: (document.getElementById('convertAssign').value||'').trim()||null,
        advance_amount: document.getElementById('convertAdvance').value ? Number(document.getElementById('convertAdvance').value) : null,
        pakistani_price: document.getElementById('convertPakPrice').value ? Number(document.getElementById('convertPakPrice').value) : null,
        sheet_uid: (document.getElementById('convertSheetUid').value||'').trim()||null,
        remarks: (document.getElementById('convertRemarks').value||'').trim()||null
      });
      location.reload();
    } catch(e){ alert('Convert failed: '+e.message); }
  };
</script>
