<% if (typeof user !== 'undefined' && user && typeof socketAuthToken !== 'undefined' && socketAuthToken) { %>
<script src="/socket.io/socket.io.js"></script>

<audio id="leadSiren" preload="auto">
  <source src="/sounds/new-lead.wav" type="audio/mpeg">
</audio>

<div id="soundUnlockWrap" style="position:fixed; right:16px; bottom:16px; z-index:9999; display:none;">
  <button id="soundUnlockBtn" class="btn btn-dark btn-sm">Enable New Lead Sound</button>
</div>

<div id="leadToast"
     style="position:fixed; left:16px; bottom:16px; z-index:9999; display:none; min-width:260px;
            background:#111827; color:#fff; padding:12px 14px; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,.25);">
  <div style="font-weight:800; margin-bottom:2px;">New Lead</div>
  <div id="leadToastText" style="font-size:13px; opacity:.9;"></div>
</div>

<script>
(function () {
  if (typeof io === 'undefined') {
    console.warn('[lead-alert] socket.io client not loaded');
    return;
  }

  const siren = document.getElementById('leadSiren');
  const unlockWrap = document.getElementById('soundUnlockWrap');
  const unlockBtn = document.getElementById('soundUnlockBtn');
  const toast = document.getElementById('leadToast');
  const toastText = document.getElementById('leadToastText');

  let connected = false;
  let errorToastTimer = null;

  function showToast(msg, title) {
    if (!toast || !toastText) return;
    const titleEl = toast.querySelector('div');
    if (titleEl && title) titleEl.textContent = title;
    toastText.textContent = msg || '';
    toast.style.display = 'block';
    clearTimeout(window.__leadToastTimer);
    window.__leadToastTimer = setTimeout(() => { toast.style.display = 'none'; }, 6000);
  }

  async function playSiren() {
    if (!siren) return false;
    try {
      siren.currentTime = 0;
      await siren.play();
      return true;
    } catch (e) {
      console.warn('[lead-alert] play blocked:', e && e.message);
      return false;
    }
  }

  async function unlockSound() {
    const ok = await playSiren();
    if (!ok) {
      showToast('Browser blocked sound. Try again.', 'Sound');
      if (unlockWrap) unlockWrap.style.display = 'block';
      return;
    }
    try { siren.pause(); siren.currentTime = 0; } catch (e) {}
    localStorage.setItem('leadSoundUnlocked', '1');
    if (unlockWrap) unlockWrap.style.display = 'none';
    showToast('New lead sound enabled.', 'Sound');
  }

  const unlockedAlready = localStorage.getItem('leadSoundUnlocked') === '1';
  if (!unlockedAlready && unlockWrap) unlockWrap.style.display = 'block';

  if (unlockBtn) unlockBtn.addEventListener('click', unlockSound);

  const socket = io({
    withCredentials: true,
    auth: { token: '<%- socketAuthToken %>' },
    transports: ['polling', 'websocket'],
    reconnection: true,
    reconnectionAttempts: Infinity,
    reconnectionDelay: 1000,
    reconnectionDelayMax: 8000,
    timeout: 20000
  });

  function markConnected() {
    connected = true;
    clearTimeout(errorToastTimer);
  }

  socket.on('connect', () => {
    console.log('[lead-alert] transport connected:', socket.id);
  });

  socket.on('socket:ready', () => {
    console.log('[lead-alert] socket ready');
    markConnected();
    showToast('Realtime alerts connected.', 'Connected');
  });

  socket.on('connect_error', (err) => {
    console.warn('[lead-alert] connect_error:', err && err.message);
    if (connected) return;
    clearTimeout(errorToastTimer);
    errorToastTimer = setTimeout(() => {
      if (!connected && !socket.connected) {
        showToast('Realtime alerts reconnecting…', 'Connection');
      }
    }, 4000);
  });

  socket.on('disconnect', (reason) => {
    console.warn('[lead-alert] disconnected:', reason);
    connected = false;
  });

  socket.on('lead:new', async (lead) => {
    console.log('[lead-alert] lead:new received:', lead);

    const msg = `tempid=${lead?.tempid || '-'} • ${lead?.name || 'Unnamed'} • ${lead?.phone || '-'}`;
    showToast(msg, 'New Lead');

    if (localStorage.getItem('leadSoundUnlocked') === '1') {
      const ok = await playSiren();
      if (!ok && unlockWrap) unlockWrap.style.display = 'block';
    } else {
      if (unlockWrap) unlockWrap.style.display = 'block';
    }
  });
})();
</script>
<% } %>
