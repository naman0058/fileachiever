<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Team Access</h1>
        <p>Add, edit, or revoke portal access for admins, agents, and module staff. Disabled or removed users are signed out automatically.</p>
      </div>
    </header>

    <% if (error) { %><div class="admin-alert admin-alert--danger"><i class="bi bi-exclamation-circle"></i><%= error %></div><% } %>
    <% if (success) { %><div class="admin-alert admin-alert--success"><i class="bi bi-check-circle"></i><%= success %></div><% } %>

    <div class="admin-form-card mb-3">
      <div class="admin-form-card__head">
        <div class="admin-form-card__title">Add User</div>
        <div class="admin-form-card__sub">Creates a new login for the Sales CRM or a module portal</div>
      </div>
      <div class="admin-form-card__body">
        <form method="POST" action="/sales/admin/users" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label">Full Name</label>
            <input class="form-control" name="name" required placeholder="Full name">
          </div>
          <div class="col-md-3">
            <label class="form-label">Email (login)</label>
            <input class="form-control" type="email" name="email" required placeholder="email@example.com">
          </div>
          <div class="col-md-2">
            <label class="form-label">Role</label>
            <select class="form-select" name="role" required>
              <% roleOptions.forEach(function(r){ %>
                <option value="<%= r.value %>" <%= r.value === 'agent' ? 'selected' : '' %>><%= r.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Password</label>
            <input class="form-control" type="password" name="password" required minlength="6" placeholder="Min. 6 chars">
          </div>
          <div class="col-md-2">
            <button type="submit" class="agent-btn agent-btn--primary w-100"><i class="bi bi-person-plus"></i> Add</button>
          </div>
        </form>
      </div>
    </div>

    <form method="GET" action="/sales/admin/users" class="admin-filter-bar">
      <input type="search" name="q" class="form-control" style="max-width:220px" placeholder="Search name or email" value="<%= filters.q %>">
      <select name="role" class="form-select" style="max-width:200px" onchange="this.form.submit()">
        <option value="">All roles</option>
        <% roleOptions.forEach(function(r){ %>
          <option value="<%= r.value %>" <%= filters.role === r.value ? 'selected' : '' %>><%= r.label %></option>
        <% }) %>
      </select>
      <select name="status" class="form-select" style="max-width:160px" onchange="this.form.submit()">
        <option value="">All statuses</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
      <button type="submit" class="agent-btn agent-btn--ghost"><i class="bi bi-search"></i> Filter</button>
      <% if (filters.q || filters.role || filters.status) { %>
        <a href="/sales/admin/users" class="agent-btn agent-btn--ghost">Clear</a>
      <% } %>
    </form>

    <div class="agent-table-card">
      <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
          <div class="fw-bold">User Directory</div>
          <div class="crm-small"><%= users.length %> accounts</div>
        </div>
        <div class="crm-small text-muted"><i class="bi bi-shield-lock"></i> Revoked access signs users out within ~30 seconds</div>
      </div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table admin-users-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Status</th>
              <th>Joined</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!users.length) { %>
              <tr><td colspan="5" class="agent-empty"><i class="bi bi-people"></i>No users match your filters.</td></tr>
            <% } %>
            <% users.forEach(function(u){ %>
              <tr class="<%= u.is_active ? '' : 'admin-users-row--inactive' %>">
                <td>
                  <strong><%= u.name %></strong>
                  <div class="crm-small"><%= u.email %></div>
                  <div class="crm-small text-muted">ID #<%= u.id %></div>
                </td>
                <td><span class="admin-role-chip admin-role-chip--<%= String(u.role||'').replace(/_/g,'-') %>"><%= crmUserRoleLabel(u.role) %></span></td>
                <td>
                  <span class="admin-status <%= u.is_active ? 'admin-status--active' : 'admin-status--inactive' %>">
                    <%= u.is_active ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="crm-small"><%= u.created_at ? new Date(u.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '—' %></td>
                <td class="text-end">
                  <div class="admin-users-actions">
                    <button type="button" class="agent-btn agent-btn--ghost agent-btn--sm js-edit-user"
                      data-id="<%= u.id %>"
                      data-name="<%= u.name %>"
                      data-email="<%= u.email %>"
                      data-role="<%= u.role %>"
                      data-active="<%= u.is_active ? '1' : '0' %>">
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    <form method="POST" action="/sales/admin/users/<%= u.id %>/toggle-active" class="d-inline" onsubmit="return confirm('<%= u.is_active ? 'Deactivate this user? They will be signed out immediately.' : 'Activate this user?' %>');">
                      <button type="submit" class="agent-btn agent-btn--ghost agent-btn--sm">
                        <i class="bi bi-<%= u.is_active ? 'pause-circle' : 'play-circle' %>"></i>
                        <%= u.is_active ? 'Disable' : 'Enable' %>
                      </button>
                    </form>
                    <form method="POST" action="/sales/admin/users/<%= u.id %>/delete" class="d-inline" onsubmit="return confirm('Permanently delete <%= u.name %>? This cannot be undone.');">
                      <button type="submit" class="agent-btn agent-btn--ghost agent-btn--sm admin-users-delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content admin-modal">
      <form method="POST" id="editUserForm" action="">
        <div class="modal-header">
          <h5 class="modal-title">Edit User</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input class="form-control" name="name" id="editName" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" type="email" name="email" id="editEmail" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Role</label>
            <select class="form-select" name="role" id="editRole" required>
              <% roleOptions.forEach(function(r){ %>
                <option value="<%= r.value %>"><%= r.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">New Password <span class="text-muted fw-normal">(leave blank to keep current)</span></label>
            <input class="form-control" type="password" name="password" minlength="6" placeholder="Optional">
          </div>
          <div class="mb-0">
            <label class="form-label">Account Status</label>
            <select class="form-select" name="is_active" id="editActive">
              <option value="1">Active</option>
              <option value="0">Inactive — signs user out</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="agent-btn agent-btn--ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="agent-btn agent-btn--primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
  var modalEl = document.getElementById('editUserModal');
  var form = document.getElementById('editUserForm');
  var modal = modalEl ? new bootstrap.Modal(modalEl) : null;

  document.querySelectorAll('.js-edit-user').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-id');
      form.action = '/sales/admin/users/' + id + '/update';
      document.getElementById('editName').value = btn.getAttribute('data-name') || '';
      document.getElementById('editEmail').value = btn.getAttribute('data-email') || '';
      document.getElementById('editRole').value = btn.getAttribute('data-role') || 'agent';
      document.getElementById('editActive').value = btn.getAttribute('data-active') || '1';
      if (modal) modal.show();
    });
  });
})();
</script>
</body>
</html>
