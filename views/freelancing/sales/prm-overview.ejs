<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/sales/sales.css?v=4">
  <style>.prm-tick { color: #10b981; } .prm-cross { color: #ef4444; }</style>
</head>
<body>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="topbar">
      <div>
        <div class="topTitle"><%= pageTitle %></div>
        <div class="topSub">View project report sections (headings, subheadings, body). Min. <%= minHeadings %> headings per source code. Click Edit to manage.</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger mb-3"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success mb-3"><%= success %></div>
    <% } %>

    <div class="crm-card mb-3">
      <div class="p-3 d-flex flex-wrap gap-3 align-items-center">
        <a class="btn btn-sm <%= filters.tab === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>" href="/sales/admin/project-report-manager<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>">All</a>
        <a class="btn btn-sm <%= filters.tab === 'pending' ? 'btn-warning' : 'btn-outline-secondary' %>" href="/sales/admin/project-report-manager?tab=pending<%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>">
          Pending (<%= stats.pending %>)
        </a>
        <a class="btn btn-sm <%= filters.tab === 'complete' ? 'btn-success' : 'btn-outline-secondary' %>" href="/sales/admin/project-report-manager?tab=complete<%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>">
          Complete (<%= stats.complete %>)
        </a>
        <form method="GET" action="/sales/admin/project-report-manager" class="d-flex align-items-center gap-2">
          <input type="hidden" name="tab" value="<%= filters.tab %>">
          <input type="search" name="q" class="form-control form-control-sm" style="width:200px;" value="<%= filters.q || '' %>" placeholder="Search name…">
          <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
        </form>
      </div>
    </div>

    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="fw-bold">Source Code List (Report Sections)</div>
        <div class="mutedSmall">Headings X/<%= minHeadings %>. ✓ = complete, ✗ = missing. Click Edit to add/update report sections. Admin can verify completed work.</div>
      </div>

      <div class="p-3">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th style="width:50px;">ID</th>
                <th>Name</th>
                <th>Category</th>
                <th style="width:120px;">Headings</th>
                <th>Admin Verified</th>
                <th style="width:240px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!rows.length) { %>
                <tr><td colspan="6" class="py-4 mutedSmall">No source codes found.</td></tr>
              <% } %>
              <% (rows || []).forEach(function(r){ %>
                <tr>
                  <td class="fw-semibold">#<%= r.id %></td>
                  <td><%= r.name || '-' %></td>
                  <td><span class="badge bg-secondary"><%= r.category || '-' %></span></td>
                  <td>
                    <% if (r.hasEnoughHeadings) { %>
                    <i class="bi bi-check-circle-fill prm-tick" title="<%= r.reportSectionCount %>/<%= minHeadings %>">✓</i> <%= r.reportSectionCount %>/<%= minHeadings %>
                    <% } else { %>
                    <i class="bi bi-x-circle-fill prm-cross" title="<%= r.reportSectionCount %>/<%= minHeadings %>"></i> <%= r.reportSectionCount %>/<%= minHeadings %> <span class="text-warning">(−<%= r.missingCount || 0 %>)</span>
                    <% } %>
                  </td>
                  <td class="small">
                    <% if (r.prm_report_verified) { %>
                    <span class="text-success">✓ Verified</span>
                    <% } else { %>
                    <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <a class="btn btn-sm btn-primary me-1" href="/project-report-manager/edit/<%= r.id %>">Edit Report Sections</a>
                    <% if (r.hasEnoughHeadings && !r.prm_report_verified) { %>
                    <button type="button" class="btn btn-sm btn-success verify-btn" data-id="<%= r.id %>">Verify</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('.verify-btn').forEach(function(btn){
  btn.addEventListener('click', async function(){
    const id = this.dataset.id;
    const res = await fetch('/sales/api/admin/project-report-manager/' + id + '/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: ''
    });
    const j = await res.json();
    if (j.ok) { window.location.reload(); } else { alert(j.message || 'Failed'); }
  });
});
</script>

</body>
</html>
