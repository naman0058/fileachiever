<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'Project Report Manager' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Project Report Manager</h1>
        <p>Track report section completion per product — minimum <%= minHeadings %> headings required. Verify before publishing.</p>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'prm', activeTab: 'overview' }) %>

    <% if (error) { %><div class="admin-alert admin-alert--danger"><%= error %></div><% } %>
    <% if (success) { %><div class="admin-alert admin-alert--success"><%= success %></div><% } %>

    <div class="agent-metrics mb-3" style="grid-template-columns:repeat(3,1fr);max-width:720px;">
      <div class="agent-metric" style="--metric-accent:#6366f1;--metric-bg:#eef2ff;">
        <div class="agent-metric__label">Total Products</div>
        <div class="agent-metric__value"><%= stats.total %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#f59e0b;--metric-bg:#fffbeb;">
        <div class="agent-metric__label">Incomplete</div>
        <div class="agent-metric__value"><%= stats.pending %></div>
      </div>
      <div class="agent-metric" style="--metric-accent:#16a34a;--metric-bg:#f0fdf4;">
        <div class="agent-metric__label">Complete</div>
        <div class="agent-metric__value"><%= stats.complete %></div>
      </div>
    </div>

    <div class="admin-filter-bar">
      <a class="admin-filter-pill <%= filters.tab === 'all' ? 'is-active' : '' %>" href="/sales/admin/project-report-manager<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>">All</a>
      <a class="admin-filter-pill <%= filters.tab === 'pending' ? 'is-active is-active--warn' : '' %>" href="/sales/admin/project-report-manager?tab=pending<%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>">
        Pending <span class="admin-filter-pill__count">(<%= stats.pending %>)</span>
      </a>
      <a class="admin-filter-pill <%= filters.tab === 'complete' ? 'is-active is-active--ok' : '' %>" href="/sales/admin/project-report-manager?tab=complete<%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %>">
        Complete <span class="admin-filter-pill__count">(<%= stats.complete %>)</span>
      </a>
      <form method="GET" action="/sales/admin/project-report-manager" class="ms-auto d-flex gap-2">
        <input type="hidden" name="tab" value="<%= filters.tab %>">
        <input type="search" name="q" class="form-control" style="max-width:220px;border-radius:12px;" value="<%= filters.q || '' %>" placeholder="Search products…">
        <button type="submit" class="agent-btn agent-btn--primary agent-btn--sm"><i class="bi bi-search"></i></button>
      </form>
    </div>

    <div class="agent-table-card">
      <div class="p-3 border-bottom"><div class="fw-bold">Report Sections</div><div class="crm-small">Min. <%= minHeadings %> headings per product</div></div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead><tr><th>ID</th><th>Product</th><th>Category</th><th>Headings</th><th>Verified</th><th>Actions</th></tr></thead>
          <tbody>
            <% if (!rows.length) { %><tr><td colspan="6" class="agent-empty"><i class="bi bi-file-earmark-text"></i>No products found.</td></tr><% } %>
            <% (rows || []).forEach(function(r){ %>
              <tr>
                <td><span class="crm-chip">#<%= r.id %></span></td>
                <td><strong><%= r.name || '—' %></strong></td>
                <td><span class="agent-badge agent-badge--muted"><%= r.category || '—' %></span></td>
                <td>
                  <% if (r.hasEnoughHeadings) { %>
                    <span class="admin-tick">✓</span> <%= r.reportSectionCount %>/<%= minHeadings %>
                  <% } else { %>
                    <span class="admin-cross">✗</span> <%= r.reportSectionCount %>/<%= minHeadings %>
                    <span class="crm-small text-warning">(−<%= r.missingCount || 0 %>)</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.prm_report_verified) { %><span class="admin-status admin-status--done">Verified</span>
                  <% } else { %><span class="crm-small">—</span><% } %>
                </td>
                <td>
                  <a class="agent-btn agent-btn--ghost agent-btn--sm" href="/project-report-manager/edit/<%= r.id %>"><i class="bi bi-pencil"></i> Edit</a>
                  <% if (r.hasEnoughHeadings && !r.prm_report_verified) { %>
                    <button type="button" class="agent-btn agent-btn--success agent-btn--sm verify-btn" data-id="<%= r.id %>">Verify</button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
<script>
document.querySelectorAll('.verify-btn').forEach(function(btn){
  btn.addEventListener('click', async function(){
    const res = await fetch('/sales/api/admin/project-report-manager/' + this.dataset.id + '/verify', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: '' });
    const j = await res.json();
    if (j.ok) window.location.reload(); else alert(j.message || 'Failed');
  });
});
</script>
</body>
</html>
