<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/admin-head', { pageTitle: 'Source Code Manager' }) %>
  <link rel="stylesheet" href="/sales/scm-dashboard.css?v=3">
</head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Source Code Manager</h1>
        <p>Enterprise catalog audit — track screenshots, demo links, UML diagrams, and database assets. Filter by gaps, verify completed work, and monitor completion across <%= stats.total %> products.</p>
      </div>
      <div class="agent-page-header__actions">
        <span class="agent-badge agent-badge--muted" style="font-size:12px;padding:8px 14px;">
          <i class="bi bi-pie-chart me-1"></i><%= stats.completionRate %>% catalog complete
        </span>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'scm', activeTab: 'overview' }) %>

    <% if (error) { %><div class="admin-alert admin-alert--danger"><i class="bi bi-exclamation-circle"></i> <%= error %></div><% } %>
    <% if (success) { %><div class="admin-alert admin-alert--success"><i class="bi bi-check-circle"></i> <%= success %></div><% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/scm-catalog-dashboard', {
      basePath: '/sales/admin/source-code-manager',
      screenshotsApiPrefix: '/sales/api/admin/source-code-manager',
      rows, stats, chartData, categoryList, filters, buildQuery,
      isAdmin: true
    }) %>
  </main>
</div>

<script>
document.querySelectorAll('.verify-btn').forEach(function(btn){
  btn.addEventListener('click', async function(){
    if (!confirm('Mark this product as admin-verified?')) return;
    const res = await fetch('/sales/api/admin/source-code-manager/' + this.dataset.id + '/verify', {
      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'field=' + encodeURIComponent(this.dataset.field)
    });
    const j = await res.json();
    if (j.ok) window.location.reload(); else alert(j.message || 'Failed');
  });
});
</script>
</body>
</html>
