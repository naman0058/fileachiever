<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/sales/sales.css?v=4">
</head>
<body>

<div class="crm-layout">
  <aside class="crm-sidebar-wrap">
    <%- include('partials/sidebar', { user, active }) %>
  </aside>

  <main class="crm-main">

    <div class="topbar">
      <div>
        <div class="topTitle"><%= pageTitle %></div>
        <div class="topSub">Add and manage setup support team members. They will log in and receive assigned requests.</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger mb-3"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert alert-success mb-3"><%= success %></div>
    <% } %>

    <div class="crm-card mb-4">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="fw-bold">Add Setup Support Employee</div>
      </div>
      <div class="p-3">
        <form method="POST" action="/sales/admin/setup-support/employees" class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Name</label>
            <input class="form-control" name="name" required placeholder="Employee name">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Email (login)</label>
            <input class="form-control" type="email" name="email" required placeholder="email@example.com">
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Password</label>
            <input class="form-control" type="password" name="password" required placeholder="Initial password">
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-primary">Add Employee</button>
          </div>
        </form>
      </div>
    </div>

    <div class="crm-card">
      <div class="p-3 border-bottom" style="border-color: var(--line) !important;">
        <div class="fw-bold">Setup Support Employees</div>
        <div class="mutedSmall">Total: <%= employees.length %></div>
      </div>
      <div class="p-3">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <% if (!employees.length) { %>
                <tr><td colspan="5" class="py-4 mutedSmall">No setup support employees yet. Add one above.</td></tr>
              <% } %>
              <% employees.forEach(function(e){ %>
                <tr>
                  <td>#<%= e.id %></td>
                  <td class="fw-semibold"><%= e.name %></td>
                  <td><%= e.email %></td>
                  <td><span class="badge <%= e.is_active ? 'bg-success' : 'bg-secondary' %>"><%= e.is_active ? 'Active' : 'Inactive' %></span></td>
                  <td class="mutedSmall"><%= e.created_at ? new Date(e.created_at).toLocaleDateString() : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>

</body>
</html>
