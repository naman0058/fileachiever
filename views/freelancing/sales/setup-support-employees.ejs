<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/admin-head', { pageTitle: 'Setup Support Team' }) %></head>
<body class="agent-crm admin-crm">
<div class="agent-shell">
  <div class="agent-sidebar-wrap"><%- include('partials/admin-sidebar', { user, active }) %></div>
  <main class="agent-main">
    <header class="agent-page-header">
      <div>
        <h1>Setup Support Team</h1>
        <p>Add and manage setup support staff. They log in at <code>/setup-support</code> to receive assigned requests.</p>
      </div>
    </header>

    <%- include('partials/admin-module-tabs', { module: 'setupSupport', activeTab: 'employees' }) %>

    <% if (error) { %><div class="admin-alert admin-alert--danger"><i class="bi bi-exclamation-circle"></i><%= error %></div><% } %>
    <% if (success) { %><div class="admin-alert admin-alert--success"><i class="bi bi-check-circle"></i><%= success %></div><% } %>

    <div class="admin-form-card mb-3">
      <div class="admin-form-card__head">
        <div class="admin-form-card__title">Add Team Member</div>
        <div class="admin-form-card__sub">Creates login credentials for the setup support portal</div>
      </div>
      <div class="admin-form-card__body">
        <form method="POST" action="/sales/admin/setup-support/employees" class="row g-3 align-items-end">
          <div class="col-md-4">
            <label class="form-label">Full Name</label>
            <input class="form-control" name="name" required placeholder="Employee name">
          </div>
          <div class="col-md-4">
            <label class="form-label">Email (login)</label>
            <input class="form-control" type="email" name="email" required placeholder="email@example.com">
          </div>
          <div class="col-md-4">
            <label class="form-label">Initial Password</label>
            <input class="form-control" type="password" name="password" required placeholder="Min. 6 characters">
          </div>
          <div class="col-12">
            <button type="submit" class="agent-btn agent-btn--primary"><i class="bi bi-person-plus"></i> Add Employee</button>
          </div>
        </form>
      </div>
    </div>

    <div class="agent-table-card">
      <div class="p-3 border-bottom"><div class="fw-bold">Team Directory</div><div class="crm-small"><%= employees.length %> members</div></div>
      <div class="crm-table-wrap table-responsive">
        <table class="crm-table">
          <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Status</th><th>Joined</th></tr></thead>
          <tbody>
            <% if (!employees.length) { %>
              <tr><td colspan="5" class="agent-empty"><i class="bi bi-people"></i>No team members yet.</td></tr>
            <% } %>
            <% employees.forEach(function(e){ %>
              <tr>
                <td><span class="crm-chip">#<%= e.id %></span></td>
                <td><strong><%= e.name %></strong></td>
                <td><%= e.email %></td>
                <td><span class="admin-status <%= e.is_active ? 'admin-status--active' : 'admin-status--inactive' %>"><%= e.is_active ? 'Active' : 'Inactive' %></span></td>
                <td class="crm-small"><%= e.created_at ? new Date(e.created_at).toLocaleDateString() : '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
