<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/portal-head', { pageTitle: 'Edit · ' + (sc.name || 'Product') }) %>
  <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/sales/scm-edit.css?v=1">
</head>
<body class="scm-portal">
<% var p = product || {}; %>
<% var ringClass = p.completionPct >= 100 ? '' : (p.completionPct >= 50 ? 'scm-edit-hero__ring--mid' : 'scm-edit-hero__ring--low'); %>
<div class="scm-portal-layout">
  <%- include('partials/portal-sidebar', { user, stats, activeNav: 'edit' }) %>
  <div class="scm-portal-main">
    <%- include('partials/portal-topbar', { stats, pageHeading: 'Edit Product', showSearch: false }) %>
    <div class="scm-portal-content">
      <div class="scm-edit-hero">
        <div class="scm-edit-hero__main">
          <h1 class="scm-edit-hero__title"><%= sc.name || 'Product' %></h1>
          <div class="scm-edit-hero__meta">
            <span class="scm-edit-hero__id">#<%= sc.id %></span>
            <% if (sc.category) { %><span class="scm-edit-hero__cat"><i class="bi bi-tag"></i> <%= sc.category %></span><% } %>
            <span><%= (screenshots || []).length %> gallery · <%= diagramPresent || 0 %>/10 diagrams · <%= (dbScreenshots || []).length %> DB shots</span>
          </div>
          <div class="scm-edit-asset-strip mt-3">
            <span class="scm-edit-asset-pill <%= p.hasScreenshot ? 'scm-edit-asset-pill--ok' : 'scm-edit-asset-pill--miss' %>"><i class="bi bi-image"></i> Screenshots</span>
            <span class="scm-edit-asset-pill <%= p.hasDemo ? 'scm-edit-asset-pill--ok' : 'scm-edit-asset-pill--miss' %>"><i class="bi bi-link-45deg"></i> Demo</span>
            <span class="scm-edit-asset-pill <%= p.hasAllDiagrams ? 'scm-edit-asset-pill--ok' : 'scm-edit-asset-pill--partial' %>"><i class="bi bi-diagram-3"></i> Diagrams <%= p.diagramCount || 0 %>/10</span>
            <span class="scm-edit-asset-pill <%= p.hasDbScreenshots ? 'scm-edit-asset-pill--ok' : 'scm-edit-asset-pill--miss' %>"><i class="bi bi-database"></i> DB SS</span>
          </div>
        </div>
        <div class="scm-edit-hero__aside">
          <div class="scm-edit-hero__ring <%= ringClass %>" style="--pct:<%= p.completionPct || 0 %>"><span><%= p.completionPct || 0 %>%</span></div>
          <a href="/source-code-manager" class="scm-edit-btn scm-edit-btn--outline"><i class="bi bi-arrow-left"></i> Catalog</a>
        </div>
      </div>

      <% if (error) { %><div class="admin-alert admin-alert--danger mb-3"><i class="bi bi-exclamation-circle"></i> <%= error %></div><% } %>
      <% if (success) { %><div class="admin-alert admin-alert--success mb-3"><i class="bi bi-check-circle"></i> <%= success %></div><% } %>

      <nav class="scm-edit-nav" id="scmEditNav">
        <a class="scm-edit-nav__link is-active" href="#scm-section-context"><i class="bi bi-info-circle"></i> Context</a>
        <a class="scm-edit-nav__link" href="#scm-section-media"><i class="bi bi-play-circle"></i> Media & Demo</a>
        <a class="scm-edit-nav__link" href="#scm-section-gallery"><i class="bi bi-images"></i> Gallery <span class="scm-edit-nav__badge"><%= (screenshots || []).length %></span></a>
        <a class="scm-edit-nav__link" href="#scm-section-diagrams"><i class="bi bi-diagram-3"></i> Diagrams <span class="scm-edit-nav__badge"><%= diagramPresent || 0 %>/10</span></a>
        <a class="scm-edit-nav__link" href="#scm-section-database"><i class="bi bi-database"></i> Database <span class="scm-edit-nav__badge"><%= (dbScreenshots || []).length %></span></a>
      </nav>

      <div class="scm-portal-edit-wrap">

        <!-- Project context -->
        <section class="scm-edit-panel" id="scm-section-context">
          <div class="scm-edit-panel__head">
            <div class="scm-edit-panel__head-left">
              <h2 class="scm-edit-panel__title"><i class="bi bi-journal-text"></i> Project Context</h2>
              <p class="scm-edit-panel__sub">Reference material for screenshots, diagrams, and database documentation</p>
            </div>
          </div>
          <div class="scm-edit-panel__body">
            <div class="scm-edit-context-grid">
              <div class="scm-edit-context-item scm-edit-context-item--full">
                <div class="scm-edit-context-item__label">Description</div>
                <div class="scm-edit-context-item__value"><%= sc.description || sc.short_description || '—' %></div>
              </div>
              <% if (sc.admin_features && String(sc.admin_features).trim()) { %>
              <div class="scm-edit-context-item scm-edit-context-item--full">
                <div class="scm-edit-context-item__label">Admin Features</div>
                <div class="scm-edit-context-html"><%- sc.admin_features %></div>
              </div>
              <% } %>
              <% if (sc.user_features && String(sc.user_features).trim()) { %>
              <div class="scm-edit-context-item scm-edit-context-item--full">
                <div class="scm-edit-context-item__label">User Features</div>
                <div class="scm-edit-context-html"><%- sc.user_features %></div>
              </div>
              <% } %>
              <% if (sc.other_features && String(sc.other_features).trim()) { %>
              <div class="scm-edit-context-item scm-edit-context-item--full">
                <div class="scm-edit-context-item__label">Other Features</div>
                <div class="scm-edit-context-html"><%- sc.other_features %></div>
              </div>
              <% } %>
              <% if (sc.functionality && String(sc.functionality).trim()) { %>
              <div class="scm-edit-context-item scm-edit-context-item--full">
                <div class="scm-edit-context-item__label">Functionality</div>
                <div class="scm-edit-context-html"><%- sc.functionality %></div>
              </div>
              <% } %>
              <div class="scm-edit-context-item scm-edit-context-item--full">
                <div class="scm-edit-context-item__label">Project Files</div>
                <div class="scm-edit-files">
                  <% var readmeName = sc.readme_file && String(sc.readme_file).trim(); %>
                  <% var schemaName = sc.schema_file && String(sc.schema_file).trim(); %>
                  <% var sqlName = sc.sql_file && String(sc.sql_file).trim(); %>
                  <% if (readmeName) { %>
                    <a href="/images/<%= encodeURIComponent(readmeName) %>" class="scm-edit-file-btn" download target="_blank" rel="noopener"><i class="bi bi-file-earmark-text"></i> README</a>
                  <% } else { %><span class="scm-edit-file-btn scm-edit-file-btn--empty"><i class="bi bi-file-earmark-text"></i> README N/A</span><% } %>
                  <% if (schemaName) { %>
                    <a href="/images/<%= encodeURIComponent(schemaName) %>" class="scm-edit-file-btn" download target="_blank" rel="noopener"><i class="bi bi-file-earmark-code"></i> Schema</a>
                  <% } else { %><span class="scm-edit-file-btn scm-edit-file-btn--empty"><i class="bi bi-file-earmark-code"></i> Schema N/A</span><% } %>
                  <% if (sqlName) { %>
                    <a href="/images/<%= encodeURIComponent(sqlName) %>" class="scm-edit-file-btn" download target="_blank" rel="noopener"><i class="bi bi-filetype-sql"></i> SQL</a>
                  <% } else { %><span class="scm-edit-file-btn scm-edit-file-btn--empty"><i class="bi bi-filetype-sql"></i> SQL N/A</span><% } %>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Media & demo -->
        <section class="scm-edit-panel" id="scm-section-media">
          <div class="scm-edit-panel__head">
            <div class="scm-edit-panel__head-left">
              <h2 class="scm-edit-panel__title"><i class="bi bi-play-circle"></i> Media & Demo</h2>
              <p class="scm-edit-panel__sub">Cover image and live demo URL — required for catalog completion</p>
            </div>
          </div>
          <div class="scm-edit-panel__body">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="scm-edit-field">
                  <label class="scm-edit-field__label">
                    Main Cover Image
                    <span class="scm-edit-status <%= hasScreenshot ? 'scm-edit-status--ok' : 'scm-edit-status--miss' %>">
                      <i class="bi bi-<%= hasScreenshot ? 'check-circle-fill' : 'x-circle-fill' %>"></i> <%= hasScreenshot ? 'Present' : 'Missing' %>
                    </span>
                  </label>
                  <input type="url" id="imageUrl" class="form-control" placeholder="https://cdn.example.com/cover.jpg" value="<%= sc.image || '' %>">
                  <div class="scm-edit-field__hint">Primary thumbnail shown in the product catalog</div>
                  <% if (sc.image && String(sc.image).trim()) { %>
                  <div class="mt-2">
                    <img
                      src="<%= cloudinaryUrl(sc.image, { width: 320 }) %>"
                      alt="Cover preview"
                      class="scm-edit-gallery-item__thumb"
                      width="200"
                      height="144"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <% } %>
                  <button type="button" class="scm-edit-btn scm-edit-btn--primary mt-2" id="btnSaveImage"><i class="bi bi-check2"></i> Save Image</button>
                </div>
              </div>
              <div class="col-md-6">
                <div class="scm-edit-field">
                  <label class="scm-edit-field__label">
                    Live Demo URL
                    <span class="scm-edit-status <%= hasDemo ? 'scm-edit-status--ok' : 'scm-edit-status--miss' %>">
                      <i class="bi bi-<%= hasDemo ? 'check-circle-fill' : 'x-circle-fill' %>"></i> <%= hasDemo ? 'Present' : 'Missing' %>
                    </span>
                  </label>
                  <input type="url" id="demoUrl" class="form-control" placeholder="https://demo.example.com" value="<%= sc.demo_url || '' %>">
                  <div class="scm-edit-field__hint">Working demo link for sales and verification</div>
                  <button type="button" class="scm-edit-btn scm-edit-btn--primary mt-2" id="btnSaveDemo"><i class="bi bi-check2"></i> Save Demo</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Screenshot gallery -->
        <section class="scm-edit-panel" id="scm-section-gallery">
          <div class="scm-edit-panel__head">
            <div class="scm-edit-panel__head-left">
              <h2 class="scm-edit-panel__title"><i class="bi bi-images"></i> Screenshot Gallery</h2>
              <p class="scm-edit-panel__sub">Input/output design screenshots for the product listing</p>
            </div>
            <span class="scm-edit-status scm-edit-status--ok"><%= (screenshots || []).length %> items</span>
          </div>
          <div class="scm-edit-panel__body">
            <div class="scm-edit-grid-2">
              <div>
                <div class="scm-edit-field">
                  <label class="scm-edit-field__label">Add New Screenshot</label>
                  <input type="url" id="screenshotUrl" class="form-control mb-2" placeholder="https://example.com/screen.jpg">
                  <div class="row g-2 mb-2">
                    <div class="col-md-6">
                      <select id="screenshotType" class="form-select">
                        <option value="input_design">Input Design</option>
                        <option value="output_design">Output Design</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <input type="text" id="screenshotName" class="form-control" placeholder="Label e.g. Login Screen">
                    </div>
                  </div>
                  <button type="button" class="scm-edit-btn scm-edit-btn--outline" id="btnAddScreenshot"><i class="bi bi-plus-lg"></i> Add to Gallery</button>
                </div>
              </div>
              <div>
                <label class="scm-edit-field__label mb-2">Current Gallery</label>
                <% if (screenshots.length) { %>
                <div class="scm-edit-gallery">
                  <% screenshots.forEach(function(s){ %>
                  <div class="scm-edit-gallery-item screenshot-item" data-sid="<%= s.id %>">
                    <img src="<%= cloudinaryUrl(s.url, { width: 200 }) %>" alt="<%= s.name || 'Screenshot' %>" class="scm-edit-gallery-item__thumb" width="100" height="72" loading="lazy" decoding="async" onerror="this.src='';this.classList.add('bg-light')">
                    <div class="scm-edit-gallery-item__body">
                      <input type="url" class="form-control form-control-sm screenshot-url-input mb-1" value="<%= s.url %>" placeholder="URL" data-sid="<%= s.id %>">
                      <div class="row g-1 mb-1">
                        <div class="col-6">
                          <select class="form-select form-select-sm screenshot-type-input" data-sid="<%= s.id %>">
                            <option value="input_design" <%= (s.type || 'input_design') === 'input_design' ? 'selected' : '' %>>Input</option>
                            <option value="output_design" <%= (s.type || '') === 'output_design' ? 'selected' : '' %>>Output</option>
                          </select>
                        </div>
                        <div class="col-6">
                          <input type="text" class="form-control form-control-sm screenshot-name-input" value="<%= s.name || '' %>" placeholder="Name" data-sid="<%= s.id %>">
                        </div>
                      </div>
                      <div class="scm-edit-gallery-item__actions">
                        <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--primary screenshot-edit-btn" data-sid="<%= s.id %>">Save</button>
                        <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--danger screenshot-delete-btn" data-sid="<%= s.id %>">Delete</button>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                </div>
                <% } else { %>
                <div class="scm-edit-gallery-empty"><i class="bi bi-image"></i>No screenshots yet — add URLs above</div>
                <% } %>
              </div>
            </div>
          </div>
        </section>

        <!-- Diagrams -->
        <section class="scm-edit-panel" id="scm-section-diagrams">
          <div class="scm-edit-panel__head">
            <div class="scm-edit-panel__head-left">
              <h2 class="scm-edit-panel__title"><i class="bi bi-diagram-3"></i> UML & Architecture Diagrams</h2>
              <p class="scm-edit-panel__sub">10 required diagram types — ER, DFD levels, use case, class, activity, sequence, flow chart, system architecture</p>
            </div>
            <span class="scm-edit-status <%= p.hasAllDiagrams ? 'scm-edit-status--ok' : 'scm-edit-status--miss' %>"><%= diagramPresent || 0 %>/10 uploaded</span>
          </div>
          <div class="scm-edit-panel__body">
            <div class="scm-edit-diagram-grid">
              <% (diagramTypes || []).forEach(function(dt){ %>
              <% var existingUrl = (diagramsMap || {})[dt.key]; var hasDiagram = !!(existingUrl && String(existingUrl).trim()); %>
              <div class="scm-edit-diagram-card diagram-item <%= hasDiagram ? 'scm-edit-diagram-card--done' : '' %>" data-type="<%= dt.key %>">
                <div class="scm-edit-diagram-card__top">
                  <span class="scm-edit-diagram-card__label"><%= dt.label %></span>
                  <span class="scm-edit-status <%= hasDiagram ? 'scm-edit-status--ok' : 'scm-edit-status--miss' %>"><%= hasDiagram ? 'Done' : 'Missing' %></span>
                </div>
                <input type="url" class="form-control form-control-sm diagram-url-input" placeholder="https://..." value="<%= existingUrl || '' %>" data-type="<%= dt.key %>">
                <div class="scm-edit-diagram-card__actions">
                  <% if (hasDiagram) { %>
                    <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--primary diagram-update-btn flex-grow-1" data-type="<%= dt.key %>">Update</button>
                    <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--danger diagram-delete-btn" data-type="<%= dt.key %>"><i class="bi bi-trash"></i></button>
                  <% } else { %>
                    <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--primary diagram-add-btn w-100" data-type="<%= dt.key %>"><i class="bi bi-plus-lg"></i> Add Diagram</button>
                  <% } %>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </section>

        <!-- Database screenshots -->
        <section class="scm-edit-panel" id="scm-section-database">
          <div class="scm-edit-panel__head">
            <div class="scm-edit-panel__head-left">
              <h2 class="scm-edit-panel__title"><i class="bi bi-database"></i> Database Screenshots</h2>
              <p class="scm-edit-panel__sub">Schema captures with optional datatable documentation per table</p>
            </div>
            <span class="scm-edit-status <%= p.hasDbScreenshots ? 'scm-edit-status--ok' : 'scm-edit-status--miss' %>"><%= (dbScreenshots || []).length %> records</span>
          </div>
          <div class="scm-edit-panel__body">
            <div class="scm-edit-db-grid">
              <div>
                <div class="scm-edit-field">
                  <label class="scm-edit-field__label">Add Database Screenshot</label>
                  <input type="text" id="dbScreenshotName" class="form-control mb-2" placeholder="Table name e.g. users">
                  <input type="url" id="dbScreenshotUrl" class="form-control mb-2" placeholder="Screenshot URL">
                  <label class="scm-edit-field__label mt-2">Data Table (optional)</label>
                  <div id="dbScreenshotDataTableAdd" class="datatable-editor-wrap"></div>
                  <button type="button" class="scm-edit-btn scm-edit-btn--primary mt-3" id="btnAddDbScreenshot"><i class="bi bi-plus-lg"></i> Add Record</button>
                </div>
              </div>
              <div>
                <label class="scm-edit-field__label mb-2">Existing Records</label>
                <% if ((dbScreenshots || []).length) { %>
                  <% (dbScreenshots || []).forEach(function(ds){ %>
                  <% var hasDatatable = !!(ds.data_table && String(ds.data_table).trim()); %>
                  <div class="scm-edit-db-item db-screenshot-item" data-dsid="<%= ds.id %>">
                    <div class="scm-edit-db-item__head">
                      <img src="<%= cloudinaryUrl(ds.url, { width: 200 }) %>" alt="<%= ds.name %>" class="scm-edit-gallery-item__thumb" width="100" height="72" loading="lazy" decoding="async" onerror="this.style.display='none'">
                      <div class="flex-grow-1 min-w-0">
                        <input type="text" class="form-control form-control-sm db-screenshot-name-input mb-1" value="<%= ds.name || '' %>" placeholder="Name" data-dsid="<%= ds.id %>">
                        <input type="url" class="form-control form-control-sm db-screenshot-url-input mb-1" value="<%= ds.url %>" placeholder="URL" data-dsid="<%= ds.id %>">
                        <span class="scm-edit-status <%= hasDatatable ? 'scm-edit-status--ok' : 'scm-edit-status--miss' %>"><%= hasDatatable ? 'Datatable present' : 'Datatable missing' %></span>
                        <div class="scm-edit-gallery-item__actions mt-2">
                          <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--primary db-screenshot-edit-btn" data-dsid="<%= ds.id %>">Save</button>
                          <button type="button" class="scm-edit-btn scm-edit-btn--sm scm-edit-btn--danger db-screenshot-delete-btn" data-dsid="<%= ds.id %>">Delete</button>
                        </div>
                      </div>
                    </div>
                    <div class="scm-edit-db-item__editor">
                      <label class="scm-edit-field__label">Data Table Editor</label>
                      <div id="data-table-editor-<%= ds.id %>" class="datatable-editor-wrap" data-initial="<%- (ds.data_table || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"></div>
                    </div>
                  </div>
                  <% }) %>
                <% } else { %>
                  <div class="scm-edit-gallery-empty"><i class="bi bi-database"></i>No database screenshots yet</div>
                <% } %>
              </div>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>
</div>

<div class="toast-container scm-edit-toast-wrap">
  <div id="scmEditToast" class="toast align-items-center text-bg-dark border-0">
    <div class="d-flex">
      <div class="toast-body" id="scmEditToastBody">Saved</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
<script>
const scId = <%= sc.id %>;
function scmToast(msg, reload) {
  const el = document.getElementById('scmEditToast');
  document.getElementById('scmEditToastBody').textContent = msg || 'Done';
  bootstrap.Toast.getOrCreateInstance(el, { delay: reload ? 1200 : 2200 }).show();
  if (reload) setTimeout(function(){ location.reload(); }, 1300);
}
(function(){
  var nav = document.getElementById('scmEditNav');
  if (!nav) return;
  var links = nav.querySelectorAll('.scm-edit-nav__link');
  var sections = [];
  links.forEach(function(a){
    var id = (a.getAttribute('href') || '').replace('#','');
    if (id) sections.push({ link: a, el: document.getElementById(id) });
  });
  function onScroll(){
    var y = window.scrollY + 160;
    var current = sections[0];
    sections.forEach(function(s){ if (s.el && s.el.offsetTop <= y) current = s; });
    links.forEach(function(l){ l.classList.remove('is-active'); });
    if (current && current.link) current.link.classList.add('is-active');
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
var datatableNoteOpts = {
  placeholder: 'Create table or paste data...',
  height: 150, minHeight: 120,
  toolbar: [['style',['bold','italic']],['insert',['link','table']]],
  fontNames: [], fontSize: [],
  callbacks: {
    onPaste: function(e) {
      setTimeout(function() {
        var $ed = $(e.target).closest('.note-editor').find('.note-editable');
        if (!$ed.length && $(e.target).hasClass('note-editable')) $ed = $(e.target);
        $ed.find('[style]').each(function() {
          var s = ((this.getAttribute('style')||'').replace(/\bfont-family\s*:[^;]*;?/gi,'').replace(/\bfont-size\s*:[^;]*;?/gi,'').replace(/\s*;\s*/g,';').replace(/^;|;$/g,'').trim());
          if (s) this.setAttribute('style',s); else this.removeAttribute('style');
        });
      }, 50);
    }
  }
};
$(function() {
  var $addEditor = $('#dbScreenshotDataTableAdd');
  if ($addEditor.length) $addEditor.summernote(datatableNoteOpts);
  $('.datatable-editor-wrap[data-initial]').each(function() {
    var $el = $(this);
    if ($el.attr('id') && $el.attr('id') !== 'dbScreenshotDataTableAdd') {
      var initial = $el.attr('data-initial') || '';
      $el.summernote(datatableNoteOpts);
      if (initial) $el.summernote('code', initial);
    }
  });
});
document.getElementById('btnSaveImage').onclick = async function(){
  const url = document.getElementById('imageUrl').value.trim();
  if (!url) return alert('Enter image URL');
  const res = await fetch('/source-code-manager/api/' + scId + '/image', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'url=' + encodeURIComponent(url) });
  const j = await res.json();
  if (j.ok) scmToast('Cover image saved', true); else alert(j.message || 'Failed');
};
document.getElementById('btnSaveDemo').onclick = async function(){
  const url = document.getElementById('demoUrl').value.trim();
  if (!url) return alert('Enter demo URL');
  const res = await fetch('/source-code-manager/api/' + scId + '/demo', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'url=' + encodeURIComponent(url) });
  const j = await res.json();
  if (j.ok) scmToast('Demo link saved', true); else alert(j.message || 'Failed');
};
document.getElementById('btnAddScreenshot').onclick = async function(){
  const url = document.getElementById('screenshotUrl').value.trim();
