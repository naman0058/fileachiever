});
document.querySelectorAll('.db-screenshot-edit-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    const dsid = this.dataset.dsid;
    const item = this.closest('.db-screenshot-item');
    const url = (item.querySelector('.db-screenshot-url-input')?.value || '').trim();
    const name = (item.querySelector('.db-screenshot-name-input')?.value || '').trim();
    let dataTable = '';
    try { dataTable = ($('#data-table-editor-' + dsid).summernote('code') || '').toString().trim(); } catch(e) {}
    if (!url || !name) return alert('Enter name and URL');
    const res = await fetch('/source-code-manager/api/' + scId + '/database-screenshots/' + dsid, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ url, name, data_table: dataTable }) });
    const j = await res.json();
    if (j.ok) scmToast('Database record saved', true); else alert(j.message || 'Failed');
  });
});
document.querySelectorAll('.db-screenshot-delete-btn').forEach(function(btn) {
