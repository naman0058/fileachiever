<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/portal-head', { pageTitle: 'Catalog Dashboard' }) %></head>
<body class="scm-portal">

<% var pageHeading = 'Catalog Dashboard'; %>
<% var showOverview = activeNav === 'overview'; %>
<% var filterLabels = {
  gaps: 'Work Queue — Has Gaps',
  'missing-screenshot': 'Missing Screenshots',
  'missing-demo': 'Missing Demo Links',
  'only-demo': 'Demo Only — Rest Incomplete',
  'missing-diagrams': 'Incomplete Diagrams',
  'missing-db': 'Missing DB Screenshots',
  complete: 'Fully Complete Products',
  verified: 'Admin Verified',
  unverified: 'Pending Admin Review'
}; %>
<% var filterLabel = !showOverview ? (filterLabels[activeNav] || null) : null; %>

<div class="scm-portal-layout">
  <%- include('partials/portal-sidebar', { user, stats, activeNav }) %>
  <div class="scm-portal-main">
    <%- include('partials/portal-topbar', { stats, filters, pageHeading, showSearch: true }) %>
    <div class="scm-portal-content">
      <header class="scm-portal-page-head">
        <h1><%= pageHeading %></h1>
        <p>Manage screenshots, demo links, UML diagrams, and database assets across the full product catalog. <strong><%= stats.completionRate %>%</strong> of <%= stats.total %> products are fully complete.</p>
      </header>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <%- include('../freelancing/sales/partials/scm-catalog-dashboard', {
        basePath: '/source-code-manager',
        screenshotsApiPrefix: '/source-code-manager/api',
        rows, stats, chartData, categoryList, filters, buildQuery,
        isAdmin: false,
        showOverview,
        filterLabel
      }) %>
    </div>
  </div>
</div>

<%- include('partials/portal-scripts') %>
</body>
</html>
