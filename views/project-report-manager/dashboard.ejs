<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/portal-head', { pageTitle: 'Report Dashboard' }) %></head>
<body class="scm-portal">

<% var pageHeading = 'Report Dashboard'; %>
<% var showOverview = activeNav === 'overview'; %>
<% var filterLabels = {
  gaps: 'Work Queue — Incomplete',
  'missing-empty': 'Zero Headings',
  'missing-partial': 'Partial Reports',
  complete: 'Complete Reports',
  verified: 'Admin Verified',
  unverified: 'Pending Admin Review'
}; %>
<% var filterLabel = !showOverview ? (filterLabels[activeNav] || null) : null; %>

<div class="scm-portal-layout">
  <%- include('partials/portal-sidebar', { user, stats, activeNav, minHeadings }) %>
  <div class="scm-portal-main">
    <%- include('partials/portal-topbar', { stats, filters, pageHeading, showSearch: true }) %>
    <div class="scm-portal-content">
      <header class="scm-portal-page-head">
        <h1><%= pageHeading %></h1>
        <p>Write and maintain project report headings and body content. Minimum <strong><%= minHeadings %> headings</strong> per product — <strong><%= stats.completionRate %>%</strong> of <%= stats.total %> products are complete.</p>
      </header>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <%- include('../freelancing/sales/partials/prm-catalog-dashboard', {
        basePath: '/project-report-manager',
        rows, stats, chartData, categoryList, filters, buildQuery,
        minHeadings,
        isAdmin: false,
        showOverview,
        filterLabel
      }) %>
    </div>
  </div>
</div>
<%- include('partials/portal-scripts') %>
</body>
</html>
