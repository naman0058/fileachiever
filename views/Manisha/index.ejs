<% include ./header.ejs %>
<%
function portfolioIcon(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('banner') >= 0) return 'bi-images';
  if (n.indexOf('logo') >= 0) return 'bi-palette';
  if (n.indexOf('thumbnail') >= 0) return 'bi-youtube';
  if (n.indexOf('t-shirt') >= 0 || n.indexOf('shirt') >= 0) return 'bi-handbag';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0) return 'bi-box-seam';
  if (n.indexOf('video') >= 0 || n.indexOf('animation') >= 0) return 'bi-camera-video';
  if (n.indexOf('motion') >= 0) return 'bi-play-circle';
  if (n.indexOf('character') >= 0) return 'bi-person-bounding-box';
  if (n.indexOf('brand') >= 0) return 'bi-stars';
  if (n.indexOf('invitation') >= 0 || n.indexOf('pamph') >= 0) return 'bi-file-earmark-text';
  if (n.indexOf('gif') >= 0) return 'bi-filetype-gif';
  if (n.indexOf('ppt') >= 0) return 'bi-easel';
  return 'bi-collection';
}
function formatFolderTitle(name) {
  if (!name) return 'Work';
  return name.split(' ').map(function(part) {
    if (/^\d/.test(part)) return part;
    return part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
  }).join(' ');
}
function formatFolderShort(name) {
  var t = formatFolderTitle(name);
  if (t.length <= 10) return t;
  return t.split(' ')[0];
}
var allFolders = typeof folders !== 'undefined' && folders ? folders : [];
var byFolder = typeof portfolioByFolder !== 'undefined' ? portfolioByFolder : {};
var mix = typeof featuredMix !== 'undefined' ? featuredMix : [];
var catThemes = ['indigo', 'violet', 'rose', 'cyan', 'amber', 'emerald', 'indigo', 'violet'];
var heroCarousel = [
  { url: 'https://res.cloudinary.com/dr5dofa3x/image/upload/v1743240514/Thumbnail/xoeojgmutaavc53ao0hw.jpg', title: 'Kids Brand Logo', cat: 'Logo Design', link: '/works/LOGO' },
  { url: 'https://res.cloudinary.com/dr5dofa3x/image/upload/v1743238934/BANNERS/ykqjk24ustrjnklz6cty.jpg', title: 'World Cup Campaign', cat: 'Digital Ads', link: '/works/BANNERS' },
  { url: 'https://res.cloudinary.com/dr5dofa3x/image/upload/v1743238926/BANNERS/tfx3nfmjuh1ei2lsfpng.jpg', title: 'Festive Branding', cat: 'Banner Design', link: '/works/BANNERS' },
  { url: 'https://res.cloudinary.com/dr5dofa3x/image/upload/v1743238908/BANNERS/jxkiikjazual5tkozs5w.jpg', title: 'Cinematic Promo', cat: 'Banner Design', link: '/works/BANNERS' },
  { url: 'https://res.cloudinary.com/dr5dofa3x/image/upload/v1743238725/BANNERS/h2d2gyjjbgh9cwh2yye4.jpg', title: 'Product Launch', cat: 'Banner Design', link: '/works/BANNERS' }
];
var homeWorkCategories = [
  { folder: 'BANNERS', label: 'Banners', icon: 'bi-images', theme: 'indigo' },
  { folder: 'LOGO', label: 'Logo', icon: 'bi-palette', theme: 'violet' },
  { folder: 'Thumbnail', label: 'Thumbnail', icon: 'bi-youtube', theme: 'rose' },
  { folder: 'T-SHIRT DESIGN', label: 'T-Shirt Design', icon: 'bi-handbag', theme: 'cyan' },
  { folder: 'Catalog', label: 'Catalog', icon: 'bi-journal-richtext', theme: 'amber' },
  { folder: 'PRODUCT AND PACKAGING', label: 'Packaging Design', icon: 'bi-box-seam', theme: 'emerald' },
  { folder: 'LABEL DESIGN', label: 'Label Design', icon: 'bi-tag', theme: 'indigo' },
  { folder: 'Content Writing', label: 'Content Writing', icon: 'bi-pencil-square', theme: 'violet' },
  { folder: 'MOTION GRPAHICS', label: 'Reels', icon: 'bi-phone', theme: 'rose' },
  { folder: 'PROMOTIONAL VIDEO', label: 'Promotional Video', icon: 'bi-camera-video', theme: 'cyan' },
  { folder: 'EXPLAINER VIDEO', label: 'Explainer Video', icon: 'bi-play-circle', theme: 'amber' }
];
var homePortfolioSections = [
  { folder: 'LOGO', title: 'Logo Design', theme: 'violet', icon: 'bi-palette', subtitle: 'Brand identity' },
  { folder: 'BANNERS', title: 'Banner Design', theme: 'rose', icon: 'bi-images', subtitle: 'Digital campaigns' },
  { folder: 'PRODUCT AND PACKAGING', title: 'Packaging Design', theme: 'emerald', icon: 'bi-box-seam', subtitle: 'Retail & product' },
  { folder: 'LABEL DESIGN', title: 'Label Design', theme: 'indigo', icon: 'bi-tag', subtitle: 'Print-ready labels' }
];
%>

<!-- ═══ MOBILE APP HOME ═══ -->
<div class="mc-app-home mc-mobile-only">

  <!-- Hero: featured carousel -->
  <section class="mc-app-hero">
    <% include ./partials/app-hero-carousel.ejs %>
  </section>

  <!-- All work — curated category grid -->
  <section class="mc-app-section mc-app-section--grid">
    <div class="mc-container">
    <div class="mc-app-section-head">
      <h2 class="mc-app-section-head__title">All work</h2>
    </div>
    <div class="mc-app-cat-grid">
      <% for (var ci = 0; ci < homeWorkCategories.length; ci++) {
        var cat = homeWorkCategories[ci];
      %>
      <a href="/works/<%= encodeURIComponent(cat.folder) %>" class="mc-app-cat-item mc-app-cat-item--<%= cat.theme %>">
        <span class="mc-app-cat-item__icon"><i class="bi <%= cat.icon %>"></i></span>
        <span class="mc-app-cat-item__label"><%= cat.label %></span>
      </a>
      <% } %>
      <a href="/works" class="mc-app-cat-item mc-app-cat-item--all">
        <span class="mc-app-cat-item__icon"><i class="bi bi-grid"></i></span>
        <span class="mc-app-cat-item__label">View All Work</span>
      </a>
    </div>
    </div>
  </section>

  <!-- Featured designs mix -->
  <% if (mix.length) { %>
  <section class="mc-app-section mc-app-section--spotlight">
    <div class="mc-container">
    <div class="mc-app-section-head">
      <h2 class="mc-app-section-head__title">Featured designs</h2>
      <a href="/works" class="mc-app-section-head__link">View all</a>
    </div>
    <div class="mc-app-spotlight-grid">
      <% for (var mi = 0; mi < mix.length; mi++) {
        var m = mix[mi];
        var mTitle = formatFolderTitle(m.folder);
      %>
      <a href="/works/<%= encodeURIComponent(m.folder) %>" class="mc-app-spotlight">
        <img src="<%= m.url %>" alt="<%= mTitle %>" loading="lazy">
        <span class="mc-app-spotlight__label"><%= mTitle %></span>
      </a>
      <% } %>
    </div>
    </div>
  </section>
  <% } %>

  <!-- Portfolio by category — production showcase -->
  <section class="mc-app-feed">
    <div class="mc-container">
      <div class="mc-app-feed__head">
        <span class="mc-app-feed__eyebrow">Showcase</span>
        <h2 class="mc-app-feed__title">Portfolio by category</h2>
        <p class="mc-app-feed__sub">Swipe through curated work — production quality for global brands</p>
      </div>
    </div>
    <div class="mc-app-feed__list">
    <% for (var fi = 0; fi < homePortfolioSections.length; fi++) {
      var portSection = homePortfolioSections[fi];
      var folderName = portSection.folder;
      var folderSlides = byFolder[folderName] || [];
      if (!folderSlides.length) continue;
      slides = folderSlides.slice(0, 5);
      title = portSection.title;
      link = '/works/' + encodeURIComponent(folderName);
      theme = portSection.theme;
      icon = portSection.icon;
      subtitle = portSection.subtitle;
    %>
    <% include ./partials/app-slider.ejs %>
    <% } %>
    </div>
  </section>

  <!-- Mobile CTA -->
  <section class="mc-app-cta">
    <div class="mc-container">
    <div class="mc-app-cta__card">
      <span class="mc-app-cta__eyebrow">Start your project</span>
      <h2 class="mc-app-cta__title">Get production-ready creative for your brand</h2>
      <p class="mc-app-cta__sub">1,200+ clients · Fast turnaround · WhatsApp quotes</p>
      <a href="https://wa.me/918877152035" class="mc-btn mc-btn--whatsapp mc-btn--lg mc-btn--block" target="_blank" rel="noopener">
        <i class="bi bi-whatsapp"></i> Get a free quote
      </a>
    </div>
    </div>
  </section>
</div>

