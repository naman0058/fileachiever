<% include ./header.ejs %>
<%
function formatFolderTitle(name) {
  if (!name) return 'Project';
  return name.split(' ').map(function(part) {
    if (/^\d/.test(part)) return part;
    return part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
  }).join(' ');
}
function portfolioCategory(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('logo') >= 0) return 'Branding';
  if (n.indexOf('banner') >= 0) return 'Digital ads';
  if (n.indexOf('animation') >= 0 || n.indexOf('video') >= 0 || n.indexOf('motion') >= 0) return 'Video & motion';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0 || n.indexOf('label') >= 0) return 'Packaging';
  if (n.indexOf('thumbnail') >= 0) return 'Social & YouTube';
  if (n.indexOf('character') >= 0 || n.indexOf('comic') >= 0) return 'Character design';
  if (n.indexOf('invitation') >= 0 || n.indexOf('pamph') >= 0 || n.indexOf('broch') >= 0) return 'Print design';
  return 'Creative work';
}
function portfolioIcon(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('banner') >= 0) return 'bi-images';
  if (n.indexOf('logo') >= 0) return 'bi-palette';
  if (n.indexOf('thumbnail') >= 0) return 'bi-youtube';
  if (n.indexOf('animation') >= 0 || n.indexOf('video') >= 0) return 'bi-camera-video';
  if (n.indexOf('motion') >= 0) return 'bi-play-circle';
  if (n.indexOf('character') >= 0) return 'bi-person-bounding-box';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0) return 'bi-box-seam';
  return 'bi-collection';
}
function isVideoUrl(url) {
  var ext = (url || '').split('.').pop().toLowerCase().split('?')[0];
  return ext === 'mp4' || ext === 'webm' || ext === 'mov';
}

var displayName = formatFolderTitle(folderName);
var category = portfolioCategory(folderName);
var icon = portfolioIcon(folderName);
var itemCount = result ? result.length : 0;
var imageCount = 0;
var videoCount = 0;
if (result) {
  for (var ci = 0; ci < result.length; ci++) {
    if (isVideoUrl(result[ci].image_url)) videoCount++;
    else imageCount++;
  }
}
var related = typeof relatedFolders !== 'undefined' && relatedFolders ? relatedFolders : [];
var cardThemes = ['indigo', 'violet', 'rose', 'cyan', 'amber', 'emerald'];
%>

<section class="mc-work-detail__hero">
  <div class="mc-container">
    <a href="/works" class="mc-back-link"><i class="bi bi-arrow-left"></i> Portfolio</a>

    <div class="mc-work-detail__head">
      <div class="mc-work-detail__intro">
        <div class="mc-work-detail__icon"><i class="bi <%= icon %>"></i></div>
        <div>
          <span class="mc-work-detail__cat"><%= category %></span>
          <h1 class="mc-work-detail__title"><%= displayName %></h1>
          <p class="mc-work-detail__sub">Premium <%= category.toLowerCase() %> crafted for brands that want to stand out and convert.</p>
        </div>
      </div>

      <div class="mc-work-detail__stats">
        <div class="mc-work-detail__stat">
          <span class="mc-work-detail__stat-val"><%= itemCount %></span>
          <span class="mc-work-detail__stat-lbl">Projects</span>
        </div>
        <% if (imageCount) { %>
        <div class="mc-work-detail__stat">
          <span class="mc-work-detail__stat-val"><%= imageCount %></span>
          <span class="mc-work-detail__stat-lbl">Images</span>
        </div>
        <% } %>
        <% if (videoCount) { %>
        <div class="mc-work-detail__stat">
          <span class="mc-work-detail__stat-val"><%= videoCount %></span>
          <span class="mc-work-detail__stat-lbl">Videos</span>
        </div>
        <% } %>
      </div>

      <div class="mc-page-hero__chips">
        <span class="mc-chip"><i class="bi bi-lightning-charge"></i> Fast turnaround</span>
        <span class="mc-chip"><i class="bi bi-shield-check"></i> 1,200+ clients</span>
        <span class="mc-chip mc-desktop-only"><i class="bi bi-globe2"></i> Worldwide delivery</span>
      </div>

      <div class="mc-work-detail__actions mc-desktop-only">
        <a href="https://wa.me/918877152035?text=Hi%20Manisha%2C%20I%20saw%20your%20<%= encodeURIComponent(displayName) %>%20work%20and%20want%20something%20similar." class="mc-btn mc-btn--whatsapp mc-btn--lg" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp"></i> Get similar work
        </a>
        <a href="tel:8877152035" class="mc-btn mc-btn--outline mc-btn--lg">
          <i class="bi bi-telephone"></i> Call now
        </a>
      </div>
    </div>

    <aside class="mc-work-detail__quote mc-desktop-only">
      <p class="mc-work-detail__quote-label">Start your project</p>
      <h2 class="mc-work-detail__quote-title">Want <%= displayName.toLowerCase() %> like this?</h2>
      <p class="mc-work-detail__quote-text">Share your brief on WhatsApp — most clients get a quote within a few hours.</p>
      <ul class="mc-work-detail__quote-list">
        <li><i class="bi bi-check-circle-fill"></i> Clear scope & pricing</li>
        <li><i class="bi bi-check-circle-fill"></i> Revisions until you're happy</li>
        <li><i class="bi bi-check-circle-fill"></i> Launch-ready deliverables</li>
      </ul>
      <a href="https://wa.me/918877152035?text=Hi%20Manisha%2C%20I%20saw%20your%20<%= encodeURIComponent(displayName) %>%20portfolio%20and%20want%20to%20discuss%20a%20project." class="mc-btn mc-btn--whatsapp mc-btn--block mc-btn--lg" target="_blank" rel="noopener">
        <i class="bi bi-whatsapp"></i> Message on WhatsApp
      </a>
    </aside>
  </div>
</section>

<% if (itemCount) { %>
<section class="mc-work-detail__gallery-wrap">
  <div class="mc-container">
    <div class="mc-section-bar">
      <div>
        <span class="mc-section-bar__eyebrow">Gallery</span>
        <h2 class="mc-section-bar__title">Selected work</h2>
      </div>
      <span class="mc-work-detail__count"><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></span>
    </div>

    <% var featured = result[0]; var featuredUrl = featured.image_url; var featuredIsVideo = isVideoUrl(featuredUrl); %>
    <div class="mc-work-detail__featured">
      <% if (featuredIsVideo) { %>
      <div class="mc-work-detail__tile mc-work-detail__tile--featured mc-work-detail__tile--video">
        <video controls playsinline poster="">
          <source src="<%= featuredUrl %>" type="video/<%= featuredUrl.split('.').pop().toLowerCase().split('?')[0] === 'mov' ? 'mp4' : featuredUrl.split('.').pop().toLowerCase().split('?')[0] %>">
        </video>
        <span class="mc-work-detail__badge"><i class="bi bi-play-fill"></i> Featured video</span>
      </div>
      <% } else { %>
      <button type="button" class="mc-work-detail__tile mc-work-detail__tile--featured mc-work-detail__tile--img" data-lightbox="<%= featuredUrl %>" data-alt="<%= displayName %> — featured">
        <img src="<%= featuredUrl %>" alt="<%= displayName %> — featured" loading="eager">
        <span class="mc-work-detail__tile-overlay"><i class="bi bi-arrows-fullscreen"></i> Tap to expand</span>
        <span class="mc-work-detail__badge"><i class="bi bi-star-fill"></i> Featured</span>
      </button>
      <% } %>
    </div>

    <% if (itemCount > 1) { %>
    <div class="mc-work-detail__grid">
      <% for (var i = 1; i < result.length; i++) {
        var url = result[i].image_url;
        var isVideo = isVideoUrl(url);
        var ext = url.split('.').pop().toLowerCase().split('?')[0];
      %>
      <% if (isVideo) { %>
      <div class="mc-work-detail__tile mc-work-detail__tile--video">
        <video controls playsinline preload="metadata">
          <source src="<%= url %>" type="video/<%= ext === 'mov' ? 'mp4' : ext %>">
        </video>
        <span class="mc-work-detail__badge mc-work-detail__badge--sm"><i class="bi bi-play-fill"></i> Video</span>
      </div>
      <% } else { %>
      <button type="button" class="mc-work-detail__tile mc-work-detail__tile--img" data-lightbox="<%= url %>" data-alt="<%= displayName %> work <%= i + 1 %>">
        <img src="<%= url %>" alt="<%= displayName %> work <%= i + 1 %>" loading="lazy">
        <span class="mc-work-detail__tile-overlay"><i class="bi bi-zoom-in"></i></span>
      </button>
      <% } %>
      <% } %>
    </div>
    <% } %>
  </div>
</section>
<% } else { %>
<section class="mc-work-detail__empty">
  <div class="mc-container">
    <div class="mc-work-detail__empty-card">
      <i class="bi bi-folder2-open"></i>
      <h2>Projects coming soon</h2>
      <p>We're updating this category. Meanwhile, browse other portfolio work or message us on WhatsApp.</p>
      <a href="/works" class="mc-btn mc-btn--outline">Browse portfolio</a>
    </div>
  </div>
</section>
<% } %>

<section class="mc-work-detail__convert">
  <div class="mc-container">
    <div class="mc-work-detail__steps">
      <div class="mc-work-detail__step">
        <span class="mc-work-detail__step-num">1</span>
        <div>
          <h3>Share your brief</h3>
          <p>Goals, references & timeline on WhatsApp</p>
        </div>
      </div>
      <div class="mc-work-detail__step">
        <span class="mc-work-detail__step-num">2</span>
        <div>
          <h3>Get a clear quote</h3>
          <p>Scope and pricing before we start</p>
        </div>
      </div>
      <div class="mc-work-detail__step">
        <span class="mc-work-detail__step-num">3</span>
        <div>
          <h3>Receive final files</h3>
          <p>Polished assets ready to launch</p>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="mc-work-detail__related">
  <div class="mc-container">
    <div class="mc-section-bar">
      <div>
        <span class="mc-section-bar__eyebrow">Explore more</span>
        <h2 class="mc-section-bar__title">Other categories</h2>
      </div>
      <a href="/works" class="mc-section-bar__link">View all <i class="bi bi-chevron-right"></i></a>
    </div>
    <div class="mc-work-detail__related-grid">
      <% for (var ri = 0; ri < related.length; ri++) {
        var rf = related[ri].folder_name;
        var rTheme = cardThemes[ri % cardThemes.length];
        var rIcon = portfolioIcon(rf);
        var rTitle = formatFolderTitle(rf);
      %>
      <a href="/works/<%= encodeURIComponent(rf) %>" class="mc-work-detail__related-card mc-work-detail__related-card--<%= rTheme %>">
        <span class="mc-work-detail__related-icon"><i class="bi <%= rIcon %>"></i></span>
        <span class="mc-work-detail__related-title"><%= rTitle %></span>
        <i class="bi bi-arrow-up-right mc-work-detail__related-arrow"></i>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<section class="mc-home-block mc-home-block--cta">
  <div class="mc-container">
    <div class="mc-home-final-cta">
      <h2>Ready for <%= displayName.toLowerCase() %> like this?</h2>
      <p>Most clients hear back within a few hours on WhatsApp.</p>
      <a href="https://wa.me/918877152035?text=Hi%20Manisha%2C%20I%20loved%20your%20<%= encodeURIComponent(displayName) %>%20work.%20Can%20we%20discuss%20my%20project%3F" class="mc-btn mc-btn--whatsapp mc-btn--lg mc-btn--block" target="_blank" rel="noopener">
        <i class="bi bi-whatsapp"></i> Start on WhatsApp
      </a>
    </div>
  </div>
</section>

<div class="mc-work-detail__sticky mc-mobile-only">
  <a href="https://wa.me/918877152035?text=Hi%20Manisha%2C%20I%20saw%20your%20<%= encodeURIComponent(displayName) %>%20work%20and%20want%20something%20similar." class="mc-work-detail__sticky-btn" target="_blank" rel="noopener">
    <i class="bi bi-whatsapp"></i>
    <span>Get similar work</span>
  </a>
</div>

<div class="mc-lightbox" id="mcLightbox" aria-hidden="true">
  <button type="button" class="mc-lightbox__close" id="mcLightboxClose" aria-label="Close"><i class="bi bi-x-lg"></i></button>
  <button type="button" class="mc-lightbox__nav mc-lightbox__nav--prev" id="mcLightboxPrev" aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
  <img class="mc-lightbox__img" id="mcLightboxImg" src="" alt="">
  <button type="button" class="mc-lightbox__nav mc-lightbox__nav--next" id="mcLightboxNext" aria-label="Next"><i class="bi bi-chevron-right"></i></button>
</div>

<script>
(function(){
  var tiles = [].slice.call(document.querySelectorAll('[data-lightbox]'));
  if (!tiles.length) return;

  var box = document.getElementById('mcLightbox');
  var img = document.getElementById('mcLightboxImg');
  var closeBtn = document.getElementById('mcLightboxClose');
  var prevBtn = document.getElementById('mcLightboxPrev');
  var nextBtn = document.getElementById('mcLightboxNext');
  var urls = tiles.map(function(t){ return t.getAttribute('data-lightbox'); });
  var index = 0;

  function openAt(i) {
    index = i;
    img.src = urls[index];
    img.alt = tiles[index].getAttribute('data-alt') || '';
    box.classList.add('is-open');
    box.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeBox() {
    box.classList.remove('is-open');
    box.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    img.src = '';
  }
  function step(dir) {
    index = (index + dir + urls.length) % urls.length;
    img.src = urls[index];
    img.alt = tiles[index].getAttribute('data-alt') || '';
  }

  tiles.forEach(function(tile, i) {
    tile.addEventListener('click', function(){ openAt(i); });
  });
  closeBtn.addEventListener('click', closeBox);
  box.addEventListener('click', function(e){ if (e.target === box) closeBox(); });
  prevBtn.addEventListener('click', function(e){ e.stopPropagation(); step(-1); });
  nextBtn.addEventListener('click', function(e){ e.stopPropagation(); step(1); });
  document.addEventListener('keydown', function(e) {
    if (!box.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeBox();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
})();
</script>

<% include ./footer.ejs %>
