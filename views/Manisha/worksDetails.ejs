<% include ./header.ejs %>
<%
function formatFolderTitle(name) {
  if (!name) return 'Project';
  return name.split(' ').map(function(part) {
    if (/^\d/.test(part)) return part;
    return part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
  }).join(' ');
}
function portfolioCategory(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('logo') >= 0) return 'Brand Identity';
  if (n.indexOf('banner') >= 0) return 'Digital Advertising';
  if (n.indexOf('animation') >= 0 || n.indexOf('video') >= 0 || n.indexOf('motion') >= 0) return 'Video & Motion';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0 || n.indexOf('label') >= 0) return 'Packaging Design';
  if (n.indexOf('thumbnail') >= 0) return 'Social & YouTube';
  if (n.indexOf('character') >= 0 || n.indexOf('comic') >= 0) return 'Character Design';
  if (n.indexOf('invitation') >= 0 || n.indexOf('pamph') >= 0 || n.indexOf('broch') >= 0) return 'Print Design';
  if (n.indexOf('content') >= 0) return 'Content & Copy';
  if (n.indexOf('catalog') >= 0) return 'Catalog Design';
  if (n.indexOf('t-shirt') >= 0 || n.indexOf('shirt') >= 0) return 'Merchandise Design';
  return 'Creative Studio';
}
function portfolioIcon(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('banner') >= 0) return 'bi-images';
  if (n.indexOf('logo') >= 0) return 'bi-palette';
  if (n.indexOf('thumbnail') >= 0) return 'bi-youtube';
  if (n.indexOf('animation') >= 0 || n.indexOf('video') >= 0) return 'bi-camera-video';
  if (n.indexOf('motion') >= 0) return 'bi-play-circle';
  if (n.indexOf('character') >= 0) return 'bi-person-bounding-box';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0) return 'bi-box-seam';
  if (n.indexOf('content') >= 0) return 'bi-pencil-square';
  return 'bi-collection';
}
function portfolioScope(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('logo') >= 0) return 'End-to-end brand identity systems for startups and established businesses.';
  if (n.indexOf('banner') >= 0) return 'High-impact digital banners for ads, websites, and social campaigns.';
  if (n.indexOf('video') >= 0 || n.indexOf('motion') >= 0) return 'Story-driven motion content built for engagement and conversion.';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0) return 'Retail-ready packaging that elevates shelf presence and brand recall.';
  if (n.indexOf('thumbnail') >= 0) return 'Click-worthy thumbnails engineered to boost views and watch time.';
  return 'Strategic creative execution tailored to your brand goals and audience.';
}
function portfolioDeliverables(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('logo') >= 0) return ['Logo suite', 'Color palette', 'Brand files'];
  if (n.indexOf('banner') >= 0) return ['Ad creatives', 'Web banners', 'Social sizes'];
  if (n.indexOf('video') >= 0 || n.indexOf('motion') >= 0) return ['Edited video', 'Motion graphics', 'Export formats'];
  if (n.indexOf('packaging') >= 0) return ['Pack dielines', 'Print-ready art', 'Mockups'];
  if (n.indexOf('thumbnail') >= 0) return ['YouTube thumbs', 'A/B variants', 'Source files'];
  return ['Concept direction', 'Final deliverables', 'Revision rounds'];
}
function isVideoUrl(url) {
  var ext = (url || '').split('.').pop().toLowerCase().split('?')[0];
  return ext === 'mp4' || ext === 'webm' || ext === 'mov';
}

var displayName = formatFolderTitle(folderName);
var category = portfolioCategory(folderName);
var icon = portfolioIcon(folderName);
var scope = portfolioScope(folderName);
var deliverables = portfolioDeliverables(folderName);
var itemCount = result ? result.length : 0;
var imageCount = 0;
var videoCount = 0;
if (result) {
  for (var ci = 0; ci < result.length; ci++) {
    if (isVideoUrl(result[ci].image_url)) videoCount++;
    else imageCount++;
  }
}
var related = typeof relatedFolders !== 'undefined' && relatedFolders ? relatedFolders : [];
var cardThemes = ['indigo', 'violet', 'rose', 'cyan', 'amber', 'emerald'];
var coverItem = itemCount ? result[0] : null;
var coverUrl = coverItem && !isVideoUrl(coverItem.image_url) ? coverItem.image_url : null;
var coverIsVideo = coverItem && isVideoUrl(coverItem.image_url);
var waSimilar = 'https://wa.me/918877152035?text=Hi%20Manisha%2C%20I%20saw%20your%20' + encodeURIComponent(displayName) + '%20work%20and%20want%20something%20similar.';
var waDiscuss = 'https://wa.me/918877152035?text=Hi%20Manisha%2C%20I%20saw%20your%20' + encodeURIComponent(displayName) + '%20portfolio%20and%20want%20to%20discuss%20a%20project.';
%>

<!-- ═══ COVER HERO ═══ -->
<section class="mc-case-hero<%= coverUrl ? ' mc-case-hero--has-cover' : '' %><%= coverIsVideo ? ' mc-case-hero--video' : '' %>">
  <% if (coverUrl) { %>
  <div class="mc-case-hero__bg" style="background-image:url('<%= coverUrl %>')" aria-hidden="true"></div>
  <% } %>
  <div class="mc-case-hero__overlay" aria-hidden="true"></div>

  <div class="mc-container mc-case-hero__inner">
    <nav class="mc-case-crumb" aria-label="Breadcrumb">
      <a href="/"><i class="bi bi-house"></i></a>
      <span class="mc-case-crumb__sep"><i class="bi bi-chevron-right"></i></span>
      <a href="/works">Portfolio</a>
      <span class="mc-case-crumb__sep"><i class="bi bi-chevron-right"></i></span>
      <span class="mc-case-crumb__current"><%= displayName %></span>
    </nav>

    <div class="mc-case-hero__main">
      <div class="mc-case-hero__badge"><i class="bi <%= icon %>"></i> <%= category %></div>
      <h1 class="mc-case-hero__title"><%= displayName %></h1>
      <p class="mc-case-hero__lead"><%= scope %></p>

    
    </div>
  </div>
</section>

<% if (itemCount) { %>
<!-- ═══ MAIN CASE STUDY BODY ═══ -->
<div class="mc-case-body">
  <div class="mc-container mc-case-body__grid">

    <main class="mc-case-main">

      <!-- Overview -->
    

      <!-- Gallery -->
      <section class="mc-case-gallery-section">
        <header class="mc-case-panel__head mc-case-panel__head--row">
          <div>
            <span class="mc-case-panel__eyebrow">Project gallery</span>
          </div>
        </header>

        <% if (coverIsVideo) { %>
        <div class="mc-case-gallery__hero mc-case-gallery__hero--video">
          <video controls playsinline preload="metadata">
            <source src="<%= coverItem.image_url %>" type="video/<%= coverItem.image_url.split('.').pop().toLowerCase().split('?')[0] === 'mov' ? 'mp4' : coverItem.image_url.split('.').pop().toLowerCase().split('?')[0] %>">
          </video>
          <span class="mc-case-gallery__badge"><i class="bi bi-play-fill"></i> Featured video</span>
        </div>
        <% } else if (coverUrl) { %>
        <button type="button" class="mc-case-gallery__hero mc-case-gallery__hero--img" data-lightbox="<%= coverUrl %>" data-alt="<%= displayName %> — featured">
          <img src="<%= coverUrl %>" alt="<%= displayName %> — featured" loading="eager">
          <span class="mc-case-gallery__hero-overlay">
            <i class="bi bi-arrows-fullscreen"></i>
            <span>View full size</span>
          </span>
          <span class="mc-case-gallery__badge"><i class="bi bi-star-fill"></i> Featured</span>
        </button>
        <% } %>

        <% if (itemCount > 1) { %>
        <div class="mc-case-gallery">
          <% for (var i = (coverIsVideo || coverUrl ? 1 : 0); i < result.length; i++) {
            var url = result[i].image_url;
            var isVideo = isVideoUrl(url);
            var ext = url.split('.').pop().toLowerCase().split('?')[0];
          %>
          <% if (isVideo) { %>
          <div class="mc-case-gallery__item mc-case-gallery__item--video">
            <video controls playsinline preload="metadata">
              <source src="<%= url %>" type="video/<%= ext === 'mov' ? 'mp4' : ext %>">
            </video>
            <span class="mc-case-gallery__badge mc-case-gallery__badge--sm"><i class="bi bi-play-fill"></i> Video</span>
          </div>
          <% } else { %>
          <button type="button" class="mc-case-gallery__item mc-case-gallery__item--img" data-lightbox="<%= url %>" data-alt="<%= displayName %> — <%= i + 1 %>">
            <img src="<%= url %>" alt="<%= displayName %> — <%= i + 1 %>" loading="lazy">
            <span class="mc-case-gallery__item-overlay"><i class="bi bi-zoom-in"></i></span>
          </button>
          <% } %>
          <% } %>
        </div>
        <% } %>
      </section>

      <!-- Process -->
      <section class="mc-case-process">
        <header class="mc-case-panel__head">
          <span class="mc-case-panel__eyebrow">How we work</span>
          <h2 class="mc-case-panel__title">From brief to delivery</h2>
        </header>
        <div class="mc-case-process__track">
          <div class="mc-case-process__step">
            <div class="mc-case-process__icon"><i class="bi bi-chat-dots"></i></div>
            <div class="mc-case-process__content">
              <span class="mc-case-process__num">01</span>
              <h3>Share your brief</h3>
              <p>Tell us your goals, references, and timeline on WhatsApp.</p>
            </div>
          </div>
          <div class="mc-case-process__step">
            <div class="mc-case-process__icon"><i class="bi bi-receipt"></i></div>
            <div class="mc-case-process__content">
              <span class="mc-case-process__num">02</span>
              <h3>Get a clear quote</h3>
              <p>Transparent scope and pricing before any work begins.</p>
            </div>
          </div>
          <div class="mc-case-process__step">
            <div class="mc-case-process__icon"><i class="bi bi-rocket-takeoff"></i></div>
            <div class="mc-case-process__content">
              <span class="mc-case-process__num">03</span>
              <h3>Receive final files</h3>
              <p>Polished, launch-ready assets delivered on schedule.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Desktop sidebar -->
    <aside class="mc-case-sidebar mc-desktop-only">
      <div class="mc-case-inquiry mc-case-inquiry--sticky">
        <div class="mc-case-inquiry__trust">
          <i class="bi bi-star-fill"></i>
          <span>Trusted by <strong>1,200+</strong> clients</span>
        </div>
        <div class="mc-case-inquiry__head">
          <span class="mc-case-inquiry__eyebrow">Start your project</span>
          <h3 class="mc-case-inquiry__title">Want <%= displayName.toLowerCase() %> like this?</h3>
          <p class="mc-case-inquiry__text">Message us on WhatsApp with your requirements. We typically respond within a few hours.</p>
        </div>
        <ul class="mc-case-inquiry__list">
          <li><i class="bi bi-check-circle-fill"></i> Dedicated creative direction</li>
          <li><i class="bi bi-check-circle-fill"></i> Unlimited revision rounds</li>
          <li><i class="bi bi-check-circle-fill"></i> Source &amp; export files included</li>
          <li><i class="bi bi-check-circle-fill"></i> Worldwide delivery</li>
        </ul>
        <a href="<%= waDiscuss %>" class="mc-btn mc-btn--whatsapp mc-btn--block mc-btn--lg" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp"></i> Message on WhatsApp
        </a>
        <a href="tel:8877152035" class="mc-btn mc-btn--outline mc-btn--block mc-btn--lg mc-case-inquiry__call">
          <i class="bi bi-telephone"></i> Call 8877152035
        </a>
        <div class="mc-case-inquiry__meta">
          <span><i class="bi bi-clock"></i> Avg. response: 2–4 hrs</span>
          <span><i class="bi bi-globe2"></i> 5+ countries served</span>
        </div>
      </div>
    </aside>
  </div>
</div>

<% } else { %>
<section class="mc-case-empty">
  <div class="mc-container">
    <div class="mc-case-empty__card">
      <div class="mc-case-empty__icon"><i class="bi bi-folder2-open"></i></div>
      <h2>Projects coming soon</h2>
      <p>We're updating this category with new work. Browse other portfolio categories or reach out on WhatsApp.</p>
      <div class="mc-case-empty__actions">
        <a href="/works" class="mc-btn mc-btn--primary mc-btn--lg">Browse portfolio</a>
        <a href="<%= waDiscuss %>" class="mc-btn mc-btn--outline mc-btn--lg" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp"></i> Contact us
        </a>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if (related.length) { %>
<section class="mc-case-related">
  <div class="mc-container">
    <header class="mc-case-panel__head mc-case-panel__head--row">
      <div>
        <span class="mc-case-panel__eyebrow">Explore more</span>
        <h2 class="mc-case-panel__title">More portfolio categories</h2>
      </div>
      <a href="/works" class="mc-case-related__all">View all <i class="bi bi-arrow-right"></i></a>
    </header>
    <div class="mc-case-related__grid">
      <% for (var ri = 0; ri < related.length; ri++) {
        var rf = related[ri].folder_name;
        var rTheme = cardThemes[ri % cardThemes.length];
        var rIcon = portfolioIcon(rf);
        var rTitle = formatFolderTitle(rf);
        var rCat = portfolioCategory(rf);
      %>
      <a href="/works/<%= encodeURIComponent(rf) %>" class="mc-case-related__card mc-case-related__card--<%= rTheme %>">
        <span class="mc-case-related__icon"><i class="bi <%= rIcon %>"></i></span>
        <span class="mc-case-related__cat"><%= rCat %></span>
        <span class="mc-case-related__name"><%= rTitle %></span>
        <i class="bi bi-arrow-up-right mc-case-related__arrow"></i>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- CTA band -->
<section class="mc-case-cta">
  <div class="mc-container mc-case-cta__inner">
    <div class="mc-case-cta__copy">
      <span class="mc-case-cta__eyebrow">Ready to start?</span>
      <h2>Let's create <%= displayName.toLowerCase() %> that converts</h2>
      <p>Join 1,200+ brands who trust us for design that drives results.</p>
    </div>
    <div class="mc-case-cta__actions">
      <a href="<%= waSimilar %>" class="mc-btn mc-btn--whatsapp mc-btn--lg" target="_blank" rel="noopener">
        <i class="bi bi-whatsapp"></i> Get similar work
      </a>
      <a href="/works" class="mc-btn mc-btn--ghost mc-btn--lg mc-desktop-only">Browse portfolio</a>
    </div>
  </div>
</section>

<!-- Mobile sticky CTA -->
<div class="mc-case-sticky mc-mobile-only">
  <a href="<%= waSimilar %>" class="mc-case-sticky__btn" target="_blank" rel="noopener">
    <i class="bi bi-whatsapp"></i>
    <span>Get similar work</span>
  </a>
</div>

<!-- Lightbox -->
<div class="mc-lightbox" id="mcLightbox" aria-hidden="true">
  <div class="mc-lightbox__backdrop"></div>
  <button type="button" class="mc-lightbox__close" id="mcLightboxClose" aria-label="Close"><i class="bi bi-x-lg"></i></button>
  <button type="button" class="mc-lightbox__nav mc-lightbox__nav--prev" id="mcLightboxPrev" aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
  <div class="mc-lightbox__stage">
    <img class="mc-lightbox__img" id="mcLightboxImg" src="" alt="">
    <span class="mc-lightbox__counter" id="mcLightboxCounter"></span>
  </div>
  <button type="button" class="mc-lightbox__nav mc-lightbox__nav--next" id="mcLightboxNext" aria-label="Next"><i class="bi bi-chevron-right"></i></button>
</div>

<script>
(function(){
  var tiles = [].slice.call(document.querySelectorAll('[data-lightbox]'));
  if (!tiles.length) return;

  var box = document.getElementById('mcLightbox');
  var img = document.getElementById('mcLightboxImg');
  var counter = document.getElementById('mcLightboxCounter');
  var closeBtn = document.getElementById('mcLightboxClose');
  var prevBtn = document.getElementById('mcLightboxPrev');
  var nextBtn = document.getElementById('mcLightboxNext');
  var urls = tiles.map(function(t){ return t.getAttribute('data-lightbox'); });
  var index = 0;
  var touchStartX = 0;
  var touchStartY = 0;

  function updateView() {
    img.src = urls[index];
    img.alt = tiles[index].getAttribute('data-alt') || '';
    if (counter) counter.textContent = (index + 1) + ' / ' + urls.length;
    if (prevBtn) prevBtn.style.visibility = urls.length > 1 ? 'visible' : 'hidden';
    if (nextBtn) nextBtn.style.visibility = urls.length > 1 ? 'visible' : 'hidden';
  }
  function openAt(i) {
    index = i;
    updateView();
    box.classList.add('is-open');
    box.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeBox() {
    box.classList.remove('is-open');
    box.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    img.src = '';
  }
  function step(dir) {
    if (urls.length < 2) return;
    index = (index + dir + urls.length) % urls.length;
    updateView();
  }

  tiles.forEach(function(tile, i) {
    tile.addEventListener('click', function(){ openAt(i); });
  });
  closeBtn.addEventListener('click', function(e){ e.stopPropagation(); closeBox(); });
  box.addEventListener('click', function(e){
    if (e.target === box || e.target.classList.contains('mc-lightbox__backdrop')) closeBox();
  });
  prevBtn.addEventListener('click', function(e){ e.stopPropagation(); step(-1); });
  nextBtn.addEventListener('click', function(e){ e.stopPropagation(); step(1); });
  document.addEventListener('keydown', function(e) {
    if (!box.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeBox();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  box.addEventListener('touchstart', function(e) {
    if (!box.classList.contains('is-open')) return;
    touchStartX = e.changedTouches[0].clientX;
    touchStartY = e.changedTouches[0].clientY;
  }, { passive: true });

  box.addEventListener('touchend', function(e) {
    if (!box.classList.contains('is-open')) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    var dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
    step(dx > 0 ? -1 : 1);
  }, { passive: true });
})();
</script>

<% include ./footer.ejs %>
