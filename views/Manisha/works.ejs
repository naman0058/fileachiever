<% include ./header.ejs %>
<%
var cardThemes = ['indigo', 'violet', 'rose', 'cyan', 'amber', 'emerald'];
function portfolioIcon(name) {
  var n = (name || '').toLowerCase();
  if (n.indexOf('banner') >= 0) return 'bi-images';
  if (n.indexOf('logo') >= 0) return 'bi-palette';
  if (n.indexOf('thumbnail') >= 0) return 'bi-youtube';
  if (n.indexOf('t-shirt') >= 0 || n.indexOf('shirt') >= 0) return 'bi-handbag';
  if (n.indexOf('packaging') >= 0 || n.indexOf('product') >= 0) return 'bi-box-seam';
  if (n.indexOf('video') >= 0 || n.indexOf('animation') >= 0) return 'bi-camera-video';
  if (n.indexOf('motion') >= 0) return 'bi-play-circle';
  if (n.indexOf('brand') >= 0) return 'bi-stars';
  return 'bi-collection';
}
function formatFolderTitle(name) {
  if (!name) return 'Project';
  return name.replace(/\b\w/g, function(c) { return c.toUpperCase(); });
}
%>

<section class="mc-page-hero">
  <div class="mc-container">
    <h1 class="mc-page-hero__title">Portfolio</h1>
    <p class="mc-page-hero__sub">Browse projects across graphic design, video, animation, and branding — delivered for clients worldwide.</p>
  </div>
</section>

<section class="mc-section mc-section--alt mc-portfolio-section" style="padding-top:0;">
  <div class="mc-container">
    <% if (result && result.length) { %>
    <div class="mc-portfolio-grid">
      <% for (var i = 0; i < result.length; i++) {
        var folder = result[i].folder_name;
        var theme = cardThemes[i % cardThemes.length];
        var icon = portfolioIcon(folder);
        var title = formatFolderTitle(folder);
      %>
      <div class="mc-portfolio-grid__item">
        <a href="/works/<%= encodeURIComponent(folder) %>" class="mc-portfolio-card mc-portfolio-card--<%= theme %>">
          <span class="mc-portfolio-card__arrow"><i class="bi bi-arrow-up-right"></i></span>
          <div class="mc-portfolio-card__icon"><i class="bi <%= icon %>"></i></div>
          <div class="mc-portfolio-card__body">
            <h3 class="mc-portfolio-card__title"><%= title %></h3>
            <span class="mc-portfolio-card__meta">View projects</span>
          </div>
        </a>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <p style="text-align:center;color:#64748b;padding:48px 0;">Portfolio items coming soon.</p>
    <% } %>
  </div>
</section>

<section class="mc-section">
  <div class="mc-container">
    <div class="mc-cta">
      <h2 class="mc-cta__title">Like what you see?</h2>
      <p class="mc-cta__sub">Let's discuss your next project.</p>
      <div class="mc-cta__actions">
        <a href="https://wa.me/918877152035" class="mc-btn mc-btn--whatsapp mc-btn--lg" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp"></i> Get in touch
        </a>
      </div>
    </div>
  </div>
</section>

<% include ./footer.ejs %>
