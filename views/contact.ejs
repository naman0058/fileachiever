<style>
:root{
  --cu-ink:#0e1220;
  --cu-muted:#64748B;
  --cu-bg:#ffffff;
  --cu-card:#fff;
  --cu-blue:#2A47FF;
  --cu-orange:#F17F23;
  --cu-line:rgba(14,18,32,.08);
  --cu-radius:16px;
  --cu-shadow:0 10px 30px rgba(14,18,32,.06);
}
.cu-page{
  background:#ffffff;
  color:var(--cu-ink);
  padding-bottom:28px;
  --bl-navy:#0E1220;
  --bl-muted:#64748B;
  --bl-blue:#2A47FF;
}
.cu-wrap{ width:100%; max-width:none; margin:0; padding:0 20px; box-sizing:border-box; }

/* Main grid */
.cu-main{ padding:16px 0 8px; }
.cu-grid{
  display:grid;
  grid-template-columns:1.2fr .8fr;
  gap:14px;
  align-items:stretch;
}
.cu-grid > .cu-card,
.cu-grid > .cu-side{
  min-height:0;
  height:100%;
  box-sizing:border-box;
  align-self:stretch;
}
.cu-card{
  background:var(--cu-card);
  border:1px solid #E8ECF2;
  border-radius:12px;
  box-shadow:0 6px 18px rgba(14,18,32,.04);
  padding:16px 18px;
}
.cu-card__head{
  display:flex; align-items:center; gap:8px;
  margin-bottom:2px;
}
.cu-card__head h2,
.cu-card__head h3{
  margin:0; font-size:18px; font-weight:900; letter-spacing:-.01em; color:#0B1220;
}
.cu-card__ico{
  width:auto; height:auto; border-radius:0;
  display:inline-flex; align-items:center; justify-content:center;
  background:transparent; color:var(--cu-orange); flex-shrink:0;
  padding:0;
}
.cu-card__ico svg{ width:18px; height:18px; }
.cu-card__ico--blue{ background:transparent; color:var(--cu-orange); }
.cu-card__sub{
  margin:0 0 12px; color:#64748B; font-size:13px; font-weight:500; line-height:1.4;
}

.cu-alert{
  display:flex; align-items:center; gap:8px;
  margin-bottom:10px; padding:8px 10px;
  border-radius:10px; background:#ECFDF5; color:#047857;
  border:1px solid #A7F3D0; font-weight:700; font-size:12px;
}
.cu-alert svg{ width:15px; height:15px; }

/* Form */
.cu-form{ display:grid; gap:10px; }
.cu-form__row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.cu-field{ display:flex; flex-direction:column; gap:5px; min-width:0; }
.cu-field label{
  font-size:13px; font-weight:800; color:#0B1220;
}
.cu-field label span{ color:#EF4444; }
.cu-input{
  display:flex; align-items:center; gap:8px;
  min-height:40px; padding:0 11px;
  border:1px solid #E2E8F0; border-radius:9px; background:#fff;
  transition:border-color .15s ease, box-shadow .15s ease;
}
.cu-input:focus-within{
  border-color:#CBD5E1;
  box-shadow:0 0 0 3px rgba(14,18,32,.04);
}
.cu-input svg{ width:16px; height:16px; color:#94A3B8; flex-shrink:0; }
.cu-input input,
.cu-input select,
.cu-textarea textarea{
  flex:1; border:0; outline:0; background:transparent;
  font:inherit; font-weight:500; color:#0B1220; min-width:0;
  font-size:13px;
}
.cu-input input::placeholder,
.cu-textarea textarea::placeholder{ color:#94A3B8; font-weight:500; }
.cu-input select{
  appearance:none; cursor:pointer; height:40px;
  color:#94A3B8; padding-right:16px;
}
.cu-input select:valid{ color:#0B1220; }
.cu-select-wrap{ position:relative; padding-right:8px; }
.cu-select-wrap::after{
  content:""; position:absolute; right:14px; top:50%;
  width:7px; height:7px; border-right:2px solid #94A3B8; border-bottom:2px solid #94A3B8;
  transform:translateY(-65%) rotate(45deg); pointer-events:none;
}
.cu-textarea{
  align-items:flex-start; padding:10px 11px;
  min-height:84px;
}
.cu-textarea textarea{
  width:100%; resize:vertical; min-height:68px; line-height:1.4;
}
.cu-wa-hint{
  display:inline-flex; align-items:center; gap:7px;
  margin:0; color:#64748B; font-size:12px; font-weight:500;
  text-decoration:none;
}
.cu-wa-hint:hover{ color:#334155; }
.cu-wa-hint svg{ width:15px; height:15px; color:#22C55E; flex-shrink:0; }
.cu-hp{ position:absolute!important; left:-9999px!important; opacity:0!important; height:0!important; width:0!important; }
.cu-submit{
  display:inline-flex; align-items:center; justify-content:center; gap:7px;
  width:100%; min-height:42px; margin-top:0;
  border:0; border-radius:9px; cursor:pointer;
  background:#F17F23; color:#fff;
  font-size:14px; font-weight:800;
  box-shadow:0 8px 18px rgba(241,127,35,.24);
  transition:filter .15s ease, transform .15s ease;
}
.cu-submit:hover{ filter:brightness(1.05); color:#fff; }
.cu-submit:disabled{ opacity:.7; cursor:wait; }
.cu-submit svg{ width:16px; height:16px; }

/* Touch list — stretch to match form column height */
.cu-side{
  display:flex;
  flex-direction:column;
  gap:14px;
  min-height:100%;
  height:100%;
}
.cu-side .cu-card--touch{
  flex:1 1 auto;
  display:flex;
  flex-direction:column;
  min-height:0;
}
.cu-side .cu-card--follow{
  flex:0 0 auto;
  margin-top:0;
}
.cu-side .cu-card--follow .cu-card__sub{
  margin-bottom:14px;
}
.cu-touch{
  display:flex;
  flex-direction:column;
  justify-content:space-evenly;
  flex:1 1 auto;
  margin-top:8px;
  padding:6px 0 4px;
  min-height:0;
}
.cu-touch__item{
  display:flex; align-items:center; gap:12px;
  padding:18px 0;
  border:0;
  border-bottom:1px solid #EEF2F7;
  border-radius:0;
  background:transparent;
  text-decoration:none; color:inherit;
  transition:background .15s ease;
}
.cu-touch__item:last-child{
  border-bottom:0;
  padding-bottom:0;
}
.cu-touch__item:first-child{ padding-top:2px; }
.cu-touch__item:hover{
  background:transparent;
  box-shadow:none;
  transform:none;
}
.cu-touch__item:hover .cu-touch__title{ color:var(--cu-blue); }
.cu-touch__ico{
  width:40px; height:40px; border-radius:50%;
  display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;
}
.cu-touch__ico svg{ width:18px; height:18px; }
.cu-touch__ico--wa{ background:#E8F8EF; color:#16A34A; }
.cu-touch__ico--mail{ background:#EEE8FF; color:#6D28D9; }
.cu-touch__ico--call{ background:#FFF1E6; color:#EA580C; }
.cu-touch__ico--chat{ background:#E8EEFF; color:#2A47FF; }
.cu-touch__body{ flex:1; min-width:0; }
.cu-touch__title{
  display:block; font-size:14px; font-weight:800; color:#0B1220; line-height:1.2;
}
.cu-touch__desc{
  display:block; font-size:12px; font-weight:500; color:#64748B; margin-top:2px; line-height:1.3;
}
.cu-touch__value{
  display:block; font-size:13px; font-weight:800; color:#0B1220; margin-top:3px; line-height:1.2;
}
.cu-touch__chev{ color:#CBD5E1; flex-shrink:0; }
.cu-touch__chev svg{ width:16px; height:16px; }

.cu-socials{ display:flex; flex-wrap:wrap; gap:10px; margin-top:2px; }
.cu-social{
  width:42px; height:42px; border-radius:10px;
  display:inline-flex; align-items:center; justify-content:center;
  border:1px solid #E8ECF2; background:#fff;
  text-decoration:none; transition:transform .15s ease, box-shadow .15s ease;
}
.cu-social:hover{ transform:translateY(-2px); box-shadow:0 8px 18px rgba(14,18,32,.08); }
.cu-social svg{ width:16px; height:16px; }
.cu-social--li{ color:#0A66C2; }
.cu-social--ig{ color:#E4405F; }
.cu-social--yt{ color:#FF0000; }
.cu-social--tg{ color:#229ED9; }
.cu-social--x{ color:#0F172A; }

@media (max-width:992px){
  .cu-grid{ grid-template-columns:1fr; }
  .cu-form__row{ grid-template-columns:1fr; }
}
@media (max-width:640px){
  .cu-wrap{ padding:0 10px; }
  .cu-card{ padding:14px; }
}
</style>

