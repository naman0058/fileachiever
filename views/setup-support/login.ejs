<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Setup Support Portal • FileMakr</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/setup-support/support.css?v=20260818">
</head>
<body class="ss-login-page">
  <div class="ss-login-card">
    <div class="ss-login-accent"></div>
    <div class="ss-login-body">
      <div class="ss-login-brand">
        <div class="ss-login-logo">FileMakr</div>
        <div class="ss-login-title">Setup Support Portal</div>
        <div class="ss-login-tag">Customer setup &amp; support team</div>
      </div>
      <% if (error) { %>
      <div class="ss-login-error"><i class="bi bi-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <form method="POST" action="/setup-support/login" class="ss-login-form">
        <label>
          <span>Email</span>
          <input type="email" name="email" placeholder="you@company.com" required autocomplete="email">
        </label>
        <label>
          <span>Password</span>
          <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </label>
        <button type="submit" class="ss-btn ss-btn--primary ss-login-submit">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
