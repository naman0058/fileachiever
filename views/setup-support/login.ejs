<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Setup Support Portal • FileAchiever</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/setup-support/support.css">
  <style>
    .login-page { min-height: 100vh; background: linear-gradient(160deg, #f8fafc 0%, #f1f5f9 40%, #e2e8f0 100%); display: flex; align-items: center; justify-content: center; padding: 24px; }
    .login-card { border-radius: 20px; box-shadow: 0 4px 6px rgba(0,0,0,.04), 0 24px 50px rgba(15,23,42,.12); border: 1px solid rgba(241,127,35,.12); max-width: 420px; overflow: hidden; }
    .login-card::before { content: ''; display: block; height: 5px; background: linear-gradient(90deg, #F17F23 0%, #2E48FB 100%); }
    .login-brand .logo { font-size: 1.5rem; font-weight: 800; background: linear-gradient(135deg, #F17F23 0%, #2E48FB 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .login-brand .tagline { font-size: 0.875rem; color: #64748b; }
    .btn-signin { background: linear-gradient(135deg, #F17F23 0%, #e07015 100%); border: none; color: #fff; font-weight: 700; padding: 0.75rem 1.5rem; border-radius: 12px; }
    .btn-signin:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(241,127,35,.4); }
    .form-control:focus { border-color: #F17F23; box-shadow: 0 0 0 0.2rem rgba(241,127,35,.25); }
  </style>
</head>
<body class="login-page">
  <div class="w-100">
    <div class="card login-card mx-auto">
      <div class="card-body p-4 p-md-5">
        <div class="login-brand text-center mb-4">
          <div class="logo d-block">Setup Support Portal</div>
          <div class="tagline">Customer setup & support team</div>
        </div>
        <% if (error) { %>
        <div class="alert alert-danger py-3"><%= error %></div>
        <% } %>
        <form method="POST" action="/setup-support/login">
          <div class="mb-3">
            <label class="form-label fw-semibold">Email</label>
            <input type="email" name="email" class="form-control form-control-lg" placeholder="you@company.com" required autocomplete="email">
          </div>
          <div class="mb-4">
            <label class="form-label fw-semibold">Password</label>
            <input type="password" name="password" class="form-control form-control-lg" placeholder="••••••••" required>
          </div>
          <button type="submit" class="btn btn-signin w-100 btn-lg">Sign in</button>
        </form>

      </div>
    </div>
  </div>
</body>
</html>
