<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= pageTitle %> • FileMakr Setup Support</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" crossorigin="anonymous">
  <link rel="stylesheet" href="/setup-support/support.css?v=20260818">
</head>
<body class="support-body">

<div class="support-layout">
  <aside class="support-sidebar-wrap">
    <%- include('partials/sidebar', { user, active, filters, buildQuery }) %>
  </aside>

  <main class="support-main">
    <div class="ss-shell">
      <div class="ss-topbar">
        <div>
          <h1>Work queue</h1>
          <p>Claim open tickets, update status, and track your monthly performance.</p>
        </div>
        <div class="ss-chip">
          <i class="bi bi-person-badge"></i>
          <%= user && user.name ? user.name : 'Team member' %>
        </div>
      </div>

      <div class="ss-kpis">
        <a class="ss-kpi ss-kpi--warn" href="/setup-support<%= buildQuery('pending') ? '?' + buildQuery('pending') : '?tab=pending' %>">
          <div class="ss-kpi__label">Open</div>
          <div class="ss-kpi__value"><%= stats.pending || 0 %></div>
          <div class="ss-kpi__hint">Pending + in progress</div>
        </a>
        <a class="ss-kpi ss-kpi--blue" href="/setup-support<%= buildQuery('pending') ? '?' + buildQuery('pending') : '?tab=pending' %>">
          <div class="ss-kpi__label">In progress</div>
          <div class="ss-kpi__value"><%= stats.inProgress || 0 %></div>
          <div class="ss-kpi__hint">Active work</div>
        </a>
        <div class="ss-kpi ss-kpi--danger">
          <div class="ss-kpi__label">Aging &gt; 24h</div>
          <div class="ss-kpi__value"><%= stats.aging24h || 0 %></div>
          <div class="ss-kpi__hint">Needs attention</div>
        </div>
        <a class="ss-kpi ss-kpi--ok" href="/setup-support<%= buildQuery('done') ? '?' + buildQuery('done') : '?tab=done' %>">
          <div class="ss-kpi__label">Done (all time)</div>
          <div class="ss-kpi__value"><%= stats.done || 0 %></div>
          <div class="ss-kpi__hint">Lifetime completed</div>
        </a>
        <a class="ss-kpi ss-kpi--orange" href="/setup-support/performance">
          <div class="ss-kpi__label">Done this month</div>
          <div class="ss-kpi__value"><%= stats.doneMonth || 0 %></div>
          <div class="ss-kpi__hint">Avg <%= stats.avgHours != null ? stats.avgHours + 'h' : '—' %></div>
        </a>
        <div class="ss-kpi">
          <div class="ss-kpi__label">Claim pool</div>
          <div class="ss-kpi__value"><%= stats.available || 0 %></div>
          <div class="ss-kpi__hint">Unassigned tickets</div>
        </div>
      </div>

      <div class="ss-panel">
        <div class="ss-panel__head">
          <div>
            <h2 class="ss-panel__title">Filters</h2>
            <p class="ss-panel__sub">Search by customer, phone, order ID, or product</p>
          </div>
        </div>
        <form method="get" action="/setup-support" class="ss-filters">
          <input type="hidden" name="tab" value="<%= filters.tab %>">
          <div>
            <label for="ss-q">Search</label>
            <input id="ss-q" class="ss-input" type="search" name="q" value="<%= filters.q || '' %>" placeholder="Name, phone, order, product…" autocomplete="off">
          </div>
          <div>
            <label for="ss-status">Status</label>
            <select id="ss-status" name="status" class="ss-select">
              <option value="">All statuses</option>
              <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
              <option value="done" <%= filters.status === 'done' ? 'selected' : '' %>>Done</option>
              <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
          <div style="display:flex;align-items:flex-end;">
            <button type="submit" class="ss-btn ss-btn--primary" style="width:100%;">
              <i class="bi bi-funnel"></i> Apply
            </button>
          </div>
        </form>
        <div class="ss-tabs">
          <a class="ss-tab <%= filters.tab === 'all' ? 'is-active' : '' %>" href="/setup-support<%= buildQuery('all') ? '?' + buildQuery('all') : '' %>">All</a>
          <a class="ss-tab <%= filters.tab === 'pending' ? 'is-active is-active--warn' : '' %>" href="/setup-support<%= buildQuery('pending') ? '?' + buildQuery('pending') : '?tab=pending' %>">Open (<%= pendingCount %>)</a>
          <a class="ss-tab <%= filters.tab === 'done' ? 'is-active is-active--ok' : '' %>" href="/setup-support<%= buildQuery('done') ? '?' + buildQuery('done') : '?tab=done' %>">Completed (<%= doneCount %>)</a>
          <a class="ss-tab" href="/setup-support/performance"><i class="bi bi-graph-up-arrow"></i> Performance</a>
        </div>
      </div>

      <% if (unassigned && unassigned.length) { %>
      <div class="ss-panel">
        <div class="ss-panel__head">
          <div>
            <h2 class="ss-panel__title">Claim pool</h2>
            <p class="ss-panel__sub">Unassigned requests — claim to add them to your queue</p>
          </div>
          <span class="ss-chip"><%= unassigned.length %> available</span>
        </div>
        <div class="ss-table-wrap">
          <table class="ss-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Source</th>
                <th>Order / Product</th>
                <th>Customer</th>
                <th>Phone</th>
                <th>Enquiry</th>
                <th>Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% unassigned.forEach(function(r){ %>
              <tr>
                <td class="ss-strong">#<%= r.id %></td>
                <td>
                  <% if (r.origin === 'checkout') { %>
                  <span class="ss-badge ss-badge--checkout">Checkout</span>
                  <% } else { %>
                  <span class="ss-badge ss-badge--manual">Manual</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.fm_order_id) { %><div class="ss-strong"><%= r.fm_order_id %></div><% } %>
                  <div class="ss-muted ss-clamp"><%= (r.product_name || r.plan_label || '—').toString() %></div>
                </td>
                <td class="ss-strong"><%= r.customer_name || '—' %></td>
                <td>
                  <% if (r.customer_number) { %>
                  <a href="tel:<%= r.customer_number %>" class="ss-strong" style="text-decoration:none;color:inherit;"><%= r.customer_number %></a>
                  <a class="ss-wa" href="https://wa.me/<%= String(r.customer_number).replace(/\D/g,'') %>" target="_blank" rel="noopener" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                  <% } else { %><span class="ss-muted">—</span><% } %>
                </td>
                <td class="ss-muted ss-clamp" title="<%= (r.enquiry || '').replace(/"/g,'&quot;') %>"><%= (r.enquiry || '—').toString().slice(0, 90) %></td>
                <td class="ss-muted"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '—' %></td>
                <td>
                  <button type="button" class="ss-btn ss-btn--claim ss-btn--sm claim-btn" data-id="<%= r.id %>">
                    <i class="bi bi-hand-index-thumb"></i> Claim
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <div class="ss-panel">
        <div class="ss-panel__head">
          <div>
            <h2 class="ss-panel__title">My requests</h2>
            <p class="ss-panel__sub">Showing <%= rows.length %> ticket<%= rows.length !== 1 ? 's' : '' %> · in progress first</p>
          </div>
        </div>
        <div class="ss-table-wrap">
          <table class="ss-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Source</th>
                <th>Order / Product</th>
                <th>Customer</th>
                <th>Phone</th>
                <th>Enquiry</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!rows.length) { %>
              <tr>
                <td colspan="10">
                  <div class="ss-empty">
                    <i class="bi bi-inbox"></i>
                    No requests in this view. Claim from the pool or clear filters.
                  </div>
                </td>
              </tr>
              <% } %>
              <% rows.forEach(function(r){ %>
              <tr>
                <td class="ss-strong">#<%= r.id %></td>
                <td>
                  <% if (r.origin === 'checkout') { %>
                  <span class="ss-badge ss-badge--checkout">Checkout</span>
                  <% } else { %>
                  <span class="ss-badge ss-badge--manual">Manual</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.fm_order_id) { %><div class="ss-strong"><%= r.fm_order_id %></div><% } %>
                  <div class="ss-muted ss-clamp"><%= (r.product_name || r.plan_label || '—').toString() %></div>
                </td>
                <td>
                  <div class="ss-strong"><%= r.customer_name || '—' %></div>
                  <% if (r.customer_email) { %><div class="ss-muted" style="font-size:12px;"><%= r.customer_email %></div><% } %>
                </td>
                <td>
                  <% if (r.customer_number) { %>
                  <a href="tel:<%= r.customer_number %>" class="ss-strong" style="text-decoration:none;color:inherit;"><%= r.customer_number %></a>
                  <a class="ss-wa" href="https://wa.me/<%= String(r.customer_number).replace(/\D/g,'') %>" target="_blank" rel="noopener" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                  <% } else { %><span class="ss-muted">—</span><% } %>
                </td>
                <td class="ss-muted ss-clamp" title="<%= (r.enquiry || '').replace(/"/g,'&quot;') %>"><%= (r.enquiry || '—').toString().slice(0, 100) %></td>
                <td>
                  <span class="ss-badge ss-badge--<%= (r.status || 'pending') %>"><%= (r.status || 'pending').replace('_', ' ') %></span>
                </td>
                <td class="ss-muted ss-clamp" title="<%= (r.notes || '').replace(/"/g,'&quot;') %>"><%= (r.notes || '—').toString().slice(0, 70) %></td>
                <td class="ss-muted"><%= r.created_at ? new Date(r.created_at).toLocaleString() : '—' %></td>
                <td>
                  <% if (r.status !== 'done' && r.status !== 'cancelled') { %>
                  <div class="ss-actions">
                    <select class="ss-select-sm status-select" data-id="<%= r.id %>">
                      <option value="pending" <%= r.status === 'pending' ? 'selected' : '' %>>Pending</option>
                      <option value="in_progress" <%= r.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                      <option value="done">Done</option>
                      <option value="cancelled">Cancelled</option>
                    </select>
                    <button type="button" class="ss-btn ss-btn--ghost ss-btn--sm notes-btn" data-id="<%= r.id %>" data-notes="<%= (r.notes || '').replace(/"/g,'&quot;') %>">Notes</button>
                  </div>
                  <% } else { %>
                  <span class="ss-muted">—</span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<div class="ss-modal-backdrop" id="notesModal" aria-hidden="true">
  <div class="ss-modal" role="dialog" aria-labelledby="notesModalTitle">
    <h3 id="notesModalTitle">Update notes</h3>
    <p class="ss-muted" style="margin:0 0 10px;font-size:12px;">Contact summary, setup steps, or follow-ups</p>
    <textarea id="notesText" placeholder="Add notes…"></textarea>
    <div class="ss-modal__actions">
      <button type="button" class="ss-btn ss-btn--ghost" id="notesCancel">Cancel</button>
      <button type="button" class="ss-btn ss-btn--primary" id="notesSave">Save notes</button>
    </div>
  </div>
</div>

<script>
(function () {
  var notesModal = document.getElementById('notesModal');
  var notesText = document.getElementById('notesText');
  var notesId = null;

  function closeNotes() {
    notesModal.classList.remove('is-open');
    notesModal.setAttribute('aria-hidden', 'true');
    notesId = null;
  }

  document.querySelectorAll('.status-select').forEach(function (sel) {
    sel.addEventListener('change', async function () {
      var id = this.dataset.id;
      var status = this.value;
      var res = await fetch('/setup-support/api/' + id + '/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'status=' + encodeURIComponent(status)
      });
      var j = await res.json();
      if (j.ok) window.location.reload();
      else alert(j.message || 'Failed');
    });
  });

  document.querySelectorAll('.claim-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      this.disabled = true;
      var id = this.dataset.id;
      var res = await fetch('/setup-support/api/' + id + '/claim', { method: 'POST' });
      var j = await res.json();
      if (j.ok) window.location.reload();
      else {
        this.disabled = false;
        alert(j.message || 'Failed');
      }
    });
  });

  document.querySelectorAll('.notes-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      notesId = this.dataset.id;
      notesText.value = this.dataset.notes || '';
      notesModal.classList.add('is-open');
      notesModal.setAttribute('aria-hidden', 'false');
      notesText.focus();
    });
  });

  document.getElementById('notesCancel').addEventListener('click', closeNotes);
  notesModal.addEventListener('click', function (e) {
    if (e.target === notesModal) closeNotes();
  });
  document.getElementById('notesSave').addEventListener('click', async function () {
    if (!notesId) return;
    var statusEl = document.querySelector('.status-select[data-id="' + notesId + '"]');
    var status = statusEl ? statusEl.value : 'in_progress';
    var notes = notesText.value || '';
    var res = await fetch('/setup-support/api/' + notesId + '/status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'status=' + encodeURIComponent(status) + '&notes=' + encodeURIComponent(notes)
    });
    var j = await res.json();
    if (j.ok) window.location.reload();
    else alert(j.message || 'Failed');
  });
})();
</script>
</body>
</html>
