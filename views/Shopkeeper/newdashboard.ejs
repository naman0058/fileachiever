<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MERN Training Program | Dashboard</title>
  <link rel="shortcut icon" href="https://res.cloudinary.com/dggf8vl9p/image/upload/v1718627756/filemakr-project-file-creator-favicon_1_dqogst.avif" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f1f5f9;
      --surface: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --teal: #0d9488;
      --teal-dark: #0f766e;
      --success: #059669;
      --warning: #d97706;
      --danger: #dc2626;
      --radius: 14px;
    }
    * { box-sizing: border-box; }
    html { overflow-x: hidden; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .topbar-inner {
      max-width: 960px;
      width: 100%;
      margin: 0 auto;
      padding: 0.875rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      min-width: 0;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--text);
      min-width: 0;
      flex: 1 1 auto;
    }
    .brand img { width: 36px; height: 36px; border-radius: 8px; }
    .brand-text { line-height: 1.2; }
    .brand-text strong { display: block; font-size: 0.95rem; font-weight: 700; }
    .brand-text span { font-size: 0.75rem; color: var(--muted); font-weight: 500; }
    .topbar a.profile-link {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--teal);
      text-decoration: none;
    }
    .topbar a.profile-link:hover { text-decoration: underline; }
    .wrap {
      max-width: 960px;
      width: 100%;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 3rem;
      min-width: 0;
    }
    .greeting {
      margin-bottom: 1.25rem;
    }
    .greeting h1 {
      font-size: 1.35rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
      letter-spacing: -0.02em;
    }
    .greeting p { margin: 0; font-size: 0.9rem; color: var(--muted); }
    .alert-profile {
      background: #fffbeb;
      border: 1px solid #fde68a;
      color: #92400e;
      border-radius: var(--radius);
      padding: 0.85rem 1rem;
      margin-bottom: 1.25rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.875rem;
    }
    .alert-profile a {
      background: var(--teal);
      color: #fff;
      font-weight: 600;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.8rem;
    }
    .alert-profile a:hover { background: var(--teal-dark); }
    .progress-card {
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 1.25rem 1.35rem;
      margin-bottom: 1.5rem;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      align-items: center;
      max-width: 100%;
      min-width: 0;
      overflow-x: hidden;
    }
    .progress-copy { min-width: 0; }
    @media (max-width: 600px) {
      .progress-card { grid-template-columns: 1fr; text-align: center; }
    }
    .ring {
      width: 88px;
      height: 88px;
      margin: 0 auto;
    }
    .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .progress-copy h2 {
      font-size: 1rem;
      font-weight: 700;
      margin: 0 0 0.35rem;
    }
    .progress-copy p { margin: 0; font-size: 0.875rem; color: var(--muted); line-height: 1.5; }
    .bar-wrap {
      margin-top: 0.75rem;
      height: 8px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--teal), #14b8a6);
      transition: width 0.3s ease;
    }
    .section-title {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 0.65rem;
    }
    .task-card {
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 1.35rem;
      margin-bottom: 1.25rem;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
      max-width: 100%;
      min-width: 0;
      overflow-x: hidden;
    }
    .task-card h3 {
      margin: 0 0 0.35rem;
      font-size: 1.05rem;
      font-weight: 700;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .task-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .pill {
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      background: #f1f5f9;
      color: var(--muted);
    }
    .pill.teal { background: rgba(13, 148, 136, 0.12); color: var(--teal-dark); }
    .task-body {
      font-size: 0.9rem;
      line-height: 1.55;
      color: #334155;
      max-width: 100%;
      min-width: 0;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .task-body :first-child { margin-top: 0; }
    .task-body :last-child { margin-bottom: 0; }
    .task-body a {
      color: var(--teal-dark);
      font-weight: 500;
      word-break: break-all;
      overflow-wrap: anywhere;
      max-width: 100%;
    }
    .task-body ul, .task-body ol {
      padding-left: 1.25rem;
      margin: 0.5rem 0;
      max-width: 100%;
    }
    .task-body li { margin: 0.25rem 0; overflow-wrap: anywhere; }
    .notice-class-link {
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      background: #ecfeff;
      border: 1px solid #a5f3fc;
      color: #0e7490;
      font-size: 0.85rem;
      line-height: 1.55;
      max-width: 100%;
    }
    .notice-class-link strong { color: #0f766e; }
    .status {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 600;
      margin-top: 0.75rem;
      padding: 0.35rem 0.65rem;
      border-radius: 8px;
    }
    .status.ok { background: #d1fae5; color: #065f46; }
    .status.wait { background: #f1f5f9; color: #475569; }
    .status.bad { background: #fee2e2; color: #991b1b; }
    .form-block { margin-top: 1.15rem; padding-top: 1.15rem; border-top: 1px solid var(--border); max-width: 100%; min-width: 0; }
    .form-block label { display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.35rem; color: #334155; }
    .form-block input[type="file"] {
      font-size: 0.8rem;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
    .btn { max-width: 100%; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.75rem;
      padding: 0.65rem 1.15rem;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      color: #fff;
      background: var(--teal);
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }
    .btn:hover { background: var(--teal-dark); }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-secondary { background: #6366f1; }
    .btn-secondary:hover { background: #4f46e5; }
    .empty-state {
      background: var(--surface);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      padding: 2rem 1.25rem;
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
    }
    .empty-state strong { color: var(--text); display: block; margin-bottom: 0.35rem; }
    .hustle-card h3 { color: #7c3aed; }
    .note-closed {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      padding: 0.75rem;
      border-radius: 10px;
      font-size: 0.875rem;
      margin-top: 0.75rem;
    }
    .loader-txt { font-size: 0.8rem; color: var(--muted); margin-top: 0.5rem; display: none; }
    .loader-txt.show { display: block; }
    .hidden { display: none !important; }
    .opacity-50 { opacity: 0.5; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loader-icon { animation: spin 0.75s linear infinite; }
    .task-card--locked {
      position: relative;
    }
    .task-card--locked .task-lock-dim {
      filter: blur(1px);
      opacity: 0.45;
      pointer-events: none;
      user-select: none;
    }
    .task-lock-overlay {
      position: absolute;
      inset: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      background: rgba(248, 250, 252, 0.97);
      border-radius: inherit;
      text-align: center;
    }
    .task-lock-inner {
      max-width: 22rem;
    }
    .task-lock-inner h3 {
      margin: 0 0 0.5rem;
      font-size: 1.1rem;
      font-weight: 700;
      color: #0f172a;
    }
    .task-lock-inner p {
      margin: 0 0 1rem;
      font-size: 0.875rem;
      line-height: 1.55;
      color: #475569;
    }
    .task-lock-inner .btn-lock {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 1.2rem;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: inherit;
      color: #fff;
      background: var(--teal);
      border-radius: 10px;
      text-decoration: none;
    }
    .task-lock-inner .btn-lock:hover {
      background: var(--teal-dark);
    }
    .alert-notice-ig {
      background: #fff7ed;
      border: 1px solid #fdba74;
      color: #9a3412;
      border-radius: var(--radius);
      padding: 0.85rem 1rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      line-height: 1.5;
    }
    .alert-notice-ig strong { color: #7c2d12; }
    .notice-class-link--ig {
      background: #ecfeff;
      border: 1px solid #a5f3fc;
      color: #0e7490;
    }
    .notice-class-link--ig strong { color: #0f766e; }
    .ig-verify-panel { margin-top: 1.25rem; }
    .ig-verify-hint {
      font-size: 0.875rem;
      color: var(--muted);
      margin: 0 0 1rem;
      line-height: 1.55;
    }
    .ig-check-list {
      list-style: none;
      padding: 0;
      margin: 0 0 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      overflow: hidden;
    }
    .ig-check-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 0.875rem;
      padding: 0.65rem 0.85rem;
      border-bottom: 1px solid var(--border);
      line-height: 1.45;
    }
    .ig-check-list li:last-child { border-bottom: 0; }
    .ig-check-ok { color: var(--success); font-weight: 700; flex-shrink: 0; }
    .ig-check-bad { color: var(--danger); font-weight: 700; flex-shrink: 0; }
    .ig-check-note { color: var(--warning); flex-shrink: 0; font-weight: 700; }
    .ig-verify-err {
      color: var(--danger);
      font-size: 0.875rem;
      margin: 0 0 0.75rem;
      line-height: 1.45;
    }
    .class-meet-card {
      margin-top: 1.25rem;
      padding: 1.1rem 1.2rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: linear-gradient(135deg, #f0fdfa 0%, #f8fafc 100%);
    }
    .class-meet-card h4 {
      margin: 0 0 0.5rem;
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
    }
    .class-meet-card p { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--muted); line-height: 1.5; }
    .class-meet-link {
      display: inline-block;
      word-break: break-all;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--teal);
      margin-bottom: 0.75rem;
    }
    .class-meet-err {
      color: var(--danger);
      font-size: 0.8125rem;
      margin: 0.5rem 0 0;
      display: none;
    }
    .class-meet-err.show { display: block; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/mern-training-program/new-dashboard" class="brand">
        <img src="https://res.cloudinary.com/dggf8vl9p/image/upload/v1718627756/filemakr-project-file-creator-favicon_1_dqogst.avif" alt="" />
        <div class="brand-text">
          <strong>MERN Training Program</strong>
          <span>Daily attendance & progress</span>
        </div>
      </a>
      <a class="profile-link" href="/mern-training-program/dashboard/profile">Account & profile</a>
    </div>
  </header>

  <main class="wrap">
    <% const profile = result && result[0] ? result[0] : null; %>
    <% const igProfileRaw = profile && profile.instagram_id != null ? String(profile.instagram_id) : ''; %>
    <% const hasInstagram = igProfileRaw.trim().length > 0; %>
    <% const noticeParam = typeof notice !== 'undefined' ? notice : ''; %>

    <% if (noticeParam === 'instagram_required') { %>
      <div class="alert-notice-ig" role="alert">
        <strong>Instagram ID required.</strong> Add your Instagram username in your profile before you can verify Instagram attendance. Your submission was not saved.
      </div>
    <% } %>
    <% if (noticeParam === 'use_instagram_verify') { %>
      <div class="alert-notice-ig" role="alert">
        <strong>Use “Verify my attendance”.</strong> This daily task uses Instagram (comment check + team approval)—do not upload a screenshot.
      </div>
    <% } %>

    <div class="greeting">
      <h1>Hello<% if (profile && profile.name) { %>, <%= profile.name %><% } %></h1>
      <p>Complete today’s attendance task and keep your verified-day streak on track.</p>
    </div>

    <% if (dailyTask || hustleTask) { %>
      <% if (profile && (!profile.linkedin_id || !profile.youtube_id)) { %>
        <div class="alert-profile">
          <span>Add your LinkedIn and YouTube links on your profile to stay eligible for full program benefits.</span>
          <a href="/mern-training-program/dashboard/profile">Update profile</a>
        </div>
      <% } %>
    <% } %>

    <% const totalProgramDays = 45; const pct = Math.min(100, Math.round((currentDay / totalProgramDays) * 100)); const ringOffset = 283 - (currentDay / totalProgramDays) * 283; %>

    <div class="progress-card">
      <div class="ring" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="45" stroke="#e2e8f0" stroke-width="8" fill="none" />
          <circle cx="50" cy="50" r="45" stroke="url(#gradDash)" stroke-width="8" fill="none"
            stroke-dasharray="283" stroke-dashoffset="<%= Math.max(0, ringOffset) %>"
            stroke-linecap="round" />
          <defs>
            <linearGradient id="gradDash" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#0d9488" />
              <stop offset="100%" stop-color="#14b8a6" />
            </linearGradient>
          </defs>
          <text x="50" y="54" text-anchor="middle" font-size="15" font-weight="700" fill="#0f172a"><%= currentDay %>/<%= totalProgramDays %></text>
        </svg>
      </div>
      <div class="progress-copy">
        <h2>Your progress</h2>
        <p><strong><%= currentDay %></strong> verified attendance day(s) toward the <strong><%= totalProgramDays %>-day</strong> program target. Submit proof for each daily task on time to grow this count.</p>
        <div class="bar-wrap" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100">
          <div class="bar-fill" style="width: <%= pct %>%"></div>
        </div>
      </div>
    </div>

    <% if (!dailyTask && !hustleTask) { %>
      <p class="section-title">Today</p>
      <div class="empty-state">
        <strong>No task published for today yet</strong>
        Check back later. Your progress above still reflects verified days completed so far.
      </div>
    <% } %>

    <% if (dailyTask) { %>
      <% const isIgDaily = dailyTask.isInstagramTemplate === true; %>
      <% const igAwaitingReview = isIgDaily && dailyTask.proofUploaded && dailyTask.proofStatus === 'pending' && dailyTask.proofLink && String(dailyTask.proofLink).startsWith('instagram:'); %>
      <% const igProofPending = dailyTask.proofUploaded && dailyTask.proofStatus === 'pending' && !(dailyTask.proofLink && String(dailyTask.proofLink).startsWith('instagram:')); %>
      <p class="section-title">Today’s attendance task</p>
      <article class="task-card <%= (!hasInstagram && isIgDaily) ? 'task-card--locked' : '' %>">
        <div class="<%= (!hasInstagram && isIgDaily) ? 'task-lock-dim' : '' %>">
        <h3><%= dailyTask.title %></h3>
        <div class="task-meta">
          <span class="pill teal">Daily attendance</span>
          <span class="pill"><%= dailyTask.date %></span>
        </div>
        <div class="task-body"><%- dailyTask.description %></div>

        <% if (isIgDaily) { %>
          <div class="notice-class-link notice-class-link--ig" role="note">
            <strong>Instagram attendance:</strong> Use the <strong>same Instagram username</strong> as on your profile.
          </div>

          <% if (dailyTask.proofUploaded && dailyTask.proofStatus === 'verified') { %>
            <span class="status ok">Verified — attendance confirmed</span>
          <% } else if (igAwaitingReview) { %>
            <span class="status wait">Waiting for approval — your comment was found and sent to the team. Check your email for the Meet link after they approve.</span>
          <% } else if (igProofPending) { %>
            <span class="status wait">Under review — uploaded proof is pending (older submission). New check: use verify below if this is an Instagram task.</span>
            <div class="ig-verify-panel">
              <p class="ig-verify-hint">Comment on the post, then verify. Submissions go to the team for approval.</p>
              <ul class="ig-check-list" id="ig-check-list" style="display:none"></ul>
              <p class="ig-verify-err" id="ig-verify-err" style="display:none"></p>
              <button type="button" class="btn" id="btn-verify-ig" data-task-id="<%= dailyTask.id %>">
                <span class="button-text">Verify my attendance</span>
                <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
              </button>
            </div>
          <% } else { %>
            <% if (dailyTask.proofUploaded && dailyTask.proofStatus === 'rejected') { %>
              <span class="status bad">Needs another try<% if (dailyTask.reason) { %> — <%= dailyTask.reason %><% } %></span>
            <% } %>
            <div class="ig-verify-panel">
              <p class="ig-verify-hint">Comment on the task post from your linked Instagram account, then verify.</p>
              <ul class="ig-check-list" id="ig-check-list" style="display:none"></ul>
              <p class="ig-verify-err" id="ig-verify-err" style="display:none"></p>
              <button type="button" class="btn" id="btn-verify-ig" data-task-id="<%= dailyTask.id %>">
                <span class="button-text">Verify my attendance</span>
                <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
              </button>
            </div>
          <% } %>
        <% } else { %>
          <div class="notice-class-link" role="note">
            <strong>Notice:</strong> When you finish the task, upload a <strong>clear screenshot</strong> (or acceptable video proof) of your work. <strong>Today’s class link is sent only after your proof is submitted and approved.</strong> If you skip the upload or the proof is unusable, <strong>the class link will not be shared</strong> with you.
          </div>

          <% if (dailyTask.proofUploaded) { %>
            <% if (dailyTask.proofStatus === 'verified') { %>
              <span class="status ok">Verified — proof accepted</span>
            <% } else if (dailyTask.proofStatus === 'pending') { %>
              <span class="status wait">Under review</span>
            <% } else if (dailyTask.proofStatus === 'rejected') { %>
              <span class="status bad">Needs resubmission<% if (dailyTask.reason) { %> — <%= dailyTask.reason %><% } %></span>
              <div class="form-block">
                <form action="/mern-training-program/submit-daily-task" method="POST" enctype="multipart/form-data">
                  <input type="hidden" name="taskId" value="<%= dailyTask.id %>" />
                  <input type="hidden" name="videoScreenshotData" class="screenshot-data" />
                  <input type="hidden" name="proofUrl" class="proof-url" />
                  <label for="proof-daily">Upload new proof (image or video)</label>
                  <input id="proof-daily" type="file" name="proofFile" accept="image/*,video/*" onchange="handleProofChange(this)" />
                  <button type="submit" class="btn"><span class="button-text">Submit proof</span>
                    <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
                  </button>
                </form>
              </div>
            <% } %>
          <% } else { %>
            <div class="form-block">
              <form action="/mern-training-program/submit-daily-task" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="taskId" value="<%= dailyTask.id %>" />
                <input type="hidden" name="videoScreenshotData" class="screenshot-data" />
                <input type="hidden" name="proofUrl" class="proof-url" />
                <label for="proof-daily-new">Upload proof (image or video)</label>
                <input id="proof-daily-new" type="file" name="proofFile" accept="image/*,video/*" onchange="handleProofChange(this)" />
                <button type="submit" class="btn"><span class="button-text">Submit proof</span>
                  <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
                </button>
              </form>
            </div>
          <% } %>
        <% } %>

        <% const cm = typeof classMeet !== 'undefined' ? classMeet : { meetLink: null, inviteSent: false, timeLabel: '', calendarReady: false, calendarInvites: false }; %>
        <% if (dailyTask && dailyTask.proofStatus === 'verified') { %>
          <div class="class-meet-card" id="class-meet-section">
            <h4>Today’s live class (Google Meet)</h4>
            <p>Class time: <strong><%= cm.timeLabel || '7:00 PM' %></strong>. After you’re verified, request the link once—we email you today’s Meet URL <% if (cm.calendarInvites) { %> and add you to the Google Calendar event so you get an official invite<% } %>.</p>
            <% if (!cm.calendarReady) { %>
              <p class="ig-verify-err show" style="margin:0">Calendar integration is not configured yet. Please contact support.</p>
            <% } else if (cm.inviteSent && cm.meetLink) { %>
              <p style="margin:0 0 0.35rem;font-size:0.8125rem;color:var(--success);font-weight:600;">We emailed you this link. Check your inbox.</p>
              <a class="class-meet-link" href="<%= cm.meetLink %>" target="_blank" rel="noopener noreferrer"><%= cm.meetLink %></a>
            <% } else if (cm.meetLink) { %>
              <a class="class-meet-link" href="<%= cm.meetLink %>" target="_blank" rel="noopener noreferrer"><%= cm.meetLink %></a>
              <p class="small" style="margin:0 0 0.75rem;color:var(--muted);">Tap the button to receive the Meet link by email.</p>
              <button type="button" class="btn" id="btn-class-meet">
                <span class="button-text">Email me today’s Meet link</span>
                <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
              </button>
            <% } else { %>
              <button type="button" class="btn" id="btn-class-meet">
                <span class="button-text">Get today’s Meet link (email)</span>
                <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
              </button>
            <% } %>
            <p class="class-meet-err" id="class-meet-err" role="alert"></p>
          </div>
        <% } %>
        </div>

        <% if (!hasInstagram && isIgDaily) { %>
          <div class="task-lock-overlay" role="dialog" aria-modal="true" aria-labelledby="ig-lock-title">
            <div class="task-lock-inner">
              <h3 id="ig-lock-title">Add your Instagram ID</h3>
              <p>Instagram tasks are verified with your profile username and the Instagram API. Add your <strong>Instagram username</strong>, save, then return here to verify attendance.</p>
              <a class="btn-lock" href="/mern-training-program/dashboard/profile">Update profile &amp; Instagram</a>
            </div>
          </div>
        <% } %>
      </article>
    <% } %>

    <% if (hustleTask) { %>
      <p class="section-title">Optional challenge</p>
      <article class="task-card hustle-card">
        <h3>Bonus task</h3>
        <div class="task-meta">
          <span class="pill" style="background:#ede9fe;color:#5b21b6;">Hustle</span>
          <span class="pill"><%= hustleTask.date %></span>
        </div>
        <div class="task-body"><%- hustleTask.description %></div>

        <% if (hustleTask.isClosed) { %>
          <div class="note-closed">This challenge was already completed by another ambassador today.</div>
        <% } else if (hustleTask.proofUploaded) { %>
          <% if (hustleTask.proofStatus === 'verified') { %>
            <span class="status ok">Verified</span>
          <% } else if (hustleTask.proofStatus === 'pending') { %>
            <span class="status wait">Under review</span>
          <% } else if (hustleTask.proofStatus === 'rejected') { %>
            <span class="status bad">Rejected<% if (hustleTask.reason) { %> — <%= hustleTask.reason %><% } %></span>
            <div class="form-block">
              <form action="/mern-training-program/submit-hustle-task" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="taskId" value="<%= hustleTask.id %>" />
                <input type="hidden" name="videoScreenshotData" class="screenshot-data" />
                <input type="hidden" name="proofUrl" class="proof-url" />
                <label for="proof-hustle">Upload proof</label>
                <input id="proof-hustle" type="file" name="proofFile" accept="image/*,video/*" onchange="handleProofChange(this)" />
                <button type="submit" class="btn btn-secondary"><span class="button-text">Submit proof</span>
                  <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
                </button>
              </form>
            </div>
          <% } %>
        <% } else { %>
          <div class="form-block">
            <form action="/mern-training-program/submit-hustle-task" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="taskId" value="<%= hustleTask.id %>" />
              <input type="hidden" name="videoScreenshotData" class="screenshot-data" />
              <input type="hidden" name="proofUrl" class="proof-url" />
              <label for="proof-hustle-new">Upload proof</label>
              <input id="proof-hustle-new" type="file" name="proofFile" accept="image/*,video/*" onchange="handleProofChange(this)" />
              <button type="submit" class="btn btn-secondary"><span class="button-text">Submit proof</span>
                <svg class="loader-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path fill="currentColor" d="M4 12a8 8 0 018-8v4l3-3-3-3v4a8 8 0 100 16 8 8 0 01-8-8z"/></svg>
              </button>
            </form>
          </div>
        <% } %>
      </article>
    <% } %>
  </main>

  <canvas id="videoCanvas" class="hidden"></canvas>
  <video id="previewVideo" class="hidden" controls style="max-width:280px"></video>
  <img id="previewImage" class="hidden" alt="" style="max-width:280px" />
  <p id="loader" class="loader-txt">Uploading…</p>

  <script>
    function showButtonLoader(button) {
      var text = button.querySelector('.button-text');
      var loader = button.querySelector('.loader-icon');
      if (text && loader) {
        text.classList.add('opacity-50');
        loader.classList.remove('hidden');
        button.disabled = true;
      }
    }
    function hideButtonLoader(button) {
      var text = button.querySelector('.button-text');
      var loader = button.querySelector('.loader-icon');
      if (text && loader) {
        text.classList.remove('opacity-50');
        loader.classList.add('hidden');
        button.disabled = false;
      }
    }

    async function handleProofChange(input) {
      var file = input.files[0];
      var form = input.closest('form');
      if (!form || !file) return;

      var screenshotField = form.querySelector('.screenshot-data');
      var cloudUrlField = form.querySelector('.proof-url');
      var canvas = document.getElementById('videoCanvas');
      var ctx = canvas.getContext('2d');
      var loader = document.getElementById('loader');
      var previewVideo = document.getElementById('previewVideo');
      var previewImage = document.getElementById('previewImage');
      var submitBtn = form.querySelector('button[type="submit"]');

      previewVideo.classList.add('hidden');
      previewImage.classList.add('hidden');
      screenshotField.value = '';
      cloudUrlField.value = '';
      showButtonLoader(submitBtn);
      loader.classList.add('show');

      var isVideo = file.type.startsWith('video/');
      if (!isVideo) {
        var reader = new FileReader();
        reader.onload = async function (e) {
          previewImage.src = e.target.result;
          previewImage.classList.remove('hidden');
          try {
            cloudUrlField.value = await uploadToCloudinary(e.target.result);
          } catch (err) {
            alert('Upload failed. Try again.');
          } finally {
            hideButtonLoader(submitBtn);
            loader.classList.remove('show');
          }
        };
        reader.readAsDataURL(file);
        return;
      }

      var video = document.createElement('video');
      video.src = URL.createObjectURL(file);
      video.crossOrigin = 'anonymous';
      video.preload = 'auto';
      video.muted = true;
      video.playsInline = true;
      video.style.position = 'absolute';
      video.style.left = '-9999px';
      document.body.appendChild(video);

      video.addEventListener('loadedmetadata', function () {
        video.currentTime = Math.min(180, video.duration);
      });

      video.addEventListener('seeked', function () {
        setTimeout(async function () {
          try {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            var dataURL = canvas.toDataURL('image/jpeg', 0.9);
            if (dataURL.length < 10000) throw new Error('Blank screenshot');
            screenshotField.value = dataURL;
            previewVideo.src = video.src;
            previewVideo.classList.remove('hidden');
            cloudUrlField.value = await uploadToCloudinary(dataURL);
          } catch (e) {
            console.error(e);
            alert('Could not process video. Try an image or shorter clip.');
          } finally {
            hideButtonLoader(submitBtn);
            loader.classList.remove('show');
            URL.revokeObjectURL(video.src);
            video.remove();
          }
        }, 300);
      });
    }

    async function uploadToCloudinary(base64Data) {
      var formData = new FormData();
      formData.append('file', base64Data);
      formData.append('upload_preset', 'ml_default');
      var res = await fetch('https://api.cloudinary.com/v1_1/dr5dofa3x/image/upload', {
        method: 'POST',
        body: formData
      });
      var data = await res.json();
      if (!data.secure_url) throw new Error('Upload failed');
      return data.secure_url;
    }

    (function () {
      var btn = document.getElementById('btn-verify-ig');
      if (!btn) return;
      var listEl = document.getElementById('ig-check-list');
      var errEl = document.getElementById('ig-verify-err');
      function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s == null ? '' : String(s);
        return d.innerHTML;
      }
      btn.addEventListener('click', async function () {
        if (errEl) {
          errEl.style.display = 'none';
          errEl.textContent = '';
        }
        if (listEl) {
          listEl.style.display = 'none';
          listEl.innerHTML = '';
        }
        showButtonLoader(btn);
        try {
          var res = await fetch('/mern-training-program/verify-daily-instagram', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ taskId: btn.getAttribute('data-task-id') })
          });
          var data = {};
          try {
            data = await res.json();
          } catch (e) {}
          hideButtonLoader(btn);
          if (!res.ok) {
            if (errEl) {
              errEl.textContent = data.message || 'Verification failed.';
              errEl.style.display = 'block';
            }
            return;
          }
          if (listEl && data.checks && data.checks.length) {
            listEl.style.display = 'block';
            data.checks.forEach(function (c) {
              var li = document.createElement('li');
              var mark = '';
              if (c.api && c.ok === true) mark = '<span class="ig-check-ok">✓</span>';
              else if (c.api && c.ok === false) mark = '<span class="ig-check-bad">✗ Missing</span>';
              else mark = '<span class="ig-check-note">—</span>';
              var note = c.note
                ? '<span style="color:var(--muted);font-weight:400;font-size:0.8125rem;display:block;margin-top:0.25rem">' +
                  escapeHtml(c.note) +
                  '</span>'
                : '';
              li.innerHTML =
                mark +
                '<span><strong>' +
                escapeHtml(c.label) +
                '</strong>' +
                note +
                '</span>';
              listEl.appendChild(li);
            });
          }
          if (data.verified || data.pendingReview) {
            window.location.reload();
          }
        } catch (e) {
          hideButtonLoader(btn);
          if (errEl) {
            errEl.textContent = 'Network error. Try again.';
            errEl.style.display = 'block';
          }
        }
      });
    })();

    (function () {
      var btn = document.getElementById('btn-class-meet');
      if (!btn) return;
      var errEl = document.getElementById('class-meet-err');
      btn.addEventListener('click', async function () {
        if (errEl) {
          errEl.textContent = '';
          errEl.classList.remove('show');
        }
        showButtonLoader(btn);
        try {
          var res = await fetch('/mern-training-program/class-meet/today', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: '{}'
          });
          var data = {};
          try { data = await res.json(); } catch (e) {}
          hideButtonLoader(btn);
          if (!res.ok) {
            if (errEl) {
              errEl.textContent = data.message || 'Request failed.';
              errEl.classList.add('show');
            }
            return;
          }
          window.location.reload();
        } catch (e) {
          hideButtonLoader(btn);
          if (errEl) {
            errEl.textContent = 'Network error. Try again.';
            errEl.classList.add('show');
          }
        }
      });
    })();
  </script>
</body>
</html>
