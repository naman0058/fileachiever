<% include Includes/navbar.ejs %>

<style>
  body { background: #fff !important; }
</style>

<%
  const blogs = Array.isArray(result) ? result : [];
  const pg = pagination || {};
  const flt = filters || {};

  function blPageUrl(p) {
    const params = [];
    if (flt.q) params.push('q=' + encodeURIComponent(flt.q));
    if (flt.cat) params.push('category=' + encodeURIComponent(flt.cat));
    if (flt.order && flt.order !== 'new') params.push('sort=' + encodeURIComponent(flt.order));
    if (p > 1) params.push('page=' + encodeURIComponent(p));
    const base = (pg.baseUrl || '/blog').split('?')[0];
    return params.length ? (base + '?' + params.join('&')) : base;
  }

  function blCategoryUrl(cat) {
    const params = [];
    if (cat) params.push('category=' + encodeURIComponent(cat));
    if (flt.q) params.push('q=' + encodeURIComponent(flt.q));
    if (flt.order && flt.order !== 'new') params.push('sort=' + encodeURIComponent(flt.order));
    return params.length ? '/blog?' + params.join('&') : '/blog';
  }

  function blFormatDate(value) {
    if (!value) return '—';
    try {
      return new Date(value).toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
    } catch (_) {
      return '—';
    }
  }

  function blReadMins(blog) {
    if (typeof blogReadingMinutes === 'function') {
      const m = blogReadingMinutes(
        blog && blog.reading_time_minutes,
        (blog && blog.meta_abstract) || (blog && blog.meta_description) || (blog && blog.title) || ''
      );
      if (m) return m;
    }
    const text = String(
      (blog && (blog.meta_abstract || blog.meta_description || blog.meta_title || blog.title)) || ''
    );
    const words = text.replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
    return Math.max(1, Math.ceil(words / 200) || 3);
  }

  function blThumb(blog) {
    return String((blog && blog.thumbnail_url) || '').trim();
  }

  function blTitle(blog) {
    if (typeof blogPostHeading === 'function') {
      return blogPostHeading(blog);
    }
    return String((blog && (blog.title || blog.meta_title)) || 'Blog post').trim();
  }

  function blDesc(blog) {
    if (typeof blogPostExcerpt === 'function') {
      return blogPostExcerpt(blog, 140);
    }
    return String((blog && blog.meta_description) || '').trim();
  }

  function blCategory(blog) {
    const raw = String((blog && blog.category) || '').trim();
    if (!raw || /^null$/i.test(raw)) return 'Guide';
    return raw
      .replace(/[-_]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/\b\w/g, function (ch) { return ch.toUpperCase(); })
      .replace(/\bJs\b/g, 'JS')
      .replace(/\bAi\b/g, 'AI')
      .replace(/\bPhp\b/g, 'PHP');
  }

  function blCategoryBadge(blog) {
    return blCategory(blog).toUpperCase();
  }

  function blCategorySlug(raw) {
    return String(raw || '').trim();
  }

  function blAuthor(blog) {
    return String(
      (blog && (blog.author_name || blog.author || blog.created_by_name)) ||
      'FileMakr Team'
    ).trim();
  }

  function blCdnImage(url, width) {
    if (typeof cloudinaryUrl === 'function') {
      return cloudinaryUrl(url, { width: width || 640 });
    }
    return url;
  }

  function blCdnSrcSet(url) {
    if (typeof cloudinarySrcSet === 'function') {
      return cloudinarySrcSet(url, [320, 640, 960]);
    }
    return '';
  }

  const blHeroRaw = 'https://res.cloudinary.com/npuap6la/image/upload/v1787657312/Untitled_4.webp';
  const blHeroSrc = typeof cloudinaryUrl === 'function'
    ? cloudinaryUrl(blHeroRaw, { width: 720 })
    : blHeroRaw;

  const popularList = Array.isArray(popularPosts) ? popularPosts : blogs.slice(0, 25);
%>

<main id="main-content" class="bl-page">

  <nav class="bl-crumb-wrap" aria-label="Breadcrumb">
    <div class="bl-shell">
      <ol class="bl-crumb">
        <li><a href="/">Home</a></li>
        <li aria-current="page">Blog</li>
      </ol>
    </div>
  </nav>

  <!-- Hero — same layout as 404 (copy left, illustration right) -->
  <section class="bl-hero" aria-labelledby="bl-hero-title">
    <div class="bl-hero__wrap">
      <div class="bl-hero__grid">

        <div class="bl-hero__copy">
          <p class="bl-hero__eyebrow">FILEMAKR BLOG</p>

          <h1 id="bl-hero-title" class="bl-hero__title">
            Insights, Guides &amp;<br class="bl-hero__br">
            Resources for Students
          </h1>

          <span class="bl-hero__rule" aria-hidden="true"></span>

          <p class="bl-hero__lead">
            Explore in-depth guides, project ideas, technical tutorials and career
            resources to help you build better projects and advance your skills.
          </p>

          <ul class="bl-hero__points" aria-label="Blog highlights">
            <li>
              <span class="bl-hero__point-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 20h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5z"
                    stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>
                <strong>Expert Insights</strong>
                <small>Well-researched and practical</small>
              </span>
            </li>

            <li>
              <span class="bl-hero__point-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                    stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  <path d="M8 7h8M8 11h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </span>
              <span>
                <strong>Student Focused</strong>
                <small>Created for final year success</small>
              </span>
            </li>

            <li>
              <span class="bl-hero__point-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"
                    stroke="currentColor" stroke-width="1.7"
                    stroke-linejoin="round"/>
                </svg>
              </span>
              <span>
                <strong>Updated Regularly</strong>
                <small>Fresh content on trending topics</small>
              </span>
            </li>
          </ul>
        </div>

        <div class="bl-hero__media">
          <img
            src="<%= blHeroSrc %>"
            srcset="<%= typeof cloudinarySrcSet === 'function'
              ? cloudinarySrcSet(blHeroRaw, [480, 720, 960])
              : blHeroSrc %>"
            sizes="(max-width: 991px) calc(100vw - 20px), 520px"
            alt="FileMakr blog — project guides and student resources"
            width="720"
            height="540"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        </div>

      </div>
    </div>
  </section>

  <div class="bl-page__body">
    <div class="bl-shell">

      <section class="bl-toolbar" aria-label="Find blog articles">
        <form class="bl-toolbar__form" action="/blog" method="get" role="search">
          <label class="bl-toolbar__label" for="bl-search-q">Search blog articles</label>
          <div class="bl-toolbar__row">
            <input
              id="bl-search-q"
              class="bl-toolbar__input"
              type="search"
              name="q"
              value="<%= flt.q ? flt.q.replace(/"/g, '&quot;') : '' %>"
              placeholder="Search guides and tutorials…"
              maxlength="100"
              autocomplete="off"
            />
            <button class="bl-toolbar__btn" type="submit">Search</button>
          </div>
          <% if (typeof blogIsSearch !== 'undefined' && blogIsSearch && flt.q) { %>
            <p class="bl-toolbar__hint">Showing results for “<%= flt.q %>”. <a href="/blog">View all posts</a></p>
          <% } %>
        </form>
      </section>

      <div class="bl-layout">

        <section id="bl-posts" class="bl-posts" aria-label="Blog posts">
          <% if (blogs.length) { %>
            <% blogs.forEach(function (blog, index) {
              if (!blog || !blog.slug) return;
              const href = '/blog/' + encodeURIComponent(blog.slug || '');
              const cover = blThumb(blog);
              const title = blTitle(blog);
              const desc = blDesc(blog);
              const readMins = blReadMins(blog);
              const category = blCategory(blog);
              const author = blAuthor(blog);
              const letter = title.charAt(0).toUpperCase() || 'B';
            %>
              <article class="bl-post">
                <a class="bl-post__media" href="<%= href %>" tabindex="-1" aria-hidden="true">
                  <% if (cover) { %>
                    <img
                      src="<%= blCdnImage(cover, 720) %>"
                      srcset="<%= blCdnSrcSet(cover) %>"
                      sizes="(max-width: 767px) 100vw, 280px"
                      alt="<%= imageAltLabel(title, 'blog cover image') %>"
                      width="720"
                      height="405"
                      loading="<%= index < 2 ? 'eager' : 'lazy' %>"
                      decoding="async"
                    >
                  <% } else { %>
                    <span class="bl-post__fallback" data-letter="<%= letter %>"><%= letter %></span>
                  <% } %>
                </a>

                <div class="bl-post__body">
                  <h2 class="bl-post__title">
                    <a href="<%= href %>"><%= title %></a>
                  </h2>

                  <% if (desc) { %>
                    <p class="bl-post__desc"><%= desc %></p>
                  <% } %>

                  <div class="bl-post__footer">
                    <div class="bl-post__author">
                      <span class="bl-post__avatar" aria-hidden="true"><%= author.charAt(0).toUpperCase() %></span>
                      <span>
                        <strong><%= author %></strong>
                        <small><%= blFormatDate(blog.created_at) %> &nbsp;•&nbsp; <%= readMins %> min read</small>
                      </span>
                    </div>

                    <a class="bl-post__read" href="<%= href %>">
                      Read More <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
              <% if (index === 3) { adPosition = 'listing_1'; %>
                <%- include('partials/blog-ad-slot') %>
              <% } %>
              <% if (index === 11) { adPosition = 'listing_2'; %>
                <%- include('partials/blog-ad-slot') %>
              <% } %>
            <% }) %>
          <% } else { %>
            <div class="bl-empty">
              <div class="bl-empty__box">
                <h2>No posts found</h2>
                <p><%= flt.q ? 'Try different keywords or reset your search.' : 'Check back soon for new articles.' %></p>
                <a class="bl-empty__btn" href="/blog">View all posts</a>
              </div>
            </div>
          <% } %>

          <!-- pagination -->
          <% if (pg.totalPages > 1) {
            const win = 2;
            let start = Math.max(1, pg.page - win);
            let end = Math.min(pg.totalPages, pg.page + win);

            if (end - start < win * 2) {
              if (start === 1) end = Math.min(pg.totalPages, start + win * 2);
              else if (end === pg.totalPages) start = Math.max(1, end - win * 2);
            }
          %>
            <nav class="bl-pager" role="navigation" aria-label="Blog pagination">
              <a
                class="bl-pager__edge <%= pg.hasPrev ? '' : 'is-disabled' %>"
                href="<%= pg.hasPrev ? blPageUrl(pg.page - 1) : '#' %>"
                rel="prev"
                aria-disabled="<%= pg.hasPrev ? 'false' : 'true' %>"
              >
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Previous
              </a>

              <div class="bl-pager__pages">
                <% if (start > 1) { %>
                  <a class="bl-pager__num" href="<%= blPageUrl(1) %>">1</a>
                  <% if (start > 2) { %>
                    <span class="bl-pager__ellipsis">…</span>
                  <% } %>
                <% } %>

                <% for (let p = start; p <= end; p++) { %>
                  <a
                    class="bl-pager__num <%= p === pg.page ? 'is-active' : '' %>"
                    href="<%= blPageUrl(p) %>"
                    aria-current="<%= p === pg.page ? 'page' : 'false' %>"
                  ><%= p %></a>
                <% } %>

                <% if (end < pg.totalPages) { %>
                  <% if (end < pg.totalPages - 1) { %>
                    <span class="bl-pager__ellipsis">…</span>
                  <% } %>
                  <a class="bl-pager__num" href="<%= blPageUrl(pg.totalPages) %>"><%= pg.totalPages %></a>
                <% } %>
              </div>

              <a
                class="bl-pager__edge <%= pg.hasNext ? '' : 'is-disabled' %>"
                href="<%= pg.hasNext ? blPageUrl(pg.page + 1) : '#' %>"
                rel="next"
                aria-disabled="<%= pg.hasNext ? 'false' : 'true' %>"
              >
                Next
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </nav>
          <% } %>
        </section>

        <aside class="bl-sidebar" aria-label="Blog sidebar">

          <section class="bl-side-card">
            <h2 class="bl-side-card__title">Popular Posts</h2>
            <div class="bl-popular">
              <% if (popularList.length) { %>
                <% popularList.forEach(function (post) {
                  if (!post || !post.slug) return;
                  const href = '/blog/' + encodeURIComponent(post.slug || '');
                  const cover = blThumb(post);
                  const title = blTitle(post);
                %>
                  <article class="bl-popular__item">
                    <a class="bl-popular__thumb" href="<%= href %>" tabindex="-1" aria-hidden="true">
                      <% if (cover) { %>
                        <img
                          src="<%= blCdnImage(cover, 220) %>"
                          alt="<%= imageAltLabel(title, 'blog thumbnail') %>"
                          width="220"
                          height="124"
                          loading="lazy"
                          decoding="async"
                        >
                      <% } else { %>
                        <span><%= title.charAt(0).toUpperCase() %></span>
                      <% } %>
                    </a>
                    <div>
                      <h3><a href="<%= href %>"><%= title %></a></h3>
                      <small><%= blFormatDate(post.created_at) %></small>
                    </div>
                  </article>
                <% }) %>
              <% } else { %>
                <p class="bl-side-card__empty">Popular articles will appear here.</p>
              <% } %>
            </div>
          </section>

        </aside>
      </div>
    </div>
  </div>
</main>

<% include Includes/footer.ejs %>

<% if (typeof blogListingJsonLd !== 'undefined' && blogListingJsonLd) { %>
<script type="application/ld+json"><%- blogListingJsonLd %></script>
<% } %>
