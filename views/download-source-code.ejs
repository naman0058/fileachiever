(function initMobileStickyBar(){
  const bar = document.getElementById('StickyBuyBar');
  const sentinel = document.getElementById('StickyScrollSentinel');
  const anchor = document.getElementById('MobileCtaAnchor');
  if (!bar) return;

  var desktopMq = window.matchMedia('(min-width: 992px)');

  function shouldShowSticky() {
    if (desktopMq.matches) return true; // laptop: always fixed visible
    const el = sentinel || anchor;
    if (!el) return window.scrollY > 120;
    return el.getBoundingClientRect().bottom < 8;
  }

  function setStickyVisible(visible) {
    bar.classList.toggle('is-visible', visible);
    bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
    document.body.classList.toggle('sc-sticky-active', visible);
  }

  function updateSticky() {
    setStickyVisible(shouldShowSticky());
  }

  updateSticky();

  var scrollTick = false;
  window.addEventListener('scroll', function() {
    if (desktopMq.matches) return;
    if (scrollTick) return;
    scrollTick = true;
    requestAnimationFrame(function() {
      updateSticky();
      scrollTick = false;
    });
  }, { passive: true });

  if ('IntersectionObserver' in window && (sentinel || anchor)) {
    var observer = new IntersectionObserver(function() {
      updateSticky();
    }, { root: null, threshold: 0, rootMargin: '0px 0px 0px 0px' });
    if (sentinel) observer.observe(sentinel);
    if (anchor) observer.observe(anchor);
  }

  if (desktopMq.addEventListener) {
    desktopMq.addEventListener('change', updateSticky);
  } else if (desktopMq.addListener) {
    desktopMq.addListener(updateSticky);
  }
  window.addEventListener('resize', updateSticky, { passive: true });
})();

(function initFeatModal(){
  var modal = document.getElementById('FeatModal');
  var titleEl = document.getElementById('FeatModalTitle');
  var bodyEl = document.getElementById('FeatModalBody');
  if (!modal || !titleEl || !bodyEl) return;

  var titles = {
    admin: 'Admin Panel Features',
    user: 'User Panel Features',
    other: 'Other Features',
    run: 'How to Run this Project',
    credentials: 'Login Credentials'
  };
  var templates = {
    admin: document.getElementById('FeatTplAdmin'),
    user: document.getElementById('FeatTplUser'),
    other: document.getElementById('FeatTplOther'),
    run: document.getElementById('FeatTplRun'),
    credentials: document.getElementById('FeatTplCredentials')
  };
  var lastFocus = null;

  function isBlankHtml(node) {
    if (!node) return true;
    var text = (node.textContent || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
    return !text;
  }

  function nodeText(el) {
    return (el.textContent || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function cleanFeatContent(root) {
    if (!root) return;
    var pass;
    for (pass = 0; pass < 4; pass++) {
      var nodes = root.querySelectorAll('pre, code, p, div, li, span, section, article, h1, h2, h3, h4, h5, h6');
      var i;
      for (i = nodes.length - 1; i >= 0; i--) {
        var el = nodes[i];
        if (!el || !el.parentNode) continue;
        if (el.classList && (el.classList.contains('sc-info-run__foot') || el.classList.contains('sc-run-content'))) continue;
        var text = nodeText(el);
        var hasUsefulChild = el.querySelector && el.querySelector('img, iframe, video, table, pre, code, a, strong, b, em');
        if (!text && !hasUsefulChild) {
          el.parentNode.removeChild(el);
        }
      }
    }
  }

  function openFeat(key) {
    var tpl = templates[key];
    if (!tpl) return;
    var clone = tpl.content.cloneNode(true);
    var probe = document.createElement('div');
    probe.appendChild(clone.cloneNode(true));
    if (isBlankHtml(probe) && key !== 'run') return;
    lastFocus = document.activeElement;
    titleEl.textContent = titles[key] || 'Details';
    bodyEl.innerHTML = '';
    bodyEl.classList.add('is-clean');
    bodyEl.classList.toggle('is-run-mode', key === 'run');
    bodyEl.appendChild(tpl.content.cloneNode(true));
    cleanFeatContent(bodyEl);
    if (isBlankHtml(bodyEl) && key !== 'run') {
      bodyEl.innerHTML = '';
      bodyEl.classList.remove('is-clean', 'is-run-mode');
      return;
    }
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('sc-feat-modal-open');
    var closeBtn = modal.querySelector('.sc-feat-modal__close');
    if (closeBtn) closeBtn.focus();
  }

  function closeFeat() {
    if (!modal.classList.contains('is-open')) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('sc-feat-modal-open');
    bodyEl.innerHTML = '';
    bodyEl.classList.remove('is-clean', 'is-run-mode');
    if (lastFocus && typeof lastFocus.focus === 'function') {
      try { lastFocus.focus(); } catch (e) {}
    }
  }

  document.querySelectorAll('[data-feat]').forEach(function(btn) {
    if (btn.tagName === 'A') return;
    btn.addEventListener('click', function() {
      openFeat(btn.getAttribute('data-feat'));
    });
  });

  modal.querySelectorAll('[data-feat-close]').forEach(function(el) {
    el.addEventListener('click', closeFeat);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeFeat();
  });
})();
</script>



<script>
