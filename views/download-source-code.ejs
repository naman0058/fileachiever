      padding: 9px 12px;
      background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
      border-bottom: 1px solid #e2e8f0;
    }
    .preview-card__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .preview-card__dot--red { background: #ff5f57; }
    .preview-card__dot--yellow { background: #febc2e; }
    .preview-card__dot--green { background: #28c840; }
    .preview-card__url {
      flex: 1;
      min-width: 0;
      margin-left: 4px;
      font-size: 11px;
  font-weight: 600;
      color: #64748b;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 7px;
      padding: 5px 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .preview-card__media {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: #f1f5f9;
    }
    .preview-card__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.45s ease;
    }
    .preview-card:hover .preview-card__img { transform: scale(1.04); }
    .preview-card__mesh {
      position: relative;
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at 20% 20%, rgba(42, 71, 255, 0.12) 0%, transparent 42%),
        radial-gradient(circle at 80% 10%, rgba(241, 127, 35, 0.14) 0%, transparent 38%),
        linear-gradient(145deg, #eef2ff 0%, #f8fafc 45%, #fff7ed 100%);
    }
    .preview-card__mesh::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(42, 71, 255, 0.07) 1px, transparent 1px);
      background-size: 20px 20px;
      opacity: 0.6;
    }
    .preview-card__shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,0) 35%, rgba(15, 23, 42, 0.4) 100%);
      pointer-events: none;
    }
    .preview-card__cta {
      position: absolute;
      left: 50%;
      bottom: 20px;
      transform: translateX(-50%);
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px 10px 10px;
      border-radius: 999px;
      background: #ffffff;
      box-shadow: 0 10px 32px rgba(14, 18, 32, 0.2);
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      white-space: nowrap;
      line-height: 1;
      pointer-events: none;
    }
    .preview-card__cta-icon {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 13px;
      flex-shrink: 0;
    }
    .preview-card--demo .preview-card__cta-icon { background: var(--brandBlue, #2A47FF); }
    .preview-card--shots .preview-card__cta-icon { background: #6366f1; }
    .preview-card--wa .preview-card__cta-icon { background: #25D366; }

    @media (max-width: 991.98px) {
      .preview-card__cta {
        font-size: 15px;
        gap: 10px;
        padding: 10px 18px 10px 10px;
        bottom: 20px;
        box-shadow: 0 10px 32px rgba(14, 18, 32, 0.2);
      }
      .preview-card__cta-icon { width: 34px; height: 34px; font-size: 13px; }
      .preview-device__foot { display: none !important; }
      .preview-device__base,
      .preview-device__glow,
      .preview-device__stack { display: none !important; }
      .preview-device__screen {
        padding: 0;
        background: none;
        transform: none !important;
        box-shadow: none;
        border-radius: 12px;
        overflow: hidden;
      }
      .preview-device__screen .preview-card {
        border-radius: 12px;
      }
      .preview-device__screen .preview-card__media {
        aspect-ratio: 16 / 10;
      }
    }

    /* ===== Desktop laptop mockup ===== */
    .preview-device {
      position: relative;
      width: 100%;
    }
    .preview-device__glow {
      position: absolute;
      left: 5%;
      right: 5%;
      top: 15%;
      bottom: 25%;
      background: radial-gradient(ellipse at center, rgba(42, 71, 255, 0.18) 0%, rgba(241, 127, 35, 0.08) 45%, transparent 72%);
      filter: blur(28px);
      z-index: 0;
      pointer-events: none;
    }
    .preview-device__stack {
      position: absolute;
      top: 18px;
      right: -8px;
      width: 38%;
      aspect-ratio: 16 / 10;
      border-radius: 10px;
      overflow: hidden;
      border: 2px solid #fff;
      box-shadow: 0 16px 40px rgba(14, 18, 32, 0.18);
      transform: rotate(6deg);
      z-index: 0;
      opacity: 0.92;
    }
    .preview-device__stack img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
    }
    .preview-device__screen {
      position: relative;
      z-index: 1;
      padding: 11px 11px 0;
      border-radius: 16px 16px 0 0;
      background: linear-gradient(180deg, #2d3748 0%, #1a202c 100%);
      box-shadow:
        0 32px 64px -16px rgba(14, 18, 32, 0.35),
        0 0 0 1px rgba(255, 255, 255, 0.06) inset;
      transform: perspective(1400px) rotateY(-5deg) rotateX(3deg);
      transform-origin: center bottom;
      transition: transform 0.45s ease, box-shadow 0.45s ease;
    }
    .preview-device:hover .preview-device__screen {
      transform: perspective(1400px) rotateY(0deg) rotateX(0deg);
      box-shadow:
        0 40px 72px -16px rgba(14, 18, 32, 0.4),
        0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    }
    .preview-device__screen .preview-card {
      border: none;
      border-radius: 8px 8px 0 0;
      box-shadow: none;
      margin: 0;
    }
    .preview-device__screen .preview-card:hover {
      transform: none;
      box-shadow: none;
    }
    .preview-device__base {
      position: relative;
      z-index: 1;
      height: 16px;
      margin: 0 8%;
      background: linear-gradient(180deg, #94a3b8 0%, #64748b 100%);
      border-radius: 0 0 10px 10px;
      box-shadow: 0 12px 24px rgba(14, 18, 32, 0.15);
    }
    .preview-device__base::after {
      content: '';
      display: block;
      width: 18%;
      height: 4px;
      margin: 5px auto 0;
      background: #475569;
      border-radius: 999px;
    }
    .preview-device__foot {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      margin-top: 18px;
      padding: 0 4px;
    }
    .preview-device__action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 20px;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 800;
      text-decoration: none !important;
      border: none;
      cursor: pointer;
      transition: filter 0.2s ease, transform 0.2s ease;
    }
    .preview-device__action:hover { filter: brightness(0.97); transform: translateY(-1px); }
    .preview-device__action--primary {
      background: var(--brandBlue, #2A47FF);
      color: #fff;
      box-shadow: 0 12px 28px rgba(42, 71, 255, 0.28);
    }
    .preview-device__action--secondary {
      background: #fff;
      color: var(--brandBlue, #2A47FF);
      border: 2px solid var(--brandBlue, #2A47FF);
      box-shadow: none;
    }
    .preview-device__action--wa {
      background: #25D366;
      color: #fff;
      box-shadow: 0 10px 24px rgba(37, 211, 102, 0.28);
    }
    .preview-device__trust {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 14px;
      font-size: 11px;
      font-weight: 700;
      color: #64748b;
    }
    .preview-device__trust span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .preview-device__trust i { color: #22c55e; font-size: 12px; }

    @media (min-width: 992px) {
      .preview-device__screen .preview-card__media {
        aspect-ratio: 16 / 10;
        min-height: 240px;
      }
      .preview-device__screen .preview-card__chrome {
        padding: 10px 14px;
      }
      .preview-device__screen .preview-card__url {
        font-size: 12px;
        padding: 6px 12px;
      }
    }

