<script>
(function initScPheroThumbs(){
  var main = document.getElementById('ScPheroMainImg');
  var stage = document.getElementById('ScPheroStage');
  var overlay = document.getElementById('ScPheroDemoOverlay');
  var zoomOpen = document.getElementById('ScPheroZoomOpen');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('.sc-phero__thumb'));
  var prev = document.getElementById('ScPheroPrev');
  var next = document.getElementById('ScPheroNext');
  if (!main) return;

  var i = 0;
  var hoverZoom = 1.85;
  var shotThumbs = thumbs.filter(function(t){ return t.getAttribute('data-type') !== 'demo'; });

  function resetHoverZoom(){
    if (!stage || !main) return;
    stage.classList.remove('is-hover-zoom');
    if (!main.classList.contains('is-blurred')) {
      main.style.transform = '';
      main.style.transformOrigin = 'center center';
    }
  }

  function setActive(idx){
    if (!thumbs.length || idx < 0 || idx >= thumbs.length) return;
    i = idx;
    var btn = thumbs[i];
    var src = btn.getAttribute('data-src');
    var isDemo = btn.getAttribute('data-type') === 'demo';
    if (src) main.src = src;
    main.classList.toggle('is-blurred', !!isDemo);
    resetHoverZoom();
    if (stage) stage.classList.toggle('is-demo-mode', !!isDemo);
    if (overlay) {
      overlay.classList.toggle('is-on', !!isDemo);
      overlay.setAttribute('aria-hidden', isDemo ? 'false' : 'true');
    }
    thumbs.forEach(function(el, n){
      var on = n === i;
      el.classList.toggle('is-active', on);
      el.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    try {
      thumbs[i].scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: 'smooth' });
    } catch (e) {}
  }

  thumbs.forEach(function(btn, n){
    btn.addEventListener('click', function(){ setActive(n); });
  });
  if (prev) prev.addEventListener('click', function(){ setActive((i - 1 + thumbs.length) % thumbs.length); });
  if (next) next.addEventListener('click', function(){ setActive((i + 1) % thumbs.length); });

  if (stage && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    stage.addEventListener('mousemove', function(e){
      if (stage.classList.contains('is-demo-mode') || main.classList.contains('is-blurred')) return;
      var rect = stage.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      var x = ((e.clientX - rect.left) / rect.width) * 100;
      var y = ((e.clientY - rect.top) / rect.height) * 100;
      stage.classList.add('is-hover-zoom');
      main.style.transformOrigin = x + '% ' + y + '%';
      main.style.transform = 'scale(' + hoverZoom + ')';
    });
    stage.addEventListener('mouseleave', resetHoverZoom);
  }

  // Lightbox zoom + gallery swipe
  var lb = document.getElementById('ScZoomLb');
  var lbImg = document.getElementById('ScZoomImg');
  var lbView = document.getElementById('ScZoomViewport');
  var lbLevel = document.getElementById('ScZoomLevel');
  var lbIn = document.getElementById('ScZoomIn');
  var lbOut = document.getElementById('ScZoomOut');
  var lbReset = document.getElementById('ScZoomReset');
  var lbClose = document.getElementById('ScZoomClose');
  var lbPrev = document.getElementById('ScZoomPrev');
  var lbNext = document.getElementById('ScZoomNext');
  var lbCounter = document.getElementById('ScZoomCounter');
  var scale = 1;
  var minScale = 1;
  var maxScale = 4;
  var fitW = 0;
  var dragging = false;
  var startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0;
  var touchX = 0, touchY = 0, touchDx = 0, touchDy = 0;

  function currentShotIndex(){
    if (!shotThumbs.length) return 0;
    var active = thumbs[i];
    var idx = shotThumbs.indexOf(active);
    if (idx >= 0) return idx;
    return 0;
  }

  function updateNavUi(){
    var total = shotThumbs.length || 1;
    var cur = currentShotIndex() + 1;
    if (lbCounter) lbCounter.textContent = cur + ' / ' + total;
    var multi = shotThumbs.length > 1;
    if (lbPrev) {
      lbPrev.disabled = !multi;
      lbPrev.style.display = multi ? '' : 'none';
    }
    if (lbNext) {
      lbNext.disabled = !multi;
      lbNext.style.display = multi ? '' : 'none';
    }
  }

  function applyLbScale(){
    if (!lbImg || !lbView) return;
    var nw = lbImg.naturalWidth || 1;
    var nh = lbImg.naturalHeight || 1;
    if (!lbImg.complete || nw < 2) {
      lbImg.onload = function(){ applyLbScale(); };
      return;
    }
    var styles = window.getComputedStyle(lbView);
    var padX = (parseFloat(styles.paddingLeft) || 0) + (parseFloat(styles.paddingRight) || 0);
    var padY = (parseFloat(styles.paddingTop) || 0) + (parseFloat(styles.paddingBottom) || 0);
    var vw = Math.max(80, lbView.clientWidth - padX);
    var vh = Math.max(80, lbView.clientHeight - padY);
    var isMobile = window.matchMedia('(max-width: 767.98px)').matches;

    var fit;
    if (isMobile) {
      // Mobile: always fill screen width at 100% (no side black bars)
      fit = vw / nw;
    } else {
      // Desktop: fit inside viewport (laptop OK)
      fit = Math.min(vw / nw, vh / nh);
    }
    fitW = Math.max(1, nw * fit);
    var displayW = Math.max(1, Math.round(fitW * scale));
    var displayH = Math.max(1, Math.round((nh / nw) * displayW));

    lbImg.classList.toggle('is-lb-zoomed', scale > 1.01);
    lbImg.style.width = displayW + 'px';
    lbImg.style.height = displayH + 'px';
    lbImg.style.maxWidth = 'none';
    lbImg.style.maxHeight = 'none';
    lbImg.style.transform = 'none';
    lbView.classList.toggle('is-scrollable', true);
    if (lbLevel) lbLevel.textContent = Math.round(scale * 100) + '%';

    if (scale <= 1.01 && lbView) {
      lbView.scrollLeft = 0;
      lbView.scrollTop = 0;
    }
  }

  function showLbShot(shotIdx){
    if (!shotThumbs.length || !lbImg) return;
    var n = ((shotIdx % shotThumbs.length) + shotThumbs.length) % shotThumbs.length;
    var btn = shotThumbs[n];
    var globalIdx = thumbs.indexOf(btn);
    if (globalIdx >= 0) setActive(globalIdx);
    var src = btn.getAttribute('data-src');
    if (src) lbImg.src = src;
    scale = 1;
    if (lbView) { lbView.scrollLeft = 0; lbView.scrollTop = 0; }
    updateNavUi();
    if (lbImg.complete) applyLbScale();
    else lbImg.onload = function(){ applyLbScale(); };
  }

  function openZoom(){
    if (!lb || !lbImg || (stage && stage.classList.contains('is-demo-mode'))) return;
    // Jump to nearest real screenshot if currently on demo thumb
    if (thumbs[i] && thumbs[i].getAttribute('data-type') === 'demo') {
      if (!shotThumbs.length) return;
      setActive(thumbs.indexOf(shotThumbs[0]));
    }
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    showLbShot(currentShotIndex());
    requestAnimationFrame(function(){
      applyLbScale();
      setTimeout(applyLbScale, 60);
      setTimeout(applyLbScale, 180);
    });
  }

  function closeZoom(){
    if (!lb) return;
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    dragging = false;
    if (lbView) lbView.classList.remove('is-dragging');
  }

  function lbStep(dir){
    if (!shotThumbs.length) return;
    showLbShot(currentShotIndex() + dir);
  }

  if (zoomOpen) zoomOpen.addEventListener('click', function(e){ e.stopPropagation(); openZoom(); });
  if (stage) {
    stage.addEventListener('click', function(e){
      if (e.target.closest('.sc-phero__demo-overlay') || e.target.closest('.sc-phero__zoom-btn')) return;
      if (stage.classList.contains('is-demo-mode')) return;
      openZoom();
    });
  }
  if (lbClose) lbClose.addEventListener('click', closeZoom);
  if (lb) lb.addEventListener('click', function(e){ if (e.target === lb) closeZoom(); });
  if (lbPrev) lbPrev.addEventListener('click', function(e){ e.stopPropagation(); lbStep(-1); });
  if (lbNext) lbNext.addEventListener('click', function(e){ e.stopPropagation(); lbStep(1); });
  if (lbIn) lbIn.addEventListener('click', function(){ scale = Math.min(maxScale, +(scale + 0.25).toFixed(2)); applyLbScale(); });
  if (lbOut) lbOut.addEventListener('click', function(){ scale = Math.max(minScale, +(scale - 0.25).toFixed(2)); applyLbScale(); if (scale <= 1 && lbView) { lbView.scrollLeft = 0; lbView.scrollTop = 0; } });
  if (lbReset) lbReset.addEventListener('click', function(){ scale = 1; applyLbScale(); if (lbView) { lbView.scrollLeft = 0; lbView.scrollTop = 0; } });

  document.addEventListener('keydown', function(e){
    if (!lb || !lb.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeZoom();
    if (e.key === 'ArrowLeft') { e.preventDefault(); lbStep(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); lbStep(1); }
    if (e.key === '+' || e.key === '=') { scale = Math.min(maxScale, +(scale + 0.25).toFixed(2)); applyLbScale(); }
    if (e.key === '-') { scale = Math.max(minScale, +(scale - 0.25).toFixed(2)); applyLbScale(); }
  });

  window.addEventListener('resize', function(){
    if (lb && lb.classList.contains('is-open')) applyLbScale();
  });

  if (lbView) {
    lbView.addEventListener('wheel', function(e){
      if (!lb.classList.contains('is-open')) return;
      if (e.ctrlKey || e.metaKey || Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault();
        var delta = e.deltaY > 0 ? -0.15 : 0.15;
        scale = Math.max(minScale, Math.min(maxScale, +(scale + delta).toFixed(2)));
        applyLbScale();
      }
    }, { passive: false });

    lbView.addEventListener('mousedown', function(e){
      if (e.target.closest('.sc-zoom-lb__nav')) return;
      dragging = true;
      lbView.classList.add('is-dragging');
      startX = e.pageX;
      startY = e.pageY;
      scrollLeft = lbView.scrollLeft;
      scrollTop = lbView.scrollTop;
    });
    window.addEventListener('mouseup', function(){
      dragging = false;
      if (lbView) lbView.classList.remove('is-dragging');
    });
    window.addEventListener('mousemove', function(e){
      if (!dragging || !lbView) return;
      lbView.scrollLeft = scrollLeft - (e.pageX - startX);
      lbView.scrollTop = scrollTop - (e.pageY - startY);
    });

    // Touch swipe left/right for next/prev when not zoomed-in
    lbView.addEventListener('touchstart', function(e){
      if (!e.touches || !e.touches[0]) return;
      touchX = e.touches[0].clientX;
      touchY = e.touches[0].clientY;
      touchDx = 0;
      touchDy = 0;
    }, { passive: true });
    lbView.addEventListener('touchmove', function(e){
      if (!e.touches || !e.touches[0]) return;
      touchDx = e.touches[0].clientX - touchX;
      touchDy = e.touches[0].clientY - touchY;
    }, { passive: true });
    lbView.addEventListener('touchend', function(){
      if (scale > 1.05) return; // panning mode when zoomed
      if (Math.abs(touchDx) < 55 || Math.abs(touchDx) < Math.abs(touchDy)) return;
      if (touchDx < 0) lbStep(1);
      else lbStep(-1);
    }, { passive: true });
  }
})();
</script>

