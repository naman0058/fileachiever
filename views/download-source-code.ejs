  .sc-zoom-lb__btn {
    min-width: 36px;
    height: 36px;
    flex: 1;
    padding: 0 6px;
    font-size: 13px;
  }
  .sc-zoom-lb__btn--close { flex: 0 0 40px; }
  .sc-zoom-lb__level { min-width: 40px; font-size: 11px; }
  .sc-zoom-lb__viewport {
    padding: 0 0 44px;
    overflow: auto;
    align-items: center;
    justify-content: center;
  }
  .sc-zoom-lb__img {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    border-radius: 0;
    box-shadow: none;
  }
  .sc-zoom-lb__img.is-lb-zoomed {
    width: auto !important;
    max-width: none !important;
  }
  .sc-zoom-lb__nav {
    width: 40px;
    height: 40px;
    background: rgba(15, 23, 42, 0.72);
  }
  .sc-zoom-lb__nav--prev { left: 6px; }
  .sc-zoom-lb__nav--next { right: 6px; }
  .sc-zoom-lb__counter {
    bottom: max(10px, env(safe-area-inset-bottom));
  }
}
.sc-phero__demo-overlay {
  position: absolute;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(11, 18, 32, 0.42);
  z-index: 2;
  padding: 16px;
}
.sc-phero__demo-overlay.is-on {
  display: flex;
}
.sc-phero__demo-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 48px;
  padding: 0 22px;
  border-radius: 12px;
  background: var(--ph-blue);
  color: #fff !important;
  font-size: 15px;
  font-weight: 800;
  text-decoration: none !important;
  box-shadow: 0 12px 32px rgba(42, 71, 255, 0.4);
  border: 0;
  cursor: pointer;
}
.sc-phero__demo-cta:hover { filter: brightness(1.06); color: #fff !important; }
.sc-phero__demo-cta svg { width: 16px; height: 16px; flex-shrink: 0; }
.sc-phero__thumb--demo {
  position: relative;
  background: #0F172A;
}
.sc-phero__thumb--demo img {
  filter: blur(2px);
  transform: scale(1.08);
  opacity: 0.75;
}
.sc-phero__thumb--demo::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(42, 71, 255, 0.35);
}
.sc-phero__thumb-play {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  pointer-events: none;
}
.sc-phero__thumb-play svg { width: 16px; height: 16px; }
.sc-phero__stage-empty {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 280px;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: #0F172A;
  cursor: default;
}
.sc-phero__stage-empty-bg {
  position: absolute;
  inset: -18px;
  background:
    radial-gradient(ellipse 70% 55% at 20% 30%, rgba(42, 71, 255, 0.45), transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 70%, rgba(241, 127, 35, 0.35), transparent 55%),
    linear-gradient(145deg, #1E293B 0%, #0F172A 48%, #111827 100%);
  filter: blur(18px);
  transform: scale(1.08);
  pointer-events: none;
}
.sc-phero__stage-empty-bg::before,
.sc-phero__stage-empty-bg::after {
  content: '';
  position: absolute;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.08);
}
.sc-phero__stage-empty-bg::before {
  top: 18%;
  left: 12%;
  width: 42%;
  height: 48%;
}
.sc-phero__stage-empty-bg::after {
  top: 28%;
  right: 10%;
  width: 36%;
  height: 40%;
}
.sc-phero__stage-empty-shade {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  pointer-events: none;
}
.sc-phero__gallery-req {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 48px;
  padding: 12px 20px;
  border-radius: 12px;
  border: 0;
  background: #25D366;
  color: #fff !important;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.01em;
  text-decoration: none !important;
  box-shadow: 0 12px 28px rgba(37, 211, 102, 0.35);
  transition: filter .15s ease, transform .15s ease;
}
.sc-phero__gallery-req:hover {
  filter: brightness(1.05);
  transform: translateY(-1px);
  color: #fff !important;
}
.sc-phero__gallery-req svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
.sc-phero__stage.is-empty-gallery {
  cursor: default;
  background: #0F172A;
}
@media (max-width: 767.98px) {
  .sc-phero__stage-empty {
    min-height: 200px;
  }
  .sc-phero__gallery-req {
    min-height: 44px;
    padding: 10px 16px;
    font-size: 13px;
  }
}

.sc-phero__thumbs-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
}
.sc-phero__thumb-nav {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  border-radius: 999px;
  border: 1px solid var(--ph-line);
  background: #fff;
  color: var(--ph-ink);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
}
.sc-phero__thumb-nav:hover { border-color: var(--ph-blue); color: var(--ph-blue); }
.sc-phero__thumb-nav:disabled { opacity: 0.35; cursor: default; }
.sc-phero__thumbs {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 8px;
  justify-content: stretch;
  align-items: stretch;
  overflow: hidden;
  padding: 2px;
}
.sc-phero__thumbs::-webkit-scrollbar { display: none; }
.sc-phero__thumb {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  height: 52px;
  border-radius: 8px;
  overflow: hidden;
  border: 2px solid transparent;
  padding: 0;
  background: var(--ph-soft);
  cursor: pointer;
}
.sc-phero__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.sc-phero__thumb.is-active {
  border-color: var(--ph-blue);
  box-shadow: 0 0 0 2px rgba(42, 71, 255, 0.15);
}

@media (max-width: 575.98px) {
  .sc-phero__thumb { height: 44px; }
  .sc-phero__thumbs { gap: 6px; }
}
</style>

