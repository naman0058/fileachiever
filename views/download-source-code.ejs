(function initMobileStickyBar(){
  const bar = document.getElementById('StickyBuyBar');
  const topPromo = document.getElementById('StickyTopPromo');
  const sentinel = document.getElementById('StickyScrollSentinel');
  const anchor = document.getElementById('MobileCtaAnchor');
  if (!bar && !topPromo) return;

  if (window.matchMedia('(min-width: 992px)').matches) return;

  function shouldShowSticky() {
    const el = sentinel || anchor;
    if (!el) return window.scrollY > 120;
    return el.getBoundingClientRect().bottom < 8;
  }

  function setStickyVisible(visible) {
    if (bar) {
      bar.classList.toggle('is-visible', visible);
      bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
    }
    if (topPromo) {
      topPromo.classList.toggle('is-visible', visible);
      topPromo.setAttribute('aria-hidden', visible ? 'false' : 'true');
    }
    document.body.classList.toggle('sc-sticky-active', visible);
  }

  function updateSticky() {
    setStickyVisible(shouldShowSticky());
  }

  setStickyVisible(false);
  updateSticky();

  var scrollTick = false;
  window.addEventListener('scroll', function() {
    if (scrollTick) return;
    scrollTick = true;
    requestAnimationFrame(function() {
      updateSticky();
      scrollTick = false;
    });
  }, { passive: true });

  if ('IntersectionObserver' in window && (sentinel || anchor)) {
    var observer = new IntersectionObserver(function() {
      updateSticky();
    }, { root: null, threshold: 0, rootMargin: '0px 0px 0px 0px' });
    if (sentinel) observer.observe(sentinel);
    if (anchor) observer.observe(anchor);
  }

  window.matchMedia('(min-width: 992px)').addEventListener('change', function(e) {
    if (e.matches) setStickyVisible(false);
  });

  window.addEventListener('resize', updateSticky, { passive: true });
})();
</script>

<script>
(function(){
  const list = document.getElementById('Grid');
  const empty = document.getElementById('RelFilterEmpty');
  if (!list) return;

  const items = list.querySelectorAll('.sc-rel-item');
  const filterBtns = document.querySelectorAll('.sc-related__filter, .sc-related__empty-btn');

  function applyFilter(mode) {
    let visible = 0;
    items.forEach(function(el) {
      const show = mode === 'all' || el.getAttribute('data-has-demo') === '1';
      el.hidden = !show;
      if (show) visible++;
    });

    if (empty) {
      empty.classList.toggle('is-visible', visible === 0 && mode === 'demo');
    }

    document.querySelectorAll('.sc-related__filter').forEach(function(btn) {
      const active = btn.getAttribute('data-filter') === mode;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.disabled) return;
      applyFilter(btn.getAttribute('data-filter') || 'all');
    });
  });
})();
</script>



