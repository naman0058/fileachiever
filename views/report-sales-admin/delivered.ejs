<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Delivered • Report Sales Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/report-sales-admin/prs-admin.css?v=2">
</head>
<body class="support-body">
<div class="support-layout">
  <aside class="support-sidebar-wrap"><%- include('partials/sidebar') %></aside>
  <main class="support-main">
    <div class="ss-shell">
      <div class="ss-topbar">
        <div>
          <h1>Delivered</h1>
          <p>Last 100 completed orders · prices hidden</p>
        </div>
        <form method="get" action="/report-sales-admin/delivered">
          <select name="plan" class="ss-select" style="min-width:160px" onchange="this.form.submit()">
            <option value="">All plans</option>
            <% Object.keys(planMeta).forEach(function(k){ %><option value="<%= k %>" <%= filters.plan===k?'selected':'' %>><%= planMeta[k] %></option><% }) %>
          </select>
        </form>
      </div>
      <div class="ss-panel">
        <div class="ss-panel__head">
          <div><h2 class="ss-panel__title">Recent deliveries</h2><p class="ss-panel__sub"><%= rows.length %> of max 100</p></div>
          <a class="ss-btn ss-btn--ghost ss-btn--sm" href="/report-sales-admin">Back to open work</a>
        </div>
        <div class="ss-table-wrap">
          <table class="ss-table">
            <thead>
              <tr>
                <th>ID</th><th>Plan</th><th>Order / Product</th><th>Customer</th><th>Phone</th>
                <th>Assignee</th><th>Delivered</th>
              </tr>
            </thead>
            <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="7"><div class="ss-empty"><i class="bi bi-check2-circle"></i>No delivered orders yet.</div></td></tr>
            <% } %>
            <% rows.forEach(function(r){ %>
              <tr>
                <td class="ss-strong">#<%= r.id %></td>
                <td><span class="ss-badge ss-badge--checkout"><%= planMeta[r.plan] || r.plan %></span></td>
                <td><div class="ss-strong"><%= r.fm_order_id || '—' %></div><div class="ss-muted ss-clamp"><%= r.product_name || '—' %></div></td>
                <td>
                  <div class="ss-strong"><%= r.customer_name %></div>
                  <% if (r.customer_email) { %><div class="ss-muted" style="font-size:12px"><%= r.customer_email %></div><% } %>
                </td>
                <td>
                  <% if (r.customer_number) { %>
                  <%= r.customer_number %>
                  <a class="ss-wa" href="https://wa.me/<%= String(r.customer_number).replace(/\D/g,'') %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i></a>
                  <% } else { %>—<% } %>
                </td>
                <td><%= r.assignee_name || '—' %></td>
                <td class="ss-muted"><%= r.delivered_at ? new Date(r.delivered_at).toLocaleString() : (r.created_at ? new Date(r.created_at).toLocaleString() : '—') %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
</body>
</html>
