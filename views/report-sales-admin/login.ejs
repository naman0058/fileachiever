<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Report Sales Admin • FileMakr</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/report-sales-admin/prs-admin.css?v=1">
</head>
<body class="ss-login-page">
  <div class="ss-login-card">
    <div class="ss-login-accent"></div>
    <div class="ss-login-body">
      <div class="ss-login-brand">
        <div class="ss-login-logo">FileMakr</div>
        <div class="ss-login-title">Report Sales Admin</div>
        <div class="ss-login-tag">Orders · pipeline · team · analytics</div>
      </div>
      <% if (msg) { %><div class="ss-login-error"><%= msg %></div><% } %>
      <% if (error) { %><div class="ss-login-error"><i class="bi bi-exclamation-circle"></i> <%= error %></div><% } %>
      <% if (typeof teamLink !== 'undefined' && teamLink) { %>
      <p style="text-align:center;margin:0 0 12px"><a href="/report-sales/login" style="color:#2A47FF;font-weight:700">Go to Report Sales Team</a></p>
      <% } %>
      <form method="POST" action="/report-sales-admin/login" class="ss-login-form">
        <label><span>Email</span><input type="email" name="email" required autocomplete="email" placeholder="admin@company.com"></label>
        <label><span>Password</span><input type="password" name="password" required autocomplete="current-password"></label>
        <button type="submit" class="ss-btn ss-btn--primary ss-login-submit">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
