<!-- Tailwind CDN with brand colors -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          brandOrange: '#F17F23',
          brandBlue: '#2A47FF'
        }
      }
    }
  }
</script>
<% var _portalTarget = (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) ? '_top' : '_self'; %>

<!-- Add student (MERN onboarding) -->
<div class="max-w-4xl mx-auto px-4 py-8 relative">
  <div id="mern-form-busy-overlay" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/30 backdrop-blur-[1px]" aria-hidden="true">
    <div class="bg-white rounded-xl shadow-2xl px-8 py-5 flex items-center gap-3 text-slate-800 font-medium border border-slate-200">
      <svg class="h-6 w-6 shrink-0 animate-spin text-brandBlue" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
      <span id="mern-form-busy-label">Working…</span>
    </div>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <a href="/mern-training-manager" target="<%= _portalTarget %>" class="text-sm font-medium text-brandBlue hover:underline">← Back to program manager</a>
    <a href="/add-ambassador/bulk-sample.csv" class="text-sm font-medium text-slate-600 hover:text-brandBlue">Download CSV template</a>
  </div>

  <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
    
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-800 to-slate-900 text-white text-center py-5 px-4">
      <p class="text-xs uppercase tracking-widest text-slate-400 mb-1">MERN training · onboarding</p>
      <h2 class="text-2xl font-semibold">Add student</h2>
      <p class="text-sm text-slate-300 mt-2 max-w-xl mx-auto">Creates the shopkeeper record and sends the 45-day program welcome email plus login credentials for the student dashboard.</p>
    </div>

    <!-- Form -->
    <form id="form-add-student" action="/add-ambassador" method="POST" class="p-6 space-y-6 bg-gray-50">
      <% if (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) { %>
      <input type="hidden" name="embed" value="1">
      <% } %>
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block mb-1 font-medium text-gray-700">Full Name</label>
          <input type="text" name="name" id="name" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brandOrange" placeholder="John Doe" required>
        </div>

        <div>
          <label for="number" class="block mb-1 font-medium text-gray-700">Phone Number</label>
          <input type="text" name="number" id="number" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brandOrange" placeholder="9876543210" required>
        </div>

        <div class="md:col-span-2">
          <label for="address" class="block mb-1 font-medium text-gray-700">College Name</label>
          <textarea name="address" id="address" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brandOrange" rows="2" placeholder="ABC Institute of Technology" required></textarea>
        </div>

        <div>
          <label for="email" class="block mb-1 font-medium text-gray-700">Email</label>
          <input type="email" name="email" id="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brandOrange" placeholder="you@example.com" required>
        </div>

        <div>
          <label for="instagram_id" class="block mb-1 font-medium text-gray-700">Instagram ID</label>
          <input type="text" name="instagram_id" id="instagram_id" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brandOrange" placeholder="@your_handle" required>
        </div>

        <div>
          <label for="unique_code" class="block mb-1 font-medium text-gray-700">Unique Code</label>
          <input type="text" name="unique_code" id="unique_code" class="w-full px-4 py-2 border border-gray-300 rounded-md bg-gray-100" placeholder="Auto-generated" readonly required>
        </div>


          <div>
          <label for="referal_code" class="block mb-1 font-medium text-gray-700">Referral Code (Optional)</label>
          <input type="text" name="referal_code" id="referal_code" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-brandOrange">
        </div>

      </div>

      <% if (typeof msg !== 'undefined' && msg) { %>
        <p class="text-green-700 text-sm font-medium mt-2 bg-green-50 border border-green-100 rounded-lg px-3 py-2"><%= msg %></p>
      <% } %>
      <% if (typeof bulkError !== 'undefined' && bulkError) { %>
        <p class="text-red-700 text-sm mt-2 bg-red-50 border border-red-100 rounded-lg px-3 py-2"><%= bulkError %></p>
      <% } %>

      <div class="text-right pt-4">
        <button type="submit" id="btn-send-onboarding" class="inline-flex items-center justify-center gap-2 min-w-[220px] bg-brandBlue hover:bg-blue-700 disabled:hover:bg-brandBlue text-white px-6 py-2 text-lg font-semibold rounded-lg transition duration-200 disabled:opacity-90 disabled:cursor-not-allowed">
          Send onboarding &amp; credentials
        </button>
      </div>
    </form>
  </div>

  <!-- Bulk CSV -->
  <div class="mt-8 bg-white shadow-xl rounded-2xl overflow-hidden border border-slate-100">
    <div class="bg-slate-100 px-6 py-4 border-b border-slate-200">
      <h3 class="text-lg font-semibold text-slate-800">Bulk upload (CSV)</h3>
      <p class="text-sm text-slate-600 mt-1">One row per student. Columns: <code class="text-xs bg-white px-1 rounded">name</code>, <code class="text-xs bg-white px-1 rounded">number</code>, <code class="text-xs bg-white px-1 rounded">address</code> (college), <code class="text-xs bg-white px-1 rounded">email</code>, <code class="text-xs bg-white px-1 rounded">instagram_id</code>, optional <code class="text-xs bg-white px-1 rounded">referal_code</code>. Aliases: <code>phone</code>/<code>mobile</code>, <code>college</code>, <code>instagram</code>.</p>
    </div>
    <form id="form-bulk-csv" action="/add-ambassador/bulk" method="POST" enctype="multipart/form-data" class="p-6 flex flex-wrap items-end gap-4 bg-gray-50">
      <% if (typeof mernPortalEmbed !== 'undefined' && mernPortalEmbed) { %>
      <input type="hidden" name="embed" value="1">
      <% } %>
      <div class="flex-1 min-w-[200px]">
        <label class="block text-sm font-medium text-gray-700 mb-1">CSV file</label>
        <input type="file" name="bulk_csv" accept=".csv,text/csv" required class="block w-full text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-brandBlue file:text-white"/>
      </div>
      <button type="submit" id="btn-bulk-import" class="inline-flex items-center justify-center gap-2 min-w-[200px] bg-slate-800 hover:bg-slate-900 disabled:hover:bg-slate-800 text-white px-6 py-2 rounded-lg font-semibold disabled:opacity-90 disabled:cursor-not-allowed">Import &amp; email all</button>
    </form>
  </div>
</div>

<!-- Auto-generate referral code script -->
<script>
  function generateUniqueCode(name, address) {
    const clean = str => str.trim().replace(/\s+/g, '').toUpperCase();
    const part1 = clean(name).substring(0, 3);
    const part2 = clean(address).substring(0, 3);
    const randomNum = Math.floor(100 + Math.random() * 900); // 100–999
    return `${part1}${part2}${randomNum}`;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const nameInput = document.getElementById("name");
    const addressInput = document.getElementById("address");
    const codeInput = document.getElementById("unique_code");

    const updateCode = () => {
      const name = nameInput.value;
      const address = addressInput.value;
      if (name.length >= 3 && address.length >= 3) {
        codeInput.value = generateUniqueCode(name, address);
      } else {
        codeInput.value = "";
      }
    };

    nameInput.addEventListener("input", updateCode);
    addressInput.addEventListener("input", updateCode);
  });

  (function () {
    function spinnerSvg() {
      return '<svg class="h-5 w-5 shrink-0 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
    }

    var overlay = document.getElementById('mern-form-busy-overlay');
    var overlayLabel = document.getElementById('mern-form-busy-label');

    function showBusy(message) {
      if (overlay && overlayLabel) {
        overlayLabel.textContent = message;
        overlay.classList.remove('hidden');
        overlay.setAttribute('aria-hidden', 'false');
      }
    }

    function setSubmitLoading(btn, label) {
      if (!btn || btn.dataset.loading === '1') return;
      btn.dataset.originalHtml = btn.innerHTML;
      btn.dataset.loading = '1';
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      btn.innerHTML = spinnerSvg() + '<span>' + label + '</span>';
    }

    window.addEventListener('pageshow', function (ev) {
      if (!ev.persisted) return;
      if (overlay) {
        overlay.classList.add('hidden');
        overlay.setAttribute('aria-hidden', 'true');
      }
      ['btn-send-onboarding', 'btn-bulk-import'].forEach(function (id) {
        var b = document.getElementById(id);
        if (!b || !b.dataset.originalHtml) return;
        b.innerHTML = b.dataset.originalHtml;
        delete b.dataset.originalHtml;
        delete b.dataset.loading;
        b.disabled = false;
        b.removeAttribute('aria-busy');
      });
    });

    var formSingle = document.getElementById('form-add-student');
    var formBulk = document.getElementById('form-bulk-csv');
    if (formSingle) {
      formSingle.addEventListener('submit', function () {
        showBusy('Sending onboarding and credentials…');
        setSubmitLoading(document.getElementById('btn-send-onboarding'), 'Sending…');
      });
    }
    if (formBulk) {
      formBulk.addEventListener('submit', function () {
        showBusy('Importing CSV and emailing students…');
        setSubmitLoading(document.getElementById('btn-bulk-import'), 'Importing…');
      });
    }
  })();
</script>
