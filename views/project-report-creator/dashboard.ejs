<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= pageTitle %> • FileAchiever</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/setup-support/support.css">
</head>
<body class="support-body">

<div class="support-layout">
  <aside class="support-sidebar-wrap">
    <div class="support-sidebar">
      <div class="support-sidebar__brand">
        <div class="support-brand">Project Report Creator</div>
        <div class="support-sub">Create & download reports</div>
      </div>
      <nav class="support-nav">
        <a class="support-link active" href="/project-report-creator"><i class="bi bi-grid-3x3-gap-fill"></i>Dashboard</a>
        <div class="support-nav__sep"></div>
        <a class="support-link danger" href="/project-report-creator/logout"><i class="bi bi-box-arrow-right"></i>Logout</a>
      </nav>
      <div class="support-user">
        <div class="support-user__avatar"><i class="bi bi-person-circle"></i></div>
        <div class="support-user__info">
          <div class="support-user__name"><%= user.name %></div>
          <div class="support-user__meta">Project Report Creator</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="support-main">
    <div class="container-fluid px-4 px-lg-5 py-5">
      <div class="support-page-header mb-5">
        <div class="support-header-accent"></div>
        <h1 class="support-page-title">Project Report Creator</h1>
        <p class="support-page-sub">Select a topic to create a customized report. Choose sections, database screenshots, screenshots, arrange with drag-drop, then download as Word.</p>
      </div>

      <div class="card support-card support-filter-card mb-5">
        <div class="card-body p-0">
          <form method="get" action="/project-report-creator" class="support-filters row g-3 align-items-end p-4 px-lg-5">
            <div class="col-12 col-md-8 col-lg-9">
              <label class="form-label support-form-label">Search</label>
              <div class="input-group support-input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" name="q" class="form-control support-input" value="<%= filters.q || '' %>" placeholder="Name, seo_name, description…" autocomplete="off">
              </div>
            </div>
            <div class="col-12 col-md-4 col-lg-3">
              <button type="submit" class="btn w-100 support-btn-apply"><i class="bi bi-funnel me-2"></i>Apply</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card support-card support-data-card">
        <div class="card-header support-card-header">
          <h5 class="support-card-title">Source Code List (Topics)</h5>
          <p class="mb-0 small text-muted">Click "Create Report" to build a customized report with sections, screenshots, and more.</p>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 support-table">
              <thead class="support-table-head">
                <tr>
                  <th class="text-uppercase small fw-bold text-muted" style="width:50px;">ID</th>
                  <th class="text-uppercase small fw-bold text-muted">Name</th>
                  <th class="text-uppercase small fw-bold text-muted">Category</th>
                  <th class="text-uppercase small fw-bold text-muted">Sections</th>
                  <th class="text-uppercase small fw-bold text-muted">DB Screenshots</th>
                  <th class="text-uppercase small fw-bold text-muted">Screenshots</th>
                  <th class="text-uppercase small fw-bold text-muted" style="width:140px;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (!rows.length) { %>
                <tr><td colspan="7" class="py-5 text-center text-muted">No source codes found.</td></tr>
                <% } %>
                <% rows.forEach(function(r){ %>
                <tr>
                  <td class="fw-semibold">#<%= r.id %></td>
                  <td><%= r.name || '-' %></td>
                  <td><span class="badge bg-secondary"><%= r.category || '-' %></span></td>
                  <td><%= r.section_count || 0 %></td>
                  <td><%= r.db_screenshot_count || 0 %></td>
                  <td><%= r.screenshot_count || 0 %></td>
                  <td>
                    <a href="/project-report-creator/create/<%= r.id %>" class="btn btn-sm btn-primary"><i class="bi bi-file-earmark-plus me-1"></i>Create Report</a>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
</body>
</html>
