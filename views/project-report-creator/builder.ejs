<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title><%= pageTitle %> • FileMakr</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/setup-support/support.css">
  <link rel="stylesheet" href="/setup-support/prc.css?v=2">
</head>
<body class="support-body prc-app">
<div class="support-layout">
  <aside class="support-sidebar-wrap">
    <div class="support-sidebar">
      <div class="support-sidebar__brand">
        <div class="prc-brand-mark"><span></span> FileMakr</div>
        <div class="support-brand">Report Creator</div>
        <div class="support-sub"><%= sc.name %></div>
        <div class="prc-role-chip">Builder</div>
      </div>
      <nav class="support-nav">
        <a class="support-link" href="/project-report-creator"><i class="bi bi-grid-3x3-gap-fill"></i>Projects</a>
        <a class="support-link active" href="/project-report-creator/create/<%= sc.id %>"><i class="bi bi-pencil-square"></i>Builder</a>
        <div class="support-nav__sep"></div>
        <a class="support-link danger" href="/project-report-creator/logout"><i class="bi bi-box-arrow-right"></i>Logout</a>
      </nav>
      <div class="support-user">
        <div class="support-user__avatar"><i class="bi bi-person-circle"></i></div>
        <div class="support-user__info">
          <div class="support-user__name"><%= user.name %></div>
          <div class="support-user__meta">Project Report Creator</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="support-main">
    <div class="prc-shell">
      <div class="prc-builder-top">
        <div class="prc-builder-top__meta">
          <div class="prc-crumb">
            <a href="/project-report-creator">Dashboard</a>
            <span class="prc-crumb__sep">/</span>
            <span>Create</span>
            <span class="prc-crumb__sep">/</span>
            <span class="prc-crumb__current" title="<%= sc.name %>"><%= sc.name %></span>
          </div>
          <h1 class="prc-topbar__title" style="font-size:22px;margin:0;">Create report</h1>
        </div>
        <div class="prc-builder-top__actions">
          <span class="prc-live-count"><strong id="prcLiveItemCount">0</strong> items in outline</span>
          <a href="/project-report-creator" class="prc-btn prc-btn--ghost prc-btn--sm"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
      </div>

      <section class="prc-toc-studio" aria-label="Paste table of contents">
        <div class="prc-toc-studio__main">
          <h2 class="prc-toc-studio__label"><i class="bi bi-clipboard-plus"></i> Paste table of content</h2>
          <p class="prc-toc-studio__hint">Paste your TOC, generate a matched outline from this project’s library, then download Word. Missing titles become blank pages.</p>
          <textarea id="prcTocPasteText" rows="8" placeholder="1 Introduction&#10;1.1 Background of the Project&#10;2 System Architecture&#10;3 Data Flow Diagram (Level 0)&#10;4 Use Case Diagram&#10;5 Database Schema&#10;6 Table Structures&#10;7 Results and Discussion&#10;8 Conclusion"></textarea>
          <div class="prc-toc-actions">
            <button type="button" class="prc-btn prc-btn--blue" id="btnTocFromText">
              <i class="bi bi-magic"></i> Generate report from TOC
            </button>
            <span id="prcTocGenerateNote" class="d-none"></span>
          </div>
        </div>
        <aside class="prc-toc-studio__aside">
          <p class="prc-aside-title">Auto-match rules</p>
          <ul class="prc-match-list">
            <li><i class="bi bi-diagram-3"></i> “Data Flow Diagram” → Zero / First / Second Level DFDs (0 same page)</li>
            <li><i class="bi bi-share"></i> Entity-Relationship Diagram → ER diagram</li>
            <li><i class="bi bi-book"></i> Bibliography / References → content only (no 11.1 subheading)</li>
            <li><i class="bi bi-diagram-3"></i> Architecture, UML, ER → diagrams only</li>
            <li><i class="bi bi-database"></i> Database Schema / Data Dictionary → DB screenshots</li>
            <li><i class="bi bi-table"></i> Table Structures → data tables</li>
            <li><i class="bi bi-window-stack"></i> Results &amp; Discussion → UI screenshots</li>
            <li><i class="bi bi-file-earmark"></i> Unmatched titles → blank page with heading</li>
          </ul>
          <div class="prc-how">
            <details>
              <summary>Manual build tips</summary>
              Tick library items → Add to report. Use Add main title / subtitle, drag to reorder, then Download Word from the bar below.
            </details>
          </div>
        </aside>
      </section>

      <div class="prc-layout">
        <div class="prc-panel">
          <div class="prc-panel-header">
            <h2><i class="bi bi-collection me-2"></i>Content library</h2>
            <p>Select items with checkboxes, then add them to the outline.</p>
          </div>
          <div class="prc-panel-body">
            <div class="accordion accordion-flush" id="libraryAccordion">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSections" aria-expanded="true">
                    <i class="bi bi-journal-text me-2"></i>Sections &amp; subheadings
                  </button>
                </h2>
                <div id="collapseSections" class="accordion-collapse collapse show" data-bs-parent="#libraryAccordion">
                  <div class="accordion-body pt-0">
                    <div id="availableSectionsChecks"></div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDiagrams">
                    <i class="bi bi-diagram-3 me-2"></i>Diagrams
                  </button>
                </h2>
                <div id="collapseDiagrams" class="accordion-collapse collapse" data-bs-parent="#libraryAccordion">
                  <div class="accordion-body pt-0">
                    <div id="availableDiagrams"></div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDbDt">
                    <i class="bi bi-table me-2"></i>Datatables
                  </button>
                </h2>
                <div id="collapseDbDt" class="accordion-collapse collapse" data-bs-parent="#libraryAccordion">
                  <div class="accordion-body pt-0">
                    <div id="availableDbDatatables"></div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDbShot">
                    <i class="bi bi-images me-2"></i>Database screenshots
                  </button>
                </h2>
                <div id="collapseDbShot" class="accordion-collapse collapse" data-bs-parent="#libraryAccordion">
                  <div class="accordion-body pt-0">
                    <div id="availableDbScreenshots"></div>
                  </div>
                </div>
              </div>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseScr">
                    <i class="bi bi-window-stack me-2"></i>UI screenshots
                  </button>
                </h2>
                <div id="collapseScr" class="accordion-collapse collapse" data-bs-parent="#libraryAccordion">
                  <div class="accordion-body pt-0">
                    <div id="availableScreenshots"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="prc-toolbar">
              <button type="button" class="btn btn-primary" id="btnAddSelected"><i class="bi bi-plus-lg me-1"></i>Add to report</button>
              <span class="prc-hint-pill"><i class="bi bi-check2-square"></i> Tick rows, then add</span>
            </div>
          </div>
        </div>

        <div class="prc-panel">
          <div class="prc-panel-header">
            <h2><i class="bi bi-list-nested me-2"></i>Report outline</h2>
            <p>Edit titles, drag to reorder, then export from the bar below.</p>
          </div>
          <div class="prc-panel-body">
            <div class="prc-outline-help">
              <strong>Chapters:</strong> Add main title / subtitle, then drag above related media. Tick rows for bulk move or remove.
            </div>
            <div class="prc-outline-toolbar">
              <button type="button" class="btn btn-sm btn-success" id="btnAddOutlineHeading" title="Inserts a main chapter title"><i class="bi bi-bookmark-plus me-1"></i>Add main title</button>
              <button type="button" class="btn btn-sm btn-outline-success" id="btnAddOutlineSubheading" title="Inserts a subtitle"><i class="bi bi-bookmark me-1"></i>Add subtitle</button>
              <span class="border-start mx-1 align-self-stretch d-none d-sm-block" style="min-height:1.5rem;"></span>
              <button type="button" class="btn btn-sm btn-outline-primary" id="btnOutlineMoveEnd"><i class="bi bi-arrow-down-circle me-1"></i>Put at bottom</button>
              <button type="button" class="btn btn-sm btn-outline-primary" id="btnOutlineMoveStart"><i class="bi bi-arrow-up-circle me-1"></i>Put at top</button>
              <button type="button" class="btn btn-sm btn-outline-secondary" id="btnOutlineClearSel">Clear ticks</button>
              <button type="button" class="btn btn-sm btn-outline-danger" id="btnOutlineRemoveSel"><i class="bi bi-trash me-1"></i>Remove ticked</button>
            </div>
            <div id="reportItems" class="report-items-list"></div>
            <div class="report-empty-hint mt-2" id="reportEmptyMsg">Nothing in your list yet. Generate from TOC above, or pick library items and click <strong>Add to report</strong>.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="prc-export-bar" role="region" aria-label="Export actions">
      <div class="prc-export-bar__left">
        Outline ready: <strong id="prcExportItemCount">0</strong> item(s)
      </div>
      <div class="prc-export-bar__actions">
        <button type="button" class="prc-btn prc-btn--orange" id="btnDownloadWord"><i class="bi bi-download"></i> Download Word</button>
        <div class="btn-group">
          <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-journal-text me-1"></i>Synopsis
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="button" class="dropdown-item js-prc-pack-dl" data-id="<%= sc.id %>" data-name="<%= (sc.name||'Report').replace(/"/g,'&quot;') %>" data-plan="synopsis" data-format="docx"><i class="bi bi-file-earmark-word me-1"></i>Word</button></li>
            <li><button type="button" class="dropdown-item js-prc-pack-dl" data-id="<%= sc.id %>" data-name="<%= (sc.name||'Report').replace(/"/g,'&quot;') %>" data-plan="synopsis" data-format="pdf"><i class="bi bi-filetype-pdf me-1"></i>PDF</button></li>
          </ul>
        </div>
        <div class="btn-group">
          <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-file-earmark-ruled me-1"></i>Pre Defined
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="button" class="dropdown-item js-prc-pack-dl" data-id="<%= sc.id %>" data-name="<%= (sc.name||'Report').replace(/"/g,'&quot;') %>" data-plan="report" data-format="docx"><i class="bi bi-file-earmark-word me-1"></i>Word</button></li>
            <li><button type="button" class="dropdown-item js-prc-pack-dl" data-id="<%= sc.id %>" data-name="<%= (sc.name||'Report').replace(/"/g,'&quot;') %>" data-plan="report" data-format="pdf"><i class="bi bi-filetype-pdf me-1"></i>PDF</button></li>
          </ul>
        </div>
        <button type="button" class="btn btn-outline-danger" id="btnClearReport">Clear list</button>
      </div>
    </div>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="module">
(function () {
  /**
   * Load Sortable with MultiDrag from one official bundle. Importing Sortable + MultiDrag
   * as separate esm.sh modules often mounts the plugin on a different Sortable class than
   * `new Sortable()`, so group drag silently does nothing.
   */
  async function loadSortableWithMultiDrag() {
    const urls = [
      'https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/modular/sortable.complete.esm.js',
      'https://esm.sh/sortablejs@1.15.6/modular/sortable.complete.esm.js'
    ];
    let SortableCtor = null;
    for (let i = 0; i < urls.length; i++) {
      try {
        const mod = await import(urls[i]);
        SortableCtor = mod.default;
        if (SortableCtor) break;
      } catch (err) {
        console.warn('PRC: Sortable bundle failed:', urls[i], err);
      }
    }
    window.PRCMultidragActive = !!(SortableCtor && SortableCtor.utils && typeof SortableCtor.utils.select === 'function');
    if (!window.PRCMultidragActive && SortableCtor) {
      console.warn('PRC: Sortable loaded without MultiDrag utils; group drag disabled.');
    }
    window.PRCSortable = SortableCtor;
    window.dispatchEvent(new Event('prc-sortable-ready'));
  }
  loadSortableWithMultiDrag();
})();
</script>
<script>
const scId = <%= sc.id %>;
const scName = <%- JSON.stringify(sc.name || 'Report') %>;
let reportItems = [];
let sectionsData = [];
let diagramsData = [];
let dbScreenshotsData = [];
let screenshotsData = [];

/** Content library list order (project / report flow). Unknown types sort after these. */
const DIAGRAM_LIBRARY_ORDER = [
  'system_architecture_diagram',
  'dfd_zero_level',
  'dfd_first_level',
  'dfd_second_level',
  'er_diagram',
  'use_case_diagram',
  'class_diagram',
  'activity_diagram',
  'sequence_diagram',
  'flow_chart_diagram'
];

function diagramLibrarySortRank(diagramType) {
  const t = (diagramType || '').toString().trim().toLowerCase();
  const i = DIAGRAM_LIBRARY_ORDER.indexOf(t);
  return i === -1 ? DIAGRAM_LIBRARY_ORDER.length : i;
}

/** Original `diagramsData` indices in display order (checkbox indices unchanged). */
function getDiagramRenderOrder() {
  return diagramsData
    .map((d, idx) => ({
      idx,
      rank: diagramLibrarySortRank(d.diagram_type),
      type: (d.diagram_type || '').toString()
    }))
    .sort((a, b) => {
      if (a.rank !== b.rank) return a.rank - b.rank;
      return a.idx - b.idx;
    })
    .map(x => x.idx);
}

function genUid() {
  return 'i' + Date.now() + '_' + Math.random().toString(36).slice(2, 11);
}

async function loadData() {
  const res = await fetch('/project-report-creator/api/source-code/' + scId + '/data');
  const j = await res.json();
  if (!j.ok) { alert('Failed to load data.'); return; }
  sectionsData = j.sections || [];
  diagramsData = j.diagrams || [];
  dbScreenshotsData = j.dbScreenshots || [];
  screenshotsData = j.screenshots || [];
  renderAvailable();
}

function renderAvailable() {
  const checkedSec = new Set();
  const checkedSub = new Set();
  const checkedDiag = new Set();
  const checkedDb = new Set();
  const checkedDbDt = new Set();
  const checkedScr = new Set();
  document.querySelectorAll('.section-check:checked').forEach(cb => { checkedSec.add(cb.dataset.secIdx); });
  document.querySelectorAll('.subheading-check:checked').forEach(cb => { checkedSub.add(cb.dataset.secIdx + '-' + cb.dataset.shIdx); });
  document.querySelectorAll('.diagram-check:checked').forEach(cb => { checkedDiag.add(cb.dataset.diagIdx); });
  document.querySelectorAll('.db-check:checked').forEach(cb => { checkedDb.add(cb.dataset.dbIdx); });
  document.querySelectorAll('.db-datatable-check:checked').forEach(cb => { checkedDbDt.add(cb.dataset.dbIdx); });
  document.querySelectorAll('.screenshot-check:checked').forEach(cb => { checkedScr.add(cb.dataset.scrIdx); });

  const secEl = document.getElementById('availableSectionsChecks');
  secEl.innerHTML = '<div class="prc-library-bulk-hint">Bulk select (optional):</div>';
  sectionsData.forEach((sec, secIdx) => {
    const div = document.createElement('div');
    div.className = 'prc-section-group';
    const subs = (sec.subheadings || []).map((sh, shIdx) => `
        <li class="prc-sub-pill">
          <label class="d-flex align-items-start gap-2">
            <input type="checkbox" class="subheading-check mt-1" data-sec-idx="${secIdx}" data-sh-idx="${shIdx}" ${checkedSub.has(secIdx + '-' + shIdx) ? 'checked' : ''}>
            <span>${escapeHtml(sh.subheading || '(Untitled)')}</span>
          </label>
        </li>
      `).join('');
    div.innerHTML = `
      <div class="prc-section-heading">
        <label class="d-flex align-items-start gap-2 mb-0">
          <input type="checkbox" class="section-check mt-1" data-sec-idx="${secIdx}" ${checkedSec.has(String(secIdx)) ? 'checked' : ''}>
          <span>${escapeHtml(sec.heading || '(Untitled)')}</span>
        </label>
      </div>
      ${subs ? '<ul class="prc-sub-list">' + subs + '</ul>' : ''}
    `;
    secEl.appendChild(div);
  });

  const diagEl = document.getElementById('availableDiagrams');
  diagEl.innerHTML = '';
  if (diagramsData.length) {
    const h = document.createElement('div');
    h.className = 'prc-library-bulk-hint mb-2';
    h.innerHTML = '<label class="mb-0"><input type="checkbox" class="select-all-diagrams me-2">Select all diagrams</label>';
    diagEl.appendChild(h);
  }
  getDiagramRenderOrder().forEach((idx) => {
    const d = diagramsData[idx];
    if (!d) return;
    const div = document.createElement('div');
    div.className = 'prc-lib-option';
    div.innerHTML = `
      <label class="d-flex align-items-center gap-2">
        <input type="checkbox" class="diagram-check" data-diag-idx="${idx}" ${checkedDiag.has(String(idx)) ? 'checked' : ''}>
        <span>${escapeHtml(d.label || d.diagram_type || 'Diagram')}</span>
      </label>
      <span class="prc-lib-type-hint">Diagram</span>
    `;
    diagEl.appendChild(div);
  });

  const dbDtEl = document.getElementById('availableDbDatatables');
  dbDtEl.innerHTML = '';
  const hasAnyDatatable = dbScreenshotsData.some((d) => d.data_table);
  if (hasAnyDatatable) {
    const h = document.createElement('div');
    h.className = 'prc-library-bulk-hint mb-2';
    h.innerHTML = '<label class="mb-0"><input type="checkbox" class="select-all-db-datatables me-2">Select all datatables</label>';
    dbDtEl.appendChild(h);
  }
  dbScreenshotsData.forEach((d, idx) => {
    if (!d.data_table) return;
    const baseName = escapeHtml(d.name || 'Screenshot ' + d.id);
    const div2 = document.createElement('div');
    div2.className = 'prc-lib-option';
    div2.innerHTML = `
      <label class="d-flex align-items-center gap-2">
        <input type="checkbox" class="db-datatable-check" data-db-idx="${idx}" ${checkedDbDt.has(String(idx)) ? 'checked' : ''}>
        <span>${baseName}</span>
      </label>
      <span class="prc-lib-type-hint">Datatable</span>
    `;
    dbDtEl.appendChild(div2);
  });
  if (!hasAnyDatatable) {
    dbDtEl.innerHTML = '<p class="small text-muted mb-0">No datatables uploaded for this project.</p>';
  }

  const dbShotEl = document.getElementById('availableDbScreenshots');
  dbShotEl.innerHTML = '';
  if (dbScreenshotsData.length) {
    const h = document.createElement('div');
    h.className = 'prc-library-bulk-hint mb-2';
    h.innerHTML = '<label class="mb-0"><input type="checkbox" class="select-all-db-screenshots me-2">Select all database screenshots</label>';
    dbShotEl.appendChild(h);
  }
  dbScreenshotsData.forEach((d, idx) => {
    const baseName = escapeHtml(d.name || 'Screenshot ' + d.id);
    const div1 = document.createElement('div');
    div1.className = 'prc-lib-option';
    div1.innerHTML = `
      <label class="d-flex align-items-center gap-2">
        <input type="checkbox" class="db-check" data-db-idx="${idx}" ${checkedDb.has(String(idx)) ? 'checked' : ''}>
        <span>${baseName}</span>
      </label>
      <span class="prc-lib-type-hint">DB screenshot</span>
    `;
    dbShotEl.appendChild(div1);
  });

  const scrEl = document.getElementById('availableScreenshots');
  scrEl.innerHTML = '';
  if (screenshotsData.length) {
    const h = document.createElement('div');
    h.className = 'prc-library-bulk-hint mb-2';
    h.innerHTML = '<label class="mb-0"><input type="checkbox" class="select-all-screenshots me-2">Select all screenshots</label>';
    scrEl.appendChild(h);
    const currentMode = document.querySelector('input[name="screenshotMode"]:checked')?.value || 'typewise';
    const modeDiv = document.createElement('div');
    modeDiv.className = 'mb-2 small';
    modeDiv.innerHTML = `
      <label class="me-3"><input type="radio" name="screenshotMode" value="typewise" ${currentMode === 'typewise' ? 'checked' : ''}> Type-wise order</label>
      <label><input type="radio" name="screenshotMode" value="direct" ${currentMode === 'direct' ? 'checked' : ''}> List order</label>
    `;
    scrEl.appendChild(modeDiv);
  }
  const typewise = document.querySelector('input[name="screenshotMode"]:checked')?.value === 'typewise';
  const orderedScreenshots = typewise
    ? [...screenshotsData.filter(s => (s.type || '').toLowerCase() === 'input_design'),
       ...screenshotsData.filter(s => (s.type || '').toLowerCase() === 'output_design'),
       ...screenshotsData.filter(s => { const t = (s.type || '').toLowerCase(); return t !== 'input_design' && t !== 'output_design'; })]
    : screenshotsData;
  orderedScreenshots.forEach((s) => {
    const idx = screenshotsData.indexOf(s);
    if (idx < 0) return;
    const div = document.createElement('div');
    div.className = 'prc-lib-option';
    div.innerHTML = `
      <label class="d-flex align-items-center gap-2">
        <input type="checkbox" class="screenshot-check" data-scr-idx="${idx}" ${checkedScr.has(String(idx)) ? 'checked' : ''}>
        <span>${escapeHtml(s.name || s.type || 'Screenshot ' + s.id)}</span>
      </label>
      <span class="prc-lib-type-hint">${escapeHtml((s.type || 'UI').replace(/_/g, ' '))}</span>
    `;
    scrEl.appendChild(div);
  });
  document.querySelectorAll('input[name="screenshotMode"]').forEach(r => {
    r.onchange = () => renderAvailable();
  });
}

document.body.addEventListener('change', function(e) {
  if (e.target.classList.contains('select-all-diagrams')) {
    document.querySelectorAll('#availableDiagrams .diagram-check').forEach(cb => { cb.checked = e.target.checked; });
  }
  if (e.target.classList.contains('select-all-db-datatables')) {
    document.querySelectorAll('#availableDbDatatables .db-datatable-check').forEach(cb => { cb.checked = e.target.checked; });
  }
  if (e.target.classList.contains('select-all-db-screenshots')) {
    document.querySelectorAll('#availableDbScreenshots .db-check').forEach(cb => { cb.checked = e.target.checked; });
  }
  if (e.target.classList.contains('select-all-screenshots')) {
    document.querySelectorAll('#availableScreenshots .screenshot-check').forEach(cb => { cb.checked = e.target.checked; });
  }
});

function escapeHtml(s) {
  if (!s) return '';
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML.replace(/"/g, '&quot;');
}

function isReferencesSection(heading) {
  const h = (heading || '').toString().trim().toLowerCase();
  return h === 'references' || h === 'reference';
}

function getSelectedItems() {
  const items = [];
  const checkedSec = new Set();
  const checkedSub = new Set();
  document.querySelectorAll('.section-check:checked').forEach(cb => { checkedSec.add(cb.dataset.secIdx); });
  document.querySelectorAll('.subheading-check:checked').forEach(cb => { checkedSub.add(cb.dataset.secIdx + '-' + cb.dataset.shIdx); });

  const refsSection = [];
  const otherSections = [];
  sectionsData.forEach((sec, secIdx) => {
    const heading = sec.heading || '(Untitled)';
    const sectionItems = [];
    if (checkedSec.has(String(secIdx))) {
      sectionItems.push({ type: 'heading', heading: heading });
    }
    (sec.subheadings || []).forEach((sh, shIdx) => {
      if (checkedSub.has(secIdx + '-' + shIdx)) {
        sectionItems.push({ type: 'subheading', subheading: sh.subheading || '(Untitled)', body: sh.body || '' });
      }
    });
    if (sectionItems.length) {
      if (isReferencesSection(heading)) refsSection.push(...sectionItems);
      else otherSections.push(...sectionItems);
    }
  });
  items.push(...otherSections);

  document.querySelectorAll('.diagram-check:checked').forEach(cb => {
    const idx = parseInt(cb.dataset.diagIdx, 10);
    if (Number.isFinite(idx) && diagramsData[idx]) {
      const d = diagramsData[idx];
      items.push({ type: 'diagram', url: d.url || '', label: d.label || '' });
    }
  });

  document.querySelectorAll('.db-datatable-check:checked').forEach(cb => {
    const idx = parseInt(cb.dataset.dbIdx, 10);
    if (Number.isFinite(idx) && dbScreenshotsData[idx]) {
      const db = dbScreenshotsData[idx];
      if (db.data_table) {
        items.push({ type: 'db_datatable', name: db.name || 'Database Screenshot', data_table: db.data_table || '' });
      }
    }
  });
  document.querySelectorAll('.db-check:checked').forEach(cb => {
    const idx = parseInt(cb.dataset.dbIdx, 10);
    if (Number.isFinite(idx) && dbScreenshotsData[idx]) {
      const db = dbScreenshotsData[idx];
      items.push({ type: 'db_screenshot', url: db.url || '', name: db.name || 'Database Screenshot' });
    }
  });

  let selectedScreenshots = [];
  document.querySelectorAll('.screenshot-check:checked').forEach(cb => {
    const idx = parseInt(cb.dataset.scrIdx, 10);
    if (Number.isFinite(idx) && screenshotsData[idx]) {
      const s = screenshotsData[idx];
      selectedScreenshots.push({ url: s.url || '', type: (s.type || '').toLowerCase(), name: s.name || 'Screenshot' });
    }
  });
  const typewise = document.querySelector('input[name="screenshotMode"]:checked')?.value === 'typewise';
  if (typewise && selectedScreenshots.length) {
    selectedScreenshots.sort((a, b) => {
      const order = { 'input_design': 0, 'output_design': 1 };
      const oa = order[a.type] ?? 2;
      const ob = order[b.type] ?? 2;
      return oa - ob;
    });
  }
  selectedScreenshots.forEach(s => items.push({ type: 'screenshot', url: s.url, name: s.name }));

  items.push(...refsSection);
  return items;
}

function addSelectedToReport() {
  const items = getSelectedItems();
  items.forEach(it => { it._uid = genUid(); });
  reportItems.push(...items);
  renderReportItems();
  document.querySelectorAll('#availableSectionsChecks input:checked, #availableDiagrams input:checked, #availableDbDatatables input:checked, #availableDbScreenshots input:checked, #availableScreenshots input:checked').forEach(cb => { cb.checked = false; });
  document.querySelectorAll('.select-all-diagrams, .select-all-db-datatables, .select-all-db-screenshots, .select-all-screenshots').forEach(cb => { cb.checked = false; });
}

function outlineRowKindLabel(type) {
  const map = {
    heading: 'Main title',
    subheading: 'Subtitle',
    diagram: 'Diagram',
    db_datatable: 'Data table',
    db_screenshot: 'DB picture',
    screenshot: 'Screen picture'
  };
  return map[type] || 'Item';
}

function outlineRowTierClass(type) {
  if (type === 'heading') return 'prc-outline-heading';
  if (type === 'subheading') return 'prc-outline-sub';
  return 'prc-outline-extra';
}

function reportItemEditorHtml(it, i) {
  const uid = it._uid || ('i' + i);
  const kind = outlineRowKindLabel(it.type);
  let editorBlock = '';
  if (it.type === 'heading') {
    const v = escapeHtml(it.heading || '');
    editorBlock = `
      <input type="text" class="form-control prc-outline-input report-edit-field" data-uid="${uid}" data-field="heading" value="${v}" placeholder="Main section title (e.g. Introduction)" aria-label="Main section title">
      <span class="prc-outline-kind">${kind}</span>`;
  } else if (it.type === 'subheading') {
    const v = escapeHtml(it.subheading || '');
    editorBlock = `
      <input type="text" class="form-control prc-outline-input report-edit-field" data-uid="${uid}" data-field="subheading" value="${v}" placeholder="Subtitle under the section above" aria-label="Subtitle">
      <span class="prc-outline-kind">${kind}</span>`;
  } else if (it.type === 'diagram') {
    const v = escapeHtml(it.label || '');
    editorBlock = `
      <input type="text" class="form-control prc-outline-input report-edit-field" data-uid="${uid}" data-field="label" value="${v}" placeholder="Caption for this diagram" aria-label="Diagram caption">
      <span class="prc-outline-kind">${kind}</span>`;
  } else if (it.type === 'db_screenshot' || it.type === 'db_datatable') {
    const v = escapeHtml(it.name || '');
    editorBlock = `
      <input type="text" class="form-control prc-outline-input report-edit-field" data-uid="${uid}" data-field="name" value="${v}" placeholder="Caption for this table or picture" aria-label="Caption">
      <span class="prc-outline-kind">${kind}</span>`;
  } else if (it.type === 'screenshot') {
    const v = escapeHtml(it.name || '');
    editorBlock = `
      <input type="text" class="form-control prc-outline-input report-edit-field" data-uid="${uid}" data-field="name" value="${v}" placeholder="Caption for this screen" aria-label="Screen caption">
      <span class="prc-outline-kind">${kind}</span>`;
  }

  return `
    <div class="report-outline-cb-wrap">
      <input type="checkbox" class="form-check-input report-outline-select" data-uid="${uid}" title="Tick to use Put at top / bottom or Remove">
    </div>
    <div class="drag-handle" title="Drag to move this line. Shift+click other lines first to move several at once"><i class="bi bi-grip-vertical"></i></div>
    <div class="report-item-main">
      ${editorBlock}
    </div>
    <button type="button" class="btn btn-sm btn-outline-danger btn-remove p-1 align-self-center" data-uid="${uid}" title="Remove this line"><i class="bi bi-trash"></i></button>
  `;
}

function syncReportFieldsFromDom() {
  document.querySelectorAll('.report-edit-field').forEach(inp => {
    const uid = inp.dataset.uid;
    const field = inp.dataset.field;
    const it = reportItems.find(x => (x._uid || '') === uid);
    if (it && field) it[field] = inp.value;
  });
}

function getSelectedOutlineUids() {
  return Array.from(document.querySelectorAll('#reportItems .report-outline-select:checked'))
    .map(cb => cb.dataset.uid)
    .filter(Boolean);
}

function restoreOutlineSelection(uidSet) {
  if (!uidSet || !uidSet.size) return;
  document.querySelectorAll('#reportItems .report-outline-select').forEach(cb => {
    if (uidSet.has(cb.dataset.uid)) cb.checked = true;
  });
}

function updatePrcLiveCounts() {
  var n = reportItems.length;
  var elTop = document.getElementById('prcLiveItemCount');
  var elBar = document.getElementById('prcExportItemCount');
  if (elTop) elTop.textContent = String(n);
  if (elBar) elBar.textContent = String(n);
}

function renderReportItems() {
  const el = document.getElementById('reportItems');
  const emptyMsg = document.getElementById('reportEmptyMsg');
  el.innerHTML = '';
  reportItems.forEach((it, i) => {
    const div = document.createElement('div');
    div.className = 'report-item ' + outlineRowTierClass(it.type);
    div.dataset.uid = it._uid || ('i' + i);
    div.innerHTML = reportItemEditorHtml(it, i);
    el.appendChild(div);
  });
  emptyMsg.style.display = reportItems.length ? 'none' : 'block';
  updatePrcLiveCounts();
  mountReportSortable();
}

function mountReportSortable() {
  const el = document.getElementById('reportItems');
  const S = window.PRCSortable;
  if (!S) return;
  if (el._sortable) el._sortable.destroy();
  const opts = {
    animation: 220,
    easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
    ghostClass: 'report-item-ghost',
    dragClass: 'report-item-drag',
    handle: '.drag-handle',
    fallbackOnBody: true,
    swapThreshold: 0.65,
    filter: '.report-outline-select, .report-edit-field, .btn-remove, .form-check-input, label',
    preventOnFilter: false,
    onEnd: function () {
      syncReportFieldsFromDom();
      const selected = new Set(getSelectedOutlineUids());
      const uids = [];
      el.querySelectorAll('.report-item').forEach(div => { uids.push(div.dataset.uid); });
      const byUid = {};
      reportItems.forEach(it => { byUid[it._uid || ''] = it; });
      reportItems = uids.map(uid => byUid[uid]).filter(Boolean);
      renderReportItems();
      restoreOutlineSelection(selected);
    }
  };
  if (window.PRCMultidragActive) {
    opts.multiDrag = true;
    opts.selectedClass = 'sortable-selected';
    opts.avoidImplicitDeselect = true;
  }
  el._sortable = new S(el, opts);
}

/** When several outline rows are ticked, push them into MultiDrag before drag starts (Shift+click also works). */
function prcSyncOutlineChecksToMultiDrag(listEl, draggedRow) {
  const S = window.PRCSortable;
  if (!listEl || !draggedRow || !S || !window.PRCMultidragActive || !S.utils || typeof S.utils.select !== 'function') return;
  const checkedRows = Array.from(listEl.querySelectorAll('.report-outline-select:checked'))
    .map(cb => cb.closest('.report-item'))
    .filter(Boolean);
  if (checkedRows.length < 2 || checkedRows.indexOf(draggedRow) === -1) return;
  checkedRows.forEach(function (r) { S.utils.select(r); });
}

document.getElementById('reportItems').addEventListener('input', function(e) {
  const inp = e.target.closest('.report-edit-field');
  if (!inp) return;
  const uid = inp.dataset.uid;
  const field = inp.dataset.field;
  const it = reportItems.find(x => (x._uid || '') === uid);
  if (it && field) it[field] = inp.value;
});

document.getElementById('reportItems').addEventListener('click', function(e) {
  const btn = e.target.closest('.btn-remove');
  if (!btn) return;
  const uid = btn.dataset.uid;
  if (uid) {
    reportItems = reportItems.filter(it => (it._uid || '') !== uid);
    renderReportItems();
  }
});

document.getElementById('reportItems').addEventListener('mousedown', function(e) {
  if (e.target.classList && e.target.classList.contains('report-outline-select')) {
    e.stopPropagation();
  }
}, true);

document.getElementById('reportItems').addEventListener('pointerdown', function(e) {
  const handle = e.target.closest('.drag-handle');
  if (!handle) return;
  const row = handle.closest('.report-item');
  prcSyncOutlineChecksToMultiDrag(this, row);
}, true);

document.getElementById('btnAddOutlineHeading').onclick = function() {
  syncReportFieldsFromDom();
  reportItems.push({ type: 'heading', heading: '', _uid: genUid() });
  renderReportItems();
};

document.getElementById('btnAddOutlineSubheading').onclick = function() {
  syncReportFieldsFromDom();
  reportItems.push({ type: 'subheading', subheading: '', _uid: genUid() });
  renderReportItems();
};

document.getElementById('btnOutlineMoveEnd').onclick = function() {
  syncReportFieldsFromDom();
  const sel = new Set(getSelectedOutlineUids());
  if (!sel.size) {
    alert('Tick one or more lines on the left, then try again.');
    return;
  }
  const moving = reportItems.filter(it => sel.has(it._uid));
  const rest = reportItems.filter(it => !sel.has(it._uid));
  reportItems = rest.concat(moving);
  renderReportItems();
  restoreOutlineSelection(sel);
};

document.getElementById('btnOutlineMoveStart').onclick = function() {
  syncReportFieldsFromDom();
  const sel = new Set(getSelectedOutlineUids());
  if (!sel.size) {
    alert('Tick one or more lines on the left, then try again.');
    return;
  }
  const moving = reportItems.filter(it => sel.has(it._uid));
  const rest = reportItems.filter(it => !sel.has(it._uid));
  reportItems = moving.concat(rest);
  renderReportItems();
  restoreOutlineSelection(sel);
};

document.getElementById('btnOutlineClearSel').onclick = function() {
  document.querySelectorAll('#reportItems .report-outline-select').forEach(cb => { cb.checked = false; });
};

document.getElementById('btnOutlineRemoveSel').onclick = function() {
  syncReportFieldsFromDom();
  const sel = new Set(getSelectedOutlineUids());
  if (!sel.size) {
    alert('Tick the lines you want to remove.');
    return;
  }
  if (!confirm('Remove ' + sel.size + ' line(s) from your report list?')) return;
  reportItems = reportItems.filter(it => !sel.has(it._uid));
  renderReportItems();
};

document.getElementById('btnAddSelected').onclick = addSelectedToReport;

document.getElementById('btnClearReport').onclick = function() {
  if (confirm('Remove everything from your report list?')) {
    reportItems = [];
    renderReportItems();
  }
};

document.getElementById('btnTocFromText').onclick = async function () {
  const ta = document.getElementById('prcTocPasteText');
  const text = (ta && ta.value) ? ta.value.trim() : '';
  if (!text) {
    alert('Paste your table of contents text first.');
    return;
  }
  const btn = this;
  const prev = btn.innerHTML;
  const noteEl = document.getElementById('prcTocGenerateNote');
  if (noteEl) {
    noteEl.classList.add('d-none');
    noteEl.textContent = '';
  }
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating…';
  try {
    const res = await fetch('/project-report-creator/api/source-code/' + scId + '/toc-from-text', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ text: text })
    });
    const ct = (res.headers.get('Content-Type') || '').toLowerCase();
    if (!res.ok) {
      let msg = 'Request failed.';
      try {
        if (ct.includes('application/json')) {
          const j = await res.json();
          if (j.message) msg = j.message;
        }
      } catch (_) { /* ignore */ }
      throw new Error(msg);
    }
    const data = await res.json();
    if (!data.ok) throw new Error(data.message || 'Failed');
    reportItems = (data.reportItems || []).map(function (it) {
      return Object.assign({}, it, { _uid: genUid() });
    });
    renderReportItems();
    var lines = [];
    if (data.notes) lines.push(data.notes);
    if (data.matchedLabels && data.matchedLabels.length) {
      lines.push('Matched: ' + data.matchedLabels.slice(0, 12).join('; ') + (data.matchedLabels.length > 12 ? '…' : ''));
    }
    if (data.missingLabels && data.missingLabels.length) {
      lines.push('Blank placeholders: ' + data.missingLabels.slice(0, 12).join('; ') + (data.missingLabels.length > 12 ? '…' : ''));
    }
    lines.push('Report built — click Download Word when ready.');
    if (noteEl) {
      noteEl.textContent = 'Report built — click Download Word.';
      noteEl.classList.remove('d-none');
    }
    const dl = document.getElementById('btnDownloadWord');
    if (dl) {
      dl.classList.add('btn-success');
      dl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    alert(lines.join('\n\n'));
  } catch (err) {
    alert(err.message || 'Could not generate report from TOC.');
  } finally {
    btn.disabled = false;
    btn.innerHTML = prev;
  }
};

document.getElementById('btnDownloadWord').onclick = async function() {
  syncReportFieldsFromDom();
  if (document.activeElement && typeof document.activeElement.blur === 'function') {
    document.activeElement.blur();
  }
  await new Promise(function (r) { setTimeout(r, 0); });
  syncReportFieldsFromDom();
  if (!reportItems.length) {
    alert('Add at least one item to your report list first.');
    return;
  }
  const btn = this;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generating…';
  try {
    const itemsToSend = reportItems.map(({ _uid, _scrType, ...rest }) => rest);
    const payload = {
      sourceCodeId: scId,
      sourceCodeName: scName,
      items: itemsToSend
    };
    const fname = (scName || 'report').replace(/[^\w\s-]/g, '') + '.docx';
    if (window.FmDownloadProgress && typeof window.FmDownloadProgress.postAndSave === 'function') {
      await window.FmDownloadProgress.postAndSave(
        '/project-report-creator/api/download-word',
        payload,
        { title: 'Preparing Word…', filename: fname }
      );
    } else {
      const res = await fetch('/project-report-creator/api/download-word', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload)
      });
      if (!res.ok) {
        const j = await res.json().catch(() => ({}));
        throw new Error(j.message || 'Download failed');
      }
      const blob = await res.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = fname;
      a.click();
      URL.revokeObjectURL(a.href);
    }
  } catch (err) {
    if (!(window.FmDownloadProgress && err)) {
      alert(err.message || 'Failed to download.');
    }
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-download me-2"></i>Download Word';
  }
};

function bootBuilder() {
  if (!window.PRCSortable) {
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js';
    s.onload = function () {
      window.PRCSortable = window.Sortable;
      window.PRCMultidragActive = false;
      loadData();
    };
    s.onerror = function () {
      alert('Could not load the reorder library. Check your network and refresh.');
    };
    document.head.appendChild(s);
    return;
  }
  loadData();
}
window.addEventListener('prc-sortable-ready', bootBuilder, { once: true });
</script>
