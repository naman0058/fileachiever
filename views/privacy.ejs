<% include Includes/navbar.ejs %>
<% include Includes/projectReport.ejs %>
<% include partials/legal-page-head.ejs %>

<%
  const lpCheckIcon = '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="M8.5 12.2 11 14.7 15.8 9.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  lpHeroId = 'lp-privacy-hero-title';
  lpHeroCrumb = 'Privacy Policy';
  lpHeroEyebrow = 'Privacy First';
  lpHeroTitle = 'Your Privacy<br class="bl-hero__br">Our Responsibility';
  lpHeroLead = 'FileMakr is built for <strong>academic use</strong>. We help students access project reports and source code. We <strong>do not sell</strong> personal data — this page explains what we collect, why, and how we protect it.';
  lpHeroAlt = 'FileMakr privacy policy — student data protection';
  lpHeroPointsLabel = 'Privacy highlights';
  lpHeroPoints = [
    { icon: lpCheckIcon, strong: 'Academic purpose only', small: 'Built for student learning' },
    { icon: lpCheckIcon, strong: 'Secure checkout', small: 'Encrypted payment gateways' },
    { icon: lpCheckIcon, strong: 'Your data, your control', small: 'We never sell personal data' }
  ];
%>

<div class="lp-page bl-page">
  <% include partials/legal-bl-hero.ejs %>

  <main class="lp-body">
    <div class="lp-wrap">
      <div class="lp-summary">
        <article class="lp-summary__card">
          <span class="lp-summary__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20v-1.2c0-3.3 3.6-6 8-6s8 2.7 8 6V20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <h3>Who we are</h3>
          <p>FileMakr provides academic project files, reports, and source code for college students — strictly for <strong>learning and submission</strong>.</p>
        </article>
        <article class="lp-summary__card">
          <span class="lp-summary__ico lp-summary__ico--orange" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M3 11h18M3 15h18M7 7h10M7 19h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <h3>No data sales</h3>
          <p>We <strong>never sell</strong> personal data. Limited data is used for orders, support, payments, and site analytics.</p>
        </article>
        <article class="lp-summary__card">
          <span class="lp-summary__ico lp-summary__ico--green" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </span>
          <h3>Minimal retention</h3>
          <p>We keep data only as long as needed for <strong>orders, support, and legal obligations</strong>, then securely delete it.</p>
        </article>
      </div>

      <div class="lp-layout">
        <section class="lp-section" id="commitment">
          <h2>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 20 6.5v5.2c0 4.6-3.1 8.8-8 10.3-4.9-1.5-8-5.7-8-10.3V6.5L12 3z" stroke="currentColor" stroke-width="1.8"/></svg>
            Our commitment
          </h2>
          <p>
            Your privacy is important to us. This policy explains how FileMakr (“we”, “us”) handles information on
            <a href="https://www.filemakr.com" rel="noopener">filemakr.com</a> and related pages. By using our website, you agree to this policy.
          </p>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2" stroke="currentColor" stroke-width="1.8"/></svg>
            What we collect
          </h3>
          <ul class="lp-list">
            <li><strong>Contact details</strong> (name, email, phone) to deliver downloads, receipts, and support.</li>
            <li><strong>Order data</strong> (items purchased, amounts, transaction IDs) to fulfill and support your order.</li>
            <li><strong>Technical data</strong> (device, browser, approximate location) via cookies/analytics to improve performance.</li>
            <li><strong>Support messages</strong> (email/WhatsApp/chat) to resolve queries quickly.</li>
          </ul>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/></svg>
            Why we collect it
          </h3>
          <ul class="lp-list">
            <li>To <strong>process payments</strong> and deliver digital downloads.</li>
            <li>To provide <strong>customer support</strong> and optional code setup assistance.</li>
            <li>To <strong>improve the site</strong> (usage analytics and performance insights).</li>
            <li>To meet <strong>legal/accounting</strong> obligations.</li>
          </ul>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Who we share it with
          </h3>
          <p>We don’t sell your data. Limited sharing happens with:</p>
          <ul class="lp-list">
            <li><strong>Payment processors</strong> (to complete transactions securely).</li>
            <li><strong>Cloud/hosting &amp; analytics providers</strong> (to run our site and understand usage).</li>
            <li><strong>Messaging providers</strong> (WhatsApp/email) when you request support.</li>
            <li><strong>Law enforcement</strong> if required by law.</li>
          </ul>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            Data retention
          </h3>
          <p>We retain personal data only as long as necessary to provide services and comply with legal obligations. After that, we <strong>delete or anonymize</strong> it.</p>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            Cookies
          </h3>
          <p>We use essential cookies for website functionality and limited analytics cookies to improve performance. You can control cookies via your browser settings. Disabling some may affect site features.</p>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            Security
          </h3>
          <p>We use commercially reasonable safeguards (encryption in transit, access controls, hardened hosting) to protect data from unauthorized access, alteration, or disclosure.</p>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Third-party links
          </h3>
          <p>Our site may link to external websites. We don’t control their content or policies. Review their privacy policies for details.</p>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M6 20v-1a6 6 0 0 1 12 0v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            Children’s privacy
          </h3>
          <p>FileMakr is intended for college students. We do not knowingly collect personal data from children under 13. If you believe a child provided data, contact us to remove it.</p>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Your choices &amp; rights
          </h3>
          <ul class="lp-list">
            <li>Access, update, or delete your information (subject to legal retention).</li>
            <li>Opt out of non-essential emails (order-critical emails still apply).</li>
            <li>Control cookies in your browser.</li>
          </ul>

          <h3>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Contact us
          </h3>
          <p>
            Questions about this policy? Need to exercise your rights?
            Chat: <a href="https://wa.me/918319339945" target="_blank" rel="noopener noreferrer">WhatsApp Support</a>
            or use our <a href="/contact-us">Contact form</a>.
          </p>

          <div class="lp-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              Last updated: <%= (new Date()).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </span>
            <span>Effective since: 18 November 2019</span>
          </div>
        </section>
      </div>

      <% include partials/legal-related-links.ejs %>

      <section class="lp-cta">
        <div>
          <h2>Built for students. Privacy by design.</h2>
          <p>Explore project files &amp; source code for academic use — fast, secure, and student-friendly.</p>
        </div>
        <div class="lp-cta__actions">
          <a class="lp-btn lp-btn--orange" href="/final-year-project-ideas">Browse Project Ideas</a>
          <a class="lp-btn lp-btn--ghost" href="https://wa.me/918319339945" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        </div>
      </section>

    </div>
  </main>
</div>

<% include Includes/footer.ejs %>

<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"PrivacyPolicy",
  "name":"FileMakr Privacy Policy",
  "url":"https://www.filemakr.com/privacy-policy",
  "publisher":{
    "@type":"Organization",
    "name":"FileMakr",
    "url":"https://www.filemakr.com"
  },
  "inLanguage":"en",
  "dateModified":"<%= (new Date()).toISOString().split('T')[0] %>"
}
</script>
