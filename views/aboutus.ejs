<main class="about-main">

  <!-- ========= STATS BAR ========= -->
  <section class="about-stats" aria-label="FileMakr highlights">
    <div class="about-stats__wrap">
      <div class="about-stats__bar">

        <article class="about-stats__item">
          <span class="about-stats__icon about-stats__icon--blue" aria-hidden="true">
