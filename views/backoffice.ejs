<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Backoffice • FileAchiever</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/brand.css">
  <style>
    :root {
      --brand-primary: #F17F23;
      --brand-secondary: #2E48FB;
    }
    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 50%, #dee2e6 100%);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .backoffice-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,.15), 0 0 0 1px rgba(0,0,0,.04);
      overflow: hidden;
      max-width: 420px;
      width: 100%;
    }
    .backoffice-header {
      background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-secondary) 100%);
      color: #fff;
      padding: 2rem;
      text-align: center;
    }
    .backoffice-header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      margin: 0 0 0.25rem 0;
      letter-spacing: -0.02em;
    }
    .backoffice-header p {
      font-size: 0.875rem;
      opacity: 0.9;
      margin: 0;
    }
    .backoffice-body {
      padding: 2rem;
    }
    .form-label {
      font-weight: 600;
      color: #374151;
      margin-bottom: 0.5rem;
    }
    .form-control, .form-select {
      border-radius: 12px;
      border: 1px solid #e5e7eb;
      padding: 0.75rem 1rem;
      font-size: 1rem;
    }
    .form-control:focus {
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(241, 127, 35, 0.2);
    }
    .btn-login {
      background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-secondary) 100%);
      border: none;
      border-radius: 12px;
      padding: 0.875rem 1.5rem;
      font-weight: 600;
      font-size: 1rem;
      color: #fff;
      width: 100%;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 25px -5px rgba(241, 127, 35, 0.3);
      color: #fff;
    }
    .btn-login:disabled {
      opacity: 0.7;
      transform: none;
    }
    .alert {
      border-radius: 12px;
    }
    .step-2 { display: none; }
    .step-2.active { display: block; }
    .otp-inputs {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      margin: 1rem 0;
    }
    .otp-inputs input {
      width: 3rem;
      height: 3.5rem;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 700;
      border-radius: 12px;
      border: 2px solid #e5e7eb;
    }
    .otp-inputs input:focus {
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(241, 127, 35, 0.2);
    }
    .link-back {
      color: var(--brand-secondary);
      font-size: 0.875rem;
      text-decoration: none;
      margin-top: 1rem;
      display: inline-block;
    }
    .link-back:hover { color: #1a2fb8; }
  </style>
</head>
<body>
  <div class="backoffice-card">
    <div class="backoffice-header">
      <h1>FileAchiever</h1>
      <p>Backoffice Portal</p>
    </div>
    <div class="backoffice-body">
      <% if (msg && msg.length) { %>
        <div class="alert alert-<%= (typeof msgType !== 'undefined' && msgType) ? msgType : 'danger' %> mb-3" role="alert"><%= msg %></div>
      <% } %>

      <% if (step === 'verify') { %>
      <div class="step-2 active">
        <h5 class="fw-bold mb-3">Enter verification code</h5>
        <p class="text-muted small mb-3">We sent a 6-digit code to <strong><%= email %></strong></p>
        <form action="/backoffice/verify-otp" method="post">
          <input type="hidden" name="email" value="<%= email %>">
          <div class="otp-inputs">
            <input type="text" name="otp1" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="one-time-code" class="form-control">
            <input type="text" name="otp2" maxlength="1" pattern="[0-9]" inputmode="numeric" class="form-control">
            <input type="text" name="otp3" maxlength="1" pattern="[0-9]" inputmode="numeric" class="form-control">
            <input type="text" name="otp4" maxlength="1" pattern="[0-9]" inputmode="numeric" class="form-control">
            <input type="text" name="otp5" maxlength="1" pattern="[0-9]" inputmode="numeric" class="form-control">
            <input type="text" name="otp6" maxlength="1" pattern="[0-9]" inputmode="numeric" class="form-control">
          </div>
          <button type="submit" class="btn btn-login mt-2">Verify & Sign in</button>
        </form>
        <a href="/backoffice?clear=1" class="link-back d-block text-center">← Use a different email</a>
      </div>
      <% } else { %>
      <div class="step-1">
        <h5 class="fw-bold mb-3">Sign in with email</h5>
        <p class="text-muted small mb-3">We'll send a one-time code to your email</p>
        <form action="/backoffice/request-otp" method="post">
          <div class="mb-3">
            <label class="form-label" for="email">Email address</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="admin@example.com" required autocomplete="email">
          </div>
          <button type="submit" class="btn btn-login">Send verification code</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
  <script>
    document.querySelectorAll('.otp-inputs input').forEach((inp, i, arr) => {
      inp.addEventListener('input', function() {
        if (this.value.length === 1 && i < arr.length - 1) arr[i + 1].focus();
      });
      inp.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace' && !this.value && i > 0) arr[i - 1].focus();
      });
    });
  </script>
</body>
</html>
