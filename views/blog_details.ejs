<% include Includes/navbar.ejs %>
<% include Includes/projectReport.ejs %>

<link rel="stylesheet" href="/css/home-directory.css?v=57">
<link rel="stylesheet" href="/css/blog-page.css?v=18">
<link rel="stylesheet" href="/css/blog-detail-page.css?v=5">

<script>
  window.FM_CLOUDINARY_CDN_BASE=<%= JSON.stringify(typeof cloudinaryCdnBase !== 'undefined' ? cloudinaryCdnBase : '') %>;
  window.FM_CLOUDINARY_CDN=<%= JSON.stringify(typeof cloudinaryCdnHost !== 'undefined' ? cloudinaryCdnHost : '') %>;
</script>
<script src="/js/fm-cloudinary.js?v=6"></script>

<%
  const post = (Array.isArray(result) && result[0]) ? result[0] : {};
  const bdPageTitle = (typeof Metatags !== 'undefined' && Metatags.displayTitle)
    ? Metatags.displayTitle
    : String(post.title || post.meta_title || 'Blog Article').trim();
  const bdPageLead = (typeof Metatags !== 'undefined' && Metatags.description)
    ? Metatags.description
    : String(post.meta_description || '').trim();
  function bdItemTitle(item) {
    if (typeof blogPostHeading === 'function') return blogPostHeading(item);
    return String((item && (item.title || item.meta_title)) || 'Blog post').trim();
  }
  const recentList = Array.isArray(recentBlogs) ? recentBlogs : [];
  const sidebarPosts = recentList.filter(function (b) { return b.slug !== post.slug; }).slice(0, 25);
  const relatedPosts = sidebarPosts.slice(0, 3);
  const pageUrl = typeof fullUrl !== 'undefined' ? fullUrl : '';
  const canonicalHref = (post.canonical_url && String(post.canonical_url).trim()) ? post.canonical_url : pageUrl;

  function bdFormatDate(value) {
    if (!value) return '—';
    try {
      return new Date(value).toLocaleDateString('en-IN', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      });
    } catch (_) {
      return '—';
    }
  }

  function bdCategoryLabel(raw) {
    const s = String(raw || '').trim();
    if (!s || /^null$/i.test(s) || /^all$/i.test(s)) return 'Guide';
    return s
      .replace(/[-_]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/\b\w/g, function (ch) { return ch.toUpperCase(); })
      .replace(/\bJs\b/g, 'JS')
      .replace(/\bAi\b/g, 'AI');
  }

  function bdCdnImage(url, width) {
    if (typeof cloudinaryUrl === 'function') {
      return cloudinaryUrl(url, { width: width || 640 });
    }
    return url;
  }

  function bdCdnSrcSet(url, widths) {
    if (typeof cloudinarySrcSet === 'function') {
      return cloudinarySrcSet(url, widths || [320, 640, 960, 1200]);
    }
    return '';
  }

  function bdReadMins(html) {
    const text = String(html || post.meta_description || post.meta_title || '');
    const words = text.replace(/<[^>]*>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
    return Math.max(3, Math.ceil(words / 200));
  }

  const bdCover = String(post.thumbnail_url || '').trim();
  const bdHeroFallback = 'https://res.cloudinary.com/npuap6la/image/upload/v1787657312/Untitled_4.webp';
  const bdHeroRaw = bdCover || bdHeroFallback;
  const bdHeroSrc = bdCdnImage(bdHeroRaw, 720);
  const bdAuthor = String(post.author_name || post.author || post.created_by_name || 'FileMakr Team').trim();
  const bdTags = String(post.tags || '')
    .split(',')
    .map(function (t) { return t.trim(); })
    .filter(Boolean)
    .slice(0, 12);
%>

<div class="bd-page">

  <div class="bd-progress" id="bdProgress" aria-hidden="true" role="progressbar" aria-valuemin="0" aria-valuemax="100"></div>

  <nav class="bd-crumb-wrap" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
    <div class="bd-shell">
      <ol class="bd-crumb">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1">
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/blog" itemprop="item"><span itemprop="name">Blog</span></a>
        <meta itemprop="position" content="2">
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
        <span itemprop="name"><%= bdPageTitle %></span>
        <meta itemprop="item" content="<%= canonicalHref %>">
        <meta itemprop="position" content="3">
      </li>
      </ol>
    </div>
  </nav>

  <!-- Hero — same layout as blog listing (copy left, image right) -->
  <section class="bl-hero" aria-labelledby="bd-hero-title">
    <div class="bl-hero__wrap">
      <div class="bl-hero__grid">

        <div class="bl-hero__copy">
          <p class="bl-hero__eyebrow"><%= bdCategoryLabel(post.category) %></p>

          <h1 id="bd-hero-title" class="bl-hero__title" itemprop="headline"><%= bdPageTitle %></h1>

          <span class="bl-hero__rule" aria-hidden="true"></span>

          <% if (bdPageLead) { %>
            <p class="bl-hero__lead" itemprop="description"><%= bdPageLead %></p>
          <% } %>

          <ul class="bl-hero__points" aria-label="Article details">
            <li>
              <span class="bl-hero__point-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M8 2v3M16 2v3M4 9h16M6 5h12a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"
                    stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </span>
              <span>
                <strong>Published</strong>
                <small>
                  <time datetime="<%= new Date(post.created_at || Date.now()).toISOString() %>">
                    <%= bdFormatDate(post.created_at) %>
                  </time>
                </small>
              </span>
            </li>

            <li>
              <span class="bl-hero__point-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
                  <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </span>
              <span>
                <strong>Reading Time</strong>
                <small id="bdReadTime"><%= post.reading_time_minutes || bdReadMins(post.content) %> min read</small>
              </span>
            </li>

            <li>
              <span class="bl-hero__point-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M20 21a8 8 0 1 0-16 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/>
                </svg>
              </span>
              <span>
                <strong><%= bdAuthor %></strong>
                <small>Published by FileMakr</small>
              </span>
            </li>
          </ul>
        </div>

        <div class="bl-hero__media">
          <img
            src="<%= bdHeroSrc %>"
            srcset="<%= bdCdnSrcSet(bdHeroRaw, [480, 720, 960]) %>"
            sizes="(max-width: 991px) calc(100vw - 20px), 520px"
            alt="<%= bdPageTitle.replace(/"/g, '&quot;') %>"
            width="720"
            height="540"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            itemprop="image"
          >
        </div>

      </div>
    </div>
  </section>

  <div class="bd-body">
    <div class="bd-shell bd-layout">

      <div class="bd-main">
        <article class="bd-article" id="bdArticle" itemscope itemtype="https://schema.org/Article">
          <div class="bd-content entry-content" itemprop="articleBody">
            <%- post.content %>
          </div>

          <div class="bd-article__footer">
            <div class="bd-share">
              <span class="bd-share__label">Share this article</span>
              <div class="bd-share__actions" role="group" aria-label="Share">
              <a class="bd-share__btn" id="bdShareX" href="#" aria-label="Share on X" title="Share on X">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M16.5 4h3.2l-7 8.1L21 20h-6.3l-4.9-6.4L4.6 20H1.4l7.5-8.7L3 4h6.5l4.4 5.8L16.5 4z" fill="currentColor"/>
                </svg>
              </a>
              <a class="bd-share__btn" id="bdShareLI" href="#" aria-label="Share on LinkedIn" title="Share on LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6.5 9.5h3v10h-3v-10zM8 4.5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5zM11 9.5h2.9v1.4h.1c.4-.8 1.5-1.7 3.1-1.7 3.3 0 3.9 2.2 3.9 5v5.3H18v-4.7c0-1.1 0-2.6-1.6-2.6-1.6 0-1.9 1.3-1.9 2.5v4.8H11V9.5z" fill="currentColor"/>
                </svg>
              </a>
              <a class="bd-share__btn" id="bdShareFB" href="#" aria-label="Share on Facebook" title="Share on Facebook">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14 8.5h2.5l-.5 3H14v8h-3.5v-8H9V8.5h1.5V6.8c0-2 1.2-3.1 3-3.1.9 0 1.7.1 1.9.1v2.2H14c-1.1 0-1.3.5-1.3 1.2V8.5z" fill="currentColor"/>
                </svg>
              </a>
              <button type="button" class="bd-share__btn" id="bdShareCopy" aria-label="Copy link" title="Copy link">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M10 8H8.5A2.5 2.5 0 0 0 6 10.5v7A2.5 2.5 0 0 0 8.5 20h7a2.5 2.5 0 0 0 2.5-2.5V17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M14 6h4v4M11 13 18 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            </div>

            <% if (post.updated_at) { %>
              <p class="bd-updated">Last updated: <%= bdFormatDate(post.updated_at) %></p>
            <% } %>
          </div>

          <section class="bd-cta" aria-label="Related resources">
            <div class="bd-cta__grid">
              <div>
                <h2 class="bd-cta__title">Need project files or source code?</h2>
                <p class="bd-cta__desc">
                  Explore ready-to-use
                  <a href="/source-code">source code</a> and
                  <a href="/final-year-project-ideas">project ideas</a>
                  aligned to college formats.
                </p>
              </div>
              <div class="bd-cta__actions">
                <a class="bd-btn bd-btn--primary" href="/source-code">Explore Source Code</a>
                <a class="bd-btn bd-btn--outline" href="/btech-final-year-project-report">Project Reports</a>
              </div>
            </div>
          </section>

          <% if (relatedPosts.length) { %>
            <section class="bd-related" aria-labelledby="bd-related-title">
              <h2 id="bd-related-title" class="bd-related__title">Related Articles</h2>
              <div class="bd-related__grid">
                <% relatedPosts.forEach(function (item) {
                  const href = '/blog/' + encodeURIComponent(item.slug || '');
                  const cover = String(item.thumbnail_url || '').trim();
                %>
                  <article class="bd-rel">
                    <a class="bd-rel__media" href="<%= href %>" tabindex="-1" aria-hidden="true">
                      <% if (cover) { %>
                        <img
                          src="<%= bdCdnImage(cover, 480) %>"
                          srcset="<%= bdCdnSrcSet(cover, [240, 480, 720]) %>"
                          sizes="160px"
                          alt="<%= imageAltLabel(bdItemTitle(item), 'related blog post thumbnail') %>"
                          width="480"
                          height="270"
                          loading="lazy"
                          decoding="async"
                        >
                      <% } %>
                    </a>
                    <div class="bd-rel__body">
                      <h3 class="bd-rel__title"><a href="<%= href %>"><%= bdItemTitle(item) %></a></h3>
                      <span class="bd-rel__date"><%= bdFormatDate(item.created_at) %></span>
                    </div>
                  </article>
                <% }) %>
              </div>
            </section>
          <% } %>
        </article>
      </div>

      <aside class="bd-sidebar" aria-label="Blog sidebar">
        <section class="bd-side-card">
          <h2 class="bd-side-card__title">Popular Posts</h2>
          <div class="bd-popular">
            <% if (sidebarPosts.length) { %>
              <% sidebarPosts.forEach(function (item) {
                const href = '/blog/' + encodeURIComponent(item.slug || '');
                const cover = String(item.thumbnail_url || '').trim();
                const title = bdItemTitle(item);
              %>
                <article class="bd-popular__item">
                  <a class="bd-popular__thumb" href="<%= href %>" tabindex="-1" aria-hidden="true">
                    <% if (cover) { %>
                      <img
                        src="<%= bdCdnImage(cover, 220) %>"
                        alt="<%= imageAltLabel(title, 'popular blog post thumbnail') %>"
                        width="220"
                        height="124"
                        loading="lazy"
                        decoding="async"
                      >
                    <% } %>
                  </a>
                  <div>
                    <h3><a href="<%= href %>"><%= title %></a></h3>
                    <small><%= bdFormatDate(item.created_at) %></small>
                  </div>
                </article>
              <% }) %>
            <% } else { %>
              <p class="bd-updated">More articles coming soon.</p>
            <% } %>
          </div>
        </section>

        <% if (bdTags.length) { %>
          <section class="bd-side-card">
            <h2 class="bd-side-card__title">Topics</h2>
            <div class="bd-tags">
              <% bdTags.forEach(function (tag) { %>
                <a class="bd-tag" href="/blog?q=<%= encodeURIComponent(tag) %>"><%= tag %></a>
              <% }) %>
            </div>
          </section>
        <% } %>
      </aside>

    </div>
  </div>
</div>

<% include Includes/footer.ejs %>

<script>
(function () {
  var article = document.getElementById('bdArticle');
  var content = article ? article.querySelector('.bd-content') : null;
  var bar = document.getElementById('bdProgress');
  var readEl = document.getElementById('bdReadTime');

  if (content) {
    content.querySelectorAll('table').forEach(function (tbl) {
      if (tbl.closest('.table-responsive')) return;
      var wrap = document.createElement('div');
      wrap.className = 'table-responsive';
      tbl.parentNode.insertBefore(wrap, tbl);
      wrap.appendChild(tbl);
    });

    <% if (!post.reading_time_minutes) { %>
    if (readEl) {
      var words = (content.innerText || '').trim().split(/\s+/).filter(Boolean).length;
      var mins = Math.max(1, Math.ceil(words / 200));
      readEl.textContent = mins + ' min read';
    }
    <% } %>

    var pageTitle = (document.getElementById('bd-hero-title') || {}).textContent || '';
    var firstHeading = content.querySelector('h1, h2, h3');
    if (firstHeading && pageTitle) {
      var a = firstHeading.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
      var b = pageTitle.replace(/\s+/g, ' ').trim().toLowerCase();
      if (a === b || a.indexOf(b) === 0 || b.indexOf(a) === 0) {
        firstHeading.classList.add('bd-content__dup');
      }
    }
  }

  function onScroll() {
    if (!bar) return;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    var pct = docHeight > 0 ? Math.min(100, (window.scrollY / docHeight) * 100) : 0;
    bar.style.width = pct + '%';
    bar.setAttribute('aria-valuenow', String(Math.round(pct)));
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  var shareUrl = window.location.href;
  var shareTitle = document.getElementById('bd-hero-title');
  var title = shareTitle ? shareTitle.textContent.trim() : 'Article';
  var q = encodeURIComponent(title + ' - ' + shareUrl);
  var u = encodeURIComponent(shareUrl);

  var shareX = document.getElementById('bdShareX');
  var shareLI = document.getElementById('bdShareLI');
  var shareFB = document.getElementById('bdShareFB');
  var shareCopy = document.getElementById('bdShareCopy');

  if (shareX) {
    shareX.href = 'https://twitter.com/intent/tweet?text=' + q;
    shareX.target = '_blank';
    shareX.rel = 'noopener noreferrer';
  }
  if (shareLI) {
    shareLI.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + u;
    shareLI.target = '_blank';
    shareLI.rel = 'noopener noreferrer';
  }
  if (shareFB) {
    shareFB.href = 'https://www.facebook.com/sharer/sharer.php?u=' + u;
    shareFB.target = '_blank';
    shareFB.rel = 'noopener noreferrer';
  }
  if (shareCopy) {
    shareCopy.addEventListener('click', function () {
      var done = function () {
        shareCopy.title = 'Link copied';
        setTimeout(function () { shareCopy.title = 'Copy link'; }, 1500);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(done).catch(function () {});
      }
    });
  }
})();
</script>

<% if (post.schema_markup && String(post.schema_markup).trim()) { %>
<script type="application/ld+json">
<%- post.schema_markup %>
</script>
<% } else { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": <%- JSON.stringify(bdPageTitle) %>,
  "description": <%- JSON.stringify(bdPageLead) %>,
  "image": <%- JSON.stringify(bdCover || '') %>,
  "author": { "@type": "Organization", "name": "FileMakr" },
  "publisher": {
    "@type": "Organization",
    "name": "FileMakr",
    "logo": {
      "@type": "ImageObject",
      "url": "https://res.cloudinary.com/dggf8vl9p/image/upload/v1718627756/filemakr-project-file-creator-favicon_1_dqogst.avif"
    }
  },
  "datePublished": <%- JSON.stringify(new Date(post.created_at || Date.now()).toISOString()) %>,
  <% if (post.updated_at) { %>
  "dateModified": <%- JSON.stringify(new Date(post.updated_at).toISOString()) %>,
  <% } %>
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": <%- JSON.stringify(pageUrl) %>
  }
}
</script>
<% } %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "<%= pageUrl ? pageUrl.split('/blog')[0].replace(/\/$/, '') || 'https://www.filemakr.com' : 'https://www.filemakr.com' %>"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "<%= pageUrl ? pageUrl.split('/blog')[0].replace(/\/$/, '') + '/blog' : 'https://www.filemakr.com/blog' %>"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": <%- JSON.stringify(bdPageTitle) %>,
      "item": <%- JSON.stringify(canonicalHref) %>
    }
  ]
}
</script>
