<% include Includes/blognav.ejs %>
<% include Includes/projectReport.ejs %>

<!-- ====== BREADCRUMB (Schema.org structured) ====== -->
<nav class="breadcrumb-bar" aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
  <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1">
      </li>
      <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/blog" itemprop="item"><span itemprop="name">Blog</span></a>
        <meta itemprop="position" content="2">
      </li>
      <li class="breadcrumb-item active" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
        <span itemprop="name"><%= result[0].meta_title %></span>
        <meta itemprop="item" content="<%= typeof fullUrl !== 'undefined' ? fullUrl : '' %>">
        <meta itemprop="position" content="3">
      </li>
    </ol>
  </div>
</nav>

<!-- ====== READING PROGRESS ====== -->
<div class="read-progress" id="ReadProgress" aria-hidden="true" role="progressbar" aria-valuemin="0" aria-valuemax="100"></div>

<!-- ====== HERO (E-E-A-T friendly) ====== -->
<header class="post-hero" role="banner">
  <div class="container post-hero__wrapper">
    <div class="post-hero__grid <%= !result[0].thumbnail_url ? 'post-hero__grid--no-cover' : '' %>">
      <div class="post-hero__copy">
        <span class="post-pill"><%= (result[0].category || 'Insights').replace(/-/g, ' ') %></span>
        <h1 class="post-title" itemprop="headline"><%= result[0].meta_title %></h1>
        <p class="post-sub" itemprop="description"><%= result[0].meta_description || '' %></p>
        <div class="post-meta-row">
          <ul class="post-meta" aria-label="Article metadata">
            <li><i data-feather="calendar"></i><time datetime="<%= new Date(result[0].created_at || Date.now()).toISOString() %>"><%= new Date(result[0].created_at || Date.now()).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></time></li>
            <li><i data-feather="clock"></i><span id="ReadTime">— min read</span></li>
            <% if (result[0].reading_time_minutes) { %>
            <li><i data-feather="book-open"></i><span><%= result[0].reading_time_minutes %> min</span></li>
            <% } %>
          </ul>
          <div class="post-author-block">
            <div class="post-author-avatar" aria-hidden="true">
              <i data-feather="user"></i>
            </div>
            <div class="post-author-info">
              <span class="post-author-label">Published by</span>
              <span class="post-author-name">FileMakr</span>
            </div>
          </div>
        </div>
      </div>
      <% if (result[0].thumbnail_url) { %>
      <figure class="post-hero__cover">
        <img src="<%= result[0].thumbnail_url %>"
             alt="<%= (result[0].meta_title || '').replace(/"/g, '&quot;') %> — cover image"
             width="1200" height="675" loading="eager" decoding="async"
             itemprop="image">
      </figure>
      <% } %>
    </div>
  </div>
</header>

<main class="post-main" id="main" role="main">
  <div class="container post-grid">
    <!-- ====== ARTICLE (Google-friendly structure) ====== -->
    <article class="post-article" id="Article" itemscope itemtype="https://schema.org/Article">
      <!-- Content -->
      <div class="post-content entry-content" itemprop="articleBody">
        <%- result[0].content %>
      </div>

      <!-- Share & Trust -->
      <div class="post-actions-row">
        <div class="post-share">
          <span class="share-label">Share this article</span>
          <div class="share-actions" role="group">
            <a class="s-btn" id="ShareTW" aria-label="Share on X (Twitter)" title="Share on X"><i data-feather="twitter"></i></a>
            <a class="s-btn" id="ShareLI" aria-label="Share on LinkedIn" title="Share on LinkedIn"><i data-feather="linkedin"></i></a>
            <a class="s-btn" id="ShareFB" aria-label="Share on Facebook" title="Share on Facebook"><i data-feather="facebook"></i></a>
            <a class="s-btn" id="ShareCPY" aria-label="Copy link" title="Copy link"><i data-feather="link-2"></i></a>
          </div>
        </div>
        <% if (result[0].updated_at) { %>
        <p class="post-updated small text-muted">Last updated: <%= new Date(result[0].updated_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
        <% } %>
      </div>

      <!-- CTA (clear value proposition) -->
      <section class="post-cta" aria-label="Related resources">
        <div class="cta-box">
          <div class="cta-icon" aria-hidden="true"><i data-feather="file-code"></i></div>
          <div class="cta-copy">
            <h2 class="cta-title">Need project files or source code?</h2>
            <p class="cta-desc">Explore ready-to-use <a href="/source-code" class="link-strong">source code</a> and <a href="/final-year-project-ideas" class="link-strong">project ideas</a> aligned to college formats.</p>
          </div>
          <div class="cta-actions" role="group">
            <a class="btn btn-brand" href="/source-code"><i data-feather="code"></i> Explore Source Code</a>
            <a class="btn btn-outline" href="/btech-final-year-project-report"><i data-feather="file-text"></i> Project Reports</a>
          </div>
        </div>
      </section>

      <!-- Related Articles -->
      <% if (Array.isArray(recentBlogs) && recentBlogs.length) { 
           const related = recentBlogs.filter(b => b.slug !== result[0].slug).slice(0,3); 
           if (related.length) { %>
      <section class="post-related" aria-labelledby="related-heading">
        <h2 id="related-heading" class="related-heading">Related Articles</h2>
        <div class="rel-grid">
          <% related.forEach(r => { %>
            <article class="rel-card">
              <a class="rel-thumb" href="/blog/<%= r.slug %>">
                <img src="<%= r.thumbnail_url %>" alt="<%= (r.meta_title || '').replace(/"/g, '&quot;') %>" loading="lazy" decoding="async">
              </a>
              <div class="rel-body">
                <h3 class="rel-title"><a href="/blog/<%= r.slug %>"><%= r.meta_title %></a></h3>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
      <% } } %>
    </article>

    <!-- ====== SIDEBAR ====== -->
    <aside class="post-sidebar" aria-label="Related content">
      <!-- Recent Posts -->
      <div class="card sidebar-card">
        <div class="card-hd"><i data-feather="trending-up"></i> Recent Posts</div>
        <ul class="list-recent" role="list">
          <% if (Array.isArray(recentBlogs)) { recentBlogs.slice(0,6).forEach(function(b){ %>
            <li class="recent-item">
              <a class="recent-thumb" href="/blog/<%= b.slug %>">
                <img src="<%= b.thumbnail_url %>" alt="" loading="lazy" decoding="async">
              </a>
              <div class="recent-meta">
                <a class="recent-title" href="/blog/<%= b.slug %>"><%= b.meta_title %></a>
              </div>
            </li>
          <% }) } %>
        </ul>
      </div>

      <!-- Tags / Topics -->
      <% if (result[0].tags || result[0].meta_keywords) { 
           const tags = (result[0].tags || '').toString().split(',').map(t=>t.trim()).filter(Boolean).slice(0,12);
           const kws  = (result[0].meta_keywords || '').toString().split(',').map(t=>t.trim()).filter(Boolean).slice(0,8);
      %>
      <div class="card sidebar-card">
        <div class="card-hd"><i data-feather="hash"></i> Topics</div>
        <div class="tag-cloud">
          <% tags.forEach(function(t){ %><a href="/blog?tag=<%= encodeURIComponent(t) %>" class="tag"><%= t %></a><% }) %>
        </div>
      </div>
      <% if (kws.length) { %>
      <div class="card sidebar-card">
        <div class="card-hd"><i data-feather="search"></i> Keywords</div>
        <div class="tag-cloud">
          <% kws.forEach(function(k){ %><span class="tag tag-muted"><%= k %></span><% }) %>
        </div>
      </div>
      <% } } %>
    </aside>
  </div>
</main>

<% include Includes/footer.ejs %>

<!-- ====== STYLES (Google content-quality friendly) ====== -->
<style>
:root{
  --ink:#111827; --muted:#6b7280; --bg:#f9fafb; --card:#fff; --brd:#e5e7eb;
  --brand:#2563eb; --accent:#F17F23; --ring:rgba(37,99,235,.2); --radius:12px;
  --content-max:65ch; /* Optimal line length for readability */
  --space-xs:.25rem; --space-sm:.5rem; --space-md:1rem; --space-lg:1.5rem; --space-xl:2rem;
}

/* Horizontal spacing - ensure left/right padding on mobile */
.breadcrumb-bar .container,
.post-hero .container,
.post-main .container{ padding-left:max(var(--space-md), 16px); padding-right:max(var(--space-md), 16px); }
@media (min-width:576px){
  .breadcrumb-bar .container,
  .post-hero .container,
  .post-main .container{ padding-left:var(--space-lg); padding-right:var(--space-lg); }
}
@media (min-width:1200px){
  .breadcrumb-bar .container,
  .post-hero .container,
  .post-main .container{ padding-left:var(--space-xl); padding-right:var(--space-xl); }
}

/* Reading progress */
.read-progress{ position:fixed; top:0; left:0; height:4px; width:0; background:linear-gradient(90deg,var(--brand),#60a5fa); z-index:9999; transition:width .15s ease; }

/* Breadcrumb */
.breadcrumb-bar{ border-bottom:1px solid var(--brd); background:var(--card); padding:var(--space-sm) 0; }
.breadcrumb{ display:flex; flex-wrap:wrap; gap:var(--space-xs); margin:0; padding:0; list-style:none; font-size:.875rem; }
.breadcrumb-item{ display:flex; align-items:center; }
.breadcrumb-item + .breadcrumb-item::before{ content:"/"; color:var(--muted); margin-right:var(--space-sm); }
.breadcrumb-item a{ color:var(--brand); text-decoration:none; }
.breadcrumb-item a:hover{ text-decoration:underline; }
.breadcrumb-item.active{ color:var(--muted); max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
@media (min-width:768px){ .breadcrumb-item.active{ max-width:400px; } }

/* Hero */
.post-hero{ background:linear-gradient(180deg, #f0f9ff 0%, #fff 100%); border-bottom:1px solid var(--brd); }
.post-hero__wrapper{ padding:var(--space-xl) 0; }
.post-hero__grid{ display:grid; gap:var(--space-xl); grid-template-columns:1fr; align-items:start; }
@media (min-width:992px){ .post-hero__grid{ grid-template-columns:1.1fr .9fr; } }
.post-hero__grid--no-cover{ grid-template-columns:1fr; }
.post-pill{ display:inline-block; font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--brand); background:rgba(37,99,235,.08); border-radius:999px; padding:var(--space-xs) var(--space-sm); margin-bottom:var(--space-sm); }
.post-title{ margin:0 0 var(--space-sm); color:var(--ink); font-weight:800; font-size:clamp(1.5rem,4vw,2.25rem); line-height:1.2; letter-spacing:-.02em; }
.post-sub{ margin:0 0 var(--space-md); color:var(--muted); font-size:1.0625rem; line-height:1.6; }
.post-meta-row{ display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--space-md); }
.post-meta{ list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:var(--space-md); color:var(--muted); font-size:.875rem; }
.post-meta li{ display:flex; align-items:center; gap:var(--space-xs); }
.post-meta i{ width:16px; height:16px; color:var(--brand); }
.post-author-block{ display:flex; align-items:center; gap:var(--space-sm); }
.post-author-avatar{ width:40px; height:40px; border-radius:50%; background:var(--bg); border:1px solid var(--brd); display:flex; align-items:center; justify-content:center; }
.post-author-avatar i{ width:20px; height:20px; color:var(--brand); }
.post-author-label{ font-size:.75rem; color:var(--muted); display:block; }
.post-author-name{ font-weight:600; color:var(--ink); }
.post-hero__cover{ margin:0; border-radius:var(--radius); overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,.08); }
.post-hero__cover img{ display:block; width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; }

/* Main */
.post-main{ background:var(--bg); }
.post-grid{ display:grid; gap:var(--space-xl); grid-template-columns:1fr; padding:var(--space-xl) 0; }
@media (min-width:1200px){ .post-grid{ grid-template-columns:minmax(0,1fr) 340px; } }

.card{ background:var(--card); border:1px solid var(--brd); border-radius:var(--radius); box-shadow:0 1px 3px rgba(0,0,0,.04); }
.card-hd{ padding:var(--space-md) var(--space-lg); border-bottom:1px solid var(--brd); font-weight:700; font-size:.9375rem; color:var(--ink); display:flex; align-items:center; gap:var(--space-sm); }
.card-hd i{ width:18px; height:18px; color:var(--brand); }

/* Content - fills grid */
.post-article{ min-width:0; }
.post-content{ background:var(--card); border:1px solid var(--brd); border-radius:var(--radius); padding:var(--space-xl); box-shadow:0 1px 3px rgba(0,0,0,.04); margin-bottom:var(--space-lg); font-size:1.0625rem; line-height:1.75; color:var(--ink); width:100%; min-width:0; }
.post-content p{ margin:0 0 1.25em; }
.post-content h2{ font-size:1.5rem; font-weight:700; margin:1.75em 0 .75em; color:var(--ink); }
.post-content h3{ font-size:1.25rem; font-weight:700; margin:1.5em 0 .6em; }
.post-content h4{ font-size:1.125rem; font-weight:600; margin:1.25em 0 .5em; }
.post-content ul,.post-content ol{ padding-left:1.5em; margin:1em 0; }
.post-content li{ margin:.35em 0; }
.post-content blockquote{ border-left:4px solid var(--brand); background:#f8fafc; padding:1em 1.25em; margin:1.5em 0; color:var(--muted); font-style:italic; border-radius:0 var(--radius) var(--radius) 0; }
.post-content img{ max-width:100%; height:auto; border-radius:var(--radius); border:1px solid var(--brd); }
.post-content a{ color:var(--brand); text-decoration:none; }
.post-content a:hover{ text-decoration:underline; }

/* Responsive tables */
.post-content .table-responsive{ overflow-x:auto; -webkit-overflow-scrolling:touch; margin:1.25em 0; border-radius:var(--radius); border:1px solid var(--brd); }
.post-content .table-responsive table{ width:100%; min-width:320px; border-collapse:collapse; }
.post-content .table-responsive th,.post-content .table-responsive td{ padding:.6em .75em; text-align:left; border-bottom:1px solid var(--brd); }
.post-content .table-responsive th{ background:var(--bg); font-weight:600; font-size:.9375rem; }
.post-content .table-responsive tr:last-child td{ border-bottom:none; }
@media (max-width:767.98px){
  .post-content .table-responsive th,.post-content .table-responsive td{ padding:.5em .6em; font-size:.875rem; white-space:normal; word-break:break-word; }
}

/* Share & actions */
.post-actions-row{ display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--space-md); margin-bottom:var(--space-xl); }
.post-share{ display:flex; align-items:center; gap:var(--space-md); flex-wrap:wrap; }
.share-label{ font-size:.875rem; font-weight:600; color:var(--muted); }
.share-actions{ display:flex; gap:var(--space-sm); }
.s-btn{ display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; border-radius:var(--radius); border:1px solid var(--brd); color:var(--ink); background:var(--card); text-decoration:none; transition:box-shadow .15s, border-color .15s; }
.s-btn:hover{ border-color:var(--brand); box-shadow:0 0 0 3px var(--ring); }
.s-btn i{ width:20px; height:20px; }
.post-updated{ margin:0; }

/* CTA */
.post-cta{ margin-bottom:var(--space-xl); }
.post-cta .cta-box{ display:grid; gap:var(--space-lg); padding:var(--space-xl); border:1px solid var(--brd); border-radius:var(--radius); background:linear-gradient(135deg,#eff6ff 0%,#fef3c7 100%); }
@media (min-width:768px){ .post-cta .cta-box{ grid-template-columns:auto 1fr auto; align-items:center; } }
.cta-icon{ width:56px; height:56px; border-radius:var(--radius); background:var(--brand); color:#fff; display:flex; align-items:center; justify-content:center; }
.cta-icon i{ width:28px; height:28px; }
.cta-title{ margin:0 0 var(--space-xs); font-size:1.125rem; font-weight:700; color:var(--ink); }
.cta-desc{ margin:0; font-size:.9375rem; color:var(--muted); line-height:1.5; }
.link-strong{ color:var(--brand); text-decoration:none; font-weight:600; }
.link-strong:hover{ text-decoration:underline; }
.cta-actions{ display:flex; gap:var(--space-sm); flex-wrap:wrap; }
.btn{ display:inline-flex; align-items:center; justify-content:center; gap:var(--space-sm); height:44px; padding:0 20px; border-radius:var(--radius); font-weight:600; font-size:.9375rem; text-decoration:none; transition:opacity .15s, box-shadow .15s; }
.btn i{ width:18px; height:18px; }
.btn-brand{ background:var(--brand); color:#fff; border:1px solid var(--brand); }
.btn-brand:hover{ opacity:.95; }
.btn-outline{ background:var(--card); color:var(--ink); border:1px solid var(--brd); }
.btn-outline:hover{ box-shadow:0 0 0 3px var(--ring); }

/* Related */
.post-related{ margin-top:var(--space-xl); }
.related-heading{ font-size:1.25rem; font-weight:700; color:var(--ink); margin:0 0 var(--space-lg); }
.rel-grid{ display:grid; gap:var(--space-lg); grid-template-columns:1fr; }
@media (min-width:768px){ .rel-grid{ grid-template-columns:repeat(3,1fr); } }
.rel-card{ background:var(--card); border:1px solid var(--brd); border-radius:var(--radius); overflow:hidden; transition:box-shadow .15s; }
.rel-card:hover{ box-shadow:0 4px 20px rgba(0,0,0,.08); }
.rel-thumb{ display:block; }
.rel-thumb img{ display:block; width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; }
.rel-body{ padding:var(--space-md); }
.rel-title{ margin:0; font-size:1rem; font-weight:600; line-height:1.4; }
.rel-title a{ color:var(--ink); text-decoration:none; }
.rel-title a:hover{ color:var(--brand); text-decoration:underline; }

/* Sidebar */
.post-sidebar{ display:flex; flex-direction:column; gap:var(--space-lg); }
@media (min-width:1200px){ .post-sidebar{ position:sticky; top:100px; align-self:start; } }
.sidebar-card .card-hd{ font-size:.875rem; }
.list-recent{ list-style:none; padding:var(--space-md); margin:0; display:grid; gap:var(--space-md); }
.recent-item{ display:flex; gap:var(--space-md); align-items:flex-start; }
.recent-thumb{ flex:0 0 80px; border-radius:8px; overflow:hidden; border:1px solid var(--brd); }
.recent-thumb img{ display:block; width:100%; height:100%; object-fit:cover; aspect-ratio:4/3; }
.recent-title{ color:var(--ink); font-weight:600; font-size:.875rem; line-height:1.4; text-decoration:none; display:block; }
.recent-title:hover{ color:var(--brand); }
.tag-cloud{ padding:var(--space-md); display:flex; flex-wrap:wrap; gap:var(--space-sm); }
.tag{ display:inline-flex; align-items:center; padding:var(--space-xs) var(--space-sm); border-radius:999px; font-size:.8125rem; font-weight:500; background:var(--bg); color:var(--ink); text-decoration:none; border:1px solid var(--brd); transition:border-color .15s, background .15s; }
.tag:hover{ border-color:var(--brand); background:rgba(37,99,235,.06); }
.tag-muted{ opacity:.85; pointer-events:none; }
</style>

<!-- ====== SCRIPTS ====== -->
<script>
(function(){
  // Feather
  function ready(fn){ if(document.readyState !== 'loading'){ fn(); } else { document.addEventListener('DOMContentLoaded', fn); } }
  function ensureFeather(cb){
    if (window.feather && typeof window.feather.replace === 'function') return cb();
    var s=document.createElement('script'); s.src='https://unpkg.com/feather-icons';
    s.onload=function(){ window.feather && window.feather.replace(); cb(); };
    document.head.appendChild(s);
  }

  // Read time & table wrap & progress
  ready(function(){
    const article = document.getElementById('Article');
    const content = article ? article.querySelector('.post-content') : null;

    // Wrap tables for horizontal scroll on mobile
    if (content){
      content.querySelectorAll('table').forEach(function(tbl){
        if (tbl.closest('.table-responsive')) return;
        var wrap = document.createElement('div');
        wrap.className = 'table-responsive';
        tbl.parentNode.insertBefore(wrap, tbl);
        wrap.appendChild(tbl);
      });
    }

    // Reading time (~200 wpm)
    if (content){
      const text = content.innerText || '';
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      const mins = Math.max(1, Math.ceil(words / 200));
      const rtEl = document.getElementById('ReadTime');
      if (rtEl) rtEl.textContent = mins + ' min read';
    }

    // Reading progress (fixed bar at top)
    const bar = document.getElementById('ReadProgress');
    function onScroll(){
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrolled = window.scrollY;
      const pct = docHeight > 0 ? Math.min(100, (scrolled / docHeight) * 100) : 0;
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', Math.round(pct));
    }
    window.addEventListener('scroll', onScroll, { passive:true });
    onScroll();

    // Share
    const shareUrl = window.location.href;
    const title = document.querySelector('.post-title')?.textContent || 'Article';
    const q = encodeURIComponent(title + ' - ' + shareUrl);
    const u = encodeURIComponent(shareUrl);

    const tw = document.getElementById('ShareTW');
    const li = document.getElementById('ShareLI');
    const fb = document.getElementById('ShareFB');
    const cp = document.getElementById('ShareCPY');

    tw && tw.addEventListener('click', ()=> window.open('https://twitter.com/intent/tweet?text=' + q, '_blank', 'noopener'));
    li && li.addEventListener('click', ()=> window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + u, '_blank', 'noopener'));
    fb && fb.addEventListener('click', ()=> window.open('https://www.facebook.com/sharer/sharer.php?u=' + u, '_blank', 'noopener'));
    cp && cp.addEventListener('click', async ()=>{
      try{ await navigator.clipboard.writeText(shareUrl); cp.innerHTML = '<i data-feather="check"></i>'; ensureFeather(()=>window.feather.replace()); setTimeout(()=>{ cp.innerHTML = '<i data-feather="link-2"></i>'; ensureFeather(()=>window.feather.replace()); }, 1500); }catch(e){}
    });

    ensureFeather(()=> window.feather.replace());
  });
})();
</script>

<!-- ====== SEO: Structured Data (Google guidelines, E-E-A-T) ====== -->
<% if (result[0].schema_markup && result[0].schema_markup.trim()) { %>
<!-- Custom JSON-LD from database (writer-defined, per-blog) -->
<script type="application/ld+json">
<%- result[0].schema_markup %>
</script>
<% } else { %>
<!-- Fallback Article schema when no custom schema_markup -->
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Article",
  "headline": <%- JSON.stringify(result[0].meta_title) %>,
  "description": <%- JSON.stringify(result[0].meta_description || "") %>,
  "image": <%- JSON.stringify(result[0].thumbnail_url) %>,
  "author": {"@type":"Organization","name":"FileMakr"},
  "publisher": {"@type":"Organization","name":"FileMakr","logo":{"@type":"ImageObject","url":"https://res.cloudinary.com/dggf8vl9p/image/upload/v1718627756/filemakr-project-file-creator-favicon_1_dqogst.avif"}},
  "datePublished": <%- JSON.stringify(new Date(result[0].created_at || Date.now()).toISOString()) %>,
  <% if (result[0].updated_at) { %>
  "dateModified": <%- JSON.stringify(new Date(result[0].updated_at).toISOString()) %>,
  <% } %>
  "mainEntityOfPage": {"@type":"WebPage","@id": <%- JSON.stringify(typeof fullUrl !== 'undefined' ? fullUrl : '') %>}
}
</script>
<% } %>
<!-- BreadcrumbList for navigation path -->
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":"<%= (typeof fullUrl !== 'undefined' && fullUrl) ? fullUrl.split('/blog')[0].replace(/\/$/, '') || 'https://www.filemakr.com' : 'https://www.filemakr.com' %>"},
    {"@type":"ListItem","position":2,"name":"Blog","item":"<%= (typeof fullUrl !== 'undefined' && fullUrl) ? fullUrl.split('/blog')[0].replace(/\/$/, '') + '/blog' : 'https://www.filemakr.com/blog' %>"},
    {"@type":"ListItem","position":3,"name":<%- JSON.stringify(result[0].meta_title) %>,"item":<%- JSON.stringify(typeof fullUrl !== 'undefined' ? fullUrl : '') %>}
  ]
}
</script>
