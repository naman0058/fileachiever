<%
  const onPageSeoFallback = {
    title: 'Page Not Found (404) | FileMakr',
    description: 'The page you requested was not found. Browse FileMakr project reports, source code and live demos for final-year students.',
    author: 'https://www.filemakr.com',
    abstract: 'FileMakr 404 — find project reports and source code for final-year projects.',
    keywords: '404, page not found, FileMakr, project reports, source code',
    url: 'https://www.filemakr.com'
  };

  const commonFallback = {
    ogPhone: '+91-8319339945',
    ogEmail: 'filemakr@gmail.com',
    ogCountry: 'India',
    ogImage: 'https://www.filemakr.com/images/ogimage.jpg',
    HandheldFriendly: 'true',
    MobileOptimized: 'width',
    Icon: 'https://res.cloudinary.com/dggf8vl9p/image/upload/v1718627756/filemakr-project-file-creator-favicon_1_dqogst.avif',
    URL: 'https://www.filemakr.com',
    siteName: 'FileMakr'
  };

  if (typeof Metatags === 'undefined' || !Metatags) Metatags = onPageSeoFallback;
  if (typeof CommonMetaTags === 'undefined' || !CommonMetaTags) CommonMetaTags = commonFallback;
  if (typeof category === 'undefined' || !Array.isArray(category)) category = [];
  if (typeof fullUrl === 'undefined' || !fullUrl) fullUrl = 'https://www.filemakr.com';
  if (typeof graduation_type_send === 'undefined') graduation_type_send = '';
  if (typeof active === 'undefined') active = '';

  const resolvedStatus = (typeof statusCode !== 'undefined' && statusCode)
    ? Number(statusCode)
    : ((typeof error !== 'undefined' && error && error.status) ? Number(error.status) : 404);

  const is404 = !resolvedStatus || resolvedStatus === 404;
  const displayCode = is404 ? 404 : resolvedStatus;

  const erHeroRaw = 'https://res.cloudinary.com/npuap6la/image/upload/v1787647185/Untitled_2.webp';
  const erHeroSrc = typeof cloudinaryUrl === 'function'
    ? cloudinaryUrl(erHeroRaw, { width: 720 })
    : erHeroRaw;

  const waLink =
    'https://wa.me/918319339945?text=' +
    encodeURIComponent('Hi FileMakr, I landed on a missing page and need help finding a project report / source code.');
%>

