<script src="/js/fm-download-progress.js?v=1"></script>
<script>
(function(){
  function copyText(text, btn, okTitle) {
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function(){
        if (btn) {
          btn.title = okTitle || 'Copied';
          setTimeout(function(){ btn.title = btn.getAttribute('aria-label') || 'Copy'; }, 1200);
        }
      }).catch(function(){});
    }
  }
  var shaBtn = document.getElementById('DrShaCopy');
  var shaFull = document.getElementById('DrShaFull');
  if (shaBtn && shaFull) {
    shaBtn.addEventListener('click', function(){
      copyText(shaFull.textContent || '', shaBtn, 'Copied');
    });
  }
  var orderBtn = document.getElementById('DrOrderCopy');
  var orderIdEl = document.getElementById('DrOrderId');
  if (orderBtn && orderIdEl) {
    orderBtn.addEventListener('click', function(){
      copyText(orderIdEl.textContent || '', orderBtn, 'Copied');
    });
  }

  // Fetch download with progress overlay (Word/PDF). ZIP/CDN files use direct navigation (no CORS fetch).
  function isDirectFileDownload(url) {
    if (!url) return false;
    if (/\.zip(\?|$)/i.test(url)) return true;
    if (/\/download-instant-source/i.test(url)) return true;
    if (/\/images\//i.test(url)) return true;
    try {
      var parsed = new URL(url, window.location.origin);
      if (parsed.origin !== window.location.origin && /\.(zip|rar|7z)(\?|$)/i.test(parsed.pathname)) {
        return true;
      }
    } catch (e) {}
    return false;
  }

  function bindIframeDownload(btn) {
    if (!btn) return;
    var idleHtml = btn.innerHTML;
    btn.addEventListener('click', function(){
      if (btn.disabled || btn.getAttribute('aria-disabled') === 'true') return;
      if (btn.classList.contains('is-loading')) return;
      var url = btn.getAttribute('data-download-url');
      if (!url) return;

      if (isDirectFileDownload(url)) {
        window.location.assign(url);
        return;
      }

      var isPdf = /format=pdf/i.test(url) || /\.pdf(\?|$)/i.test(url);
      btn.classList.add('is-loading');
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      btn.innerHTML = '<span class="dr-spin" aria-hidden="true"></span> ' +
        (isPdf ? 'Preparing PDF…' : 'Preparing file…');

      var run = function () {
        if (window.FmDownloadProgress && typeof window.FmDownloadProgress.fetchAndSave === 'function') {
          return window.FmDownloadProgress.fetchAndSave(url, {
            title: isPdf ? 'Preparing PDF…' : 'Preparing Word…',
            isPdf: isPdf
          });
        }
        return fetch(url, { credentials: 'same-origin' })
          .then(function(res){
            if (!res.ok) throw new Error('Download failed (' + res.status + ')');
            var cd = res.headers.get('Content-Disposition') || '';
            var match = /filename\*?=(?:UTF-8''|")?([^\";]+)"?/i.exec(cd);
            var filename = match ? decodeURIComponent(match[1].replace(/["']/g, '').trim()) : '';
            if (!filename) filename = isPdf ? 'report.pdf' : 'report.docx';
            return res.blob().then(function(blob){ return { blob: blob, filename: filename }; });
          })
          .then(function(data){
            var objectUrl = URL.createObjectURL(data.blob);
            var a = document.createElement('a');
            a.href = objectUrl;
            a.download = data.filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            setTimeout(function(){ try { URL.revokeObjectURL(objectUrl); } catch (e) {} }, 2000);
          });
      };

      run()
        .catch(function(err){
          if (!(window.FmDownloadProgress && err)) {
            alert((err && err.message) ? err.message : 'Download failed. Please try again.');
          }
        })
        .finally(function(){
          btn.classList.remove('is-loading');
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          btn.innerHTML = idleHtml;
        });
    });
  }
  bindIframeDownload(document.getElementById('DownloadBtn'));
  bindIframeDownload(document.getElementById('DownloadBtnPdf'));
  bindIframeDownload(document.getElementById('DownloadBtnAddon'));

  var unavailCopy = document.getElementById('DrUnavailableOrderCopy');
  if (unavailCopy && orderIdEl) {
    unavailCopy.addEventListener('click', function(){
      copyText(orderIdEl.textContent || '', unavailCopy, 'Copied');
      var prev = unavailCopy.textContent;
      unavailCopy.textContent = 'Copied';
      setTimeout(function(){ unavailCopy.textContent = prev || 'Copy Order ID'; }, 1200);
    });
  }
  var addonUnavailCopy = document.getElementById('DrAddonUnavailableOrderCopy');
  if (addonUnavailCopy && orderIdEl) {
    addonUnavailCopy.addEventListener('click', function(){
      copyText(orderIdEl.textContent || '', addonUnavailCopy, 'Copied');
      var prev = addonUnavailCopy.textContent;
      addonUnavailCopy.textContent = 'Copied';
      setTimeout(function(){ addonUnavailCopy.textContent = prev || 'Copy Order ID'; }, 1200);
    });
  }

  var ORDER_ID = <%- JSON.stringify(orderIdSafe) %>;
  var labels = { 1: 'Poor', 2: 'Fair', 3: 'Good', 4: 'Very Good', 5: 'Excellent' };
  var sharedRating = <%= existingRatingSafe || 0 %>;

  function paintStars(root, value, hoverValue) {
    var stars = root.querySelectorAll('.dr-rate-star');
    var active = hoverValue || value || 0;
    for (var i = 0; i < stars.length; i++) {
      var v = parseInt(stars[i].getAttribute('data-val'), 10);
      stars[i].classList.toggle('is-on', v <= (value || 0));
      stars[i].classList.toggle('is-hover', hoverValue ? v <= hoverValue : false);
    }
    var score = root.querySelector('[data-rate-score]');
    var pill = root.querySelector('[data-rate-pill]');
    if (score) score.textContent = value ? Number(value).toFixed(1) : '—';
    if (pill) {
      if (value) {
        pill.style.display = '';
        pill.textContent = labels[value] || '';
      } else {
        pill.style.display = 'none';
      }
    }
  }

  function syncAll(value) {
    sharedRating = value;
    var roots = document.querySelectorAll('[data-rate-root]');
    for (var i = 0; i < roots.length; i++) paintStars(roots[i], value, 0);
  }

  function saveReview(root, rating, withText) {
    var msg = root.querySelector('[data-rate-msg]');
    var textEl = root.querySelector('[data-rate-text]');
    var saveBtn = root.querySelector('[data-rate-save]');
    if (!ORDER_ID) {
      if (msg) { msg.textContent = 'Order ID missing — refresh the page.'; msg.classList.add('is-err'); }
      return;
    }
    if (saveBtn) saveBtn.disabled = true;
    if (msg) { msg.textContent = 'Saving...'; msg.classList.remove('is-err'); }

    var body = {
      order_id: ORDER_ID,
      rating: rating,
      // Keep current textarea text on star-only saves so rating updates don't wipe the review
      review_text: textEl ? (textEl.value || '') : ''
    };

    fetch('/checkout/review', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(body)
    }).then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); })
      .then(function(res){
        if (!res.ok || !res.j || !res.j.ok) {
          throw new Error((res.j && res.j.error) || 'Could not save');
        }
        syncAll(Number(res.j.rating) || rating);
        // keep textarea values in sync across widgets
        var texts = document.querySelectorAll('[data-rate-text]');
        for (var t = 0; t < texts.length; t++) {
          if (typeof res.j.review_text === 'string') texts[t].value = res.j.review_text;
        }
        if (msg) {
          msg.textContent = withText ? 'Thanks! Review saved.' : 'Thanks! Rating saved.';
          msg.classList.remove('is-err');
        }
      })
      .catch(function(err){
        if (msg) {
          msg.textContent = err.message || 'Save failed';
          msg.classList.add('is-err');
        }
      })
      .finally(function(){
        if (saveBtn) saveBtn.disabled = false;
      });
  }

  var roots = document.querySelectorAll('[data-rate-root]');
  for (var r = 0; r < roots.length; r++) {
    (function(root){
      paintStars(root, sharedRating, 0);
      var stars = root.querySelectorAll('.dr-rate-star');
      var form = root.querySelector('[data-rate-form]');
      var saveBtn = root.querySelector('[data-rate-save]');

      for (var i = 0; i < stars.length; i++) {
        stars[i].addEventListener('mouseenter', function(){
          paintStars(root, sharedRating, parseInt(this.getAttribute('data-val'), 10));
        });
        stars[i].addEventListener('mouseleave', function(){
          paintStars(root, sharedRating, 0);
        });
        stars[i].addEventListener('click', function(){
          var val = parseInt(this.getAttribute('data-val'), 10);
          syncAll(val);
          if (form) form.classList.add('is-open');
          // open all forms
          var forms = document.querySelectorAll('[data-rate-form]');
          for (var f = 0; f < forms.length; f++) forms[f].classList.add('is-open');
          saveReview(root, val, false);
        });
      }
      if (saveBtn) {
        saveBtn.addEventListener('click', function(){
          if (!sharedRating) {
            var msg = root.querySelector('[data-rate-msg]');
            if (msg) { msg.textContent = 'Please select a star rating first.'; msg.classList.add('is-err'); }
            return;
          }
          saveReview(root, sharedRating, true);
        });
      }
    })(roots[r]);
  }
})();
</script>
