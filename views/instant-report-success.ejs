<style>
.dr{
  --blue:#2A47FF; --orange:#F17F23; --ink:#0E1220; --muted:#64748B; --line:#EEF1F6; --bg:#FAFAFD;
  --green:#16A34A; --wa:#25D366;
  background:#FAFAFD;
  padding:28px 20px 48px;
  min-height:62vh;
  box-sizing:border-box;
  width:100%;
}
.dr-wrap{ width:100%; max-width:none; margin:0; }
.dr-card{
  background:#fff; border:none; border-radius:0;
  box-shadow:none; overflow:hidden; margin-bottom:0;
}
.dr-card + .dr-card{
  border-top:1px solid var(--line);
}
.dr-hero{ padding:36px 0 18px; text-align:center; position:relative; }
.dr-hero__mark{
  width:112px;height:112px;margin:0 auto 18px;
  position:relative;display:flex;align-items:center;justify-content:center;
}
.dr-hero__burst{
  position:absolute;inset:-18px;pointer-events:none;
}
.dr-hero__dot{
  position:absolute;border-radius:50%;
}
.dr-hero__line{
  position:absolute;width:10px;height:2.5px;border-radius:2px;opacity:.9;
}
.dr-check{
  width:84px;height:84px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:radial-gradient(circle at 35% 30%, #34D399 0%, #22C55E 42%, #16A34A 100%);
  box-shadow:
    0 0 0 10px rgba(34,197,94,.12),
    0 0 0 20px rgba(34,197,94,.06),
    0 0 0 30px rgba(34,197,94,.03),
    0 14px 32px rgba(22,163,74,.28);
  position:relative;z-index:1;
}
.dr-check svg{ width:38px;height:38px; color:#fff; }
.dr-hero__text{ min-width:0; }
.dr-hero h1{
  margin:0 0 10px;font-size:32px;font-weight:800;color:var(--ink);letter-spacing:-.03em;line-height:1.15;
}
.dr-hero > p,
.dr-hero__text > p{
  margin:0 auto 0;max-width:620px;font-size:15px;font-weight:500;color:#64748B;line-height:1.55;
}
.dr-hero__badge{
  display:none;
  margin-top:12px;
  align-items:center;gap:6px;width:fit-content;
  padding:6px 12px;border-radius:999px;
  background:#E8F5E9;color:#15803D;
  font-size:12.5px;font-weight:800;
}
.dr-hero__badge svg{ width:14px;height:14px;flex-shrink:0; }
.dr-hero__desk{ display:inline; }
.dr-hero__mob{ display:none; }

@media (max-width:720px){
  .dr{
    padding:16px 10px 32px;
  }
  .dr-card{
    background:transparent;
  }
  .dr-hero{
    display:flex;align-items:center;gap:14px;
    text-align:left;
    padding:16px 14px;
    margin:0 0 12px;
    background:#fff;
    border:1px solid #E6EAF0;
    border-radius:16px;
  }
  .dr-hero__mark{
    width:78px;height:78px;margin:0;flex-shrink:0;
  }
  .dr-hero__burst{ inset:-10px; }
  .dr-check{
    width:56px;height:56px;
    box-shadow:
      0 0 0 7px rgba(34,197,94,.14),
      0 0 0 14px rgba(34,197,94,.06),
      0 8px 18px rgba(22,163,74,.22);
  }
  .dr-check svg{ width:26px;height:26px; }
  .dr-hero__text{ flex:1; min-width:0; }
  .dr-hero h1{
    margin:0 0 6px;font-size:20px;letter-spacing:-.02em;
  }
  .dr-hero__text > p{
    margin:0;font-size:13px;line-height:1.45;max-width:none;
  }
  .dr-hero__desk{ display:none; }
  .dr-hero__mob{ display:inline; }
  .dr-hero__badge{ display:inline-flex; }
  .dr-order{ margin-top:0; }
}

.dr-status{
  display:flex;align-items:stretch;justify-content:space-between;gap:0;
  margin:22px 0 0;padding:16px 10px;
  background:#E8F5E9;border:1px solid #C8E6C9;border-radius:14px;
}
.dr-status__item{
  flex:1;min-width:0;display:flex;align-items:flex-start;gap:10px;
  padding:4px 14px;text-align:left;position:relative;
}
.dr-status__item + .dr-status__item::before{
  content:"";position:absolute;left:0;top:12%;bottom:12%;width:1px;background:#B7DFB9;
}
.dr-status__ico{
  width:34px;height:34px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.7);color:#15803D;
}
.dr-status__ico svg{ width:18px;height:18px; }
.dr-status__copy{ min-width:0; }
.dr-status__copy strong{ display:block;font-size:13.5px;font-weight:800;color:#14532D;margin:0 0 2px;line-height:1.25; }
.dr-status__copy span{ display:block;font-size:12px;font-weight:500;color:#3F7A48;line-height:1.35; }

.dr-order{
  margin-top:16px;border:1px solid #E6EAF0;border-radius:14px;background:#fff;padding:18px 20px 10px;
}
.dr-order__head{
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  margin:0 0 10px;
}
.dr-order__title{
  display:inline-flex;align-items:center;gap:8px;margin:0;
  font-size:17px;font-weight:800;color:var(--ink);
}
.dr-order__title svg{ width:18px;height:18px; color:var(--blue); }
.dr-orderid{
  display:inline-flex;align-items:center;gap:6px;
  font-size:12.5px;font-weight:700;color:var(--muted);
}
.dr-orderid b{ color:var(--ink); font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
.dr-orderid__copy{
  display:inline-flex;align-items:center;justify-content:center;
  width:22px;height:22px;border:none;border-radius:6px;background:transparent;
  color:var(--blue);cursor:pointer;padding:0;
}
.dr-orderid__copy:hover{ background:#EEF2FF; }
.dr-orderid__copy svg{ width:14px;height:14px; }

.dr-meta{ border:none; border-radius:0; padding:2px 0; background:transparent; }
.dr-meta__row{
  display:flex;justify-content:space-between;gap:16px;align-items:flex-start;
  padding:12px 0;font-size:13.5px;
}
.dr-meta__row + .dr-meta__row{ border-top:1px dashed #E2E8F0; }
.dr-meta__label{ color:var(--muted); font-weight:600; }
.dr-meta__value{ color:var(--ink); font-weight:800; text-align:right; word-break:break-word; }
.dr-badge{
  display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;
  background:#DCFCE7;color:#166534;font-size:12px;font-weight:800;
}

.dr-files{
  margin-top:16px;border:1px solid #E6EAF0;border-radius:14px;overflow:hidden;background:#fff;
}

@media (max-width:900px){
  .dr-status{ flex-wrap:wrap; }
  .dr-status__item{ flex:1 1 42%; padding:10px 12px; }
  .dr-status__item + .dr-status__item::before{ display:none; }
  .dr-status__item:nth-child(even){ border-left:1px solid #B7DFB9; }
  .dr-status__item:nth-child(n+3){ border-top:1px solid #B7DFB9; }
}
@media (max-width:720px){
  .dr-status{ display:none !important; }
}
@media (max-width:520px){
  .dr-status__item{ flex:1 1 100%; border-left:none !important; }
  .dr-status__item + .dr-status__item{ border-top:1px solid #B7DFB9; }
}
.dr-files__head{ padding:18px 18px 14px; }
.dr-files__title{
  display:flex;align-items:center;gap:10px;margin:0 0 4px;
  font-size:18px;font-weight:800;color:var(--ink);letter-spacing:-.02em;
}
.dr-files__title svg{ width:22px;height:22px;color:var(--blue);flex-shrink:0; }
.dr-files__sub{ margin:0;font-size:13.5px;font-weight:500;color:var(--muted);line-height:1.45; }
.dr-files__sub .dr-hero__mob{ display:none; }
.dr-files__sub .dr-hero__desk{ display:inline; }

.dr-file{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  margin:0 18px 16px;padding:14px 16px;
  border:1px solid #E6EAF0;border-radius:12px;background:#fff;
}
.dr-file__left{ display:flex;align-items:center;gap:12px;flex:1;min-width:200px; }
.dr-file__ico{
  width:48px;height:48px;border-radius:10px;flex-shrink:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:#EEF2FF;color:var(--blue);position:relative;
}
.dr-file__ico svg{ width:22px;height:22px; }
.dr-file__badge{
  position:absolute;bottom:-3px;right:-4px;
  font-size:8px;font-weight:900;letter-spacing:.02em;line-height:1;
  background:var(--blue);color:#fff;border-radius:4px;padding:2px 4px;
}
.dr-file__meta{ min-width:0; text-align:left; }
.dr-file__name{ margin:0 0 3px; font-size:14px; font-weight:800; color:var(--ink); word-break:break-word; }
.dr-file__sub{ margin:0; font-size:12px; font-weight:600; color:var(--muted); }

.dr-file__hash{
  display:flex;flex-direction:column;gap:2px;padding:0 14px;
  border-left:1px solid #E6EAF0;min-width:120px;
}
.dr-file__hash-label{
  font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#94A3B8;
}
.dr-file__hash-val{
  display:inline-flex;align-items:center;gap:6px;
  font-size:13px;font-weight:700;color:var(--ink);
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
.dr-file__copy{
  display:inline-flex;align-items:center;justify-content:center;
  width:22px;height:22px;border:none;border-radius:6px;background:transparent;
  color:var(--blue);cursor:pointer;padding:0;
}
.dr-file__copy:hover{ background:#EEF2FF; }
.dr-file__copy svg{ width:14px;height:14px; }

.dr-file__btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  min-height:44px;padding:0 18px;border-radius:10px;border:none;margin-left:auto;
  background:var(--blue);color:#fff;font-size:14px;font-weight:800;text-decoration:none;
  box-shadow:none;cursor:pointer;white-space:nowrap;
}
.dr-file__btn:hover{ filter:brightness(1.03); color:#fff; }
.dr-file__btn:disabled,
.dr-file__btn.is-disabled,
.dr-file__btn.is-loading{
  background:#94A3B8;color:#fff;cursor:not-allowed;filter:none;opacity:.92;
  box-shadow:none;
}
.dr-file__btn svg{ width:16px;height:16px; }
.dr-file__btn .dr-spin{
  width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;
  border-radius:50%;display:inline-block;animation:drSpin .7s linear infinite;flex-shrink:0;
}
@keyframes drSpin{ to{ transform:rotate(360deg); } }

.dr-file-note{
  display:flex;align-items:flex-start;gap:12px;
  margin:0 0 14px;padding:14px 16px;
  border:1px solid #F1D4A3;border-radius:12px;background:#FFF8EE;
  text-align:left;
}
.dr-file-note__ico{
  width:36px;height:36px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:#fff;color:#C2410C;border:1px solid #F5DEB3;
}
.dr-file-note__ico svg{ width:18px;height:18px; }
.dr-file-note__body{ min-width:0;flex:1; }
.dr-file-note__body strong{
  display:block;font-size:14px;font-weight:800;color:#9A3412;margin:0 0 4px;line-height:1.3;
}
.dr-file-note__body p{
  margin:0;font-size:13px;font-weight:500;color:#9A5B2E;line-height:1.5;
}
.dr-file-note__actions{
  display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;
}
.dr-file-note__btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  height:34px;padding:0 12px;border-radius:8px;font-size:12.5px;font-weight:800;
  text-decoration:none;border:1.5px solid transparent;cursor:pointer;background:#fff;
}
.dr-file-note__btn--wa{ color:#128C7E;border-color:#25D366; }
.dr-file-note__btn--wa:hover{ background:#ECFDF5; text-decoration:none; }
.dr-file-note__btn--copy{ color:var(--blue);border-color:#C7D2FE; }
.dr-file-note__btn--copy:hover{ background:#EEF2FF; }
.dr-file-note__btn svg{ width:14px;height:14px; }

.dr-safe{
  display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap;
  margin:0;padding:12px 10px;
  border:none;border-top:1px solid #E6EAF0;border-radius:0;background:#F5F7FB;
  font-size:12px;font-weight:700;color:#475569;
}
.dr-safe__item{
  display:inline-flex;align-items:center;gap:6px;padding:4px 10px;
}
.dr-safe__item + .dr-safe__item{ border-left:1px solid #D7DEEA; }
.dr-safe svg{ width:14px;height:14px;flex-shrink:0; }
.dr-safe__item--ok svg{ color:#16A34A; }
.dr-safe__item--lock svg{ color:#2A47FF; }
.dr-safe__item--virus svg{ color:#7C3AED; }

.dr-support-m{ display:none; }

@media (max-width:720px){
  .dr-files__head{ padding:14px 14px 10px; }
  .dr-files__title{ font-size:16px; gap:8px; }
  .dr-files__title svg{ width:18px;height:18px; }
  .dr-files__sub{ font-size:12.5px; }
  .dr-files__sub .dr-hero__desk{ display:none; }
  .dr-files__sub .dr-hero__mob{ display:inline; }

  .dr-file{
    flex-direction:column;align-items:stretch;gap:12px;
    margin:0 14px 14px;padding:12px;
  }
  .dr-file__left{ min-width:0; width:100%; }
  .dr-file__hash{ display:none !important; }
  .dr-file__btn{ width:100%; margin-left:0; min-height:46px; }

  .dr-safe{
    justify-content:space-between;padding:10px 8px;gap:0;
  }
  .dr-safe__item{
    flex:1;justify-content:center;padding:4px 4px;
    font-size:10.5px;text-align:center;flex-direction:column;gap:4px;
  }
  .dr-safe__item + .dr-safe__item{ border-left:1px solid #D7DEEA; }

  .dr-panel,
  .dr-feats{ display:none !important; }

  .dr-rate-m{ display:block !important; }
  .dr-support-m{
    display:flex;align-items:center;gap:12px;
    margin:14px 0 0;padding:14px;
    background:#EEF2FF;border:1px solid #DCE3F5;border-radius:14px;
  }
  .dr-support-m__ico{
    width:44px;height:44px;border-radius:50%;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
    background:#fff;color:var(--blue);
  }
  .dr-support-m__ico svg{ width:22px;height:22px; }
  .dr-support-m__copy{ flex:1;min-width:0;text-align:left; }
  .dr-support-m__copy strong{ display:block;font-size:14.5px;font-weight:800;color:var(--ink);margin:0 0 2px; }
  .dr-support-m__copy span{ display:block;font-size:12px;font-weight:500;color:var(--muted);line-height:1.35; }
  .dr-support-m__btn{
    display:inline-flex;align-items:center;justify-content:center;gap:7px;
    height:40px;padding:0 12px;border-radius:10px;flex-shrink:0;
    border:1.5px solid var(--blue);background:#fff;color:var(--blue);
    font-size:12.5px;font-weight:800;text-decoration:none;white-space:nowrap;
  }
  .dr-support-m__btn svg{ width:15px;height:15px; }
}
@media (max-width:420px){
  .dr-support-m{ flex-wrap:wrap; }
  .dr-support-m__btn{ width:100%; }
}

.dr-panel{
  display:grid;grid-template-columns:1.05fr 1fr;gap:0;
  margin:16px 0 0;border:1px solid #E6EAF0;border-radius:14px;background:#fff;overflow:hidden;
}
.dr-panel__col{ padding:20px 22px; text-align:left; }
.dr-panel__col + .dr-panel__col{ border-left:1px solid #E6EAF0; }
.dr-panel__row{ display:flex;align-items:flex-start;gap:12px; }
.dr-panel__ico{
  width:44px;height:44px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  background:#EEF2FF;color:var(--blue);
}
.dr-panel__ico svg{ width:22px;height:22px; }
.dr-panel__copy{ min-width:0; }
.dr-panel__copy strong{ display:block;font-size:15px;font-weight:800;color:var(--ink);margin:0 0 3px; }
.dr-panel__copy span{ display:block;font-size:12.5px;font-weight:500;color:var(--muted);line-height:1.4; }
.dr-panel__stars{
  display:flex;align-items:center;gap:10px;margin-top:10px;flex-wrap:wrap;
}
.dr-rate-widget{ display:flex;align-items:center;gap:10px;flex-wrap:wrap; }
.dr-rate-stars{ display:inline-flex;align-items:center;gap:2px; }
.dr-rate-star{
  appearance:none;border:none;background:transparent;padding:0;margin:0;
  cursor:pointer;font-size:22px;line-height:1;color:#E2E8F0;
}
.dr-rate-star.is-on{ color:#F5B301; }
.dr-rate-star:hover,
.dr-rate-star.is-hover{ color:#F5B301; }
.dr-rate-star:disabled{ cursor:default; }
.dr-rate-score{ font-size:14px;font-weight:800;color:var(--blue); }
.dr-rate-pill{
  display:inline-flex;align-items:center;padding:3px 10px;border-radius:999px;
  background:var(--blue);color:#fff;font-size:12px;font-weight:800;
}
.dr-rate-form{ width:100%; margin-top:10px; display:none; }
.dr-rate-form.is-open{ display:block; }
.dr-rate-form textarea{
  width:100%;min-height:72px;resize:vertical;box-sizing:border-box;
  border:1px solid #E6EAF0;border-radius:10px;padding:10px 12px;
  font:inherit;font-size:13px;color:var(--ink);background:#fff;
}
.dr-rate-form__row{ display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px;flex-wrap:wrap; }
.dr-rate-form__msg{ font-size:12px;font-weight:700;color:#16A34A;min-height:16px; }
.dr-rate-form__msg.is-err{ color:#DC2626; }
.dr-rate-save{
  display:inline-flex;align-items:center;justify-content:center;
  height:36px;padding:0 14px;border-radius:9px;border:none;
  background:var(--blue);color:#fff;font-size:12.5px;font-weight:800;cursor:pointer;
}
.dr-rate-save:disabled{ opacity:.6; cursor:default; }

.dr-rate-m{
  display:none;
  margin:14px 0 0;padding:14px;border:1px solid #E6EAF0;border-radius:14px;background:#fff;
}
.dr-rate-m__head{ display:flex;align-items:flex-start;gap:12px;text-align:left; }
.dr-rate-m__ico{
  width:40px;height:40px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;background:#EEF2FF;color:var(--blue);
}
.dr-rate-m__ico svg{ width:20px;height:20px; }
.dr-rate-m strong{ display:block;font-size:14.5px;font-weight:800;color:var(--ink);margin:0 0 2px; }
.dr-rate-m > .dr-rate-m__head span{ display:block;font-size:12px;font-weight:500;color:var(--muted); }

.dr-panel__actions{ display:flex;flex-wrap:wrap;gap:8px;margin-top:12px; }
.dr-panel__btn{
  display:inline-flex;align-items:center;gap:7px;
  height:36px;padding:0 12px;border-radius:9px;
  border:1.5px solid;background:#fff;
  font-size:12.5px;font-weight:800;text-decoration:none;
}
.dr-panel__btn svg{ width:15px;height:15px; }
.dr-panel__btn--wa{ color:#16A34A; border-color:#86EFAC; }
.dr-panel__btn--wa:hover{ background:#F0FDF4; color:#16A34A; }
.dr-panel__btn--ticket{ color:#2A47FF; border-color:#BFDBFE; }
.dr-panel__btn--ticket:hover{ background:#EFF6FF; color:#2A47FF; }
.dr-panel__btn--mail{ color:#7C3AED; border-color:#DDD6FE; }
.dr-panel__btn--mail:hover{ background:#F5F3FF; color:#7C3AED; }

.dr-feats{
  display:flex;align-items:stretch;justify-content:space-between;
  margin:14px 0 0;border:1px solid #E6EAF0;border-radius:14px;background:#fff;
  padding:18px 8px;overflow:hidden;
}
.dr-feats__item{
  flex:1;min-width:0;
  display:flex;align-items:center;gap:12px;
  padding:4px 14px;text-align:left;position:relative;
}
.dr-feats__item + .dr-feats__item::before{
  content:"";position:absolute;left:0;top:10%;bottom:10%;
  width:1px;background:#E6EAF0;
}
.dr-feats__ico{
  width:42px;height:42px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
}
.dr-feats__ico svg{ width:20px;height:20px; }
.dr-feats__copy{ min-width:0; }
.dr-feats__item strong{
  display:block;font-size:13.5px;font-weight:800;color:var(--ink);margin:0 0 2px;line-height:1.25;
}
.dr-feats__item span{
  display:block;font-size:12px;font-weight:500;color:var(--muted);line-height:1.35;
}

@media (max-width:900px){
  .dr-panel{ grid-template-columns:1fr; }
  .dr-panel__col + .dr-panel__col{ border-left:none; border-top:1px solid #E6EAF0; }
  .dr-feats{ flex-wrap:wrap; }
  .dr-feats__item{ flex:1 1 42%; padding:12px 10px; }
  .dr-feats__item + .dr-feats__item::before{ display:none; }
  .dr-feats__item:nth-child(even){ border-left:1px solid #E6EAF0; }
  .dr-feats__item:nth-child(n+3){ border-top:1px solid #E6EAF0; }
}
@media (max-width:520px){
  .dr-feats__item{ flex:1 1 100%; border-left:none !important; }
  .dr-feats__item + .dr-feats__item{ border-top:1px solid #E6EAF0; }
}
</style>

