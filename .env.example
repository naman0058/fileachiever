# MERN Training — daily Google Meet (7 PM default, Asia/Kolkata)
# Calendar ID: use "primary" for the OAuth user’s main calendar, or the calendar ID from
# Google Calendar settings. For service accounts, share that calendar with the SA email.
MERN_GOOGLE_CALENDAR_ID=
# Optional; defaults to GOOGLE_SERVICE_ACCOUNT_JSON (service account path — no Calendar guest invites)
# MERN_GOOGLE_CALENDAR_KEYFILE=./service-account.json
# OAuth user (recommended for Calendar invites): run npm run mern-calendar-oauth once
# MERN_GOOGLE_OAUTH_CLIENT_ID=
# MERN_GOOGLE_OAUTH_CLIENT_SECRET=
# MERN_GOOGLE_OAUTH_REFRESH_TOKEN=
# Must match redirect URI used when you obtained the refresh token (defaults for local script):
# MERN_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8766/mern-calendar-oauth-callback
MERN_CLASS_TZ=Asia/Kolkata
MERN_CLASS_HOUR=19
MERN_CLASS_MINUTE=0
MERN_CLASS_DURATION_MINUTES=60

